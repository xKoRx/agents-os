 "transcript": [
  {
   "id": "asr-00075",
   "start_ms": 525900,
   "end_ms": 527380,
   "text": "Bueno, lástima"
  },
  {
   "id": "asr-00076",
   "start_ms": 527380,
   "end_ms": 529240,
   "text": "que llegó antes de que pudiésemos entrar"
  },
  {
   "id": "asr-00077",
   "start_ms": 529240,
   "end_ms": 531120,
   "text": "en la sesión, pero el objetivo de libra"
  },
  {
   "id": "asr-00078",
   "start_ms": 531120,
   "end_ms": 533600,
   "text": "estaba ahí arriba. Esta es un poco la importancia"
  },
  {
   "id": "asr-00079",
   "start_ms": 533600,
   "end_ms": 534660,
   "text": "de los rangos."
  },
  {
   "id": "asr-00080",
   "start_ms": 535400,
   "end_ms": 536720,
   "text": "Asumir que se van a completar"
  },
  {
   "id": "asr-00081",
   "start_ms": 536720,
   "end_ms": 539220,
   "text": "y que el precio funciona de esta manera. De un rango"
  }
 ],
