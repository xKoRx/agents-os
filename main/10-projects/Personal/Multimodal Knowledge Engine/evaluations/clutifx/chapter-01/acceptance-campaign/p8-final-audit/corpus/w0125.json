   "start_ms": 1934420,
   "end_ms": 1937180,
   "text": "es básicamente esto"
  },
  {
   "id": "asr-00277",
   "start_ms": 1937180,
   "end_ms": 1938420,
   "text": "concepto muy importante"
  },
  {
   "id": "asr-00278",
   "start_ms": 1938420,
   "end_ms": 1940700,
