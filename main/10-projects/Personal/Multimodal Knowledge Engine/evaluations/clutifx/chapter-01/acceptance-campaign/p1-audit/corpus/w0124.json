 "unresolved_record_ids": [],
 "transcript": [
  {
   "id": "asr-00271",
   "start_ms": 1883530,
   "end_ms": 1906420,
   "text": "Esto de aquí y cierra aquí, ¿vale? A las 5. Esto es el concepto de Power 3. ¿Por qué es importante esto? Para saber, pues, si tú estás buscando compras en un contexto alcista, las compras ideales siempre, siempre, siempre van a estar en esta etapa de manipulación de la vela, ¿vale?"
  },
  {
   "id": "asr-00272",
   "start_ms": 1906420,
   "end_ms": 1919200,
   "text": "Por lo tanto, es importante para saber, imagínate, son las 4.30 y tú quieres entrar en un long, pues lo que vas a hacer es esperar a que abra la nueva vela de 4 horas a las 5 para en el power of 3 entrar en el punto óptimo."
  },
  {
   "id": "asr-00273",
   "start_ms": 1919580,
   "end_ms": 1925600,
   "text": "Vas a la vela anterior, si esto abre aquí, significa que la vela anterior ha cerrado aquí, ¿vale?"
  },
  {
   "id": "asr-00274",
   "start_ms": 1926200,
   "end_ms": 1929620,
   "text": "¿Qué te es mejor, entrar aquí arriba o entrar aquí abajo?"
  }
 ],
