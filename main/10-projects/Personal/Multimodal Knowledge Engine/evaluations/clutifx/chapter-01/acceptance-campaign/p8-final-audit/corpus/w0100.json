 "transcript": [
  {
   "id": "asr-00207",
   "start_ms": 1535940,
   "end_ms": 1552160,
   "text": "Luego, concepto de failure swing, ya lo visteis también un poco en el curso intermedio. El failure swing es cuando el precio no consigue hacer un nuevo bajo y puede darse por varios casos."
  },
  {
   "id": "asr-00208",
   "start_ms": 1552160,
   "end_ms": 1553960,
   "text": "por la SMT"
  },
  {
   "id": "asr-00209",
   "start_ms": 1553960,
   "end_ms": 1555930,
   "text": "puede darse por"
  },
  {
   "id": "asr-00210",
   "start_ms": 1555930,
   "end_ms": 1558430,
   "text": "que ha hecho el alto"
  },
  {
   "id": "asr-00211",
   "start_ms": 1558430,
   "end_ms": 1560870,
   "text": "al final, o en este caso el bajo"
  },
  {
   "id": "asr-00212",
   "start_ms": 1560870,
   "end_ms": 1564680,
   "text": "al final de la vela"
  },
  {
   "id": "asr-00213",
   "start_ms": 1564680,
   "end_ms": 1566320,
   "text": "va a haber un capítulo de Felur Swing"
  }
 ],
