 "unresolved_record_ids": [],
 "transcript": [
  {
   "id": "asr-00098",
   "start_ms": 572710,
   "end_ms": 594750,
   "text": "¿Por qué? Porque ahora vamos a lo que podría ser 4 horas, ha tomado el low de este rango, así, ¿vale? Luego hace otra vela por aquí, vamos a dibujarlo con mechas también que se vea un poco más real, ¿sí?"
  },
  {
   "id": "asr-00099",
   "start_ms": 594750,
   "end_ms": 620320,
   "text": "Y la nueva vela que abre va a abrir por aquí y si nos toma este low por aquí y cierra adentro o reacciona en la otra vela, o sea, toma el low de la vela anterior y sube, esto es lo que llamaremos un rango pendiente."
  }
 ],
