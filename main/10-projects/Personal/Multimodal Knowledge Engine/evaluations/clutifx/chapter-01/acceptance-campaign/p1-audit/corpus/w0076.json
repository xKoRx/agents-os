 "unresolved_record_ids": [],
 "transcript": [
  {
   "id": "asr-00163",
   "start_ms": 1157090,
   "end_ms": 1161050,
   "text": "y tendríamos a lo mejor un nuevo rango que podría ser este."
  },
  {
   "id": "asr-00164",
   "start_ms": 1161750,
   "end_ms": 1166610,
   "text": "O sea, esto ya no sería un intertartel sub, sino que sería un tartel sub de este rango"
  },
  {
   "id": "asr-00165",
   "start_ms": 1166610,
   "end_ms": 1170510,
   "text": "y este lo podríamos ya eliminar porque la vela cierra fuera, ¿vale?"
  },
  {
   "id": "asr-00166",
   "start_ms": 1170790,
   "end_ms": 1174750,
   "text": "Importante este concepto también, que una vez el rango se nos completa,"
  },
  {
   "id": "asr-00167",
   "start_ms": 1175840,
   "end_ms": 1179620,
   "text": "completa significa que toma tanto el low como el alto, ¿vale?"
  },
  {
   "id": "asr-00168",
   "start_ms": 1179620,
   "end_ms": 1197440,
   "text": "Este rango ya se puede eliminar y del mismo caso, si cierra afuera, esto ya no es un rango. Si tenemos una idea alcista, tendremos que esperar ahora a que una nueva vela, bueno, la dejo aquí marcada, en este caso, ello, esto ya no es un rango."
  }
 ],
