 "transcript": [
  {
   "id": "asr-00069",
   "start_ms": 509540,
   "end_ms": 514419,
   "text": "Otra vez, rango bullish en Libra, teníamos este objetivo para hoy. ¿Por qué? Cierra"
  },
  {
   "id": "asr-00070",
   "start_ms": 514419,
   "end_ms": 516220,
   "text": "con fuerza este, no teníamos"
  },
  {
   "id": "asr-00071",
   "start_ms": 516220,
   "end_ms": 519039,
   "text": "rango bajista"
  },
  {
   "id": "asr-00072",
   "start_ms": 519039,
   "end_ms": 520880,
   "text": "que ha hecho a la libra ir directamente"
  },
  {
   "id": "asr-00073",
   "start_ms": 520880,
   "end_ms": 522020,
   "text": "hasta su objetivo."
  },
  {
   "id": "asr-00074",
   "start_ms": 523169,
   "end_ms": 524110,
   "text": "Aquí lo veis claro."
  }
 ],
