+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.fury.toolkit.kvs.BulkResult;
+import com.fury.toolkit.kvs.ErrorCode;
+import com.fury.toolkit.kvs.Item;
+import com.fury.toolkit.kvs.ItemResult;
+import com.fury.toolkit.kvs.KeyResult;
+import com.fury.toolkit.kvs.KvsClient;
+import com.fury.toolkit.kvs.KvsClientException;
+import com.fury.toolkit.kvs.Operations;
+import java.time.Clock;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.regex.Pattern;
+
+/**
+ * Instance-owned byte store for the explicit {@code memory-e2e} profile.
+ *
+ * <p>Creation is exclusive and assigns version one. Updates compare the requested version and
+ * increment it once. TTL -1 does not expire, zero expires immediately, and positive TTL is seconds
+ * from the successful write. Reads retain the configured TTL, not a server-derived remaining TTL.
+ * Each instance owns its state; another context or JVM has a separate store and restart loses it.
+ * Typed, batch and bulk APIs are deliberately unsupported and return a failed future.
+ */
+public final class LocalInMemoryKvsClient implements KvsClient {
+
+  private static final int NO_EXPIRATION = -1;
+  private static final Pattern RUN_ID = Pattern.compile("[a-z0-9][a-z0-9_-]{7,63}");
+  private static final String INVALID_ARGUMENT = "LOCAL_MEMORY_KVS_INVALID_ARGUMENT";
+  private static final String CONFLICT = "LOCAL_MEMORY_KVS_CONFLICT";
+  private static final String CLOSED = "LOCAL_MEMORY_KVS_CLOSED";
+  private static final String UNSUPPORTED = "LOCAL_MEMORY_KVS_UNSUPPORTED_API";
+
+  private final ConcurrentHashMap<String, Stored> entries = new ConcurrentHashMap<>();
+  private final Clock clock;
+  private final String runId;
+  private final String instanceId = UUID.randomUUID().toString();
+  private final long ownerPid = ProcessHandle.current().pid();
+  private boolean isClosed;
+
+  /**
+   * Creates an isolated store with the system UTC clock.
+   *
+   * @param runId the owned local E2E run identifier
+   * @throws IllegalArgumentException if the run identifier is invalid
+   */
+  public LocalInMemoryKvsClient(String runId) {
+    this(runId, Clock.systemUTC());
+  }
+
+  LocalInMemoryKvsClient(String runId, Clock clock) {
+    if (runId == null || !RUN_ID.matcher(runId).matches()) {
+      throw new IllegalArgumentException("LOCAL_MEMORY_KVS_RUN_ID_INVALID");
+    }
+    this.runId = runId;
+    this.clock = Objects.requireNonNull(clock, "clock");
+  }
+
+  /** @return the run identifier bound when the store was created */
+  public String runId() {
+    return runId;
+  }
+
+  /** @return the immutable identifier of this store instance */
+  public String instanceId() {
+    return instanceId;
+  }
+
+  /** @return the native PID of the JVM that created this store */
+  public long ownerPid() {
+    return ownerPid;
+  }
+
+  @Override
+  public CompletableFuture<Item<byte[]>> getAsync(String key) {
+    return execute(() -> {
+      requireKey(key);
+      final Stored stored = current(key);
+      return stored == null ? null : snapshot(key, stored);
+    });
+  }
+
+  @Override
+  public CompletableFuture<Void> saveAsync(Item<byte[]> item) {
+    return execute(() -> {
+      requireItem(item);
+      if (current(item.getKey()) != null) {
+        throw failure(ErrorCode.CONFLICT, CONFLICT);
+      }
+      entries.put(item.getKey(), stored(item, 1));
+      return null;
+    });
+  }
+
+  @Override
+  public CompletableFuture<Void> updateAsync(Item<byte[]> item) {
+    return execute(() -> {
+      requireItem(item);
+      final Stored existing = current(item.getKey());
+      if (existing == null || existing.version() != item.getVersion()) {
+        throw failure(ErrorCode.CONFLICT, CONFLICT);
+      }
+      if (existing.version() == Integer.MAX_VALUE) {
+        throw failure(ErrorCode.BAD_REQUEST, INVALID_ARGUMENT);
+      }
+      entries.put(item.getKey(), stored(item, existing.version() + 1));
+      return null;
+    });
+  }
+
+  @Override
+  public CompletableFuture<Boolean> deleteAsync(String key) {
+    return execute(() -> {
+      requireKey(key);
+      if (current(key) == null) {
+        return false;
+      }
+      entries.remove(key);
+      return true;
+    });
+  }
+
+  @Override
+  public synchronized void close() {
+    isClosed = true;
+    entries.clear();
+  }
+
+  @Override
+  public <T> CompletableFuture<Item<T>> getAsync(String key, Class<T> type) {
+    return unsupported();
+  }
+
+  @Override
+  public CompletableFuture<List<Item<byte[]>>> batchReadAsync(List<String> keys) {
+    return unsupported();
+  }
+
+  @Override
+  public <T> CompletableFuture<List<Item<T>>> batchReadAsync(List<String> keys, Class<T> type) {
+    return unsupported();
+  }
+
+  @Override
+  public CompletableFuture<Void> batchWriteAsync(Operations operations) {
+    return unsupported();
+  }
+
+  @Override
+  public CompletableFuture<BulkResult<KeyResult>> bulkWriteAsync(Operations operations) {
+    return unsupported();
+  }
+
+  @Override
+  public CompletableFuture<BulkResult<ItemResult<byte[]>>> bulkReadAsync(List<String> keys) {
+    return unsupported();
+  }
+
+  @Override
+  public <T> CompletableFuture<BulkResult<ItemResult<T>>> bulkReadAsync(List<String> keys, Class<T> type) {
+    return unsupported();
+  }
+
+  // One instance monitor orders CRUD with close, so no write can repopulate a closed store.
+  private synchronized <T> CompletableFuture<T> execute(KvsOperation<T> operation) {
+    if (isClosed) {
+      return CompletableFuture.failedFuture(failure(ErrorCode.SERVICE_ERROR, CLOSED));
+    }
+    try {
+      return CompletableFuture.completedFuture(operation.run());
+    } catch (KvsClientException failure) {
+      return CompletableFuture.failedFuture(failure);
+    }
+  }
+
+  private <T> CompletableFuture<T> unsupported() {
+    return execute(() -> {
+      throw failure(ErrorCode.BAD_REQUEST, UNSUPPORTED);
+    });
+  }
+
+  private Stored current(String key) {
+    final Stored stored = entries.get(key);
+    if (stored != null && stored.ttl() != NO_EXPIRATION && clock.millis() >= stored.expiresAt()) {
+      entries.remove(key);
+      return null;
+    }
+    return stored;
+  }
+
+  private Stored stored(Item<byte[]> item, int version) throws KvsClientException {
+    final long now = clock.millis();
+    final long expiresAt;
+    try {
+      expiresAt = item.getTtl() == NO_EXPIRATION
+          ? Long.MAX_VALUE : Math.addExact(now, TimeUnit.SECONDS.toMillis(item.getTtl()));
+    } catch (ArithmeticException overflow) {
+      throw failure(ErrorCode.BAD_REQUEST, INVALID_ARGUMENT);
+    }
+    final byte[] value = item.getValue();
+    return new Stored(Arrays.copyOf(value, value.length), version, item.getTtl(), expiresAt, now);
+  }
+
+  private static Item<byte[]> snapshot(String key, Stored stored) {
+    return new Item<>(key, Arrays.copyOf(stored.value(), stored.value().length),
+        stored.ttl(), stored.version(), stored.writtenAt());
+  }
+
+  private static void requireItem(Item<byte[]> item) throws KvsClientException {
+    if (item == null || item.getValue() == null || item.getTtl() < NO_EXPIRATION) {
+      throw failure(ErrorCode.BAD_REQUEST, INVALID_ARGUMENT);
+    }
+    requireKey(item.getKey());
+  }
+
+  private static void requireKey(String key) throws KvsClientException {
+    if (key == null || key.isBlank()) {
+      throw failure(ErrorCode.BAD_REQUEST, INVALID_ARGUMENT);
+    }
+  }
+
+  private static KvsClientException failure(ErrorCode code, String message) {
+    return new KvsClientException(code.getCode(), message);
+  }
+
+  private record Stored(byte[] value, int version, int ttl, long expiresAt, long writtenAt) { }
+
+  @FunctionalInterface
+  private interface KvsOperation<T> {
+    T run() throws KvsClientException;
+  }
+}
