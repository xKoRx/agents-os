+  private static IdempotencyGuard guard(LocalInMemoryKvsClient client, Clock clock) {
+    return new IdempotencyGuard(client,
+        JsonMapper.builder().propertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE).build(),
+        GUARD_TTL, STALE_MS, RETRY_MS, clock);
+  }
+
+  private static int winners(Callable<Boolean> operation) throws Exception {
+    final CountDownLatch ready = new CountDownLatch(WORKERS);
+    final CountDownLatch start = new CountDownLatch(1);
+    try (var executor = Executors.newFixedThreadPool(WORKERS)) {
+      try {
+        final List<Future<Boolean>> attempts = new ArrayList<>();
+        for (int index = 0; index < WORKERS; index++) {
+          attempts.add(executor.submit(() -> {
+            ready.countDown();
+            if (!start.await(DEADLINE_SECONDS, TimeUnit.SECONDS)) {
+              throw new IllegalStateException("concurrency start deadline");
+            }
+            return operation.call();
+          }));
+        }
+        assertTrue(ready.await(DEADLINE_SECONDS, TimeUnit.SECONDS));
+        start.countDown();
+        int count = 0;
+        for (Future<Boolean> attempt : attempts) {
+          if (attempt.get(DEADLINE_SECONDS, TimeUnit.SECONDS)) {
+            count++;
+          }
+        }
+        return count;
+      } finally {
+        start.countDown();
+        executor.shutdownNow();
+      }
+    }
+  }
+
+  private static boolean attempt(KvsWrite operation) throws KvsClientException {
+    try {
+      operation.run();
+      return true;
+    } catch (KvsClientException failure) {
+      assertEquals(ErrorCode.CONFLICT.getCode(), failure.getErrorCode());
+      return false;
+    }
+  }
+
+  private static void assertCode(ErrorCode expected, Executable operation) {
+    assertEquals(expected.getCode(), assertThrows(KvsClientException.class, operation).getErrorCode());
+  }
+
+  private static void assertFutureCode(ErrorCode expected, CompletableFuture<?> future) {
+    assertEquals(expected.getCode(), assertInstanceOf(KvsClientException.class,
+        assertThrows(java.util.concurrent.ExecutionException.class, future::get).getCause()).getErrorCode());
+  }
+
+  private static Item<byte[]> item(int version, int ttl) {
+    return Item.builder(KEY, bytes()).withVersion(version).withTtl(ttl).build();
+  }
+
+  private static byte[] bytes() {
+    return VALUE.getBytes(StandardCharsets.UTF_8);
+  }
+
+  private static String text(Item<byte[]> item) {
+    return new String(item.getValue(), StandardCharsets.UTF_8);
+  }
+
+  @FunctionalInterface
+  private interface KvsWrite {
+    void run() throws KvsClientException;
+  }
+
+  private static final class MutableClock extends Clock {
+    private final AtomicLong currentMillis = new AtomicLong(NOW_MS);
+
+    void advance(long millis) {
+      currentMillis.addAndGet(millis);
+    }
+
+    @Override
+    public ZoneId getZone() {
+      return ZoneOffset.UTC;
+    }
+
+    @Override
+    public Clock withZone(ZoneId zone) {
+      return Clock.fixed(instant(), zone);
+    }
+
+    @Override
+    public Instant instant() {
+      return Instant.ofEpochMilli(currentMillis.get());
+    }
+  }
