+package com.mercadolibre.rio_controlplane_kafka.reale2e.support;
+
+import org.springframework.test.context.ActiveProfilesResolver;
+
+/** Selects local memory only for the explicit local task; the remote suite keeps its original profiles. */
+public final class E2eActiveProfilesResolver implements ActiveProfilesResolver {
+  private static final String MEMORY_PROPERTY = "e2e.memory";
+
+  @Override
+  public String[] resolve(Class<?> testClass) {
+    if (isMemoryRun()) {
+      return new String[] {"local", "real-e2e", "memory-e2e"};
+    }
+    return new String[] {"local", "real-e2e"};
+  }
+
+  /**
+   * Reads the exact task mode; an unexpected value fails instead of changing the suite silently.
+   *
+   * @return whether the explicit local memory task is active
+   */
+  public static boolean isMemoryRun() {
+    String configured = System.getProperty(MEMORY_PROPERTY);
+    if (configured == null || "false".equals(configured)) {
+      return false;
+    }
+    if ("true".equals(configured)) {
+      return true;
+    }
+    throw new IllegalStateException("E2E_MEMORY_MODE_MUST_BE_TRUE_OR_FALSE");
+  }
+}
