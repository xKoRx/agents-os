+  @Test
+  void actualGuardTakesOverStaleClaimThroughCas() throws Exception {
+    final MutableClock clock = new MutableClock();
+    try (var client = new LocalInMemoryKvsClient(RUN_ID, clock)) {
+      final IdempotencyGuard guard = guard(client, clock);
+      assertInstanceOf(ClaimResult.Proceed.class, guard.claim(KEY));
+      clock.advance(STALE_MS + 1);
+      final ClaimResult.Proceed takeover = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(KEY));
+      assertEquals(2, takeover.version());
+      assertFalse(takeover.kvsError());
+      assertTrue(guard.finalizeFailed(KEY, takeover.version(), "TEST_OUTCOME"));
+      assertEquals(ClaimResult.DropReason.TERMINAL,
+          assertInstanceOf(ClaimResult.Drop.class, guard.claim(KEY)).reason());
+    }
+  }
