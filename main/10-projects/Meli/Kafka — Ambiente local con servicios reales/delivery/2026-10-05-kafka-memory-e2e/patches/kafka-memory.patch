+  @Test
+  void actualGuardClaimsReservesFinalizesAndDropsTerminalRedelivery() throws Exception {
+    final MutableClock clock = new MutableClock();
+    try (var client = new LocalInMemoryKvsClient(RUN_ID, clock)) {
+      final IdempotencyGuard guard = guard(client, clock);
+      final ClaimResult.Proceed claim = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(KEY));
+      assertEquals(1, claim.version());
+      assertFalse(claim.kvsError());
+      final ClaimResult.Proceed publication = assertInstanceOf(
+          ClaimResult.Proceed.class, guard.preparePublication(KEY, claim.version()));
+      assertEquals(2, publication.version());
+      assertTrue(guard.finalizeCompleted(KEY, publication.version()));
+      assertEquals(3, client.get(KEY).getVersion());
+      final ClaimResult.Drop duplicate = assertInstanceOf(ClaimResult.Drop.class, guard.claim(KEY));
+      assertEquals(ClaimResult.DropReason.TERMINAL, duplicate.reason());
+    }
+  }
