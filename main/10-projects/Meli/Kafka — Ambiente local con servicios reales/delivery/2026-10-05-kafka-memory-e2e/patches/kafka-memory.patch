+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.fury.toolkit.kvs.KvsClient;
+import com.mercadolibre.rio.sdk.events.actions.ActionTriggerMessage;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentOperation;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentTriggerMessage;
+import com.mercadolibre.rio_controlplane_kafka.Application;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.support.E2eActiveProfilesResolver;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture;
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.test.annotation.DirtiesContext;
+import org.springframework.test.context.ActiveProfiles;
+import tools.jackson.databind.ObjectMapper;
+
+/** Actual Kafka triggers traverse the real HTTP bridge and processors in one owned application context. */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = {"SCOPE_SUFFIX=local", "kafka.bootstrap-servers=${E2E_BOOTSTRAP_SERVERS}",
+        "kafka.provisioning.timeout-minutes=1", "e2e.bridge.enabled=true"})
+@ActiveProfiles(resolver = E2eActiveProfilesResolver.class)
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+class RealKafkaTriggerBridgeIntegrationTest {
+  private static final Duration METADATA_DEADLINE = Duration.ofSeconds(30);
+  private static final Duration DUPLICATE_OBSERVATION = Duration.ofSeconds(1);
+  private static final int RESULT_COUNT = 2;
+  private static final int UPDATED_PARTITIONS = 2;
+  private static final short UPDATED_REPLICATION = 2;
+  @LocalServerPort private int port;
+  @Autowired private ObjectMapper mapper;
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+  @Autowired private KafkaTriggerHttpBridge bridge;
+  private RealE2eFixture fixture;
+
+  @BeforeEach
+  void registerActualBridgeBeforeKafkaDispatch() throws Exception {
+    fixture = new RealE2eFixture(port, mapper, kvs, RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS"));
+    fixture.registerKafkaTriggerDispatchAtPort(port);
+    assertTrue(bridge.isRunning(), "The productive bridge of this actual context must be running");
+  }
+
+  @AfterEach
+  void deleteOnlyScenarioResourcesAfterActualOffsetsAndWorkerIdle() throws Exception {
+    if (fixture != null) {
+      fixture.close();
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"aws-msk-topic", "gcp-kafka-topic"})
+  void kafkaSdkTriggersCompletePhysicalCrudPeekAndSameInstanceRedelivery(String provider) throws Exception {
+    String topic = fixture.uniqueTopic("bridge_journey");
+    var create = fixture.trigger(DeploymentOperation.PROVISION, provider, fixture.paramsFor(provider, topic, 1, (short) 1));
+    publishDeployment(create);
+    assertDimensions(topic, 1, (short) 1);
+
+    var desired = fixture.paramsFor(provider, topic, UPDATED_PARTITIONS, UPDATED_REPLICATION);
+    desired.put("retention_ms", 123_456L);
+    publishDeployment(fixture.trigger(DeploymentOperation.UPDATE, provider, desired));
+    assertDimensions(topic, UPDATED_PARTITIONS, UPDATED_REPLICATION);
+    assertEquals("123456", fixture.topicConfigs(topic).get("retention.ms"));
+
+    fixture.seed(topic, 0, "bridge-key", "actual-bridge-value");
+    assertActualPeekAndRedelivery(provider, topic);
+    publishDeployment(fixture.trigger(DeploymentOperation.DEPROVISION, provider,
+        fixture.paramsFor(provider, topic, UPDATED_PARTITIONS, UPDATED_REPLICATION)));
+    Awaitility.await().atMost(METADATA_DEADLINE).untilAsserted(() -> assertFalse(
+        fixture.admin().listTopics().names().get(10, TimeUnit.SECONDS).contains(topic)));
+  }
+
+  private void publishDeployment(DeploymentTriggerMessage trigger) throws Exception {
+    fixture.publishKafkaTrigger(RealE2eFixture.requiredEnv("E2E_DEPLOYMENT_TRIGGER_TOPIC"),
+        trigger.deploymentId().toString(), trigger);
+    assertEquals("COMPLETED", fixture.awaitDeployment(trigger.deploymentId()).path("status").asString());
+    String prefix = "gcp-kafka-topic".equals(trigger.componentType()) ? "gcp-deployment:" : "deployment:";
+    fixture.awaitKvs(prefix + trigger.deploymentId(), "COMPLETED");
+  }
+
+  private void assertDimensions(String topic, int partitions, short replication) {
+    Awaitility.await().atMost(METADATA_DEADLINE).untilAsserted(() -> {
+      var actual = fixture.awaitTopic(topic);
+      assertEquals(partitions, actual.partitions().size());
+      assertTrue(actual.partitions().stream().allMatch(partition -> partition.replicas().size() == replication));
+    });
+  }
+
+  private void assertActualPeekAndRedelivery(String provider, String topic) throws Exception {
+    var original = fixture.action(Map.of("topic_name", topic, "num_msgs", 1, "offset", "EARLIEST", "timeout_ms", 1000));
+    var trigger = new ActionTriggerMessage(original.actionId(), original.dataProductId(), original.componentId(),
+        original.environmentId(), original.actionName(), provider, original.actionTimeout(), original.data(), null,
+        original.triggeredBy(), original.triggeredAt(), original.componentName(), original.environmentName(), original.dataProductName());
+    String triggerTopic = RealE2eFixture.requiredEnv("E2E_ACTION_TRIGGER_TOPIC");
+    fixture.publishKafkaTrigger(triggerTopic, trigger.actionId(), trigger);
+    var actual = fixture.awaitAction(trigger.actionId());
+    assertEquals("COMPLETED", actual.path("status").asString());
+    assertEquals("bridge-key", actual.path("result").path("messages").get(0).path("key").asString());
+    assertEquals("actual-bridge-value", actual.path("result").path("messages").get(0).path("value").asString());
+    fixture.awaitKvs("action:" + trigger.actionId(), "COMPLETED");
+    assertEquals(RESULT_COUNT, fixture.resultsFor(trigger.actionId()).size());
+    fixture.publishKafkaTrigger(triggerTopic, trigger.actionId(), trigger);
+    fixture.awaitWorkersQuiescent();
+    fixture.assertNoMoreResults(trigger.actionId(), RESULT_COUNT, DUPLICATE_OBSERVATION);
+  }
