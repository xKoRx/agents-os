diff --git a/e2e/tests/sandbox-contract.py b/e2e/tests/sandbox-contract.py
index a8d1abe..53dee52 100644
--- a/e2e/tests/sandbox-contract.py
+++ b/e2e/tests/sandbox-contract.py
@@ -363,5 +363,49 @@ class ScopeControlContract(unittest.TestCase):
             constructor.assert_not_called()
 
 
+class AuthenticationConstructorContract(unittest.TestCase):
+    """SDK import ordering only; no authentication renewal or real-service evidence."""
+
+    def test_expired_auth_fails_before_importing_the_sdk(self):
+        original_import = __import__
+
+        def import_without_sdk(name, *args, **kwargs):
+            if name == 'cli_sandbox.rest.sandboxsapi':
+                raise AssertionError('SDK imported before authentication guard')
+            return original_import(name, *args, **kwargs)
+
+        for code in ('SANDBOX_FURY_LOGIN_REQUIRED', 'SANDBOX_ZERO_TRUST_LOGIN_REQUIRED'):
+            with self.subTest(code=code):
+                with patch.object(sandbox.Lifecycle, 'stored_auth_headers', side_effect=RuntimeError(code)):
+                    with patch('builtins.__import__', side_effect=import_without_sdk):
+                        with self.assertRaisesRegex(RuntimeError, code):
+                            sandbox.Lifecycle(Path('/unused-control-fixture'), {'scope': 'cp'})
+
+    def test_valid_auth_preserves_sdk_construction_after_the_guard(self):
+        observed = []
+        original_import = __import__
+        client = object()
+
+        def guarded_auth(lifecycle):
+            observed.append('authentication-guard')
+            return {}
+
+        def client_factory():
+            observed.append('sdk-construction')
+            return client
+
+        def import_sdk_fixture(name, *args, **kwargs):
+            if name == 'cli_sandbox.rest.sandboxsapi':
+                observed.append('sdk-import')
+                return types.SimpleNamespace(SandboxApi=client_factory)
+            return original_import(name, *args, **kwargs)
+
+        with patch.object(sandbox.Lifecycle, 'stored_auth_headers', guarded_auth):
+            with patch('builtins.__import__', side_effect=import_sdk_fixture):
+                lifecycle = sandbox.Lifecycle(Path('/unused-control-fixture'), {'scope': 'cp'})
+        self.assertEqual(observed, ['authentication-guard', 'sdk-import', 'sdk-construction'])
+        self.assertIs(lifecycle.api, client)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=1)
