+        "{{ index .Config.Labels \"com.docker.compose.project\" }}", container), "").strip());
+    lifecycle.registerCleanupAbsence("pipeline-database-" + UUID.randomUUID(), this::assertOwnedAbsence);
+  }
+
+  /** Immutable exact identities declared by this fixture before SQL; no global row scan creates ownership. */
+  List<Product> ownedProducts() { return List.copyOf(products.values()); }
+
+  Product seedProduct(boolean isPublic) throws Exception {
+    long id = nextId();
+    String name = "e2e_" + UUID.randomUUID().toString().replace("-", "");
+    Product product = new Product(id, name, UUID.randomUUID().toString());
+    assertEquals("0", query("SELECT COUNT(*) FROM data_product WHERE id=? OR name=?", id, name).strip());
+    products.put(id, product);
