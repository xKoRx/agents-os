+      assertEquals("KAFKA_ADMIN_ERROR", failure.path("error").path("code").asString());
+      fixture.awaitKvs(("gcp-kafka-topic".equals(provider) ? "gcp-deployment:" : "deployment:") + failedTrigger.deploymentId(), "FAILED");
