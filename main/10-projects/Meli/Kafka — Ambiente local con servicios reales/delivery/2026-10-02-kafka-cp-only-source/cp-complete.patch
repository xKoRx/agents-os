+  @BeforeEach
+  void connectOnlyOwnedRealServices() throws Exception {
+    playmaker = loopback(OwnedPlaymakerDatabase.required("E2E_PLAYMAKER_BASE_URL"));
+    URI cp = loopback(OwnedPlaymakerDatabase.required("E2E_CP_BASE_URL"));
+    cpKvs = RealE2eKvsClientFactory.create(OwnedPlaymakerDatabase.required("E2E_KVS_CONTAINER_NAME"),
+        System.getenv("E2E_KVS_SEGMENT_ID"), 3_000);
+    actionKvs = RealE2eKvsClientFactory.create(OwnedPlaymakerDatabase.required("E2E_PLAYMAKER_ACTION_RESULTS_CONTAINER"),
+        System.getenv("E2E_PLAYMAKER_KVS_SEGMENT_ID"), 3_000);
+    actionLockKvs = RealE2eKvsClientFactory.create(OwnedPlaymakerDatabase.required("E2E_PLAYMAKER_ACTION_LOCKS_CONTAINER"),
+        System.getenv("E2E_PLAYMAKER_KVS_SEGMENT_ID"), 3_000);
+    fixture = new RealE2eFixture(cp.getPort(), mapper, cpKvs,
+        OwnedPlaymakerDatabase.required("E2E_BOOTSTRAP_SERVERS"));
+    fixture.registerKafkaTriggerDispatchAtPort(cp.getPort());
+    lifecycle = OwnedPlaymakerLifecycle.beginFixture(fixture, PlaymakerMutationReceiptVerifier.fromEnvironment());
+    assertEquals(200, request("GET", "/ping", null, false).statusCode(), "The leased PM generation must be running");
+    database = new OwnedPlaymakerDatabase(lifecycle);
+    lifecycle.registerCleanupAbsence("pm_data_product_action_lock", () -> {
+      if (actionLockKvs.get("dp-action-lock:" + database.dataProductId()) != null) {
+        throw new IllegalStateException("E2E_PLAYMAKER_ACTION_LOCK_NOT_ABSENT");
+      }
+    });
+  }
+
+  @AfterEach
+  void verifyCleanup() throws Throwable {
+    List<Throwable> failures = new ArrayList<>();
+    OwnedPlaymakerLifecycle.CleanupPermit permit = null;
+    if (database != null && fixture != null) {
+      try {
+        Map<String, String> ids = new LinkedHashMap<>();
+        for (String wireId : database.correlationIds()) {
+          UUID id = UUID.fromString(wireId);
+          fixture.registerKey("deployment:" + id);
+          fixture.registerKey("gcp-deployment:" + id);
+          ids.put("deployment_correlation." + id, id.toString());
+        }
+        if (lifecycle != null) { lifecycle.bindObservedResponseIds(ids); }
+      } catch (Throwable failure) { failures.add(failure); }
+    }
+    if (lifecycle != null) {
+      try {
+        if (!failures.isEmpty()) { lifecycle.markUnknown("CORRELATION_INVENTORY_UNVERIFIED"); }
+        if (actionId != null) {
+          UUID.fromString(actionId); // Never adopt null/global action keys.
+          lifecycle.bindObservedResponseIds(Map.of("action_id", actionId));
+          lifecycle.registerCleanupAbsence("pm_action_result", () -> {
+            if (actionKvs.get("actions:" + actionId) != null) {
+              throw new IllegalStateException("E2E_PLAYMAKER_ACTION_NOT_ABSENT");
+            }
+          });
+        }
+        lifecycle.stopAndReap(Duration.ofSeconds(30));
+        lifecycle.verifyStoppedOffsetsAndAbsenceInputs(database);
+        permit = lifecycle.cleanupPermit(); // Actual CP close succeeds before PM/SQL deletion.
+        if (actionId != null) {
+          permit.assertValid();
+          actionKvs.delete("actions:" + actionId);
+        }
+        if (database != null) {
+          permit.assertValid();
+          actionLockKvs.delete("dp-action-lock:" + database.dataProductId());
+          database.cleanupVerified(permit);
+        }
+        lifecycle.verifyCleanupAbsence();
+      } catch (Throwable failure) {
+        failures.add(failure);
+        try { lifecycle.markUnknown("PM_SQL_KVS_CLEANUP_UNVERIFIED"); }
+        catch (Throwable ledgerFailure) { failures.add(ledgerFailure); }
+      }
+    } else if (fixture != null) {
+      try { fixture.retainUnverifiedPlaymakerWork(); }
+      catch (Throwable ledgerFailure) { failures.add(ledgerFailure); }
+    }
+    // Safe closes run even after UNKNOWN. SQL close is expressly nondestructive.
+    for (AutoCloseable resource : new AutoCloseable[] {fixture, database, cpKvs, actionKvs, actionLockKvs}) {
+      if (resource != null) {
+        try { resource.close(); } catch (Throwable failure) { failures.add(failure); }
+      }
+    }
+    if (lifecycle != null) {
+      if (failures.isEmpty() && permit != null) {
+        try { lifecycle.recordClientsClosed(); lifecycle.finishVerifiedCleanup(); }
+        catch (Throwable failure) { failures.add(failure); }
+      } else {
+        try { lifecycle.markUnknown("CLIENT_OR_RESOURCE_CLEANUP_UNVERIFIED"); }
+        catch (Throwable failure) { failures.add(failure); }
+      }
+      try { lifecycle.close(); } catch (Throwable failure) { failures.add(failure); }
+    }
+    if (!failures.isEmpty()) {
+      Throwable first = failures.removeFirst();
+      failures.forEach(first::addSuppressed);
+      throw first;
+    }
+    if (!bodyFailed) {
+      for (Map<String, Object> record : pendingEvidence) {
+        record.put("status", "PASS");
+        record.put("cleanup", "CERTIFIED");
+        Path directory = Path.of(System.getenv().getOrDefault("E2E_EVIDENCE_DIR", "build/e2e-evidence"));
+        Files.createDirectories(directory);
+        Files.writeString(directory.resolve(record.get("scenario") + ".json"), mapper.writeValueAsString(record));
+      }
+    }
+  }
