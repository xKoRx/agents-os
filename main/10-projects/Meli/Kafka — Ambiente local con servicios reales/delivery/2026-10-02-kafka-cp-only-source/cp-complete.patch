+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.fury.toolkit.kvs.Item;
+import com.fury.toolkit.kvs.KvsClient;
+import com.fury.toolkit.kvs.KvsClientException;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.UUID;
+import org.springframework.beans.factory.InitializingBean;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Profile;
+import org.springframework.stereotype.Component;
+
+/** Proves the configured production Toolkit client really writes, reads, and deletes owned KVS data. */
+@Component
+@Profile("real-e2e")
+public class RealE2ePreflight implements InitializingBean {
+  private static final int PROBE_TTL_SECONDS = 60;
+  private final KvsClient kvs;
+  private final String runId;
+  private final String container;
+
+  /** Creates a startup gate for the explicitly named dedicated sandbox. */
+  public RealE2ePreflight(KvsClient kvs, @Value("${e2e.run-id}") String runId,
+      @Value("${kvs.triggers-status.container-name}") String container) {
+    this.kvs = kvs;
+    this.runId = E2eSafety.runId(runId);
+    this.container = container;
+  }
+
+  @Override
+  public void afterPropertiesSet() {
+    RealE2eKvsClientFactory.requireSandboxMapping(container);
+    String key = "e2e:" + runId + ":preflight:" + UUID.randomUUID();
+    byte[] value = UUID.randomUUID().toString().getBytes(StandardCharsets.UTF_8);
+    try {
+      kvs.save(new Item<>(key, value, PROBE_TTL_SECONDS));
+      Item<byte[]> stored = kvs.get(key);
+      if (stored == null || !Arrays.equals(value, stored.getValue())) {
+        throw new IllegalStateException("REAL_E2E_KVS_READBACK_FAILED");
+      }
+    } catch (KvsClientException | RuntimeException exception) {
+      // Never expose endpoints, credentials or SDK exception bodies in startup evidence.
+      throw new IllegalStateException("REAL_E2E_KVS_UNAVAILABLE_OR_READBACK_FAILED");
+    } finally {
+      try {
+        kvs.delete(key);
+      } catch (KvsClientException | RuntimeException exception) {
+        throw new IllegalStateException("REAL_E2E_KVS_PROBE_CLEANUP_FAILED");
+      }
+    }
+  }
+}
diff --git a/src/main/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserver.java b/src/main/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserver.java
new file mode 100644
index 0000000000000000000000000000000000000000..37aad1f7c23f5c8bb0755f31e17e3153bd6b6742
--- /dev/null
+++ b/src/main/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserver.java
@@ -0,0 +1,88 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.mercadolibre.rio_controlplane_kafka.config.ExecutorConfig;
+import com.fasterxml.jackson.annotation.JsonProperty;
+import java.util.List;
+import org.springframework.core.env.Environment;
+import java.util.concurrent.AbstractExecutorService;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.TimeUnit;
+import org.springframework.beans.factory.config.BeanPostProcessor;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Profile;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** Passive local-only observation of the actual async executor; business tasks stay unchanged. */
+@Configuration
+@Profile("real-e2e")
+public class RealE2eWorkerObserver {
+  @Bean static WorkerLedger realE2eWorkerLedger(Environment environment) {
+    return new WorkerLedger(E2eSafety.runId(environment.getRequiredProperty("e2e.run-id")));
+  }
+
+  @Bean static BeanPostProcessor realE2eWorkerTracking(WorkerLedger ledger) {
+    return new BeanPostProcessor() {
+      @Override public Object postProcessAfterInitialization(Object bean, String name) {
+        if (!ExecutorConfig.ASYNC_EXECUTOR.equals(name)) return bean;
+        if (!(bean instanceof ExecutorService executor))
+          throw new IllegalStateException("REAL_E2E_ACTUAL_ASYNC_EXECUTOR_REQUIRED");
+        return new ObservedExecutor(executor, ledger);
+      }
+    };
+  }
+
+  public record Snapshot(@JsonProperty("run_id") String runId, long pid, long submitted, long finished, long rejected, long active, boolean idle) {}
+
+  static final class WorkerLedger {
+    private final String runId;
+    WorkerLedger(String runId) { this.runId = E2eSafety.runId(runId); }
+    private long submitted;
+    private long finished;
+    private long rejected;
+    synchronized void submit() { submitted++; }
+    synchronized void finish() { finished++; }
+    synchronized void reject() { rejected++; }
+    synchronized Snapshot snapshot() {
+      long active = submitted - finished - rejected;
+      if (active < 0) throw new IllegalStateException("REAL_E2E_WORKER_OBSERVATION_INCONSISTENT");
+      return new Snapshot(runId, ProcessHandle.current().pid(), submitted, finished, rejected, active, active == 0);
+    }
+  }
+
+  static final class ObservedExecutor extends AbstractExecutorService {
+    private final ExecutorService delegate;
+    private final WorkerLedger ledger;
+    ObservedExecutor(ExecutorService delegate, WorkerLedger ledger) {
+      this.delegate = delegate;
+      this.ledger = ledger;
+    }
+    @Override public void execute(Runnable task) {
+      java.util.Objects.requireNonNull(task);
+      ledger.submit();
+      try {
+        delegate.execute(() -> { try { task.run(); } finally { ledger.finish(); } });
+      } catch (RuntimeException | Error failure) {
+        ledger.reject();
+        throw failure;
+      }
+    }
+    @Override public void shutdown() { delegate.shutdown(); }
+    @Override public List<Runnable> shutdownNow() { return delegate.shutdownNow(); }
+    @Override public boolean isShutdown() { return delegate.isShutdown(); }
+    @Override public boolean isTerminated() { return delegate.isTerminated(); }
+    @Override public boolean awaitTermination(long timeout, TimeUnit unit) throws InterruptedException {
+      return delegate.awaitTermination(timeout, unit);
+    }
+  }
+
+  @RestController
+  @Profile("real-e2e")
+  public static class Controller {
+    private final WorkerLedger ledger;
+    public Controller(WorkerLedger ledger) { this.ledger = ledger; }
+    @GetMapping("/internal/e2e/workers")
+    public Snapshot workers() { return ledger.snapshot(); }
+  }
+}
