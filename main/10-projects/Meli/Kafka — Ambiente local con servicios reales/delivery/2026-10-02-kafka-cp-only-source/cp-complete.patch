@@ -0,0 +1,128 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import java.io.InputStream;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.security.MessageDigest;
+import java.time.Duration;
+import java.util.Base64;
+import java.util.HexFormat;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/** Combines freshly read provider metadata with authentication through the exact own PM generation. */
+public final class PlaymakerPrimaryEvidenceVerifier implements OwnedEntityServiceFixture.PrimaryDeploymentVerifier {
+  private final JsonMapper mapper = JsonMapper.builder().build();
+  private final HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build();
+  private final Path harness;
+
+  private PlaymakerPrimaryEvidenceVerifier(Path harness) { this.harness = harness; }
+
+  /** Resolves the checked-in verifier from the task's fixed repository; no global mutable callbacks. */
+  public static PlaymakerPrimaryEvidenceVerifier fromEnvironment() {
+    String root = System.getProperty("e2e.harness.root");
+    if (root == null || root.isBlank()) { throw unverified(); }
+    return new PlaymakerPrimaryEvidenceVerifier(Path.of(root));
+  }
+
+  /** Fresh official Fury read must prove actual deployed source, active own nonprod target and release. */
+  @Override
+  public void verify(OwnedEntityServiceFixture.Inputs inputs) throws Exception {
+    String python = required("E2E_FURY_PYTHON");
+    Path executable = Path.of(python);
+    if (!executable.isAbsolute() || !Files.isExecutable(executable)) { throw unverified(); }
+    Path output = Files.createTempFile(inputs.receipt().getParent(), ".entity-primary-read-", ".json",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    Process process = new ProcessBuilder(python, harness.resolve("e2e/verify-primary-service.py").toString(),
+        inputs.receipt().toString()).redirectError(ProcessBuilder.Redirect.DISCARD)
+        .redirectOutput(output.toFile()).start();
+    try {
+      if (!process.waitFor(30, TimeUnit.SECONDS) || process.exitValue() != 0 || Files.size(output) > 65_536) {
+        throw unverified();
+      }
+      JsonNode proof = readPrivate(output);
+      if (!"FRESH_OFFICIAL_DEPLOYMENT_READ".equals(proof.path("proof").asText())
+          || !inputs.runId().equals(proof.path("run_id").asText())) { throw unverified(); }
+    } finally {
+      if (process.isAlive()) {
+        process.destroyForcibly();
+        if (!process.waitFor(10, TimeUnit.SECONDS)) { throw unverified(); }
+      }
+      Files.delete(output);
+    }
+  }
+
+  /** Proves a denied input is genuinely authenticated before inspecting its real ACME permissions. */
+  public VerifiedIdentity verifyDeniedIdentity(Path file,
+      OwnedPlaymakerLifecycle.FixtureIdentity identity) throws Exception {
+    JsonNode binding = readPrivate(file);
+    if (!identity.runId().equals(binding.path("run_id").asText())) { throw unverified(); }
+    String token = binding.path("tiger_token").asText();
+    if (token.startsWith("Bearer ")) { token = token.substring(7); }
+    if (token.isBlank() || token.length() > 16_384 || token.indexOf('\r') >= 0 || token.indexOf('\n') >= 0) {
+      throw unverified();
+    }
+    String tokenHash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+        .digest(token.getBytes(java.nio.charset.StandardCharsets.UTF_8)));
+    if (!tokenHash.equals(binding.path("token_sha256").asText())) { throw unverified(); }
+    ProcessHandle actual = ProcessHandle.of(identity.pmPid()).orElseThrow(
+        PlaymakerPrimaryEvidenceVerifier::unverified);
+    if (!actual.isAlive() || !actual.info().startInstant().orElseThrow(
+        PlaymakerPrimaryEvidenceVerifier::unverified).equals(identity.pmStartInstant())) { throw unverified(); }
+    JsonNode artifact = readPrivate(Path.of(required("E2E_PLAYMAKER_ARTIFACT_RECEIPT_FILE")));
+    if (!identity.jarSha256().equals(artifact.path("jar_sha256").asText())
+        || !identity.sourceManifestSha256().equals(artifact.path("source_manifest_sha256").asText())) {
+      throw unverified();
+    }
+    // Both pinned SecurityConfig snapshots authenticate every unmatched route. It has no business handler.
+    URI probe = URI.create("http://127.0.0.1:" + identity.port() + "/__e2e_auth_probe__/" + UUID.randomUUID());
+    if (request(probe, null) != 401 || request(probe, token) != 404) { throw unverified(); }
+    // Decode only after the productive Tiger2.3 RSA/expiry verifier accepted this exact token.
+    String[] parts = token.split("\\.", -1);
+    if (parts.length != 3) { throw unverified(); }
+    JsonNode claims = mapper.readTree(Base64.getUrlDecoder().decode(parts[1]));
+    String mrn = claims.path("identity").asText();
+    if (!mrn.startsWith("mrn:seginf:ad:user/") || !Objects.equals(mrn, binding.path("caller_mrn").asText())) {
+      throw unverified();
+    }
+    return new VerifiedIdentity(mrn, tokenHash);
+  }
+
+  private int request(URI uri, String token) throws Exception {
+    HttpRequest.Builder request = HttpRequest.newBuilder(uri).timeout(Duration.ofSeconds(10)).GET();
+    if (token != null) { request.header("X-Tiger-Token", "Bearer " + token); }
+    // Bodies may contain identity or diagnostics; neither is retained or logged.
+    return http.send(request.build(), HttpResponse.BodyHandlers.discarding()).statusCode();
+  }
+
+  private JsonNode readPrivate(Path path) throws Exception {
+    if (!path.isAbsolute() || Files.isSymbolicLink(path) || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || Files.size(path) > 1_000_000 || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rw-------"))) { throw unverified(); }
+    try (InputStream input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) {
+      return mapper.readTree(input);
+    }
+  }
+
+  private static String required(String name) {
+    String value = System.getenv(name);
+    if (value == null || value.isBlank()) { throw unverified(); }
+    return value;
+  }
+
+  private static IllegalStateException unverified() {
+    return new IllegalStateException("ENTITY_DEPLOYED_CONTRACT_OR_GRANT_UNVERIFIED");
+  }
+
+  /** Private binding to an accepted signed token; caller identity is not a fabricated SQL permission. */
+  public record VerifiedIdentity(String callerMrn, String tokenSha256) { }
+}
