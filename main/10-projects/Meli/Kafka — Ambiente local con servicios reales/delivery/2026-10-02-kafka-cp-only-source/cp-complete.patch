@@ -0,0 +1,217 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.support;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.extension.BeforeAllCallback;
+import org.junit.jupiter.api.extension.ExtensionContext;
+import org.junit.jupiter.api.extension.TestInstanceFactoryContext;
+import org.junit.jupiter.api.extension.TestInstancePreConstructCallback;
+import tools.jackson.core.StreamReadFeature;
+import tools.jackson.core.json.JsonFactory;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Native worker provenance before fixtures. This never proves a Gradle normal exit or backend outcome. */
+public final class OwnedTestWorkerRegistration implements TestInstancePreConstructCallback, BeforeAllCallback {
+  private static final long UID = new com.sun.security.auth.module.UnixSystem().getUid();
+  private static final Set<String> TASKS = Set.of("realIntegrationTest", "e2eTest",
+      "e2eCanonicalPlaymakerTest", "e2eCandidatePlaymakerTest");
+  private static final ObjectMapper JSON = new ObjectMapper(JsonFactory.builder()
+      .enable(StreamReadFeature.STRICT_DUPLICATE_DETECTION).build());
+  private static final int MAX_BYTES = 16_384;
+  private static Registration registered;
+  private static boolean failed;
+
+  @Override
+  public void preConstructTestInstance(TestInstanceFactoryContext factoryContext, ExtensionContext context)
+      throws Exception {
+    register();
+  }
+
+  @Override
+  public void beforeAll(ExtensionContext context) throws Exception {
+    register();
+  }
+
+  private static synchronized void register() throws Exception {
+    if (failed) { throw invalid("PREVIOUS_REGISTRATION_FAILED"); }
+    try {
+      String run = required(System.getenv("E2E_RUN_ID"), "RUN_REQUIRED");
+      if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) { throw invalid("RUN_INVALID"); }
+      String task = required(System.getProperty("e2e.task"), "TASK_REQUIRED");
+      if (!TASKS.contains(task)) { throw invalid("TASK_NOT_ALLOWLISTED"); }
+      String workerId = required(System.getProperty("org.gradle.test.worker"), "WORKER_ID_REQUIRED");
+      if (workerId.length() > 128 || !workerId.matches("[a-zA-Z0-9_.-]+")) {
+        throw invalid("WORKER_ID_INVALID");
+      }
+      ProcessHandle current = ProcessHandle.current();
+      Instant currentStart = birth(current);
+      ProcessHandle owner = current.parent().orElseThrow(() -> invalid("NATIVE_OWNER_MISSING"));
+      Instant ownerStart = birth(owner);
+      Path root = privateDirectory(Path.of(required(System.getenv("E2E_TEST_WORKER_DIR"), "DIRECTORY_REQUIRED")));
+      Path directory = privateDirectory(root.resolve("task-" + task));
+      Object rootKey = key(root);
+      Object directoryKey = key(directory);
+      Path intentPath = directory.resolve("owner-intent.json");
+      Snapshot intent = readPrivate(intentPath);
+      JsonNode declaration = JSON.readTree(intent.bytes());
+      if (declaration == null || !declaration.isObject()
+          || number(declaration, "schema_version") != 1
+          || !"OWNED_GRADLE_TEST_TASK_INTENT".equals(text(declaration, "kind"))
+          || !run.equals(text(declaration, "run_id")) || !task.equals(text(declaration, "task"))
+          || number(declaration, "owner_pid") != owner.pid()
+          || !ownerStart.equals(Instant.parse(text(declaration, "owner_start_instant")))) {
+        throw invalid("OWNER_INTENT_BINDING_INVALID");
+      }
+      Map<String, Object> fields = new LinkedHashMap<>();
+      fields.put("schema_version", 1);
+      fields.put("kind", "OWNED_JUNIT_TEST_WORKER");
+      fields.put("run_id", run);
+      fields.put("task", task);
+      fields.put("pid", current.pid());
+      fields.put("process_start_instant", currentStart.toString());
+      fields.put("process_owner_pid", owner.pid());
+      fields.put("process_owner_start_instant", ownerStart.toString());
+      fields.put("process_owner_kind", "GRADLE_TEST_WORKER_NORMAL_EXIT");
+      fields.put("gradle_worker_id", workerId);
+      byte[] json = JSON.writeValueAsBytes(fields);
+      byte[] content = Arrays.copyOf(json, json.length + 1);
+      content[json.length] = '\n';
+      Path output = directory.resolve("worker-" + current.pid() + ".json");
+      if (registered != null) {
+        if (!registered.output().equals(output) || !registered.rootKey().equals(rootKey)
+            || !registered.directoryKey().equals(directoryKey)
+            || !registered.intent().identity().equals(intent.identity())
+            || !Arrays.equals(registered.intent().bytes(), intent.bytes())
+            || !Arrays.equals(registered.content(), content)) { throw invalid("REGISTRATION_BINDING_CHANGED"); }
+        Snapshot receipt = readPrivate(output);
+        if (!registered.receiptIdentity().equals(receipt.identity())
+            || !Arrays.equals(content, receipt.bytes())) { throw invalid("REGISTRATION_RECEIPT_CHANGED"); }
+      } else {
+        if (Files.exists(output, LinkOption.NOFOLLOW_LINKS)) {
+          if (!Arrays.equals(content, readPrivate(output).bytes())) { throw invalid("EXISTING_REGISTRATION_CHANGED"); }
+        } else {
+          // A partial or failed durable write cannot authorize fixtures; it is never overwritten.
+          try (FileChannel channel = FileChannel.open(output, Set.of(StandardOpenOption.CREATE_NEW,
+              StandardOpenOption.WRITE, LinkOption.NOFOLLOW_LINKS),
+              PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+            ByteBuffer bytes = ByteBuffer.wrap(content);
+            while (bytes.hasRemaining()) { channel.write(bytes); }
+            channel.force(true);
+          }
+        }
+        forceFile(output);
+        forceDirectory(directory);
+        Snapshot receipt = readPrivate(output);
+        if (!Arrays.equals(content, receipt.bytes())) { throw invalid("REGISTRATION_RECEIPT_CHANGED"); }
+        registered = new Registration(output, rootKey, directoryKey, intent, receipt.identity(), content);
+      }
+      // Recheck native and file/directory bindings after publication, before any constructor returns to JUnit.
+      if (!current.isAlive() || !owner.isAlive() || !currentStart.equals(birth(current))
+          || !ownerStart.equals(birth(owner)) || !rootKey.equals(key(privateDirectory(root)))
+          || !directoryKey.equals(key(privateDirectory(directory)))) { throw invalid("FINAL_NATIVE_OR_DIRECTORY_CHANGED"); }
+      Snapshot finalIntent = readPrivate(intentPath);
+      if (!intent.identity().equals(finalIntent.identity()) || !Arrays.equals(intent.bytes(), finalIntent.bytes())) {
+        throw invalid("OWNER_INTENT_CHANGED_DURING_REGISTRATION");
+      }
+    } catch (Exception | Error failure) {
+      failed = true;
+      if (failure instanceof RegistrationFailure invalid) { throw invalid; }
+      // Do not print arbitrary input JSON, environment values or OS exception messages.
+      throw invalid("IO_OR_NATIVE_OBSERVATION_FAILED");
+    }
+  }
+
+  private static Path privateDirectory(Path path) throws Exception {
+    if (!path.isAbsolute() || !path.normalize().equals(path) || !path.toRealPath().equals(path)
+        || !Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS)
+        || ((Number) Files.getAttribute(path, "unix:uid", LinkOption.NOFOLLOW_LINKS)).longValue() != UID
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rwx------")) || key(path) == null) {
+      throw invalid("PRIVATE_DIRECTORY_INVALID");
+    }
+    return path;
+  }
+
+  private static Fingerprint privateFile(Path path) throws Exception {
+    privateDirectory(path.getParent());
+    if (!path.isAbsolute() || !path.normalize().equals(path) || !path.toRealPath().equals(path)
+        || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || ((Number) Files.getAttribute(path, "unix:uid", LinkOption.NOFOLLOW_LINKS)).longValue() != UID
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rw-------"))) { throw invalid("PRIVATE_FILE_INVALID"); }
+    BasicFileAttributes attributes = Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+    if (attributes.fileKey() == null || attributes.size() > MAX_BYTES) { throw invalid("PRIVATE_FILE_IDENTITY_INVALID"); }
+    return new Fingerprint(attributes.fileKey(), attributes.size(), attributes.lastModifiedTime());
+  }
+
+  private static Snapshot readPrivate(Path path) throws Exception {
+    Fingerprint before = privateFile(path);
+    byte[] bytes;
+    try (var stream = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) { bytes = stream.readNBytes(MAX_BYTES + 1); }
+    if (bytes.length > MAX_BYTES || !before.equals(privateFile(path))) { throw invalid("PRIVATE_FILE_CHANGED"); }
+    return new Snapshot(before, bytes);
+  }
+
+  private static void forceFile(Path path) throws Exception {
+    privateFile(path);
+    try (FileChannel channel = FileChannel.open(path, StandardOpenOption.WRITE, LinkOption.NOFOLLOW_LINKS)) {
+      channel.force(true);
+    }
+  }
+
+  private static void forceDirectory(Path path) throws Exception {
+    privateDirectory(path);
+    try (FileChannel channel = FileChannel.open(path, StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS)) {
+      channel.force(true);
+    }
+  }
+
+  private static Object key(Path path) throws Exception {
+    return Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS).fileKey();
+  }
+
+  private static Instant birth(ProcessHandle process) throws Exception {
+    if (!process.isAlive()) { throw invalid("NATIVE_PROCESS_NOT_LIVE"); }
+    return process.info().startInstant().orElseThrow(() -> invalid("NATIVE_BIRTH_MISSING"));
+  }
+
+  private static String required(String value, String reason) throws Exception {
+    if (value == null || value.isBlank()) { throw invalid(reason); }
+    return value;
+  }
+
+  private static String text(JsonNode node, String field) throws Exception {
+    JsonNode value = node.path(field);
+    if (!value.isTextual() || value.asString().isBlank()) { throw invalid("INTENT_FIELD_INVALID"); }
+    return value.asString();
+  }
+
+  private static long number(JsonNode node, String field) throws Exception {
+    JsonNode value = node.path(field);
+    if (!value.isIntegralNumber() || !value.canConvertToLong()) { throw invalid("INTENT_FIELD_INVALID"); }
+    return value.asLong();
+  }
+
+  private record Fingerprint(Object key, long size, java.nio.file.attribute.FileTime modified) { }
+  private record Snapshot(Fingerprint identity, byte[] bytes) { }
+  private record Registration(Path output, Object rootKey, Object directoryKey, Snapshot intent,
+      Fingerprint receiptIdentity, byte[] content) { }
+  private static RegistrationFailure invalid(String reason) { return new RegistrationFailure(reason); }
+  private static final class RegistrationFailure extends IOException {
+    private RegistrationFailure(String reason) { super("E2E_TEST_WORKER_REGISTRATION_" + reason); }
+  }
+}
