+  public synchronized void beforeDltSend(String source, String dlt, String probeId) throws Exception {
+    requireRunning();
+    requireOwnedTopic(source);
+    requireOwnedTopic(dlt);
+    UUID.fromString(probeId);
+    if (!resultTopics.contains(source) || dltIntents.containsKey(probeId)) { throw failure("DLT_INTENT_INVALID"); }
+    dltIntents.put(probeId, new LinkedHashMap<>(Map.of("source_topic", source, "dlt_topic", dlt, "state", "OPEN")));
+    reason = "BEFORE_NEUTRAL_DLT_SEND";
+    persist();
+  }
