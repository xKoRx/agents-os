+  }
+
+  private void seedDefinition(Component component, Map<String, Object> params) throws Exception {
+    String json = mapper.writeValueAsString(params);
+    if (json.getBytes(StandardCharsets.UTF_8).length > TEXT_LIMIT) {
+      throw new IllegalArgumentException("PIPELINE_PARAMETER_TEXT_LIMIT_EXCEEDED");
+    }
+    long definitionId = nextId();
+    lifecycle.beforeSqlMutation(Map.of("definition." + definitionId, definitionId));
+    query("INSERT INTO component_definition (id,component_id,type,state,status,created_at,updated_at,created_by,"
+        + "parameters,slos) VALUES (?,?,'materialize','active','valid',NOW(),NOW(),'e2e',?,'[]')",
+        definitionId, component.id(), json);
+  }
+
+  void seedUndeployedSlot(Component component, Environment environment) throws Exception {
+    requireProduct(component.product());
+    assertEquals(component.product(), environment.product());
+    beforeMutation(component.product().id());
+    long serviceId = nextId();
+    lifecycle.beforeSqlMutation(Map.of("service." + serviceId, serviceId));
+    query("INSERT INTO service (id,component_id,environment_id,component_definition_id,status,created_at,created_by)"
+        + " VALUES (?,?,?,?,'not started',NOW(),'e2e')", serviceId, component.id(), environment.id(), active(component).id());
+  }
+
+  Definition active(Component component) throws Exception {
+    String row = query("SELECT id,parameters FROM component_definition WHERE component_id=? AND state='active'"
+        + " AND deleted_at IS NULL ORDER BY id DESC LIMIT 1", component.id()).strip();
+    String[] fields = row.split("\t", 2);
