+  /** Deletes all run-owned resources independently and preserves every cleanup failure. */
+  public void cleanup() throws Exception {
+    if ("UNKNOWN".equals(journalPhase)) {
+      quiescenceVerified = false;
+      throw new AssertionError("UNKNOWN work remains retained; fixture cleanup cannot override that journal");
+    }
+    awaitWorkersQuiescent();
+    setJournalState("CLEANING", "VERIFIED_WORKER_CLEANUP");
+    Throwable failure = null;
+    for (String topic : List.copyOf(ownedTopics)) {
+      try {
+        persistJournal();
+        deleteOwnedTopic(topic);
+        ownedTopics.remove(topic);
+        persistJournal();
+      } catch (Exception | AssertionError cleanupFailure) { failure = accumulate(failure, cleanupFailure); }
+    }
+    for (String key : List.copyOf(ownedKeys)) {
+      try {
+        persistJournal();
+        kvs.delete(key);
+        assertTrue(kvs.get(key) == null, "Run-owned KVS key remained after cleanup");
+        ownedKeys.remove(key);
+        persistJournal();
+      } catch (Exception | AssertionError cleanupFailure) { failure = accumulate(failure, cleanupFailure); }
+    }
+    if (failure != null) {
+      try { setJournalState("FAILED", "RESOURCE_CLEANUP_FAILED"); }
+      catch (Exception | AssertionError ledgerFailure) { failure = accumulate(failure, ledgerFailure); }
+    }
+    rethrow(failure);
+  }
+
+  private void deleteOwnedTopic(String topic) throws Exception {
+    try {
+      admin.deleteTopics(List.of(topic)).all().get(30, TimeUnit.SECONDS);
+    } catch (java.util.concurrent.ExecutionException exception) {
+      if (!(exception.getCause() instanceof org.apache.kafka.common.errors.UnknownTopicOrPartitionException)) {
+        throw exception;
+      }
+    }
+    Awaitility.await().atMost(DEADLINE).until(() ->
+        !admin.listTopics().names().get(10, TimeUnit.SECONDS).contains(topic));
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) {
+      return next;
+    }
+    first.addSuppressed(next);
+    return first;
+  }
+
+  private static void rethrow(Throwable failure) throws Exception {
+    if (failure instanceof Error error) {
+      throw error;
+    }
+    if (failure instanceof Exception exception) {
+      throw exception;
+    }
+  }
+
+  private void deleteResultGroup() throws Exception {
+    try {
+      admin.deleteConsumerGroups(List.of(resultGroup)).all().get(30, TimeUnit.SECONDS);
+    } catch (java.util.concurrent.ExecutionException exception) {
+      if (!(exception.getCause() instanceof org.apache.kafka.common.errors.GroupIdNotFoundException)) {
+        throw exception;
+      }
+    }
+    Awaitility.await().atMost(DEADLINE).until(() -> admin.listConsumerGroups().all().get(10, TimeUnit.SECONDS)
+        .stream().noneMatch(group -> resultGroup.equals(group.groupId())));
+    groupAbsent = true;
+    persistJournal();
+  }
+
+  /** Closes every real client independently and preserves cleanup failures. */
+  @Override
+  public void close() throws Exception {
+    if (closed) { return; }
+    Throwable failure = null;
+    try { cleanup(); } catch (Exception | AssertionError cleanupFailure) { failure = cleanupFailure; }
+    boolean clientSuccess = true;
+    try { results.close(Duration.ofSeconds(10)); }
+    catch (Exception | AssertionError closeFailure) { clientSuccess = false; failure = accumulate(failure, closeFailure); }
+    try { producer.close(Duration.ofSeconds(10)); }
+    catch (Exception | AssertionError closeFailure) { clientSuccess = false; failure = accumulate(failure, closeFailure); }
+    // Unknown quiescence preserves the consumer group as well as topics/keys; client close is independent.
+    if (quiescenceVerified && !"UNKNOWN".equals(journalPhase)) {
+      try { persistJournal(); deleteResultGroup(); }
+      catch (Exception | AssertionError groupFailure) { failure = accumulate(failure, groupFailure); }
+    }
+    try { admin.close(Duration.ofSeconds(10)); }
+    catch (Exception | AssertionError closeFailure) { clientSuccess = false; failure = accumulate(failure, closeFailure); }
+    clientsClosed = clientSuccess;
+    closed = true;
+    // Own private routing files are removed only after all business resources and clients are verified clean.
+    if (failure == null && quiescenceVerified && groupAbsent && ownedTopics.isEmpty() && ownedKeys.isEmpty()
+        && cleanupChildPermits.isEmpty()) {
+      for (String file : List.copyOf(ownedPrivateConfigurationFiles)) {
+        try {
+          persistJournal();
+          Files.deleteIfExists(Path.of(file));
+          assertTrue(!Files.exists(Path.of(file), LinkOption.NOFOLLOW_LINKS));
+          ownedPrivateConfigurationFiles.remove(file);
+          persistJournal();
+        } catch (Exception | AssertionError cleanupFailure) { failure = accumulate(failure, cleanupFailure); }
+      }
+    }
+    try {
+      if (failure == null && quiescenceVerified && groupAbsent && ownedTopics.isEmpty() && ownedKeys.isEmpty()
+          && cleanupChildPermits.isEmpty() && ownedPrivateConfigurationFiles.isEmpty()) { retireJournal(); }
+      else {
+        if (!cleanupChildPermits.isEmpty()) {
+          failure = accumulate(failure, new AssertionError("An authorized child journal requires exact reconciliation"));
+        }
+        if ("UNKNOWN".equals(journalPhase)) { persistJournal(); }
+        else if ("FAILED".equals(journalPhase)) { persistJournal(); }
+        else { setJournalState("FAILED", "CLIENT_OR_CHILD_CLEANUP_UNVERIFIED"); }
+      }
+    } catch (Exception | AssertionError ledgerFailure) { failure = accumulate(failure, ledgerFailure); }
+    rethrow(failure);
+  }
+}
