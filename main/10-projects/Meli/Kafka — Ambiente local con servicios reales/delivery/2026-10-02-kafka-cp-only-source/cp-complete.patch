+      fixture.assertNoMoreResults(trigger.deploymentId().toString(), 0, Duration.ofSeconds(1));
+      assertEquals(200, fixture.postDeployment(trigger).statusCode());
+      fixture.assertNoMoreResults(trigger.deploymentId().toString(), 0, Duration.ofSeconds(1));
+      assertEquals("COMPLETED", mapper.readTree(kvs.get(key).getValue()).path("state").asString());
+    }
+  }
+
+  @Test
