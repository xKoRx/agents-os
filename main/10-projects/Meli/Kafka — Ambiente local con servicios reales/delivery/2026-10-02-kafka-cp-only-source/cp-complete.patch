+package com.mercadolibre.rio_controlplane_kafka.cloud.gcp;
+
+import com.mercadolibre.rio_controlplane_kafka.cloud.CloudProvider;
+import com.mercadolibre.rio_controlplane_kafka.cloud.ClusterConnection;
+import com.mercadolibre.rio_controlplane_kafka.cloud.KafkaConnectionFactory;
+import com.mercadolibre.rio_core_java.gcpkafka.auth.GcpKafkaAdminClientConfigBuilder;
+import com.mercadolibre.rio_core_java.gcpkafka.credentials.GcpKafkaCredentialsSource;
+import java.util.Objects;
+import org.springframework.context.annotation.Profile;
+import org.springframework.stereotype.Component;
+
+/** Supplies the existing Rio OAuth client configuration to GCP action admin and consumer clients. */
+@Component
+@Profile("!real-e2e")
+public class GcpKafkaConnectionFactory implements KafkaConnectionFactory {
+  private final GcpKafkaCredentialsSource credentialsSource;
+
+  /** Creates a factory using the established Fury Secrets credential source. */
+  public GcpKafkaConnectionFactory(GcpKafkaCredentialsSource credentialsSource) {
+    this.credentialsSource = Objects.requireNonNull(credentialsSource, "credentialsSource");
+  }
+
+  @Override
+  public CloudProvider provider() {
+    return CloudProvider.GCP_KAFKA;
+  }
+
+  @Override
+  public ClusterConnection connect(String bootstrapServers) {
+    if (bootstrapServers == null || bootstrapServers.isBlank()) {
+      throw new IllegalArgumentException("GCP cluster must define bootstrap servers");
+    }
+    // Credentials remain inside the Rio SDK configuration path and must never be logged.
+    return new ClusterConnection(bootstrapServers, GcpKafkaAdminClientConfigBuilder.build(
+        bootstrapServers, credentialsSource.resolveServiceAccountKeyBytes()));
+  }
+}
