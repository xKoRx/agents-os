+  /**
+   * GCP-ROUTE-MALFORMED-CONFIG startup scope: config is eagerly bound, so there is no trigger result.
+   * This test must not be mapped as a fabricated FAILED INTERNAL business event.
+   */
+  @ParameterizedTest
+  @ValueSource(strings = {"broken", "empty", "null_cloud", "wrong_type"})
+  void malformedGcpFilePreventsActualChildStartupInsteadOfInventingAsyncFailure(String variant) throws Exception {
+    assertFalse(Files.exists(Path.of("/configs/latest")), "Owned file-config variants require a host without shared Fury profile fallback");
+    String document = switch (variant) {
+      case "broken" -> "{\"cloud_provider\":";
+      case "empty" -> "{}";
+      case "null_cloud" -> "{\"cloud_provider\":null}";
+      default -> "{\"cloud_provider\":42}";
+    };
+    Path config = Files.createTempFile("rio-e2e-routing-invalid-", ".json");
+    Path log = Files.createTempFile("rio-e2e-routing-failure-", ".log",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    Process child = null;
+    int childPort;
+    try (ServerSocket reservation = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      childPort = reservation.getLocalPort();
+    }
+    var topicsBefore = fixture.admin().listTopics().names().get(10, TimeUnit.SECONDS);
+    try {
+      Files.writeString(config, document);
+      String jar = System.getProperty("e2e.cp.jar");
+      assertNotNull(jar, "The actual bootJar path is mandatory");
+      assertTrue(Files.isRegularFile(Path.of(jar)));
+      ProcessBuilder builder = new ProcessBuilder(Path.of(System.getProperty("java.home"), "bin", "java").toString(),
+          "-Xmx512m", "-jar", jar, "--spring.profiles.active=real-e2e", "--SCOPE_SUFFIX=local",
+          "--e2e.bridge.enabled=false", "--server.port=" + childPort,
+          "--rio.config.cloud-provider.profile-name=e2e_" + runId() + "_invalid",
+          "--rio.config.cloud-provider.location=" + config.toUri())
+          .redirectErrorStream(true).redirectOutput(log.toFile());
+      child = builder.start();
+      assertTrue(child.waitFor(60, TimeUnit.SECONDS), "Invalid config must fail actual startup within the bounded deadline");
+      assertTrue(child.exitValue() != 0, "Invalid config cannot be counted as a healthy CP process");
+      String actualLogs = Files.readString(log);
+      assertTrue(actualLogs.contains("cloud-provider config unavailable after attempts:"),
+          "An unrelated startup failure cannot certify malformed routing configuration");
+      assertTrue(actualLogs.contains("resource read failed location=" + config.toUri()),
+          "Actual loader must reject this variant's own file, rather than a different config source");
+      assertEquals(topicsBefore, fixture.admin().listTopics().names().get(10, TimeUnit.SECONDS));
+    } finally {
+      if (child != null && child.isAlive()) {
+        child.destroyForcibly();
+        assertTrue(child.waitFor(15, TimeUnit.SECONDS), "Owned invalid-config child must be reaped");
+      }
+      Files.deleteIfExists(config);
+      Files.deleteIfExists(log);
+    }
+  }
