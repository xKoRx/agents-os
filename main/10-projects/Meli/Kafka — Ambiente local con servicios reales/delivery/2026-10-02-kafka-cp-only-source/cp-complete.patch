@@ -0,0 +1,40 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+/** Least-permissive destinations and run-owned Kafka identifiers for the local transport. */
+public final class E2eSafety {
+  private E2eSafety() {}
+
+  /** Validates host-side Kafka seeds; every advertised broker must also remain loopback. */
+  public static String loopbackBootstrap(String bootstrap) {
+    if (bootstrap == null || bootstrap.isBlank()) {
+      throw new IllegalArgumentException("REAL_E2E_BOOTSTRAP_REQUIRED");
+    }
+    for (String seed : bootstrap.split(",", -1)) {
+      if (!seed.matches("127\\.0\\.0\\.1:[1-9][0-9]{0,4}")) {
+        throw new IllegalArgumentException("REAL_E2E_REQUIRES_LOOPBACK_KAFKA");
+      }
+      int port = Integer.parseInt(seed.substring(seed.lastIndexOf(':') + 1));
+      if (port > 65_535) {
+        throw new IllegalArgumentException("REAL_E2E_INVALID_KAFKA_PORT");
+      }
+    }
+    return bootstrap;
+  }
+
+  /** Validates a unique namespace supplied by the owned-resource launcher. */
+  public static String runId(String runId) {
+    if (runId == null || !runId.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+      throw new IllegalArgumentException("REAL_E2E_RUN_ID_REQUIRED");
+    }
+    return runId;
+  }
+
+  /** Requires every transport topic to belong to this run. */
+  public static String topic(String topic, String runId) {
+    if (topic == null || !topic.startsWith("e2e_" + runId(runId) + "_")
+        || !topic.matches("[a-z0-9_-]{1,200}")) {
+      throw new IllegalArgumentException("REAL_E2E_TOPIC_MUST_BELONG_TO_RUN");
+    }
+    return topic;
+  }
+}
