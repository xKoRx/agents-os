@@ -0,0 +1,51 @@
+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.TimeUnit;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Read-only observer through the actual installed Fury CLI ServicesApi implementation. */
+final class ManagedBigQueueObserver {
+  private ManagedBigQueueObserver() {}
+
+  static boolean awaitTransportProbe(String probeId) throws Exception {
+    Path script = Files.createTempFile("rio-managed-bigqueue-observer-", ".py");
+    Path output = Files.createTempFile("rio-managed-bigqueue-observer-", ".json");
+    Path diagnostic = Files.createTempFile("rio-managed-bigqueue-observer-", ".log");
+    try (var resource = ManagedBigQueueObserver.class.getResourceAsStream("/fury_bigqueue_observer.py")) {
+      if (resource == null) {
+        throw new IllegalStateException("MANAGED_OBSERVER_RESOURCE_REQUIRED");
+      }
+      Files.copy(resource, script, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+      for (int attempt = 0; attempt < 20; attempt++) {
+        Process process = new ProcessBuilder(ManagedGateInputs.required("E2E_FURY_PYTHON"),
+            script.toString(), ManagedGateInputs.required("E2E_MANAGED_APPLICATION"),
+            ManagedGateInputs.required("E2E_MANAGED_BIGQUEUE_PROBE_TOPIC"),
+            ManagedGateInputs.required("E2E_MANAGED_BIGQUEUE_PROBE_CONSUMER"), probeId)
+            .redirectOutput(output.toFile()).redirectError(diagnostic.toFile()).start();
+        if (!process.waitFor(15, TimeUnit.SECONDS)) {
+          process.destroyForcibly();
+          if (!process.waitFor(5, TimeUnit.SECONDS)) {
+            throw new IllegalStateException("MANAGED_OBSERVER_PROCESS_CLEANUP_FAILED");
+          }
+          throw new IllegalStateException("MANAGED_REAL_BIGQUEUE_OBSERVER_TIMEOUT");
+        }
+        if (process.exitValue() != 0 || Files.size(output) > 262_144) {
+          throw new IllegalStateException("MANAGED_REAL_BIGQUEUE_OBSERVER_FAILED");
+        }
+        JsonNode observed = new ObjectMapper().readTree(Files.readString(output));
+        if (observed.path("correlated_probe_observed").asBoolean()) {
+          return true;
+        }
+        Thread.sleep(1_000);
+      }
+      return false;
+    } finally {
+      Files.deleteIfExists(script);
+      Files.deleteIfExists(output);
+      Files.deleteIfExists(diagnostic);
+    }
+  }
+}
