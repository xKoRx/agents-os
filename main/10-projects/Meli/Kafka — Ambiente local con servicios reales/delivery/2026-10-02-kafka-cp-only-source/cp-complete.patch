+  @ParameterizedTest
+  @MethodSource("degradedWindows")
+  void actualKvsNetworkWindowsPreserveExplicitDegradedDeliveryAndPhysicalStoreEffects(String domain, String window) throws Exception {
+    Workflow flow = workflow(domain);
+    boolean existing = window.equals("get_after_conflict_down") || window.equals("vanished_after_conflict");
+    byte[] existingBytes = mapper.writeValueAsBytes(TriggerStatusRecord.inProgress(System.currentTimeMillis()));
+    if (existing) {
+      kvs.save(Item.builder(flow.key(), existingBytes).withTtl(120).build());
+    }
+    try (ToolkitSandboxFaults faults = ToolkitSandboxFaults.openResolved();
+         RealControlplaneProcess child = RealControlplaneProcess.start(fixture, faults.childEnvironment())) {
+      RealHttpFaultProxy controlled;
+      if (window.equals("save_down")) {
+        controlled = faults.write();
+        controlled.arm(new Rule("POST", "", flow.id(), Phase.REQUEST, Action.FAIL503, 1000, 60));
+      } else if (window.equals("save_response_lost")) {
+        controlled = faults.write();
+        controlled.arm(new Rule("POST", "", flow.id(), Phase.RESPONSE, Action.RESET, 1000, 60));
+      } else if (window.equals("finalize_down")) {
+        controlled = faults.write();
+        controlled.arm(new Rule("PUT", flow.id(), "COMPLETED", Phase.REQUEST, Action.FAIL503, 1000, 60));
+      } else {
+        controlled = faults.read();
+        boolean vanished = window.startsWith("vanished_");
+        controlled.arm(new Rule("GET", flow.id(), "", Phase.REQUEST, vanished ? Action.HOLD : Action.FAIL503, 1000, 60));
+      }
+      assertEquals(200, child.postJson(flow.path(), flow.json()).statusCode());
+      controlled.awaitReached(WINDOW_DEADLINE);
+      if (window.startsWith("vanished_")) {
+        assertNotNull(kvs.get(flow.key()), "The real server must hold the key before the independent delete");
+        kvs.delete(flow.key());
+        assertNull(kvs.get(flow.key()));
+        controlled.release();
+      }
+      assertPhysicalSuccess(flow);
+      Item<byte[]> actual = kvs.get(flow.key());
+      if (window.equals("save_down") || window.startsWith("vanished_")) {
+        assertNull(actual, "A failed-before-server SAVE or independent delete cannot invent a KVS record");
+      } else {
+        assertNotNull(actual);
+        JsonNode value = mapper.readTree(actual.getValue());
+        assertEquals("IN_PROGRESS", value.path("state").asString());
+        if (window.equals("get_after_conflict_down")) {
+          assertArrayEquals(existingBytes, actual.getValue(), "Degraded processing preserves the actual existing record");
+        }
