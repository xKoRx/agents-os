+  @Test
+  void realAdminClientFailureStillDeletesEveryKvsKeyAndClosesProducer() throws Exception {
+    String bootstrap = RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS");
+    try (AdminClient recovery = AdminClient.create(Map.of("bootstrap.servers", bootstrap))) {
+      RealE2eFixture fixture = new RealE2eFixture(port, mapper, kvs, bootstrap);
+      String topic = fixture.uniqueTopic("cleanup_failure");
+      String prefix = "e2e:" + RealE2eFixture.requiredEnv("E2E_RUN_ID") + ":cleanup:" + UUID.randomUUID();
+      List<String> keys = List.of(prefix + ":one", prefix + ":two");
+      Throwable failure = null;
+      boolean closeInvoked = false;
+      try {
+        fixture.createTopic(topic, 1, (short) 1, Map.of());
+        for (String key : keys) {
+          fixture.registerKey(key);
+          kvs.save(Item.builder(key, new byte[] {1}).withTtl(60).build());
+        }
+        fixture.admin().close(Duration.ZERO);
+        closeInvoked = true;
+        Throwable expectedFailure = assertThrows(Exception.class, fixture::close);
+        assertTrue(expectedFailure.getSuppressed().length >= 1, "Kafka resource and group cleanup failures must both be retained");
+        for (String key : keys) {
+          assertTrue(kvs.get(key) == null, "Kafka cleanup failure must not prevent cleanup of another real KVS key");
+        }
+        fixture.assertProducerClosed(topic);
+      } catch (Exception | AssertionError scenarioFailure) {
+        failure = scenarioFailure;
+      }
+      if (!closeInvoked) {
+        try {
+          fixture.close();
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = accumulate(failure, cleanupFailure);
+        }
+      }
