+            + " WHERE c.data_product_id=? ORDER BY s.id", product.id())
+        + query("SELECT source_component_id,destination_component_id,active FROM component_relations"
+            + " WHERE source_data_product_id=? OR destination_data_product_id=? ORDER BY id", product.id(), product.id());
+  }
+
+  long relationCount(Component source, Component destination) throws Exception {
+    return number("SELECT COUNT(*) FROM component_relations WHERE source_component_id=?"
+        + " AND destination_component_id=? AND active=TRUE AND deleted_at IS NULL", source.id(), destination.id());
+  }
+
+  List<Deployment> deployments(Component component) throws Exception {
+    List<Deployment> deployments = new ArrayList<>();
+    for (String row : query("SELECT d.id,d.status,COALESCE(d.deployment_correlation_id,d.materialization_id,''),"
+        + "d.component_definition_id,s.environment_id,COALESCE(CAST(d._values AS CHAR),'null')"
+        + " FROM deployment d JOIN service s ON s.id=d.service_id WHERE s.component_id=? ORDER BY d.id",
+        component.id()).lines().toList()) {
