+  @ParameterizedTest(name = "{0}/{1}: genuine action failure is persisted and polled")
+  @CsvSource({"aws-msk-topic,invalid_limit", "aws-msk-topic,missing_topic",
+      "gcp-kafka-topic,invalid_limit", "gcp-kafka-topic,missing_topic"})
+  void actualCpActionFailureTraversesResultListenerToRealPlaymakerKvs(String provider, String mode) throws Exception {
+    String topic = fixture.uniqueTopic("playmaker_action_failure");
+    database.seed(provider, mapper.writeValueAsString(fixture.paramsFor(provider, topic, 1, (short) 1)));
+    JsonNode deployment = deploy();
+    assertCorrelatedOutcome(provider, awaitRequestedDeployment(deployment, "deploy_completed"), "COMPLETED");
+    if ("missing_topic".equals(mode)) {
+      fixture.admin().deleteTopics(List.of(topic)).all().get(30, TimeUnit.SECONDS);
+      Awaitility.await().atMost(DEADLINE).until(() -> !fixture.admin().listTopics().names().get().contains(topic));
+    }
+    HttpResponse<String> accepted = request("POST", database.actionPath(),
+        Map.of("timeout", 40, "data", Map.of("topic_name", topic, "num_msgs", "invalid_limit".equals(mode) ? 0 : 1,
+            "offset", "EARLIEST", "timeout_ms", 2_000)), true);
+    assertEquals(202, accepted.statusCode());
+    actionId = mapper.readTree(accepted.body()).path("action_id").asString();
+    assertFalse(actionId.isBlank());
+    fixture.registerKey("action:" + actionId);
+    JsonNode cpResult = fixture.awaitAction(actionId);
+    assertEquals("FAILED", cpResult.path("status").asString());
+    String error = "invalid_limit".equals(mode) ? "INVALID_PARAMS" : "RESOURCE_NOT_FOUND";
+    assertEquals(error, cpResult.path("error").path("code").asString());
+    fixture.awaitKvs("action:" + actionId, "FAILED");
+    Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+      var polled = request("GET", "/v2/actions/" + actionId, null, true);
+      assertEquals(200, polled.statusCode());
+      JsonNode state = mapper.readTree(polled.body());
+      assertEquals("FAILED", state.path("status").asString());
+      assertTrue(state.path("error").asString().contains(error));
+    });
+    JsonNode persisted = mapper.readTree(actionKvs.get("actions:" + actionId).getValue());
+    assertEquals("FAILED", persisted.path("status").asString());
+    assertTrue(persisted.path("error").asString().contains(error));
+    evidence("PM-ACTION-FAIL-" + provider + "-" + mode, Map.of("action_id", actionId, "cp_state", "FAILED",
+        "playmaker_state", "FAILED", "error", error));
+  }
