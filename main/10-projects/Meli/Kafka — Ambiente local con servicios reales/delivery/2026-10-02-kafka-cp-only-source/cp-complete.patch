+#!/usr/bin/env python3
+"""L0 actual private filesystem/JDK/process controls. No PM/KVS/business certificate."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+ROOT = Path(os.environ.get("PM_LIFECYCLE_CONTRACT_ROOT", Path(__file__).resolve().parents[2]))
+JAVA_HOME = Path(os.environ["JAVA_HOME"]) if os.environ.get("JAVA_HOME") else None
+JAVA = str(JAVA_HOME / "bin/java") if JAVA_HOME else shutil.which("java")
+JAVAC = str(JAVA_HOME / "bin/javac") if JAVA_HOME else shutil.which("javac")
+JAR = str(JAVA_HOME / "bin/jar") if JAVA_HOME else shutil.which("jar")
+if not all((JAVA, JAVAC, JAR)):
+    raise SystemExit("PM_LIFECYCLE_CONTROL_JDK_REQUIRED")
+
+NEUTRAL = r"""
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+public final class NeutralOwnedChild {
+  public static void main(String[] args) throws Exception {
+    int port=0;
+    for(String arg:args) if(arg.startsWith("--server.port=")) port=Integer.parseInt(arg.substring(14));
+    try(ServerSocket server=new ServerSocket()) {
+      server.setReuseAddress(true); server.bind(new InetSocketAddress(InetAddress.getByName("127.0.0.1"),port),1);
+      while(true) try(Socket socket=server.accept()) {
+        byte[] request=new byte[4096]; int n=socket.getInputStream().read(request);
+        if(n>0 && new String(request,0,n,StandardCharsets.US_ASCII).startsWith("POST /unsafe")) System.exit(79);
+        socket.getOutputStream().write("HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\npong".getBytes(StandardCharsets.US_ASCII));
+      }
+    }
+  }
+}
+"""
+
+
+def wait_until(condition, message, seconds=20):
+    end = time.monotonic() + seconds
+    while time.monotonic() < end:
+        if condition():
+            return
+        time.sleep(.05)
+    raise AssertionError(message)
+
+
+def alive(pid):
+    try:
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+
+
+def closed(port):
+    with socket.socket() as probe:
+        probe.settimeout(.25)
+        try:
+            probe.connect(("127.0.0.1", port))
+            return False
+        except ConnectionRefusedError:
+            return True
+
+
+
+def framed(control, token, *fields):
+    data = "\t".join((token, *map(str, fields))).encode()
+    with socket.socket(socket.AF_UNIX) as connection:
+        connection.settimeout(145 if fields[0] == "START" else 45)
+        connection.connect(str(control / "owner.sock"))
+        connection.sendall(struct.pack(">i", len(data)) + data)
+        def read(length):
+            result = b""
+            while len(result) < length:
+                chunk = connection.recv(length - len(result))
+                if not chunk:
+                    raise AssertionError("CONTROL_CLOSED")
+                result += chunk
+            return result
+        length = struct.unpack(">i", read(4))[0]
+        assert 0 < length <= 8192
+        return read(length).decode().split("\t")
+
+
+with tempfile.TemporaryDirectory(prefix="rio-pm-l0-", dir="/private/tmp") as directory:
+    workspace = Path(directory)
+    classes = workspace / "classes"
+    classes.mkdir(mode=0o700)
+    subprocess.run([JAVAC, "-d", str(classes), str(ROOT / "e2e/PlaymakerProcessOwner.java")],
+                   check=True, capture_output=True, timeout=30)
+    neutral = workspace / "NeutralOwnedChild.java"
+    neutral.write_text(NEUTRAL)
+    subprocess.run([JAVAC, "-d", str(classes), str(neutral)], check=True, capture_output=True, timeout=30)
+    jar = workspace / "neutral.jar"
+    subprocess.run([JAR, "--create", "--file", str(jar), "--main-class", "NeutralOwnedChild",
+                    "-C", str(classes), "NeutralOwnedChild.class"], check=True, capture_output=True, timeout=30)
+
+    def identity(pid):
+        result = subprocess.run([JAVA, "-cp", str(classes), "PlaymakerProcessOwner", "identity", str(pid)],
+                                check=True, capture_output=True, text=True, timeout=10)
+        return result.stdout.strip().split("\t")
+
+    def control_case(case):
+        home = workspace / case
+        home.mkdir(mode=0o700)
+        control = home / "control"
+        control.mkdir(mode=0o700)
+        reconciliation = home / "reconciliation"
+        reconciliation.mkdir(mode=0o700)
+        exits = home / "process-exit-records"
+        exits.mkdir(mode=0o700)
+        artifact = control / "application.jar"
+        shutil.copyfile(jar, artifact)
+        artifact.chmod(0o600)
+        with socket.socket() as free:
+            free.bind(("127.0.0.1", 0))
+            port = free.getsockname()[1]
+        run = "owner_control_" + uuid.uuid4().hex if case == "underscore-run" else uuid.uuid4().hex
+        token = str(uuid.uuid4())
+        parent_pid, parent_start = identity(os.getpid())
+        props = {"process_exit_directory": str(exits), "run_id": run, "reconciliation_directory": str(reconciliation),
+                 "control_token": token, "jar_path": str(artifact),
+                 "jar_sha256": hashlib.sha256(artifact.read_bytes()).hexdigest(),
+                 "source_commit": "0" * 40, "source_manifest_sha256": "1" * 64,
+                 "parent_pid": parent_pid, "parent_start": parent_start, "port": str(port),
+                 "consumer_group": "e2e_" + run + "_playmaker_results",
+                 "child_mode": "PRODUCTIVE_PM" if case == "missing-verifier" else "NEUTRAL_PROCESS_CONTROL",
+                 "socket_path": str(control / "owner.sock")}
+        config = control / "owner.properties"
+        config.write_text("".join(key + "=" + value.replace("\\", "\\\\").replace(":", "\\:") + "\n"
+                                  for key, value in props.items()))
+        config.chmod(0o600)
+        log = home / "guardian.log"
+        owner = None
+        worker = None
+        pids = []
+        count = 0
+        fixture = str(uuid.uuid4())
+        marker = reconciliation / ("pm-fixture-" + fixture + ".json")
+        marker.write_text(json.dumps({"kind": "L0_CONTROL_INTENT", "run_id": run}) + "\n")
+        marker.chmod(0o600)
+        try:
+            launch_control = control
+            if case == "public-directory": control.chmod(0o755)
+            if case == "symlink-directory":
+                launch_control = home / "control-alias"
+                launch_control.symlink_to(control, target_is_directory=True)
+            with log.open("wb") as output:
+                owner = subprocess.Popen([JAVA, "-cp", str(classes), "PlaymakerProcessOwner", "serve", str(launch_control)],
+                                         stdout=output, stderr=subprocess.STDOUT)
+            if case in ("missing-verifier", "public-directory", "symlink-directory"):
+                assert owner.wait(timeout=10) != 0
+                assert closed(port) and not list(reconciliation.glob("pm-lease-*.json"))
+                return 2
+            wait_until(lambda: (control / "guardian.identity").exists() or owner.poll() is not None, "OWNER_NOT_READY")
+            assert owner.poll() is None, log.read_text()
+            count += 1
+            if case == "changed-jar":
+                with artifact.open("ab") as stream:
+                    stream.write(b"changed")
+            if case == "worker-death":
+                worker = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(90)"])
+                wp, ws = identity(worker.pid)
+            else:
+                wp, ws = parent_pid, parent_start
+            if case == "wrong-birth":
+                ws = "1970-01-01T00:00:00Z"
+            response = framed(control, token, "START", fixture, wp, ws)
+            if case in ("changed-jar", "wrong-birth"):
+                assert response[0] == "ERROR"
+                assert closed(port)
+                assert any(json.loads(path.read_text())["phase"] == "UNKNOWN"
+                           for path in reconciliation.glob("pm-owner-*.json"))
+                framed(control, token, "SHUTDOWN")
+                assert owner.wait(timeout=15) != 0
+                return count + 4
+            assert response[:2] == ["OK", "READY"]
+            generation, pid, birth, lease_path = response[2:]
+            pids.append(int(pid))
+            lease = Path(lease_path)
+            record = json.loads(lease.read_text())
+            assert record["pm_pid"] == int(pid) and record["pm_start"] == birth
+            assert record["generation"] == generation and record["fixture_id"] == fixture
+            assert record["phase"] == "READY" and record["child_mode"] == "NEUTRAL_PROCESS_CONTROL"
+            assert record["consumer_group"] == props["consumer_group"]
+            assert lease.stat().st_mode & 0o777 == 0o600
+            assert (reconciliation.stat().st_mode & 0o777) == 0o700
+            count += 7
+            if case == "worker-death":
+                worker.kill()
+                worker.wait(timeout=5)
+                wait_until(lambda: not alive(int(pid)) and closed(port) and json.loads(lease.read_text())["phase"] == "STOPPED", "DEAD_WORKER_PM_NOT_REAPED")
+                record = json.loads(lease.read_text())
+                assert record["unknown"] and record["phase"] == "STOPPED"
+                assert marker.exists()
+                framed(control, token, "SHUTDOWN")
+                assert owner.wait(timeout=15) != 0
+                return count + 4
+            if case == "unsafe-exit":
+                with socket.create_connection(("127.0.0.1", port), timeout=3) as client:
+                    client.sendall(b"POST /unsafe HTTP/1.1\r\nHost: localhost\r\n\r\n")
+                wait_until(lambda: not alive(int(pid)) and json.loads(lease.read_text())["phase"] == "STOPPED",
+                           "UNSAFE_EXIT_NOT_REAPED")
+                record = json.loads(lease.read_text())
+                assert record["exit_status"] == 79 and record["unknown"]
+                framed(control, token, "SHUTDOWN")
+                assert owner.wait(timeout=15) != 0
+                return count + 3
+            if case == "stale-generation":
+                assert framed(control, token, "STOP", fixture, str(uuid.uuid4()))[0] == "ERROR"
+                assert alive(int(pid))
+                framed(control, token, "SHUTDOWN")
+                assert owner.wait(timeout=15) != 0
+                assert not alive(int(pid)) and closed(port) and marker.exists()
+                return count + 5
+            if case == "journal-write-failure":
+                reconciliation.chmod(0o500)
+                try:
+                    framed(control, token, "STOP", fixture, generation)
+                except (OSError, AssertionError):
+                    pass
+                wait_until(lambda: not alive(int(pid)) and closed(port), "JOURNAL_FAILURE_SKIPPED_PM_REAP")
+                owner.wait(timeout=15)
+                assert lease.exists() and marker.exists()
+                return count + 4
+            if case in ("parent-trap", "guardian-unresponsive"):
+                if case == "guardian-unresponsive": os.kill(owner.pid, signal.SIGSTOP)
+                env = os.environ.copy()
+                env.update({"E2E_PLAYMAKER_CONTROL_DIR": str(control),
