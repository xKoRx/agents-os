+        + query("SELECT d.id,d.component_id,d.state,d.parameters FROM component_definition d JOIN component c"
+            + " ON c.id=d.component_id WHERE c.data_product_id=? ORDER BY d.id", product.id())
+        + query("SELECT s.id,s.component_id,s.environment_id,s.component_definition_id,s.status,"
