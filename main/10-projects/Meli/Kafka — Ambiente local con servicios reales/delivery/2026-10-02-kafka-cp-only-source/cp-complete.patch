+  @Override
+  public void close() throws Exception {
+    if (closed) { return; }
+    closed = true;
+    Throwable failure = null;
+    try {
+      // Transfer sticky Entity uncertainty before any permit, including CP's destructive close.
+      if (entityService != null) { entityService.assertKnownOutcomes(); }
+      List<OwnedPipelineDatabase.Product> ownedProducts = bindOwnedLockInventory();
+      Map<String, String> ids = new LinkedHashMap<>();
+      for (String id : database.allCorrelations()) {
+        UUID.fromString(id);
+        cp.registerKey("deployment:" + id);
+        cp.registerKey("gcp-deployment:" + id);
+        ids.put("deployment_correlation." + id, id);
+      }
+      lifecycle.bindObservedResponseIds(ids);
+      lifecycle.registerCleanupAbsence("pipeline-actions", this::assertActionAbsence);
+      lifecycle.registerCleanupAbsence("pipeline-action-locks", () -> assertLockAbsence(ownedProducts));
+      if (entityService != null) {
+        lifecycle.registerCleanupAbsence("pipeline-entity-retained-contract", entityService::assertRetainedContract);
+      }
+      lifecycle.stopAndReap(DEADLINE);
+      cp.awaitWorkersQuiescent();
+      wire.auditAll(database.allCorrelations(), actionIds);
+      cp.drain(Duration.ofSeconds(2));
+      for (String id : database.allCorrelations()) {
+        assertEquals(1, cp.resultsFor(id).size(), "Each real deployment has exactly one result after barriers");
+      }
+      for (String id : actionIds) {
+        assertEquals(1, cp.resultsFor(id).size(), "Each real action has exactly one result after barriers");
+      }
+      assertEquals(ownedProducts, database.ownedProducts(), "Owned DP inventory cannot grow after the stop barrier");
+      database.assertNoExternalWorkflowReferences();
+      lifecycle.verifyStoppedOffsetsAndAbsenceInputs(database);
+      if (entityService != null) { entityService.assertKnownOutcomes(); }
+      // T25 closes the actual CP fixture and verifies it before issuing this destructive permit.
+      var permit = lifecycle.cleanupPermit();
+      if (entityService != null) { entityService.cleanupVerified(permit); }
+      for (String id : actionIds) {
+        permit.assertValid();
+        actionKvs.delete("actions:" + id);
+      }
+      for (var product : ownedProducts) {
+        permit.assertValid();
+        actionLocks.delete("dp-action-lock:" + product.id());
+      }
+      database.cleanupVerified(permit);
+      lifecycle.verifyCleanupAbsence();
+      // Archive retained Entity history only after every global absence/retained-contract check passed.
+      if (entityService != null) { entityService.retireVerifiedEvidence(permit); }
+    } catch (Exception | Error error) {
+      failure = error;
+      try { lifecycle.markUnknown("PIPELINE_FIXTURE_CLEANUP_NOT_CERTIFIED"); }
+      catch (Exception | Error ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+    }
+    // Each non-destructive close and the process guardian run independently under retained UNKNOWN.
+    for (AutoCloseable client : new AutoCloseable[] {wire, cp, database, cpKvs, actionKvs, actionLocks, http, entityService}) {
+      if (client == null) { continue; }
+      try { client.close(); }
+      catch (Exception | Error closeFailure) {
+        failure = accumulate(failure, closeFailure);
+        try { lifecycle.markUnknown("PIPELINE_OBSERVER_OR_RESOURCE_CLOSE_FAILED"); }
+        catch (Exception | Error ledgerFailure) { failure = accumulate(failure, ledgerFailure); }
+      }
+    }
+    if (failure == null) {
+      try { lifecycle.recordClientsClosed(); lifecycle.finishVerifiedCleanup(); }
+      catch (Exception | Error retirementFailure) {
+        failure = retirementFailure;
+        try { lifecycle.markUnknown("PIPELINE_FINAL_RETIREMENT_UNVERIFIED"); }
+        catch (Exception | Error ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      }
+    }
+    try { lifecycle.close(); }
+    catch (Exception | Error closeFailure) { failure = accumulate(failure, closeFailure); }
+    if (failure instanceof Error error) { throw error; }
+    if (failure instanceof Exception exception) { throw exception; }
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    if (first != next) { first.addSuppressed(next); }
+    return first;
+  }
