+    if any(recorded.get(k) != v for k, v in current.items()) or recorded.get("jar_path") != str(jar) \
+            or jar.is_symlink() or not jar.is_file() or recorded.get("jar_sha256") != sha(jar):
+        fail("SOURCE_OR_JAR_RECEIPT_DRIFT")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
+        code = str(error) if isinstance(error, RuntimeError) else "PLAYMAKER_ARTIFACT_GATE:UNVERIFIED"
+        print(code, file=__import__("sys").stderr)
+        raise SystemExit(2)
