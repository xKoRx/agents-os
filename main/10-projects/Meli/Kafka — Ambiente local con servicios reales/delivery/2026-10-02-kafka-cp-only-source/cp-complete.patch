+  public void stopAndReap(Duration deadline) throws Exception {
+    if (deadline.isNegative() || deadline.isZero()) { throw failure("INVALID_STOP_DEADLINE"); }
+    try {
+      if (identity == null) { throw failure("PROCESS_GENERATION_UNREGISTERED"); }
+      for (Map<String, Object> request : httpIntents.values()) {
+        if ("OPEN".equals(request.get("state"))) { throw failure("HTTP_REQUEST_UNSETTLED"); }
+      }
+      for (Map<String, Object> request : dltIntents.values()) {
+        if ("OPEN".equals(request.get("state"))) { throw failure("DLT_SEND_UNSETTLED"); }
+      }
+      phase = unknown ? "UNKNOWN" : "STOPPING";
+      persist();
+      String[] response = control("STOP", fixtureId.toString(), identity.generation().toString());
+      if (response.length != 6 || !"STOPPED".equals(response[1]) || Boolean.parseBoolean(response[3])
+          || Boolean.parseBoolean(response[4]) || !("0".equals(response[5]) || "143".equals(response[5]))) { throw failure("PM_STOP_UNVERIFIED_OR_FORCED"); }
+      stoppedExitStatus = Integer.parseInt(response[5]);
+      assertProcessAbsent();
+      verifyLease(false);
+      stopped = true;
+      if (!unknown) { phase = "STOPPED"; reason = "PM_REAPED_BEFORE_CP_BARRIER"; }
+      persist();
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("PM_STOP_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      // An unsettled request must not skip the independent own-process stop.
+      if (identity != null) {
+        try { control("STOP", fixtureId.toString(), identity.generation().toString()); }
+        catch (Exception stopFailure) { failure.addSuppressed(stopFailure); }
+      }
+      throw failure;
+    }
+  }
