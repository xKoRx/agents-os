+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.mercadolibre.rio_core_java.gcpkafka.client.GcpKafkaAdminClientFactory;
+import com.mercadolibre.rio_core_java.gcpkafka.spring.GcpKafkaAuthAutoConfiguration;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.admin.AdminClient;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.SpringBootConfiguration;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.context.ContextConfiguration;
+import org.springframework.context.ApplicationContextInitializer;
+import org.springframework.context.ConfigurableApplicationContext;
+
+/** Read-only managed OAuth gate using the deployed SDK and official Fury Secrets source. */
+@SpringBootTest(classes = ManagedGcpOAuthIntegrationTest.OAuthConfiguration.class,
+    webEnvironment = SpringBootTest.WebEnvironment.NONE,
+    properties = {
+      "rio.gcp.kafka.credentials.secret-name=${E2E_MANAGED_GCP_SECRET_NAME}",
+      "rio.gcp.kafka.fury-secrets.segment-id=${E2E_MANAGED_GCP_SECRET_SEGMENT}",
+      "rio.gcp.kafka.connectivity.bootstrap-servers=${E2E_MANAGED_GCP_BOOTSTRAP_SERVERS}",
+      "rio.gcp.kafka.connectivity.probe-on-startup=true",
+      "rio.gcp.kafka.connectivity.fail-fast-on-probe-failure=true",
+      "rio.gcp.kafka.connectivity.probe-timeout=15s"
+    })
+@ActiveProfiles("managed-integration")
+@ContextConfiguration(initializers = ManagedGcpOAuthIntegrationTest.ScopeInitializer.class)
+class ManagedGcpOAuthIntegrationTest {
+  @Autowired private GcpKafkaAdminClientFactory factory;
+
+  @Test
+  void authenticatesWithActualOAuthAndReadsManagedClusterMetadata() throws Exception {
+    String bootstrap = ManagedGateInputs.required("E2E_MANAGED_GCP_BOOTSTRAP_SERVERS");
+    ManagedGateInputs.requireNonprodScope();
+    AdminClient admin = factory.getClient(bootstrap);
+    try {
+      var cluster = admin.describeCluster();
+      assertThat(cluster.clusterId().get(20, TimeUnit.SECONDS)).isNotBlank();
+      assertThat(cluster.nodes().get(20, TimeUnit.SECONDS)).isNotEmpty();
+      assertThat(cluster.controller().get(20, TimeUnit.SECONDS)).isNotNull();
+    } catch (Exception exception) {
+      // Provider diagnostics can include credential/endpoint details; publish only this stable code.
+      throw new IllegalStateException("MANAGED_GCP_OAUTH_OR_METADATA_FAILED");
+    }
+  }
+
+  public static final class ScopeInitializer implements ApplicationContextInitializer<ConfigurableApplicationContext> {
+    @Override
+    public void initialize(ConfigurableApplicationContext context) {
+      ManagedGateInputs.requireNonprodScope();
+    }
