+  private static final int MAX_MESSAGE = 8192;
+  private static final String VERIFIER_ENTRY =
+      "BOOT-INF/classes/com/mercadolibre/rio/playmaker/localintegration/RealE2eOwnedProcessLeaseVerifier.class";
+  private final Path directory;
+  private final Path reconciliation;
+  private final Path socketPath;
+  private final Properties config;
+  private final String run;
+  private final String token;
+  private final Path jar;
+  private final String jarHash;
+  private final ProcessHandle parent;
+  private final Instant parentStart;
+  private final UUID ownerId = UUID.randomUUID();
+  private final Path ownerJournal;
+  private volatile boolean shutdown;
+  private volatile boolean unknown;
+  private Generation current;
+  private ServerSocketChannel server;
+
+  private PlaymakerProcessOwner(Path path) throws Exception {
+    directory = privateDirectory(path);
+    config = loadConfiguration(directory);
+    reconciliation = privateDirectory(Path.of(required(config, "reconciliation_directory")));
+    socketPath = Path.of(required(config, "socket_path"));
+    privateDirectory(socketPath.getParent());
+    if (!"owner.sock".equals(socketPath.getFileName().toString()) || socketPath.toString().length() > 100) {
+      throw failure("PRIVATE_SHORT_SOCKET_PATH_REQUIRED");
+    }
+    run = required(config, "run_id");
+    if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) { throw failure("INVALID_RUN"); }
+    token = required(config, "control_token");
+    UUID.fromString(token);
+    jar = privateFile(Path.of(required(config, "jar_path"))).toRealPath();
+    if (!jar.startsWith(directory)) { throw failure("JAR_OUTSIDE_PRIVATE_CONTROL_DIRECTORY"); }
+    jarHash = required(config, "jar_sha256");
+    verifyJar();
+    parent = ProcessHandle.of(Long.parseLong(required(config, "parent_pid")))
+        .orElseThrow(() -> failure("PARENT_ABSENT"));
+    parentStart = Instant.parse(required(config, "parent_start"));
+    verifyIdentity(parent, parentStart);
+    int port = Integer.parseInt(required(config, "port"));
+    if (port < 1024 || port > 65535) { throw failure("INVALID_PORT"); }
+    if (!required(config, "consumer_group").equals("e2e_" + run + "_playmaker_results")) {
+      throw failure("GROUP_NOT_EXACT_RUN_RESULTS");
+    }
+    if (!required(config, "source_commit").matches("[a-f0-9]{40}")
+        || !required(config, "source_manifest_sha256").matches("[a-f0-9]{64}")) {
+      throw failure("INVALID_SOURCE_IDENTITY");
+    }
+    ownerJournal = reconciliation.resolve("pm-owner-" + ownerId + ".json");
+    persistOwner("OPEN", "OWNER_REGISTERED");
+  }
+
+  /** Commands contain only fixed control fields, never environment or arbitrary executable arguments. */
+  public static void main(String[] arguments) {
+    try {
+      if (arguments.length < 2) { throw failure("INVALID_COMMAND"); }
+      String operation = arguments[0];
+      Path directory = Path.of(arguments[1]).toAbsolutePath();
+      if ("identity".equals(operation) && arguments.length == 2) {
+        ProcessHandle process = ProcessHandle.of(Long.parseLong(arguments[1]))
+            .orElseThrow(() -> failure("IDENTITY_PID_ABSENT"));
+        System.out.println(process.pid() + "\t" + start(process));
+      } else if ("stop-owner".equals(operation) && arguments.length == 2) {
+        stopOwner(directory);
+      } else if ("recover".equals(operation) && arguments.length == 2) {
+        recover(directory);
+        System.exit(1); // Recovery never retires unknown journals or certifies business cleanup.
+      } else if ("serve".equals(operation) && arguments.length == 2) {
+        new PlaymakerProcessOwner(directory).serve();
+      } else if ("request".equals(operation) && arguments.length >= 3) {
+        List<String> fields = new ArrayList<>();
+        Properties config = loadConfiguration(privateDirectory(directory));
+        fields.add(required(config, "control_token"));
+        fields.addAll(List.of(arguments).subList(2, arguments.length));
+        String response = exchange(directory, fields, Duration.ofSeconds("START".equals(arguments[2]) ? 140 : 45));
+        System.out.println(response);
+        if (!response.startsWith("OK\t")) { System.exit(1); }
+      } else {
+        throw failure("INVALID_COMMAND");
+      }
+    } catch (Exception failure) {
+      // Stable diagnostics only; exception messages from HTTP/filesystem can contain private data.
+      System.err.println("PM_OWNER_FAILED");
+      System.exit(1);
+    }
+  }
+
+  private void serve() throws Exception {
+    Path socket = socketPath;
+    if (Files.exists(socket, LinkOption.NOFOLLOW_LINKS)) { throw failure("SOCKET_ALREADY_EXISTS"); }
+    server = ServerSocketChannel.open(StandardProtocolFamily.UNIX);
+    server.bind(UnixDomainSocketAddress.of(socket));
+    Files.setPosixFilePermissions(socket, PosixFilePermissions.fromString("rw-------"));
+    server.configureBlocking(false);
+    writePrivate(directory.resolve("guardian.identity"),
+        ProcessHandle.current().pid() + "\t" + start(ProcessHandle.current()) + "\n");
+    long nextCheck = System.nanoTime();
+    try {
+      while (!shutdown) {
+        SocketChannel connection = server.accept();
+        if (connection != null) {
+          try (connection) {
+            String request = readFrame(connection, Duration.ofSeconds(5));
+            String result;
+            try { result = command(request.split("\t", -1)); }
+            catch (Exception error) {
+              retainUnknown("CONTROL_OPERATION_FAILED");
+              result = "ERROR\tCONTROL_OPERATION_FAILED";
+            }
+            writeFrame(connection, result, Duration.ofSeconds(5));
+          } catch (Exception error) { retainUnknown("CONTROL_CHANNEL_FAILED"); }
+        } else {
+          TimeUnit.MILLISECONDS.sleep(20);
+        }
+        if (System.nanoTime() >= nextCheck) {
+          watchOwners();
+          nextCheck = System.nanoTime() + Duration.ofMillis(200).toNanos();
+        }
+      }
+    } finally {
+      Throwable pending = null;
+      try { stopCurrent(Duration.ofSeconds(30), false); }
+      catch (Exception error) { pending = error; retainUnknown("FINAL_REAP_FAILED"); }
+      try { server.close(); } catch (Exception error) { pending = error; }
+      try { Files.deleteIfExists(socket); forceDirectory(socketPath.getParent()); }
+      catch (Exception error) { pending = error; }
+      if (!unknown && pending == null && current == null && noFixtureJournals()) {
+        Files.deleteIfExists(ownerJournal);
+        forceDirectory(reconciliation);
+      } else { persistOwner("UNKNOWN", "OWNER_SHUTDOWN_UNVERIFIED"); }
+      if (pending != null || unknown) { throw failure("OWNER_SHUTDOWN_UNVERIFIED"); }
+    }
+  }
+
+  private synchronized String command(String[] fields) throws Exception {
+    if (fields.length < 2 || !MessageDigest.isEqual(token.getBytes(java.nio.charset.StandardCharsets.UTF_8),
+        fields[0].getBytes(java.nio.charset.StandardCharsets.UTF_8))) { throw failure("CONTROL_AUTHORITY_INVALID"); }
+    String op = fields[1];
+    if ("STATUS".equals(op) && fields.length == 2) {
+      return current == null ? "OK\tABSENT\t" + unknown
+          : "OK\t" + current.phase + "\t" + current.id + "\t" + (current.process == null ? 0 : current.process.pid()) + "\t"
+              + current.birth + "\t" + current.lease + "\t" + unknown;
+    }
+    if ("START".equals(op) && fields.length == 5) {
+      if (unknown || current != null || !noOtherFixtureJournals(fields[2])) {
+        throw failure("RESTART_BLOCKED_RETAINED_WORK");
+      }
+      UUID fixture = UUID.fromString(fields[2]);
+      ProcessHandle worker = ProcessHandle.of(Long.parseLong(fields[3]))
+          .orElseThrow(() -> failure("WORKER_ABSENT"));
+      Instant workerStart = Instant.parse(fields[4]);
+      verifyIdentity(worker, workerStart);
+      return launch(fixture, worker, workerStart);
+    }
+    if ("STOP".equals(op) && fields.length == 4) {
+      requireCurrent(fields[2], fields[3]);
+      stopCurrent(Duration.ofSeconds(30), true);
+      return "OK\tSTOPPED\t" + current.id + "\t" + current.forced + "\t" + unknown + "\t" + current.exitStatus;
+    }
+    if ("ABORT_FIXTURE".equals(op) && fields.length == 3) {
+      UUID fixture = UUID.fromString(fields[2]);
+      if (current != null && !current.fixture.equals(fixture)) { throw failure("ABORT_NOT_EXACT_FIXTURE"); }
+      retainUnknown("FIXTURE_ABANDONED");
+      stopCurrent(Duration.ofSeconds(30), false);
+      return "OK\tABORTED_RETAINED";
+    }
+    if ("RETIRE".equals(op) && fields.length == 4) {
+      requireCurrent(fields[2], fields[3]);
+      if (unknown || !"STOPPED".equals(current.phase) || current.process.isAlive()
+          || Files.exists(reconciliation.resolve("pm-fixture-" + current.fixture + ".json"), LinkOption.NOFOLLOW_LINKS)) {
+        throw failure("RETIRE_REQUIRES_VERIFIED_FIXTURE_ABSENCE");
+      }
+      Path lease = current.lease;
+      persistExitReceipt(current); // Actual waitFor exit survives lease retirement.
+      Files.delete(lease);
+      forceDirectory(reconciliation);
+      current = null;
+      persistOwner("OPEN", "PREVIOUS_GENERATION_RETIRED");
+      return "OK\tRETIRED";
+    }
+    if ("UNKNOWN".equals(op) && fields.length == 3) {
+      if (!fields[2].matches("[A-Z0-9_]{1,96}")) { throw failure("INVALID_REASON"); }
+      retainUnknown(fields[2]);
+      return "OK\tUNKNOWN";
+    }
+    if ("SHUTDOWN".equals(op) && fields.length == 2) {
+      if (current != null || !noFixtureJournals()) { retainUnknown("PARENT_SHUTDOWN_RETAINED_WORK"); }
+      stopCurrent(Duration.ofSeconds(30), false);
+      shutdown = true;
+      return "OK\tSHUTDOWN\t" + unknown;
+    }
+    throw failure("UNSUPPORTED_CONTROL_COMMAND");
+  }
+
+  private String launch(UUID fixture, ProcessHandle worker, Instant workerBirth) throws Exception {
+    verifyJar();
+    int port = Integer.parseInt(required(config, "port"));
+    assertPortClosed(port);
+    UUID generation = UUID.randomUUID();
+    Path lease = reconciliation.resolve("pm-lease-" + generation + ".json");
+    Generation next = new Generation(generation, fixture, worker, workerBirth, lease,
+        directory.resolve("playmaker-" + generation + ".log"));
+    Files.createFile(next.log, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    current = next;
+    persistLease(next, "STARTING", "BEFORE_FORK");
+    List<String> arguments = new ArrayList<>(List.of(Path.of(System.getProperty("java.home"), "bin", "java").toString(),
+        "-Xms128m", "-Xmx512m", "-jar", jar.toString(),
+        "--spring.profiles.active=local,local-integration,real-e2e",
+        "--server.address=127.0.0.1", "--server.port=" + port,
+        "--spring.kafka.consumer.group-id=" + required(config, "consumer_group"),
+        "--spring.kafka.consumer.client-id=e2e_" + run + "_pm_" + generation,
+        "--e2e.playmaker.lease.required=true", "--e2e.playmaker.lease.path=" + lease,
+        "--e2e.playmaker.lease.generation=" + generation, "--e2e.playmaker.lease.run=" + run,
+        "--e2e.playmaker.lease.jar-sha256=" + jarHash,
+        "--e2e.playmaker.lease.source-commit=" + required(config, "source_commit"),
+        "--e2e.playmaker.lease.source-manifest-sha256=" + required(config, "source_manifest_sha256")));
+    ProcessBuilder builder = new ProcessBuilder(arguments);
+    builder.redirectOutput(ProcessBuilder.Redirect.appendTo(next.log.toFile()));
+    builder.redirectError(ProcessBuilder.Redirect.appendTo(next.log.toFile()));
+    next.process = builder.start();
+    next.birth = start(next.process.toHandle());
+    persistLease(next, "REGISTERED", "EXACT_PROCESS_BEFORE_READINESS");
+    next.phase = "REGISTERED";
+    long deadline = System.nanoTime() + Duration.ofSeconds(120).toNanos();
+    HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(1)).build();
+    while (System.nanoTime() < deadline) {
+      verifyIdentity(parent, parentStart);
+      verifyIdentity(worker, workerBirth);
+      if (!next.process.isAlive()) { throw failure("PM_EXITED_DURING_START"); }
+      try {
+        HttpResponse<String> response = http.send(HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + "/ping"))
+            .timeout(Duration.ofSeconds(1)).GET().build(), HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() == 200 && response.body().contains("pong")) {
+          next.phase = "READY";
+          persistLease(next, "READY", "EXACT_PROCESS_READY");
+          return "OK\tREADY\t" + next.id + "\t" + next.process.pid() + "\t" + next.birth + "\t" + next.lease;
+        }
+      } catch (IOException unavailable) { /* Bounded readiness, never a synthetic health result. */ }
+      TimeUnit.MILLISECONDS.sleep(100);
+    }
+    throw failure("PM_READY_DEADLINE");
+  }
+
+  private void watchOwners() throws Exception {
+    if (!sameLiveIdentity(parent, parentStart)) {
+      retainUnknown("PARENT_PROCESS_LOST");
+      stopCurrent(Duration.ofSeconds(30), false);
+      shutdown = true;
+    } else if (current != null && !"STOPPED".equals(current.phase)
+        && !sameLiveIdentity(current.worker, current.workerBirth)) {
+      retainUnknown("GRADLE_WORKER_LOST");
+      stopCurrent(Duration.ofSeconds(30), false);
+    } else if (current != null && !"STOPPED".equals(current.phase) && current.process != null
+        && !current.process.isAlive()) {
+      retainUnknown("PM_UNEXPECTED_EXIT");
+      stopCurrent(Duration.ofSeconds(30), false);
+    }
+  }
+
+  private void requireCurrent(String fixture, String generation) throws Exception {
+    if (current == null || !current.fixture.equals(UUID.fromString(fixture))
+        || !current.id.equals(UUID.fromString(generation))) { throw failure("STALE_PROCESS_GENERATION"); }
+  }
+
+  private void stopCurrent(Duration deadline, boolean fixtureStop) throws Exception {
+    if (current == null) { return; }
+    Generation value = current;
+    boolean interrupted = Thread.interrupted();
+    Throwable pending = null;
+    List<OwnedHandle> subtree = new ArrayList<>();
+    try {
+      if (value.process == null) {
+        unknown = true;
+        throw failure("STARTING_PROCESS_IDENTITY_MISSING");
+      }
+      value.stopRequested = true;
+      try { persistLease(value, "STOPPING", "OWN_STOP_INTENT_BEFORE_TERM"); }
+      catch (Exception error) { unknown = true; pending = accumulate(pending, error); }
+      ProcessHandle root = value.process.toHandle();
+      try {
+        if (value.birth == null) { throw failure("PROCESS_BIRTH_IDENTITY_UNAVAILABLE"); }
+        if (root.isAlive()) { verifyIdentity(root, value.birth); }
+        root.descendants().forEach(handle -> subtree.add(new OwnedHandle(handle, start(handle))));
+      } catch (Exception error) { unknown = true; pending = accumulate(pending, error); }
+      // Actual Process ownership does not depend on a successful journal write or birth probe.
+      for (OwnedHandle handle : subtree.reversed()) {
+        if (sameLiveIdentity(handle.handle, handle.birth)) { handle.handle.destroy(); }
+      }
+      value.process.destroy();
+      long end = System.nanoTime() + deadline.toNanos();
+      while ((value.process.isAlive() || subtree.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth)))
+          && System.nanoTime() < end) {
+        try { TimeUnit.MILLISECONDS.sleep(25); }
+        catch (InterruptedException event) { interrupted = true; }
+      }
+      for (OwnedHandle handle : subtree.reversed()) {
+        if (sameLiveIdentity(handle.handle, handle.birth)) {
+          value.forced = true;
+          handle.handle.destroyForcibly();
+        }
+      }
+      if (value.process.isAlive()) { value.forced = true; value.process.destroyForcibly(); }
+      long forcedEnd = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+      boolean reaped = false;
+      while (!reaped && System.nanoTime() < forcedEnd) {
+        try { reaped = value.process.waitFor(100, TimeUnit.MILLISECONDS); }
+        catch (InterruptedException event) { interrupted = true; }
+      }
+      while (subtree.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth))
+          && System.nanoTime() < forcedEnd) {
+        try { TimeUnit.MILLISECONDS.sleep(25); }
+        catch (InterruptedException event) { interrupted = true; }
+      }
+      if (!reaped || subtree.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth))) {
+        unknown = true;
+        pending = accumulate(pending, failure("OWNED_PROCESS_REAP_FAILED"));
+      }
+      if (reaped) { value.exitStatus = value.process.exitValue(); }
+      try { assertPortClosed(Integer.parseInt(required(config, "port"))); }
+      catch (Exception error) { unknown = true; pending = accumulate(pending, error); }
+      try { value.logSha256 = hash(privateFile(value.log)); }
+      catch (Exception error) { unknown = true; pending = accumulate(pending, error); }
+      if (value.forced || (value.exitStatus != 0 && value.exitStatus != 143)) { unknown = true; }
+      value.phase = reaped ? "STOPPED" : "UNKNOWN";
+      try { persistLease(value, value.phase, fixtureStop ? "FIXTURE_PROCESS_REAPED" : "PARENT_PROCESS_REAPED"); }
+      catch (Exception error) { unknown = true; pending = accumulate(pending, error); }
+      if (unknown) {
+        try { persistOwner("UNKNOWN", "PROCESS_OR_RECEIPT_UNVERIFIED"); }
+        catch (Exception error) { pending = accumulate(pending, error); }
+      }
+    } finally { if (interrupted) { Thread.currentThread().interrupt(); } }
+    if (pending != null) { throw failure("PROCESS_REAP_OR_DURABILITY_UNVERIFIED"); }
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    first.addSuppressed(next);
+    return first;
+  }
+
+  private void retainUnknown(String reason) throws Exception {
+    unknown = true;
+    persistOwner("UNKNOWN", reason);
+    if (current != null) { persistLease(current, current.phase, reason); }
+  }
+
+  private void persistOwner(String phase, String reason) throws Exception {
+    Map<String, Object> fields = common("PLAYMAKER_PROCESS_OWNER");
+    fields.put("owner_id", ownerId.toString());
+    fields.put("phase", phase);
+    fields.put("reason", reason);
+    fields.put("unknown", unknown);
+    fields.put("generation", current == null ? "" : current.id.toString());
+    fields.put("control_directory", directory.toString());
+    writeJournal(ownerJournal, fields);
+  }
+
+  private Map<String, Object> common(String kind) {
+    Map<String, Object> fields = new LinkedHashMap<>();
+    fields.put("schema_version", 1);
+    fields.put("kind", kind);
+    fields.put("run_id", run);
+    fields.put("parent_pid", parent.pid());
+    fields.put("parent_start", parentStart.toString());
+    fields.put("guardian_pid", ProcessHandle.current().pid());
+    fields.put("guardian_start", start(ProcessHandle.current()).toString());
+    fields.put("jar_path", jar.toString());
+    fields.put("jar_sha256", jarHash);
+    fields.put("source_commit", config.getProperty("source_commit"));
+    fields.put("source_manifest_sha256", config.getProperty("source_manifest_sha256"));
+    fields.put("port", Integer.parseInt(config.getProperty("port")));
+    fields.put("consumer_group", config.getProperty("consumer_group"));
+    fields.put("child_mode", config.getProperty("child_mode"));
+    fields.put("socket_path", socketPath.toString());
+    return fields;
+  }
