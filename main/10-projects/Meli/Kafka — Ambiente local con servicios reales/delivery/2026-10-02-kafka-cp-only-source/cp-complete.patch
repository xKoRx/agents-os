+
+  Component registerCopy(Product product, long id) throws Exception {
+    requireProduct(product);
+    String row = query("SELECT name,component_template_code FROM component WHERE id=? AND data_product_id=?",
+        id, product.id()).strip();
+    String[] fields = row.split("\t", 2);
+    if (fields.length != 2) {
+      throw new IllegalStateException("HTTP_COMPONENT_RECEIPT_NOT_OWN_DATABASE");
+    }
