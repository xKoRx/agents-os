+        "kafka.provisioning.timeout-minutes=1", "e2e.bridge.enabled=false"})
+@ActiveProfiles({"local", "real-e2e"})
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_EACH_TEST_METHOD)
+class RealPublicationFailureIntegrationTest {
+  @LocalServerPort private int port;
+  @Autowired private ObjectMapper mapper;
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+  @Autowired @Qualifier(BigQConfig.DEPLOYMENT_RESULT_CLIENT) private BigQueueClient deploymentResults;
+  @Autowired @Qualifier(BigQConfig.ACTION_RESULT_CLIENT) private BigQueueClient actionResults;
+
+  @ParameterizedTest
+  @ValueSource(strings = {"aws-msk-topic", "gcp-kafka-topic"})
+  void deploymentsKeepTerminalKvsAfterRealProducerFailureAndDropRedelivery(String provider) throws Exception {
+    try (RealE2eFixture fixture = fixture()) {
+      String topic = fixture.uniqueTopic("deploymentlostpublication");
+      var trigger = fixture.trigger(DeploymentOperation.PROVISION, provider, fixture.paramsFor(provider, topic, 1, (short) 1));
