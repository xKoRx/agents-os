+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+/**
+ * Records an unresolved provider capability rather than inventing a deletion or callback API.
+ *
+ * <p>Installed Fury CLI proves topic/consumer/scope creation and read-only peek. It exposes no
+ * verified resource deletion contract. Publication remains closed until the official lifecycle
+ * implementation, isolated callback scope and corrected segmented SDK artifact are registered
+ * and exercised with actual service metadata. A supplied HTTP URL or boolean is not proof.
+ */
+final class ManagedBigQueueLifecycleRegistry {
+  private ManagedBigQueueLifecycleRegistry() {}
+
+  static void requireVerifiedPublicationLifecycle() {
+    throw new IllegalStateException(
+        "MANAGED_BIGQUEUE_BLOCKED:SDK_SEGMENT_FIX_AND_OWNED_CLEANUP_CALLBACK_CONTRACT_UNVERIFIED");
+  }
+}
