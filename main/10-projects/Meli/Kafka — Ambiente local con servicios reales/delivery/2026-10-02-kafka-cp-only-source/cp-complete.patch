+  }
+
+  Environment seedEnvironment(Product product, String name) throws Exception {
+    requireProduct(product);
+    long id = nextId();
+    beforeMutation(product.id());
+    lifecycle.beforeSqlMutation(Map.of("environment." + id, id));
+    query("INSERT INTO environment (id,name,data_product_id,type,criticality,created_at,updated_at,created_by,"
+        + "updated_by,deleted_by) VALUES (?,?,?,'Testing','Test',NOW(),NOW(),'e2e','e2e','')", id, name, product.id());
+    return new Environment(id, name, product);
+  }
+
+  Component seedComponent(Product product, String template, Map<String, Object> params) throws Exception {
+    requireProduct(product);
+    long id = nextId();
+    String name = "component_" + UUID.randomUUID().toString().replace("-", "");
+    beforeMutation(product.id());
+    lifecycle.beforeSqlMutation(Map.of("component." + id, id));
+    query("INSERT INTO component (id,data_product_id,component_template,component_template_code,name,visibility,"
+        + "status,created_at,updated_at,created_by,updated_by,deleted_by) VALUES (?,?,?,?,?,'public','Active',"
+        + "NOW(),NOW(),'e2e','e2e','')", id, product.id(), template, template, name);
+    Component component = new Component(id, name, template, product);
+    seedDefinition(component, params);
