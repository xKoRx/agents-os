+#!/usr/bin/env python3
+"""Own five-node physical broker-reduction and restoration proof, without CP/KVS claims."""
+import base64
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+root = Path(__file__).resolve().parents[2]
+context = os.environ.get('DOCKER_CONTEXT')
+if not context:
+    raise SystemExit('EXPLICIT_DOCKER_CONTEXT_REQUIRED')
+run_id = uuid.uuid4().hex
+project = 'rio-kafka-e2e-reduction-' + run_id
+base = int(os.environ.get('E2E_KAFKA_BASE_PORT', '39592'))
+for port in range(base, base + 5):
+    with socket.socket() as reservation:
+        reservation.bind(('127.0.0.1', port))
+evidence = root / 'build/real-e2e' / run_id / 'fault-controls'
+evidence.mkdir(parents=True)
+os.chmod(evidence, 0o700)
+ledger = {'run_id': run_id, 'project': project, 'docker_context': context,
+          'scope': 'physical five-to-three broker reduction and RF5 restoration only',
+          'cp_kvs_pm_managed': 'NOT_EXECUTED', 'cp_rf_adjuster_failure': 'NOT_EXECUTED',
+          'assertions': [], 'verdict': 'NOT_EXECUTED'}
+status = 0
+with tempfile.TemporaryDirectory(prefix='e2e-broker-reduction-') as private:
+    env_file = Path(private) / 'compose.env'
+    architecture = subprocess.check_output(['docker', '--context', context, 'info', '--format', '{{.Architecture}}'], text=True).strip()
+    exports = {'E2E_RUN_ID': run_id,
+               'E2E_KRAFT_CLUSTER_ID': base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='),
+               'E2E_JAVA_TOOL_OPTIONS': '-XX:UseSVE=0' if architecture in ('aarch64', 'arm64') else '',
+               **{'E2E_KAFKA_PORT_' + str(index): str(base + index - 1) for index in range(1, 6)}}
+    env_file.write_text(''.join(key + '=' + value + '\n' for key, value in exports.items()))
+    os.chmod(env_file, 0o600)
+    compose = ['docker', '--context', context, 'compose', '--project-name', project, '--env-file', str(env_file),
+               '--file', str(root / 'e2e/compose.yaml')]
+    def command(arguments, must_pass=True):
+        response = subprocess.run(arguments, capture_output=True, text=True, timeout=240)
+        if must_pass and response.returncode != 0:
+            raise RuntimeError('OWNED_COMMAND_FAILED')
+        return response
+    def kafka(script, *arguments, must_pass=True):
+        return command(compose + ['exec', '--no-TTY', 'broker1', '/opt/kafka/bin/' + script,
+                                  '--bootstrap-server', 'broker1:19092', *arguments], must_pass)
+    def owned(service):
+        container = command(compose + ['ps', '--all', '--quiet', service]).stdout.strip()
+        if not container or len(container.splitlines()) != 1:
+            raise RuntimeError('ONE_OWNED_CONTAINER_REQUIRED')
+        labels = command(['docker', '--context', context, 'inspect', '--format',
+                          '{{index .Config.Labels "com.docker.compose.project"}} {{index .Config.Labels "com.docker.compose.service"}} {{index .Config.Labels "io.rio.e2e.owned"}} {{index .Config.Labels "io.rio.e2e.run"}}', container]).stdout.strip()
+        if labels != project + ' ' + service + ' true ' + run_id:
+            raise RuntimeError('OWNERSHIP_MISMATCH')
+    def await_nodes(expected):
+        deadline = time.monotonic() + 120
+        while time.monotonic() < deadline:
+            response = kafka('kafka-broker-api-versions.sh', must_pass=False)
+            nodes = set(re.findall(r'id: ([1-5]) rack:', response.stdout))
+            if response.returncode == 0 and len(nodes) == expected:
+                return sorted(nodes)
+            time.sleep(1)
+        raise RuntimeError('LIVE_BROKER_DEADLINE')
+    try:
+        command(compose + ['up', '--detach', '--wait', '--wait-timeout', '180'])
+        for service in ('broker1', 'broker2', 'broker3', 'broker4', 'broker5'):
+            owned(service)
+        ledger['initial_nodes'] = await_nodes(5)
+        ledger['assertions'].append('FIVE_REAL_BROKERS_READY')
+        command(compose + ['stop', '--timeout', '10', 'broker4', 'broker5'])
+        ledger['reduced_nodes'] = await_nodes(3)
+        ledger['assertions'].append('THREE_REAL_BROKERS_WITH_CONTROLLER_QUORUM')
+        topic = 'e2e_' + run_id + '_rf5'
+        denied = kafka('kafka-topics.sh', '--create', '--topic', topic, '--partitions', '3', '--replication-factor', '5', must_pass=False)
+        ledger['rf5_create_exit_code'] = denied.returncode
+        ledger['rf5_create_error_types'] = re.findall(r'[A-Za-z]+Exception', denied.stdout + denied.stderr)
+        (evidence / 'reduced-create-rf5.txt').write_text(denied.stdout + denied.stderr)
+        # Kafka can place replicas on registered but currently fenced brokers. Never assume
+        # that live-node reduction alone makes native CreateTopics reject a legal RF.
+        if denied.returncode != 0:
+            raise RuntimeError('NATIVE_RF5_REGISTERED_BROKER_ASSIGNMENT_UNEXPECTED')
+        reduced_description = kafka('kafka-topics.sh', '--describe', '--topic', topic).stdout
+        reduced_assignments = re.findall(r'Replicas: ([0-9,]+)\s+Isr: ([0-9,]+)', reduced_description)
+        if len(reduced_assignments) != 3 or any(len(set(replicas.split(','))) != 5 or len(set(isr.split(','))) > 3
+                                                for replicas, isr in reduced_assignments):
+            raise RuntimeError('REAL_FENCED_BROKER_REPLICA_ASSIGNMENT_REQUIRED')
+        (evidence / 'reduced-rf5.txt').write_text(reduced_description)
+        ledger['assertions'].append('NATIVE_RF5_ACCEPTED_WITH_REGISTERED_OFFLINE_BROKERS_AND_REDUCED_ISR')
+        owned('broker4')
+        owned('broker5')
+        command(compose + ['start', 'broker4', 'broker5'])
+        ledger['restored_nodes'] = await_nodes(5)
+        description = kafka('kafka-topics.sh', '--describe', '--topic', topic).stdout
+        assignments = re.findall(r'Replicas: ([0-9,]+)\s+Isr: ([0-9,]+)', description)
+        deadline = time.monotonic() + 60
+        while len(assignments) != 3 or any(len(set(replicas.split(','))) != 5 or len(set(isr.split(','))) != 5
+                                           for replicas, isr in assignments):
+            if time.monotonic() >= deadline:
+                raise RuntimeError('REAL_RF5_ISR_RESTORATION_REQUIRED')
+            time.sleep(1)
+            description = kafka('kafka-topics.sh', '--describe', '--topic', topic).stdout
+            assignments = re.findall(r'Replicas: ([0-9,]+)\s+Isr: ([0-9,]+)', description)
+        (evidence / 'restored-rf5.txt').write_text(description)
+        ledger['assertions'].append('RF5_REAL_CREATION_AND_FULL_ISR_AFTER_RESTORING_FIVE_BROKERS')
+        ledger['verdict'] = 'PASS'
+    except (OSError, subprocess.SubprocessError, RuntimeError) as failure:
+        ledger['verdict'] = 'FAIL'
+        ledger['failure_type'] = type(failure).__name__
+        if isinstance(failure, RuntimeError):
+            ledger['failure_code'] = str(failure)
+        status = 1
+    finally:
+        cleanup = True
+        try:
+            command(compose + ['down', '--volumes', '--remove-orphans'])
+            for kind in ('container', 'network', 'volume'):
+                query = ['docker', '--context', context]
+                query += ['ps', '--all', '--quiet'] if kind == 'container' else [kind, 'ls', '--quiet']
+                if command(query + ['--filter', 'label=com.docker.compose.project=' + project]).stdout.strip():
+                    cleanup = False
+        except (subprocess.SubprocessError, RuntimeError):
+            cleanup = False
+        ledger['cleanup'] = 'CLEANUP_CERTIFIED' if cleanup else 'CLEANUP_FAILED'
+        if not cleanup:
+            status = 1
+        (evidence / 'ledger.json').write_text(json.dumps(ledger, indent=2) + '\n')
+        print('REAL_BROKER_REDUCTION_CONTROL_' + ledger['verdict'] + ':' + str(evidence))
+        print(ledger['cleanup'] + ':' + project)
+sys.exit(status)
