+      assertTrue(fixture.awaitTopic(topic).partitions().stream().allMatch(part -> part.replicas().size() == 1));
+      assertEquals("1234567", fixture.topicConfigs(topic).get("retention.ms"));
+    } finally {
+      clusterAdmin.deleteAcls(acls.stream().map(AclBinding::toFilter).toList()).all().get(30, TimeUnit.SECONDS);
+    }
+    int failedResults = fixture.resultsFor(failedTrigger.deploymentId().toString()).size();
+    assertEquals(200, child.postJson("/triggers/deployments", mapper.writeValueAsString(Map.of("msg", failedTrigger))).statusCode());
+    fixture.assertNoMoreResults(failedTrigger.deploymentId().toString(), failedResults, Duration.ofSeconds(1));
