+  /** Requires every explicitly involved CP to finish, or every own child to have been reaped. */
+  public void awaitWorkersQuiescent() throws Exception {
+    quiescenceVerified = false;
+    try {
+      awaitOwnedWorkersQuiescent();
+      quiescenceVerified = true;
+    } catch (Exception | AssertionError observationFailure) {
+      try {
+        setJournalState("UNKNOWN", "WORKER_QUIESCENCE_UNVERIFIED");
+      } catch (Exception | AssertionError ledgerFailure) {
+        observationFailure.addSuppressed(ledgerFailure);
+      }
+      throw observationFailure;
+    }
+  }
+
+  private void awaitOwnedWorkersQuiescent() throws Exception {
+    List<Integer> ports;
+    List<RealControlplaneProcess> processes;
+    List<Thread> serviceWorkers;
+    List<String> bridgeTopics;
+    List<CleanupChildPermit> cleanupChildren;
+    synchronized (this) {
+      assertTrue(plannedWorkerPorts.isEmpty(), "A started child without a recorded exact PID cannot certify cleanup");
+      ports = List.copyOf(ownedWorkerPorts);
+      processes = List.copyOf(ownedWorkerProcesses);
+      serviceWorkers = List.copyOf(ownedServiceWorkers);
+      bridgeTopics = List.copyOf(ownedBridgeTopics);
+      cleanupChildren = List.copyOf(cleanupChildPermits.values());
+    }
+    for (CleanupChildPermit permit : cleanupChildren) {
+      Process child = cleanupChildProcesses.get(permit.childJournalId());
+      assertNotNull(child, "A cleanup child started without a recorded exact Process cannot certify deletion");
+      verifyCleanupChildOutcome(permit, child);
+    }
+    Awaitility.await("all fixture HTTP async dispatch calls must finish")
+        .atMost(DEADLINE).until(() -> inFlightAsyncRequests.get() == 0);
+    Throwable failure = null;
+    if (!bridgeTopics.isEmpty()) {
+      try {
+        Awaitility.await("actual run-owned Kafka bridge must commit all current trigger partitions")
+            .atMost(DEADLINE).until(() -> bridgeCaughtUp(bridgeTopics));
+      } catch (Exception | AssertionError observationFailure) {
+        failure = accumulate(failure, observationFailure);
+      }
+    }
+    for (Thread worker : serviceWorkers) {
+      try {
+        Awaitility.await("the exact owned service worker must terminate before resource deletion")
+            .atMost(DEADLINE).until(() -> !worker.isAlive());
+      } catch (Exception | AssertionError observationFailure) {
+        failure = accumulate(failure, observationFailure);
+      }
+    }
+    for (RealControlplaneProcess process : processes) {
+      try {
+        process.awaitIdleOrReaped(DEADLINE);
+      } catch (Exception | AssertionError observationFailure) {
+        failure = accumulate(failure, observationFailure);
+      }
+    }
+    for (int ownedPort : ports) {
+      try {
+        RealWorkerCleanupGate.awaitIdle(http, mapper, ownedPort, runId, null, DEADLINE);
+      } catch (Exception | AssertionError observationFailure) {
+        failure = accumulate(failure, observationFailure);
+      }
+    }
+    if (!bridgeTopics.isEmpty()) {
+      try {
+        Awaitility.await("owned bridge offsets and CP idle ledger must agree before deletion")
+            .atMost(DEADLINE).until(() -> {
+              if (!bridgeCaughtUp(bridgeTopics)) {
+                return false;
+              }
+              for (int ownedPort : ports) {
+                if (!RealWorkerCleanupGate.idle(http, mapper, ownedPort, runId, null)) {
+                  return false;
+                }
+              }
+              return bridgeCaughtUp(bridgeTopics);
+            });
+      } catch (Exception | AssertionError observationFailure) {
+        failure = accumulate(failure, observationFailure);
+      }
+    }
+    rethrow(failure);
+  }
