+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueClientFactory;
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueProperties;
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueTopicProperties;
+import com.mercadolibre.rio.sdk.events.bigqueue.impl.BigQueueClientImpl;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+/** PROBE_ONLY neutral SDK transport component; this never certifies a CP business journey. */
+class ManagedBigQueueTransportProbeTest {
+  @Test
+  void neutralSdkTransportProbeIsObservableOnItsOwnBigQueueConsumer() throws Exception {
+    ManagedGateInputs.requireNonprodScope();
+    // This capability is not present yet. Keep the mandatory test red, never fabricate delivery.
+    ManagedBigQueueLifecycleRegistry.requireVerifiedPublicationLifecycle();
+    String topic = ManagedGateInputs.required("E2E_MANAGED_BIGQUEUE_PROBE_TOPIC");
+    String segment = ManagedGateInputs.required("E2E_MANAGED_BIGQUEUE_SEGMENT_ID");
+    var properties = new BigQueueTopicProperties("managed-e2e-probe", topic,
+        "Run-owned managed transport probe", segment, 5_000, 3_000,
+        null, null, 1, 100, false, null, null);
+    var factory = new BigQueueClientFactory(new BigQueueProperties(
+        "rio-controlplane-kafka", List.of(properties)));
+    var client = factory.createClient("managed-e2e-probe");
+    try {
+      assertThat(client).isInstanceOf(BigQueueClientImpl.class);
+      String probeId = "e2e-" + UUID.randomUUID();
+      // Neutral transport data contains no business status, fabricated result or deployment outcome.
+      byte[] ack = client.send(Map.of("probe_id", probeId,
+          "probe_namespace", ManagedGateInputs.required("E2E_MANAGED_RUN_ID")));
+      assertThat(ack).isNotEmpty();
+      // Actual provider observation uses installed Fury ServicesApi peek, not a local HTTP fake.
+      assertThat(ManagedBigQueueObserver.awaitTransportProbe(probeId)).isTrue();
+    } finally {
+      client.close();
+    }
+  }
+}
diff --git a/src/managedIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/managed/ManagedBusinessResultObserver.java b/src/managedIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/managed/ManagedBusinessResultObserver.java
new file mode 100644
index 0000000000000000000000000000000000000000..daa2ec73c648c2b18372ed7d7c5eb3be784ad9eb
--- /dev/null
+++ b/src/managedIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/managed/ManagedBusinessResultObserver.java
@@ -0,0 +1,306 @@
+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+import com.mercadolibre.rio.sdk.events.actions.ActionResultMessage;
+import com.mercadolibre.rio.sdk.events.actions.ActionResultStatus;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentResultMessage;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentResultStatus;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Duration;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/**
+ * Observes actual business results through owned BigQueue consumers, independently of HTTP200.
+ * No peek layout/message identity/window or cleanup contract is assumed from a template.
+ */
+final class ManagedBusinessResultObserver implements AutoCloseable {
+  enum Kind { DEPLOYMENT, ACTION }
+
+  record Channel(Kind kind, String logicalTopic, String physicalTopic, String consumer, String segment) {}
+
+  record Observation(String providerMessageId, String correlationId, Kind kind, String status,
+      JsonNode payload) {
+    boolean terminal() { return "COMPLETED".equals(status) || "FAILED".equals(status); }
+  }
+
+  /** Output of a future provider decoder, exclusively from actual owned-service responses. */
+  private record ProviderRecord(String providerMessageId, String physicalTopic, String consumer,
+      JsonNode sdkPayload) {}
+
+  /**
+   * Requires a verified provider implementation, not an environment boolean or supplied URL.
+   * A partial/saturated/ambiguous peek window must throw, never prove absence of another event.
+   */
+  private interface VerifiedPeekProtocol {
+    List<ProviderRecord> completeOwnedWindow(JsonNode actualResponse, Channel channel, int requestedLimit);
+    void verifyFreshOwnedMetadata(JsonNode topicMetadata, JsonNode consumerMetadata, Channel channel);
+    void cleanupAndCertifyOwnedResources(List<Channel> channels) throws Exception;
+  }
+
+  private static final int REQUESTED_LIMIT = 64;
+  private static final Duration DEADLINE = Duration.ofMinutes(12);
+  private final ObjectMapper mapper;
+  private final VerifiedPeekProtocol protocol;
+  private final List<Channel> channels;
+  private final Map<String, Observation> records = new LinkedHashMap<>();
+
+  static ManagedBusinessResultObserver open(ObjectMapper mapper) {
+    ManagedBigQueueLifecycleRegistry.requireVerifiedPublicationLifecycle();
+    return new ManagedBusinessResultObserver(mapper, requireVerifiedPeekProtocol());
+  }
+
+  private static VerifiedPeekProtocol requireVerifiedPeekProtocol() {
+    // Templates200 prove fields, not the message peek schema/identity/window or effective deletion.
+    // Replace only with a source-owned adapter after actual owned services establish those contracts.
+    throw new IllegalStateException("MANAGED_BUSINESS_OBSERVER_BLOCKED:PEEK_SCHEMA_WINDOW_IDS_AND_CLEANUP_UNVERIFIED");
+  }
+
+  private ManagedBusinessResultObserver(ObjectMapper mapper, VerifiedPeekProtocol protocol) {
+    this.mapper = mapper;
+    this.protocol = protocol;
+    this.channels = List.of(channel(Kind.DEPLOYMENT, "DEPLOYMENT"), channel(Kind.ACTION, "ACTION"));
+    if (channels.get(0).logicalTopic().equals(channels.get(1).logicalTopic())
+        || channels.get(0).consumer().equals(channels.get(1).consumer())) {
+      throw new IllegalStateException("MANAGED_DISTINCT_RESULT_CHANNELS_REQUIRED");
+    }
+  }
+
+  private Channel channel(Kind kind, String name) {
+    String prefix = "E2E_MANAGED_" + name + "_RESULT_";
+    String runPrefix = "e2e_" + ManagedGateInputs.required("E2E_MANAGED_RUN_ID") + "_";
+    String topic = ManagedGateInputs.required(prefix + "TOPIC");
+    String physical = ManagedGateInputs.required(prefix + "TOPIC_NAME");
+    String consumer = ManagedGateInputs.required(prefix + "CONSUMER");
+    if (!topic.matches("[a-zA-Z0-9_-]{1,200}") || !consumer.matches("[a-zA-Z0-9_-]{1,200}")
+        || !physical.matches("[a-zA-Z0-9_.-]{1,250}")
+        || !topic.startsWith(runPrefix) || !consumer.startsWith(runPrefix) || !physical.startsWith(runPrefix)) {
+      throw new IllegalStateException("MANAGED_RUN_OWNED_RESULT_CHANNEL_REQUIRED");
+    }
+    return new Channel(kind, topic, physical, consumer,
+        ManagedGateInputs.required("E2E_MANAGED_BIGQUEUE_SEGMENT_ID"));
+  }
+
+  /** Verifies a fresh queue before the first trigger; stale traffic cannot become this run's proof. */
+  void requireInitiallyEmptyOwnedConsumers() throws Exception {
+    refresh();
+    if (!records.isEmpty()) {
+      throw new IllegalStateException("MANAGED_OWN_RESULT_CONSUMERS_MUST_START_EMPTY");
+    }
+  }
+
+  Observation awaitTerminal(Kind kind, String correlationId) throws Exception {
+    long deadline = System.nanoTime() + DEADLINE.toNanos();
+    while (System.nanoTime() < deadline) {
+      refresh();
+      List<Observation> matching = resultsFor(kind, correlationId);
+      List<Observation> terminals = matching.stream().filter(Observation::terminal).toList();
+      if (terminals.size() > 1) {
+        throw new IllegalStateException("MANAGED_DUPLICATE_BUSINESS_TERMINAL_OBSERVED");
+      }
+      if (!terminals.isEmpty()) {
+        return terminals.get(0);
+      }
+      TimeUnit.MILLISECONDS.sleep(500);
+    }
+    throw new IllegalStateException("MANAGED_ACTUAL_BUSINESS_RESULT_NOT_OBSERVED");
+  }
+
+  /** Both events must be actual provider records; ordering is not inferred from peek delivery. */
+  Observation awaitLifecycle(Kind kind, String id) throws Exception {
+    long deadline = System.nanoTime() + DEADLINE.toNanos();
+    while (System.nanoTime() < deadline) {
+      refresh();
+      List<Observation> matching = resultsFor(kind, id);
+      long started = matching.stream().filter(record -> "STARTED".equals(record.status())).count();
+      List<Observation> terminal = matching.stream().filter(Observation::terminal).toList();
+      if (started > 1 || terminal.size() > 1 || matching.size() > 2) {
+        throw new IllegalStateException("MANAGED_DUPLICATE_BUSINESS_LIFECYCLE_OBSERVED");
+      }
+      if (started == 1 && terminal.size() == 1) return terminal.get(0);
+      TimeUnit.MILLISECONDS.sleep(500);
+    }
+    throw new IllegalStateException("MANAGED_ACTUAL_STARTED_AND_TERMINAL_NOT_OBSERVED");
+  }
+
+  List<Observation> resultsFor(Kind kind, String id) {
+    return records.values().stream().filter(value -> value.kind() == kind && id.equals(value.correlationId())).toList();
+  }
+
+  /** Repeated peek identities are deduplicated; a new provider identity is always a new event. */
+  void assertNoNewMessages(Kind kind, String id, Duration window) throws Exception {
+    refresh();
+    List<String> before = resultsFor(kind, id).stream().map(Observation::providerMessageId).sorted().toList();
+    long deadline = System.nanoTime() + window.toNanos();
+    do {
+      refresh();
+      List<String> after = resultsFor(kind, id).stream().map(Observation::providerMessageId).sorted().toList();
+      if (!before.equals(after)) {
+        throw new IllegalStateException("MANAGED_REDELIVERY_EMITTED_ADDITIONAL_PROVIDER_MESSAGE");
+      }
+      TimeUnit.MILLISECONDS.sleep(500);
+    } while (System.nanoTime() < deadline);
+  }
+
+  /** Complete actual run snapshot, including all correlations, not only the most recent trigger. */
+  Map<String, Observation> snapshotCompleteRun(Set<String> deploymentIds, Set<String> actionIds) throws Exception {
+    refresh();
+    for (Observation actual : records.values()) {
+      Set<String> allowed = actual.kind() == Kind.DEPLOYMENT ? deploymentIds : actionIds;
+      if (!allowed.contains(actual.correlationId())) {
+        throw new IllegalStateException("MANAGED_UNEXPECTED_RUN_CORRELATION_OBSERVED");
+      }
+    }
+    for (Kind kind : Kind.values()) {
+      Set<String> expected = kind == Kind.DEPLOYMENT ? deploymentIds : actionIds;
+      for (String id : expected) {
+        List<Observation> lifecycle = resultsFor(kind, id);
+        if (lifecycle.size() != 2
+            || lifecycle.stream().filter(value -> "STARTED".equals(value.status())).count() != 1
+            || lifecycle.stream().filter(Observation::terminal).count() != 1) {
+          throw new IllegalStateException("MANAGED_INCOMPLETE_OR_DUPLICATE_RUN_LIFECYCLE");
+        }
+      }
+    }
+    return Map.copyOf(records);
+  }
+
+  /** Only after real executor termination; fresh complete provider window must match every receipt. */
+  void verifyNoAdditionalRunResults(Map<String, Observation> baseline) throws Exception {
+    refresh();
+    if (!records.equals(baseline)) {
+      throw new IllegalStateException("MANAGED_ADDITIONAL_OR_CHANGED_RESULT_AFTER_DRAIN");
+    }
+  }
+
+  private void refresh() throws Exception {
+    for (Channel channel : channels) {
+      JsonNode actual = readProviderSnapshot(channel);
+      protocol.verifyFreshOwnedMetadata(actual.path("topic"), actual.path("consumer"), channel);
+      for (ProviderRecord record : protocol.completeOwnedWindow(actual.path("peek"), channel, REQUESTED_LIMIT)) {
+        if (record.providerMessageId() == null || record.providerMessageId().isBlank()
+            || !channel.physicalTopic().equals(record.physicalTopic())
+            || !channel.consumer().equals(record.consumer())) {
+          throw new IllegalStateException("MANAGED_PROVIDER_IDENTITY_OR_MAPPING_MISMATCH");
+        }
+        Observation observed = decodeActualSdkResult(record, channel.kind());
+        String identity = channel.kind().name() + ":" + record.providerMessageId();
+        Observation previous = records.putIfAbsent(identity, observed);
+        if (previous != null && !previous.equals(observed)) {
+          throw new IllegalStateException("MANAGED_PROVIDER_MESSAGE_ID_CHANGED_PAYLOAD");
+        }
+      }
+    }
+  }
+
+  private Observation decodeActualSdkResult(ProviderRecord record, Kind kind) {
+    JsonNode payload = record.sdkPayload();
+    if (payload == null || !payload.isObject() || payload.has("msg")) {
+      throw new IllegalStateException("MANAGED_SINGLE_ACTUAL_SDK_PAYLOAD_REQUIRED");
+    }
+    try {
+      if (kind == Kind.DEPLOYMENT) {
+        DeploymentResultMessage message = mapper.treeToValue(payload, DeploymentResultMessage.class);
+        if (message.deploymentId() == null || message.status() == null || message.publishedAt() == null
+            || !"gcp-kafka-topic".equals(message.componentType()) || !Integer.valueOf(1).equals(message.schemaVersion())
+            || (message.status() == DeploymentResultStatus.COMPLETED && message.output() == null)
+            || (message.status() == DeploymentResultStatus.FAILED && message.error() == null)) {
+          throw new IllegalStateException("MANAGED_INVALID_ACTUAL_DEPLOYMENT_RESULT");
+        }
+        return new Observation(record.providerMessageId(), message.deploymentId().toString(), kind,
+            message.status().name(), payload);
+      }
+      ActionResultMessage message = mapper.treeToValue(payload, ActionResultMessage.class);
+      if (message.actionId() == null || message.actionId().isBlank() || message.status() == null
+          || (message.status() == ActionResultStatus.COMPLETED && (message.result() == null || message.completedAt() == null))
+          || (message.status() == ActionResultStatus.FAILED && (message.error() == null || message.completedAt() == null))) {
+        throw new IllegalStateException("MANAGED_INVALID_ACTUAL_ACTION_RESULT");
+      }
+      return new Observation(record.providerMessageId(), message.actionId(), kind, message.status().name(), payload);
+    } catch (IllegalStateException exception) {
+      throw exception;
+    } catch (Exception exception) {
+      throw new IllegalStateException("MANAGED_ACTUAL_RESULT_DESERIALIZATION_FAILED");
+    }
+  }
+
+  private JsonNode readProviderSnapshot(Channel channel) throws Exception {
+    String application = ManagedGateInputs.required("E2E_MANAGED_APPLICATION");
+    if (!"rio-controlplane-kafka".equals(application)) {
+      throw new IllegalStateException("MANAGED_OWN_CP_APPLICATION_REQUIRED");
+    }
+    Path script = privateFile(".py");
+    Path output = privateFile(".json");
+    Path diagnostic = privateFile(".log");
+    Process child = null;
+    try {
+      Files.writeString(script, """
+          import contextlib,json,os,sys,time
+          from pathlib import Path
+          application,topic,consumer,output,limit=sys.argv[1:]
+          os.umask(0o077)
+          with contextlib.redirect_stdout(sys.stderr):
+           from cli_services.services_commands.rest.servicesapi import ServicesApi
+           from furycli.core.helpers import credentials
+           snapshot=credentials.get_credentials()
+           token=credentials.get(credentials.TIGER_TOKEN_KEY,snapshot)
+           if not isinstance(token,str) or not token or credentials.tiger_token_expired(snapshot):
+            raise RuntimeError('MANAGED_STORED_FURY_LOGIN_REQUIRED')
+           zero_trust=credentials.get(credentials.ZT_TOKEN_KEY,snapshot)
+           if zero_trust:
+            expiry=int(credentials._decode_jwt_payload(zero_trust)['exp'])
+            if expiry<=time.time()+500: raise RuntimeError('MANAGED_STORED_ZERO_TRUST_REQUIRED')
+           headers={'X-Tiger-Token':'Bearer '+token}
+           api=ServicesApi()
+           def read(route):
+            payload,status=api.make_api_call(route,timeout=10,retry=False,authenticate=False,headers=headers)
+            if status!=200: raise RuntimeError('MANAGED_OBSERVER_API_FAILED')
+            return payload
+           actual={'topic':read(f'application/{application}/bigq/topics/{topic}'),
+                   'consumer':read(f'application/{application}/bigq/consumers/{consumer}'),
+                   'peek':read(f'application/{application}/bigq/consumers/{consumer}/peek?amount_of_messages={limit}')}
+          Path(output).write_text(json.dumps(actual))
+          """);
+      child = new ProcessBuilder(ManagedGateInputs.required("E2E_FURY_PYTHON"), script.toString(),
+          application, channel.logicalTopic(), channel.consumer(), output.toString(), Integer.toString(REQUESTED_LIMIT))
+          .redirectErrorStream(true).redirectOutput(diagnostic.toFile()).start();
+      if (!child.waitFor(45, TimeUnit.SECONDS)) {
+        throw new IllegalStateException("MANAGED_OBSERVER_PROCESS_TIMEOUT");
+      }
+      if (child.exitValue() != 0 || Files.size(output) == 0 || Files.size(output) > 4_194_304) {
+        throw new IllegalStateException("MANAGED_OBSERVER_PROVIDER_READ_FAILED");
+      }
+      return mapper.readTree(Files.readString(output));
+    } finally {
+      try {
+        if (child != null && child.isAlive()) {
+          child.destroyForcibly();
+          if (!child.waitFor(10, TimeUnit.SECONDS)) {
+            throw new IllegalStateException("MANAGED_OBSERVER_PROCESS_CLEANUP_FAILED");
+          }
+        }
+      } finally {
+        Files.deleteIfExists(script);
+        Files.deleteIfExists(output);
+        Files.deleteIfExists(diagnostic);
+      }
+    }
+  }
+
+  private static Path privateFile(String suffix) throws Exception {
+    return Files.createTempFile("rio-managed-business-", suffix,
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+  }
+
+  /** Actual remote cleanup remains a required registered provider capability, never a no-op. */
+  @Override
+  public void close() throws Exception {
+    protocol.cleanupAndCertifyOwnedResources(channels);
+  }
+}
