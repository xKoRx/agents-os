+  /** Sticky unknown is forced into CP before its existing close/delete path may execute. */
+  public synchronized void markUnknown(String why) throws Exception {
+    if (!why.matches("[A-Z0-9_]{1,96}")) { why = "UNVERIFIED_LIFECYCLE_FAILURE"; }
+    unknown = true;
+    gated = false;
+    phase = "UNKNOWN";
+    reason = why;
+    Throwable failure = null;
+    try { persist(); } catch (Exception error) { failure = error; }
+    try { fixture.retainUnverifiedPlaymakerWork(); }
+    catch (Exception | AssertionError error) { failure = accumulate(failure, error); }
+    try { control("UNKNOWN", why); } catch (Exception error) { failure = accumulate(failure, error); }
+    rethrow(failure);
+  }
