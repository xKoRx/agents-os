+      var one = requests.submit(() -> { start.await(); return first.postJson("/triggers/actions", json); });
+      var two = requests.submit(() -> { start.await(); return second.postJson("/triggers/actions", json); });
+      start.countDown();
+      assertEquals(200, one.get().statusCode());
+      assertEquals(200, two.get().statusCode());
+      assertEquals("COMPLETED", fixture.awaitAction(trigger.actionId()).path("status").asString());
+      fixture.awaitKvs("action:" + trigger.actionId(), "COMPLETED");
