+  /** Closes the actual CP fixture before granting any destructive PM/SQL permission. */
+  public CleanupPermit cleanupPermit() throws Exception {
+    try {
+      assertPermitPreconditions();
+      fixture.close();
+      controlplaneClosed = true;
+      assertPermitPreconditions();
+      phase = "CLEANING";
+      reason = "CONTROLPLANE_CLEANUP_VERIFIED";
+      persist();
+      return new CleanupPermit(this);
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("CONTROLPLANE_OR_PERMIT_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  private synchronized void assertPermit(FixtureIdentity expected) throws Exception {
+    try {
+      if (!identity.equals(expected) || !controlplaneClosed) { throw failure("PERMIT_NOT_EXACT_GENERATION"); }
+      assertPermitPreconditions();
+      persist(); // Durable intent before each caller's actual destructive operation.
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("CLEANUP_PERMIT_INVALIDATED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  private void assertPermitPreconditions() throws Exception {
+    if (unknown || !stopped || !gated || finished) { throw failure("CLEANUP_NOT_AUTHORIZED"); }
+    assertProcessAbsent();
+    verifyLease(false);
+    if (!frozenTails.equals(observeStoppedOffsets())) { throw failure("LATE_RESULT_INVALIDATES_CLEANUP"); }
+    mutationVerifier.verify(identity);
+  }
+
+  /** Observations happen while real observer clients remain open, before independent close. */
+  public void verifyCleanupAbsence() throws Exception {
+    try {
+      assertPermitPreconditions();
+      for (var check : absenceChecks.entrySet()) {
+        check.getValue().verify();
+        completedAbsenceChecks.add(check.getKey());
+        persist();
+      }
+      verifiedAbsence = true;
+      phase = "CLEANED";
+      reason = "ALL_REGISTERED_OWN_ABSENCES_VERIFIED";
+      persist();
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("OWNED_CLEANUP_ABSENCE_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  public synchronized void recordClientsClosed() throws Exception {
+    if (unknown || !verifiedAbsence) { throw failure("CLIENT_CLOSE_RECEIPT_OUT_OF_ORDER"); }
+    clientsClosed = true;
+    persist();
+  }
+
+  public void finishVerifiedCleanup() throws Exception {
+    try {
+      assertPermitPreconditions();
+      if (!verifiedAbsence || !clientsClosed || !controlplaneClosed
+          || !completedAbsenceChecks.equals(absenceChecks.keySet())) { throw failure("FINAL_CLEANUP_INCOMPLETE"); }
+      admin.close(Duration.ofSeconds(10));
+      admin = null;
+      // Keep the journal until guardian retirement is known; a failed handshake is retained.
+      phase = "VERIFIED";
+      reason = "ALL_OWN_RESOURCES_AND_CLIENTS_CLOSED";
+      persist();
+      Path verified = journal.resolveSibling(journal.getFileName() + ".verified");
+      Files.move(journal, verified, StandardCopyOption.ATOMIC_MOVE);
+      forceDirectory(reconciliationDirectory);
+      try {
+        control("RETIRE", fixtureId.toString(), identity.generation().toString());
+      } catch (Exception error) {
+        Files.move(verified, journal, StandardCopyOption.ATOMIC_MOVE);
+        forceDirectory(reconciliationDirectory);
+        throw error;
+      }
+      Files.delete(verified);
+      forceDirectory(reconciliationDirectory);
+      finished = true;
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("FINAL_JOURNAL_RETIREMENT_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
