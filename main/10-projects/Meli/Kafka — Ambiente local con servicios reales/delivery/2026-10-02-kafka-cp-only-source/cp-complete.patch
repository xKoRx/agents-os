+  private JsonNode verifyCleanupChildOutcome(CleanupChildPermit permit, Process child) throws Exception {
+    assertEquals(permit, cleanupChildPermits.get(permit.childJournalId()));
+    assertEquals(child.pid(), cleanupChildPids.get(permit.childJournalId()));
+    assertTrue(!child.isAlive() && child.waitFor(15, TimeUnit.SECONDS), "Exact authorized child must be reaped");
+    assertEquals(12, child.exitValue(), "Only T17's verified failed-cleanup outcome permits reconciliation");
+    Path childJournal = reconciliationDirectory.resolve("retained-" + permit.childJournalId() + ".json");
+    assertTrue(Files.isRegularFile(childJournal, LinkOption.NOFOLLOW_LINKS), "Child outcome journal must exist");
+    assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(childJournal));
+    JsonNode record = mapper.readTree(Files.readString(childJournal));
+    assertEquals(2, record.path("schema_version").asInt());
+    assertEquals(runId, record.path("run_id").asString());
+    assertEquals(permit.childJournalId().toString(), record.path("journal_id").asString());
+    assertEquals(child.pid(), record.path("fixture_pid").asLong());
+    assertEquals(permit, mapper.treeToValue(record.path("parent_permit"), CleanupChildPermit.class));
+    assertEquals("FAILED", record.path("phase").asString());
+    assertEquals("RESOURCE_CLEANUP_FAILED", record.path("reason").asString());
+    assertTrue(record.path("quiescence_verified").asBoolean() && record.path("clients_closed").asBoolean());
+    assertEquals(Set.of(permit.topic()), strings(record.path("declared_topics")));
+    assertEquals(Set.copyOf(permit.keys()), strings(record.path("declared_kvs_keys")));
+    assertEquals(permit.childGroup(), record.path("declared_consumer_group").asString());
+    assertTrue(strings(record.path("consumer_groups")).isEmpty());
+    assertTrue(record.path("worker_pids").isEmpty() && record.path("worker_ports").isEmpty()
+        && record.path("worker_thread_ids").isEmpty() && record.path("authorized_cleanup_children").isEmpty()
+        && record.path("fault_namespaces").isEmpty() && record.path("private_configuration_files").isEmpty()
+        && record.path("owned_private_configuration_files").isEmpty()
+        && record.path("declared_owned_private_configuration_files").isEmpty());
+    assertTrue(Set.of(permit.topic()).containsAll(strings(record.path("topics"))));
+    assertTrue(Set.copyOf(permit.keys()).containsAll(strings(record.path("kvs_keys"))));
+    return record;
+  }
