+    }
+    try { verifyJournal(journal, journalWrite, directoryKey); }
+    catch (Exception | Error failure) {
+      hasUnknownOutcome = true;
+      try { lifecycle.markUnknown("ENTITY_JOURNAL_IDENTITY_UNVERIFIED"); }
+      catch (Exception | Error ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  void cleanupVerified(OwnedPlaymakerLifecycle.CleanupPermit permit) throws Exception {
+    permit.assertValid();
+    assertKnownOutcomes();
+    for (Entity entity : entities) {
+      verifier.verify(inputs);
+      verifyMembership();
+      verifyIdentity(entity);
+      String draft = "/v1/entities/" + entity.id() + "/schemas/JSON_SCHEMA/draft";
+      HttpResponse<String> existing = request("GET", draft, null);
+      if (existing.statusCode() == 200) {
+        persistIntent("DELETE_DRAFT", entity.namespace(), entity.name());
+        permit.assertValid();
+        assertEquals(204, request("DELETE", draft, null).statusCode());
+      } else {
+        assertEquals(404, existing.statusCode());
+      }
+      assertEquals(404, request("GET", draft, null).statusCode());
+      persistIntent("DEACTIVATE_ENTITY", entity.namespace(), entity.name());
+      permit.assertValid();
+      assertEquals(200, request("PATCH", "/v1/entities/" + entity.id() + "/deactivate", null).statusCode());
+      assertEquals("DEACTIVATED", readOk("/v1/entities/" + entity.id()).path("status").asString());
+      assertTrue(revisionNumbers(entity.id()).containsAll(entity.revisions()));
+    }
+    // No DELETE entity or active revision endpoint exists: retain exact IDs/audit, never claim absence.
+    persist("RETAINED_BY_SERVICE_CONTRACT_DEACTIVATED");
+    remoteCleanupVerified = true;
+  }
+
+  void assertRetainedContract() throws Exception {
+    assertKnownOutcomes();
+    if (!remoteCleanupVerified) { throw new IllegalStateException("ENTITY_REMOTE_CLEANUP_NOT_VERIFIED"); }
+    for (Entity entity : entities) {
+      verifyIdentity(entity);
+      assertEquals(404, request("GET", "/v1/entities/" + entity.id() + "/schemas/JSON_SCHEMA/draft", null).statusCode());
+      assertEquals("DEACTIVATED", readOk("/v1/entities/" + entity.id()).path("status").asString());
+      assertTrue(revisionNumbers(entity.id()).containsAll(entity.revisions()));
+    }
+  }
+
+  @Override
+  public void close() {
+    // Closing a client is not cleanup authority. Mutations are only in cleanupVerified with a current T25 permit.
+    http.close();
+  }
+
+  static JsonNode readPrivate(JsonMapper mapper, Path path) throws Exception {
+    validatePrivateFile(path);
+    if (Files.size(path) > MAX_RECEIPT_BYTES) { throw new IllegalStateException("ENTITY_RECEIPT_TOO_LARGE"); }
+    try (var input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) { return mapper.readTree(input); }
+  }
+
+  /** Actual filesystem mechanism only; package scope enables neutral metadata controls without any client. */
+  static JournalWrite writePrivate(Path path, String json, JournalWrite previous, Object directoryKey) throws Exception {
+    verifyJournal(path, previous, directoryKey);
+    Path directory = path.getParent();
+    if (previous == null) {
+      Files.createFile(path, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+      previous = new JournalWrite(attributes(path).fileKey(), sha256(new byte[0]));
+      forceDirectory(directory);
+    }
+    Path staged = Files.createTempFile(directory, ".entity-stage-", ".tmp",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    try {
+      byte[] bytes = (json + "\n").getBytes(StandardCharsets.UTF_8);
+      try (FileChannel channel = FileChannel.open(staged, StandardOpenOption.WRITE, LinkOption.NOFOLLOW_LINKS)) {
+        ByteBuffer buffer = ByteBuffer.wrap(bytes);
+        while (buffer.hasRemaining()) { channel.write(buffer); }
+        channel.force(true);
+      }
+      verifyJournal(path, previous, directoryKey);
+      Files.move(staged, path, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      forceDirectory(directory);
+      validatePrivateFile(path);
+      JournalWrite result = new JournalWrite(attributes(path).fileKey(), sha256(bytes));
+      verifyJournal(path, result, directoryKey);
+      return result;
+    } finally {
+      // Never delete through a replaced directory; the .json marker remains the parent retention gate.
+      if (Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)
+          && java.util.Objects.equals(directoryKey, attributes(directory).fileKey())) { Files.deleteIfExists(staged); }
+    }
+  }
+
+  static void verifyJournal(Path path, JournalWrite previous, Object directoryKey) throws Exception {
+    Path directory = privateDirectory(path.getParent());
+    if (directoryKey == null || !directoryKey.equals(attributes(directory).fileKey())) {
+      throw new IllegalStateException("ENTITY_JOURNAL_DIRECTORY_CHANGED");
+    }
+    if (previous == null) {
+      if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) { throw new IllegalStateException("ENTITY_JOURNAL_ALREADY_EXISTS"); }
+    } else {
+      validatePrivateFile(path);
+      if (!previous.key().equals(attributes(path).fileKey()) || !previous.sha256().equals(sha256(Files.readAllBytes(path)))) {
+        throw new IllegalStateException("ENTITY_JOURNAL_IDENTITY_CHANGED");
+      }
+    }
+  }
+
+  private static void validatePrivateFile(Path path) throws Exception {
+    privateDirectory(path.getParent());
+    if (!path.isAbsolute() || !path.normalize().equals(path) || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS).equals(PosixFilePermissions.fromString("rw-------"))
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).getName().equals(currentOwner())
+        || attributes(path).fileKey() == null) { throw new IllegalStateException("ENTITY_PRIVATE_FILE_UNVERIFIED"); }
+  }
+
+  static Path privateDirectory(Path directory) throws Exception {
+    if (directory == null || !directory.isAbsolute() || !directory.normalize().equals(directory)
+        || !Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(directory, LinkOption.NOFOLLOW_LINKS).equals(PosixFilePermissions.fromString("rwx------"))
+        || !Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS).getName().equals(currentOwner())
+        || attributes(directory).fileKey() == null) { throw new IllegalStateException("ENTITY_PRIVATE_DIRECTORY_UNVERIFIED"); }
+    for (Path ancestor = directory; ancestor != null; ancestor = ancestor.getParent()) {
+      if (Files.isSymbolicLink(ancestor)) { throw new IllegalStateException("ENTITY_PATH_ANCESTOR_SYMLINK"); }
+    }
+    return directory;
+  }
+
+  private static String currentOwner() { return ProcessHandle.current().info().user().orElseThrow(); }
+
+  private static BasicFileAttributes attributes(Path path) throws Exception {
+    return Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+  }
+
+  private static void forceDirectory(Path directory) throws Exception {
+    try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS)) {
+      channel.force(true);
+    }
+  }
+
+  /** Called only after the caller's global lifecycle absence proof; never treats retained service history as absent. */
+  void retireVerifiedEvidence(OwnedPlaymakerLifecycle.CleanupPermit permit) throws Exception {
+    permit.assertValid();
+    assertKnownOutcomes();
+    if (!remoteCleanupVerified) { throw new IllegalStateException("ENTITY_REMOTE_CLEANUP_NOT_VERIFIED"); }
+    try {
+      Path evidence = privateDirectory(journal.getParent().getParent());
+      Path archive = evidence.resolve("verified-entity");
+      if (!Files.exists(archive, LinkOption.NOFOLLOW_LINKS)) {
+        Files.createDirectory(archive, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
+        forceDirectory(evidence);
+      }
+      privateDirectory(archive);
+      verifyJournal(journal, journalWrite, directoryKey);
+      String sourceReceipt = Files.readString(journal, StandardCharsets.UTF_8);
+      if (!sourceReceipt.endsWith("\n")) { throw new IllegalStateException("ENTITY_JOURNAL_ENCODING_CHANGED"); }
+      Path archived = archive.resolve(journal.getFileName());
+      // Exact receipt copy preserves the intent and retained identities; no history is recast as absence.
+      JournalWrite saved = writePrivate(archived, sourceReceipt.substring(0, sourceReceipt.length() - 1),
+          null, attributes(archive).fileKey());
+      verifyJournal(archived, saved, attributes(archive).fileKey());
+      if (!saved.sha256().equals(journalWrite.sha256())) { throw new IllegalStateException("ENTITY_ARCHIVE_COPY_CHANGED"); }
+      verifyJournal(journal, journalWrite, directoryKey);
+      permit.assertValid();
+      Files.delete(journal);
+      forceDirectory(journal.getParent());
+      retired = true;
+    } catch (Exception | Error failure) {
+      hasUnknownOutcome = true;
+      try { lifecycle.markUnknown("ENTITY_EVIDENCE_RETIREMENT_UNVERIFIED"); }
+      catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      try {
+        if (!Files.exists(journal, LinkOption.NOFOLLOW_LINKS)) { journalWrite = null; }
+        persist("ENTITY_EVIDENCE_RETIREMENT_UNVERIFIED");
+      } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  record JournalWrite(Object key, String sha256) { }
+
+  private static String sha256(byte[] bytes) throws Exception {
+    return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+  }
+
+  private static String encoded(String value) {
+    return URLEncoder.encode(value, StandardCharsets.UTF_8);
+  }
+
+  private static String bearer(String token) {
+    return token.startsWith("Bearer ") ? token : "Bearer " + token;
+  }
+
+  static final class Entity {
+    private final String id;
+    private final String name;
+    private final String namespace;
+    private final List<Integer> revisions;
+
+    private Entity(String id, String name, String namespace, List<Integer> revisions) {
+      this.id = id;
+      this.name = name;
+      this.namespace = namespace;
+      this.revisions = new ArrayList<>(revisions);
+    }
+
+    String id() { return id; }
+    String name() { return name; }
+    String namespace() { return namespace; }
+    List<Integer> revisions() { return List.copyOf(revisions); }
+
+    Map<String, Object> relation(String direction, int version) {
+      return Map.of("entityId", id, "direction", direction, "format", "JSON_SCHEMA", "version", version);
+    }
+  }
+}
