+  @ParameterizedTest
+  @ValueSource(strings = {"REST", "ACTION"})
+  void actualEndOffsetsDelayExceedsPeekPollingBudgetWithoutChangingPhysicalOffsets(String family) throws Exception {
+    String topic = fixture.uniqueTopic("rpc_peek_wallclock");
+    fixture.createTopic(topic, 1, (short) 1, Map.of());
+    assertEquals(0, fixture.seed(topic, 0, "wallclock-original", "actual-delayed-read"));
+    TopicPartition partition = new TopicPartition(topic, 0);
+    long before = observer.listOffsets(Map.of(partition, OffsetSpec.latest())).all()
+        .get(20, TimeUnit.SECONDS).get(partition).offset();
+    assertEquals(1, before);
+    faults.arm(requestRule(2, LIST_OFFSETS_VERSION, topic, 0, 1000));
+    long started = System.nanoTime();
+    if ("REST".equals(family)) {
+      try (var requests = Executors.newVirtualThreadPerTaskExecutor()) {
+        var response = requests.submit(() -> child.postJson("/kafka/topic/" + topic
+            + "/peek?offset=LATEST&num_msgs=1&timeout_ms=1000",
+            mapper.writeValueAsString(Map.of("brokers_url", faults.bootstrap()))));
+        try {
+          requireReached(2, LIST_OFFSETS_VERSION);
+          holdBeyondPollingBudget();
+          assertFalse(response.isDone(), "Real endOffsets wait is outside the1000ms poll budget");
+          faults.release();
+          var actual = response.get(20, TimeUnit.SECONDS);
+          assertEquals(200, actual.statusCode());
+          var messages = mapper.readTree(actual.body());
+          assertEquals("wallclock-original", messages.get(0).path("key").asString());
+          assertEquals(0, messages.get(0).path("offset").asLong());
+        } finally {
+          faults.abortHeld();
+        }
+      }
+    } else {
+      var trigger = fixture.action(Map.of("topic_name", topic, "num_msgs", 1, "timeout_ms", 1000,
+          "offset", "LATEST"));
+      assertEquals(200, child.postJson("/triggers/actions", mapper.writeValueAsString(Map.of("msg", trigger))).statusCode());
+      requireReached(2, LIST_OFFSETS_VERSION);
+      fixture.awaitKvs("action:" + trigger.actionId(), "IN_PROGRESS");
+      holdBeyondPollingBudget();
+      fixture.drain(Duration.ofMillis(200));
+      assertEquals(1, fixture.resultsFor(trigger.actionId()).size());
+      assertEquals("STARTED", fixture.resultsFor(trigger.actionId()).getFirst().path("status").asString());
+      faults.release();
+      var completed = fixture.awaitAction(trigger.actionId());
+      assertEquals("COMPLETED", completed.path("status").asString());
+      var messages = completed.path("result").path("messages");
+      assertEquals("wallclock-original", messages.get(0).path("key").asString());
+      assertEquals(0, messages.get(0).path("offset").asLong());
+      fixture.awaitKvs("action:" + trigger.actionId(), "COMPLETED");
+      fixture.assertNoMoreResults(trigger.actionId(), 2, Duration.ofSeconds(1));
+    }
+    assertTrue(Duration.ofNanos(System.nanoTime() - started).toMillis() >= 2500,
+        "Physical ListOffsets delay must exceed the advertised polling budget without pretending it is a total wall-clock deadline");
+    assertEquals(before, observer.listOffsets(Map.of(partition, OffsetSpec.latest())).all()
+        .get(20, TimeUnit.SECONDS).get(partition).offset());
+    Awaitility.await().atMost(Duration.ofSeconds(20)).until(() -> observer.listConsumerGroups().all().get()
+        .stream().noneMatch(group -> group.groupId().startsWith("controlplane-peek-")));
+  }
+
+  private void holdBeyondPollingBudget() {
+    long reached = System.nanoTime();
+    Awaitility.await().atMost(Duration.ofSeconds(5)).pollInterval(Duration.ofMillis(100))
+        .until(() -> Duration.ofNanos(System.nanoTime() - reached).toMillis() >= 2500);
+  }
+
+  private Rule requestRule(int apiKey, int version, String topic, int skip, int hits) {
+    return new Rule(apiKey, version, null, topic, Phase.REQUEST, Action.HOLD, skip, hits, 120);
+  }
+
+  private void requireReached(int apiKey, int version) throws Exception {
+    faults.awaitReached(Duration.ofSeconds(30));
+    var reached = faults.state().path("window").path("last_reached");
+    assertEquals(apiKey, reached.path("api_key").asInt());
+    assertEquals(version, reached.path("api_version").asInt());
+    assertTrue(reached.path("supported").asBoolean());
+    assertEquals(0, faults.state().path("counters").path("schema_parse_errors").asInt());
+  }
+
+  private void dispatch(com.mercadolibre.rio.sdk.events.deployment.DeploymentTriggerMessage trigger) throws Exception {
+    assertEquals(200, child.postJson("/triggers/deployments", mapper.writeValueAsString(Map.of("msg", trigger))).statusCode());
+  }
+
+  private String guardKey(String provider, String id) {
+    return ("gcp-kafka-topic".equals(provider) ? "gcp-deployment:" : "deployment:") + id;
+  }
+
+  private void awaitAbsent(String topic) {
+    Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> !observer.listTopics().names().get().contains(topic));
+  }
+
+  private Path routingFor(String bootstrap) throws Exception {
+    Path path = Files.createTempFile("e2e-owned-protocol-routing-", ".json");
+    try {
+      mapper.writeValue(path.toFile(), Map.of("cloud_provider", Map.of("gcp", Map.of("segmentation",
+          Map.of("legacy", Map.of("clusters", List.of(Map.of("key", "e2e-gcp-default",
+              "component_template_code", "gcp-kafka-topic", "bootstrap_servers", bootstrap,
+              "teams", List.of("all")))))))));
+      return path;
+    } catch (Exception | AssertionError failure) {
+      try {
+        Files.deleteIfExists(path);
+      } catch (Exception cleanupFailure) {
+        failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  @AfterEach
+  void abortEveryHeldRequestAndStopChildBeforeIndependentCleanup() throws Throwable {
+    Throwable failure = null;
+    try { faults.abortHeld(); } catch (Throwable cleanupFailure) { failure = cleanupFailure; }
+    try { if (child != null) { child.close(); child = null; } }
+    catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+    try { if (fixture != null) { fixture.close(); fixture = null; } }
+    catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+    if (failure != null) { throw failure; }
+  }
+
+  @AfterAll
+  void closeClusterResources() throws Throwable {
+    Throwable failure = null;
+    try { if (observer != null) { observer.close(Duration.ofSeconds(5)); } }
+    catch (Throwable cleanupFailure) { failure = cleanupFailure; }
+    boolean retain = true;
+    try { retain = RealE2eFixture.hasRetainedWork(); }
+    catch (Throwable observationFailure) { failure = append(failure, observationFailure); }
+    if (retain) {
+      failure = append(failure, new AssertionError("Durable work journal retains the owned protocol broker/proxy namespace and routing files"));
+    } else {
+      try { if (faults != null) { faults.close(); } }
+      catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+      try { if (proxiedRouting != null) { Files.deleteIfExists(proxiedRouting); } }
+      catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+      try { if (independentRouting != null) { Files.deleteIfExists(independentRouting); } }
+      catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+    }
+    if (failure != null) { throw failure; }
+  }
+
+  private Throwable append(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    first.addSuppressed(next);
+    return first;
+  }
+}
