@@ -0,0 +1,220 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/** Checks productive mutation receipts after startup probes and again after the exact PM process stops. */
+public final class PlaymakerMutationReceiptVerifier implements OwnedPlaymakerLifecycle.MutationReceiptVerifier {
+  private final JsonMapper mapper = JsonMapper.builder().build();
+  private final Path directory;
+  private final Path script;
+  private final Path artifact;
+  private MutationCheckpoint denialBaseline;
+
+  private PlaymakerMutationReceiptVerifier(Path directory, Path script, Path artifact) {
+    this.directory = directory;
+    this.script = script;
+    this.artifact = artifact;
+  }
+
+  /** Creates a fixture-local verifier; missing inputs remain a failed gate. */
+  public static PlaymakerMutationReceiptVerifier fromEnvironment() {
+    String root = System.getProperty("e2e.harness.root");
+    if (root == null || root.isBlank()) {
+      throw unverified();
+    }
+    return new PlaymakerMutationReceiptVerifier(Path.of(required("E2E_KVS_OBSERVATION_DIR")),
+        Path.of(root).resolve("e2e/kvs-mutation-proof.py"),
+        Path.of(required("E2E_PLAYMAKER_ARTIFACT_RECEIPT_FILE")));
+  }
+
+  /** Reads the real generation after probes; this live checkpoint remains provisional. */
+  public MutationCheckpoint checkpoint(OwnedPlaymakerLifecycle.FixtureIdentity identity) throws Exception {
+    checkArtifact(identity);
+    JsonNode state = run("checkpoint", identity, null);
+    return new MutationCheckpoint(identity.runId(), identity.fixtureId(), identity.generation(), state);
+  }
+
+  /** Registers an immutable no-additional-write expectation for the final stopped-generation gate. */
+  public void expectNoMutationsAfter(OwnedPlaymakerLifecycle.FixtureIdentity identity,
+      MutationCheckpoint baseline) throws Exception {
+    requireIdentity(identity, baseline);
+    if (denialBaseline != null) {
+      throw unverified();
+    }
+    denialBaseline = baseline;
+  }
+
+  /** Provides an immediate provisional assertion; final verify must still seal the same generation. */
+  public void assertNoMutations(OwnedPlaymakerLifecycle.FixtureIdentity identity,
+      MutationCheckpoint baseline) throws Exception {
+    requireIdentity(identity, baseline);
+    run("checkpoint", identity, persistBaseline(identity, baseline));
+  }
+
+  /** Verifies stopped process status, productive SDK, both closed clients and any denial delta. */
+  @Override
+  public void verify(OwnedPlaymakerLifecycle.FixtureIdentity identity) throws Exception {
+    checkArtifact(identity);
+    Path baseline = denialBaseline == null ? null : persistBaseline(identity, denialBaseline);
+    JsonNode proof = run("final-pm", identity, baseline);
+    // Backend UNKNOWN/inflight is a cleanup barrier even when HTTP/executor threads are idle.
+    // PID birth prevents a live, reused PID from standing in for a declared CP generation.
+    JsonNode checkpoints = proof.path("cp_checkpoints");
+    if (!checkpoints.isArray() || checkpoints.isEmpty()) { throw unverified(); }
+    for (JsonNode checkpoint : checkpoints) {
+      var currentProcess = ProcessHandle.of(checkpoint.path("pid").longValue());
+      if (currentProcess.isEmpty() || !currentProcess.get().isAlive()) {
+        if (!"PREVIOUS_CP_PROCESS_SEALED_AND_REAPED".equals(checkpoint.path("proof").asText())) { throw unverified(); }
+      } else if (!currentProcess.get().info().startInstant().orElseThrow(PlaymakerMutationReceiptVerifier::unverified)
+          .toString().equals(checkpoint.path("process_start_instant").asText())) { throw unverified(); }
+    }
+  }
+
+  private void checkArtifact(OwnedPlaymakerLifecycle.FixtureIdentity identity) throws Exception {
+    JsonNode receipt = readPrivate(artifact);
+    String mode = System.getProperty("e2e.playmaker.contract.mode", "candidate");
+    String policy = switch (mode) {
+      case "canonical" -> "0c83575c54cb198d238be7d83f3b4d8de27abbc8";
+      case "candidate" -> "7673f4bffc286f0f24d4214938df53c4c5eb9c38";
+      default -> throw unverified();
+    };
+    equal(receipt, "run_id", identity.runId());
+    equal(receipt, "contract_mode", mode);
+    equal(receipt, "policy_source_commit", policy);
+    equal(receipt, "jar_sha256", identity.jarSha256());
+    equal(receipt, "source_commit", identity.sourceCommit());
+    equal(receipt, "source_manifest_sha256", identity.sourceManifestSha256());
+    if (identity.pmPid() <= 0 || identity.pmStartInstant() == null) {
+      throw unverified();
+    }
+  }
+
+  private JsonNode run(String operation, OwnedPlaymakerLifecycle.FixtureIdentity identity,
+      Path baseline) throws Exception {
+    List<String> arguments = new ArrayList<>(List.of("python3", script.toString(), operation,
+        "--directory", directory.toString(), "--run", identity.runId(),
+        "--generation", identity.generation().toString(), "--lease", identity.leasePath().toString()));
+    if (baseline != null) {
+      arguments.addAll(List.of("--baseline", baseline.toString()));
+    }
+    Path reply = Files.createTempFile(identity.leasePath().getParent(), ".mutation-proof-", ".json",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    Process process = new ProcessBuilder(arguments).redirectError(ProcessBuilder.Redirect.DISCARD)
+        .redirectOutput(reply.toFile()).start();
+    byte[] output;
+    try {
+      if (!process.waitFor(Duration.ofSeconds(30).toMillis(), TimeUnit.MILLISECONDS)
+          || process.exitValue() != 0 || Files.size(reply) > 65_536) {
+        throw unverified();
+      }
+      output = Files.readAllBytes(reply);
+    } finally {
+      if (process.isAlive()) {
+        process.destroyForcibly();
+        if (!process.waitFor(10, TimeUnit.SECONDS)) {
+          throw unverified();
+        }
+      }
+      Files.delete(reply);
+    }
+    JsonNode state = mapper.readTree(output);
+    equal(state, "run_id", identity.runId());
+    equal(state, "generation_id", identity.generation().toString());
+    if (state.path("pid").longValue() != identity.pmPid()
+        || !identity.pmStartInstant().toString().equals(state.path("process_start_instant").asText())) {
+      throw unverified();
+    }
+    return state;
+  }
+
+  private Path persistBaseline(OwnedPlaymakerLifecycle.FixtureIdentity identity,
+      MutationCheckpoint baseline) throws Exception {
+    requireIdentity(identity, baseline);
+    Path path = identity.leasePath().getParent().resolve("mutation-baseline-" + identity.fixtureId() + ".json");
+    if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+      if (!readPrivate(path).equals(baseline.state())) {
+        throw unverified();
+      }
+      return path;
+    }
+    byte[] data = mapper.writeValueAsBytes(baseline.state());
+    try (FileChannel channel = FileChannel.open(path,
+        java.util.Set.of(StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE),
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+      ByteBuffer buffer = ByteBuffer.wrap(data);
+      while (buffer.hasRemaining()) {
+        channel.write(buffer);
+      }
+      channel.force(true);
+    }
+    try (FileChannel parent = FileChannel.open(path.getParent(), StandardOpenOption.READ)) {
+      parent.force(true);
+    }
+    return path;
+  }
+
+  private void requireIdentity(OwnedPlaymakerLifecycle.FixtureIdentity identity,
+      MutationCheckpoint baseline) {
+    if (!identity.runId().equals(baseline.runId()) || !identity.fixtureId().equals(baseline.fixtureId())
+        || !identity.generation().equals(baseline.generation())) {
+      throw unverified();
+    }
+  }
+
+  private JsonNode readPrivate(Path path) throws Exception {
+    if (!path.isAbsolute() || Files.isSymbolicLink(path)
+        || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || Files.size(path) > 4_000_000
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).equals(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS))
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rw-------"))) {
+      throw unverified();
+    }
+    for (Path parent = path.getParent(); parent != null; parent = parent.getParent()) {
+      if (Files.isSymbolicLink(parent)) { throw unverified(); }
+    }
+    try (InputStream input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) {
+      return mapper.readTree(input);
+    }
+  }
+
+  private static void equal(JsonNode data, String key, String expected) {
+    if (!data.path(key).isTextual() || !Objects.equals(expected, data.path(key).textValue())) {
+      throw unverified();
+    }
+  }
+
+  private static String required(String name) {
+    String value = System.getenv(name);
+    if (value == null || value.isBlank()) {
+      throw unverified();
+    }
+    return value;
+  }
+
+  private static IllegalStateException unverified() {
+    return new IllegalStateException("PLAYMAKER_MUTATION_RECEIPTS_UNVERIFIED");
+  }
+
+  /** Immutable wire snapshot: it contains only client identity and invocation counts. */
+  public record MutationCheckpoint(String runId, UUID fixtureId, UUID generation, JsonNode state) {
+    public MutationCheckpoint {
+      state = state.deepCopy();
+    }
+    @Override public JsonNode state() { return state.deepCopy(); }
+  }
+}
