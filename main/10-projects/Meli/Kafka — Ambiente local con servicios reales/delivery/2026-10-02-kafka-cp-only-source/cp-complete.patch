+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueClient;
+import com.mercadolibre.rio_controlplane_kafka.config.BigQConfig;
+import com.mercadolibre.rio_controlplane_kafka.deployment.gcp.topic.GcpTopicAdminClientProvider;
+import com.mercadolibre.rio_controlplane_kafka.cloud.CloudProvider;
+import com.mercadolibre.rio_controlplane_kafka.cloud.ClusterConnection;
+import com.mercadolibre.rio_controlplane_kafka.cloud.KafkaConnectionFactory;
+import java.util.Properties;
+import org.apache.kafka.clients.admin.AdminClient;
+import org.apache.kafka.clients.admin.AdminClientConfig;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Profile;
+import tools.jackson.databind.ObjectMapper;
+
+/** Only transport and connection factories vary; all CP business beans remain production code. */
+@Configuration
+@Profile("real-e2e")
+public class RealE2eConfiguration {
+  /** Actual deployment result producer under the production publisher's qualifier. */
+  @Bean(name = BigQConfig.DEPLOYMENT_RESULT_CLIENT, destroyMethod = "close")
+  public BigQueueClient deploymentResultClient(ObjectMapper mapper,
+      @Value("${e2e.bootstrap-servers}") String bootstrap,
+      @Value("${e2e.run-id}") String runId,
+      @Value("${e2e.deployment-result-topic}") String topic) {
+    return new KafkaResultBigQueueClient(bootstrap, topic, runId, mapper);
+  }
+
+  /** Actual action result producer under the production publisher's qualifier. */
+  @Bean(name = BigQConfig.ACTION_RESULT_CLIENT, destroyMethod = "close")
+  public BigQueueClient actionResultClient(ObjectMapper mapper,
+      @Value("${e2e.bootstrap-servers}") String bootstrap,
+      @Value("${e2e.run-id}") String runId,
+      @Value("${e2e.action-result-topic}") String topic) {
+    return new KafkaResultBigQueueClient(bootstrap, topic, runId, mapper);
+  }
+
+  /** Actual plaintext AdminClient for local functional GCP operations, without OAuth claims. */
+  @Bean(destroyMethod = "close")
+  public AdminClient realE2eGcpAdminClient(@Value("${e2e.bootstrap-servers}") String bootstrap) {
+    Properties properties = new Properties();
+    properties.put(AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG, E2eSafety.loopbackBootstrap(bootstrap));
+    properties.put(AdminClientConfig.REQUEST_TIMEOUT_MS_CONFIG, 5_000);
+    properties.put(AdminClientConfig.DEFAULT_API_TIMEOUT_MS_CONFIG, 10_000);
+    return AdminClient.create(properties);
+  }
+
+  /** Rejects routing drift before delegating to the real local AdminClient. */
+  @Bean
+  public GcpTopicAdminClientProvider localGcpAdminClientProvider(AdminClient realE2eGcpAdminClient,
+      @Value("${e2e.bootstrap-servers}") String bootstrap) {
+    return target -> {
+      E2eSafety.loopbackBootstrap(target.bootstrapServers());
+      if (!bootstrap.equals(target.bootstrapServers())) {
+        throw new IllegalArgumentException("REAL_E2E_GCP_ROUTING_MUST_USE_OWNED_CLUSTER");
+      }
+      return realE2eGcpAdminClient;
+    };
+  }
+  /** Uses the same GCP action factory seam with the explicitly owned plaintext local cluster. */
+  @Bean
+  public KafkaConnectionFactory realE2eGcpConnectionFactory(
+      @Value("${e2e.bootstrap-servers}") String bootstrap) {
+    return new KafkaConnectionFactory() {
+      @Override
+      public CloudProvider provider() {
+        return CloudProvider.GCP_KAFKA;
+      }
+
+      @Override
+      public ClusterConnection connect(String bootstrapServers) {
+        E2eSafety.loopbackBootstrap(bootstrapServers);
+        if (!bootstrap.equals(bootstrapServers)) {
+          throw new IllegalArgumentException("REAL_E2E_GCP_ROUTING_MUST_USE_OWNED_CLUSTER");
+        }
+        return ClusterConnection.plaintext(bootstrapServers);
+      }
+    };
+  }
+}
