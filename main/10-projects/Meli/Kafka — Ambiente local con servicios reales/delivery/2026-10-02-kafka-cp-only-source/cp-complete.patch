--- /dev/null
+++ b/e2e/kvs-mutation-proof.py
@@ -0,0 +1,313 @@
+#!/usr/bin/env python3
+"""Verify real-e2e API-call receipts; no backend, state or business result is simulated."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+from owned_test_worker_proof import require_task_completion, require_worker_generation
+import re
+import stat
+import sys
+import uuid
+
+SDK = {
+ "CP": ("1.0.5", "2d8fd088e939462480a22febaefd295cefa68623e034c33dea348061f6dc89db",
+        "d1ce59cc46bd3219e12a1d0f84bad27347ee01d3223d728f2f744a1fcc554948",
+        "aabd8913aad6107f92362d5a3bfefff8b5b6cafa4a1ac8fd97d134dc2ab5aa8b",
+        ["idempotencyKvsClient"]),
+ "PM": ("0.7.4", "af33eb9cf9a8d23c122dcad95222e0333370d8f6c8d4ac0eb6d1c4850e88d778",
+        "59038805699425c0b33875ce68ab0c1a1acab94ce456b7906ac6c0cf75159c6a",
+        "ede3ead89f8cdbad4c2e309c710a2337ccc9c0d2f422fbe27e8d2900e3c3805f",
+        ["actionResultKvsClient", "actionLockKvsClient"])}
+COUNTERS = {a + "_" + b for a in ("SAVE", "UPDATE", "DELETE", "BATCH_WRITE", "BULK_WRITE")
+            for b in ("SYNC", "ASYNC")}
+
+
+def fail(code):
+    raise RuntimeError("KVS_MUTATION_PROOF_UNVERIFIED:" + code)
+
+
+def read(path):
+    if not path.is_absolute() or path.is_symlink() or not path.is_file() \
+            or path.stat().st_uid != os.getuid() or stat.S_IMODE(path.stat().st_mode) != 0o600 \
+            or path.stat().st_size > 1_000_000:
+        fail("PRIVATE_FILE")
+    for parent in path.parents:
+        if parent.is_symlink():
+            fail("SYMLINK")
+    with path.open("rb") as stream:
+        raw = stream.read()
+    return json.loads(raw), hashlib.sha256(raw).hexdigest()
+
+
+def alive(pid):
+    if type(pid) is not int or pid <= 0:
+        fail("PID")
+    try:
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        fail("PID_VISIBILITY")
+
+
+def require(condition, code):
+    if not condition:
+        fail(code)
+
+
+def snapshot(directory, run, generation, app, final, lease=None):
+    version, sdksha, apisha, delegatesha, clients = SDK[app]
+    manifest, _ = read(directory / ("kvs-expected-" + generation + ".json"))
+    require(manifest.get("schema_version") == 1 and manifest.get("kind") == "KVS_EXPECTED_CLIENTS"
+            and manifest.get("run_id") == run and manifest.get("application") == app
+            and manifest.get("generation_id") == generation and manifest.get("clients") == clients
+            and manifest.get("sdk_version") == version
+            and manifest.get("phase") == "DECLARED_BEFORE_CLIENTS", "EXPECTED_MANIFEST")
+    if lease is not None:
+        require(manifest.get("pid") == lease.get("pm_pid")
+                and manifest.get("process_start_instant") == lease.get("pm_start")
+                and manifest.get("source_commit") == lease.get("source_commit")
+                and manifest.get("source_manifest_sha256") == lease.get("source_manifest_sha256"), "LEASE_MANIFEST")
+    receipts = {}
+    for client in clients:
+        receipt, digest = read(directory / ("kvs-mutations-" + generation + "-" + client + ".json"))
+        require(receipt.get("schema_version") == 1 and receipt.get("run_id") == run
+                and receipt.get("application") == app and receipt.get("client_name") == client
+                and receipt.get("generation_id") == generation
+                and receipt.get("pid") == manifest.get("pid")
+                and receipt.get("process_start_instant") == manifest.get("process_start_instant"), "RECEIPT_IDENTITY")
+        uuid.UUID(receipt["receipt_id"])
+        sdk = receipt.get("sdk", {})
+        require(sdk.get("version") == version and sdk.get("jar_sha256") == sdksha
+                and sdk.get("interface_sha256") == apisha and sdk.get("delegate_sha256") == delegatesha
+                and sdk.get("delegate_class") == "com.fury.toolkit.kvs.DefaultKvsClient"
+                and sdk.get("interface_origin") == sdk.get("delegate_origin")
+                and ("java-toolkit-kvs-" + version + ".jar") in sdk.get("interface_origin", ""), "PRODUCTIVE_SDK")
+        require(receipt.get("healthy") is True and receipt.get("unknown_reasons") == []
+                and receipt.get("inflight") == 0 and receipt.get("pending_sequences") == [], "UNKNOWN_OR_PENDING")
+        counts = receipt.get("attempt_counts", {})
+        require(set(counts) == COUNTERS and all(type(v) is int and v >= 0 for v in counts.values())
+                and type(receipt.get("attempt_count")) is int
+                and sum(counts.values()) == receipt.get("attempt_count")
+                and receipt.get("completed_count") == receipt.get("attempt_count"), "COUNTERS")
+        require(type(receipt.get("sequence")) is int and receipt["sequence"] >= receipt["attempt_count"], "SEQUENCE")
+        if final:
+            require(receipt.get("phase") == "SEALED" and receipt.get("delegate_closed") is True
+                    and receipt.get("close_started") is True, "CLOSE_NOT_SEALED")
+            ack, _ = read(directory / ("kvs-close-ack-" + generation + "-" + client + ".json"))
+            require(ack.get("schema_version") == 1 and ack.get("kind") == "KVS_SUCCESSFUL_CLOSE_ACK"
+                    and ack.get("run_id") == run and ack.get("application") == app
+                    and ack.get("client_name") == client and ack.get("generation_id") == generation
+                    and ack.get("pid") == manifest.get("pid")
+                    and ack.get("process_start_instant") == manifest.get("process_start_instant")
+                    and ack.get("receipt_id") == receipt.get("receipt_id")
+                    and ack.get("sequence") == receipt.get("sequence")
+                    and ack.get("receipt_sha256") == digest, "CLOSE_ACK")
+        else:
+            require(receipt.get("phase") == "OPEN" and receipt.get("delegate_closed") is False, "LIVE_PHASE")
+        receipts[client] = {"receipt_id": receipt["receipt_id"], "sequence": receipt["sequence"],
+                            "attempt_count": receipt["attempt_count"], "attempt_counts": counts}
+    return {"schema_version": 1, "run_id": run, "generation_id": generation,
+            "application": app, "pid": manifest["pid"],
+            "process_start_instant": manifest["process_start_instant"], "clients": receipts,
+            "proof": "FINAL_SEALED_WITH_CLOSE_ACK" if final else "PROVISIONAL_LIVE_CHECKPOINT"}
+
+
+
+def exact_inventory(directory, registered, final):
+    mandatory = {"expected-generations.json", ".generation-registry.lock"}
+    optional = set()
+    for manifest in registered:
+        generation = manifest.get("generation_id", "")
+        uuid.UUID(generation)
+        app = manifest.get("application")
+        require(app in SDK, "REGISTERED_APPLICATION")
+        mandatory.add("kvs-expected-" + generation + ".json")
+        for client in SDK[app][4]:
+            mandatory.add("kvs-mutations-" + generation + "-" + client + ".json")
+            ack = "kvs-close-ack-" + generation + "-" + client + ".json"
+            if final:
+                mandatory.add(ack)
+            else:
+                optional.add(ack)
+    lock = directory / ".generation-registry.lock"
+    require(lock.is_file() and not lock.is_symlink() and lock.stat().st_uid == os.getuid()
+            and stat.S_IMODE(lock.stat().st_mode) == 0o600 and lock.stat().st_size == 0, "PRIVATE_REGISTRY_LOCK")
+    actual = {entry.name for entry in directory.iterdir()}
+    require(mandatory <= actual and actual <= mandatory | optional, "EXACT_FILE_INVENTORY")
+    # A registered manifest cannot be silently replaced, omitted, or newly reconstructed.
+    for declared in registered:
+        manifest, _ = read(directory / ("kvs-expected-" + declared["generation_id"] + ".json"))
+        require(manifest == declared, "EXPECTED_REGISTRY_MANIFEST_BINDING")
+
+
+
+def require_exit_record(record, manifest, run):
+    require(record.get("schema_version") == 1 and record.get("kind") == "OWNED_GENERATION_PROCESS_EXIT"
+            and record.get("run_id") == run, "OWNED_PROCESS_EXIT_KIND")
+    for key in ("generation_id", "application", "pid", "process_start_instant", "process_owner_pid",
+                "process_owner_start_instant", "process_owner_kind"):
+        require(record.get(key) == manifest.get(key), "ACTUAL_EXIT_OWNER_BINDING")
+    require(record.get("healthy") is True and record.get("unknown_reasons") == []
+            and record.get("forced_stop") is False and record.get("exit_status") in (0, 143)
+            and (record["exit_status"] == 0 or record.get("stop_requested") is True), "ACTUAL_EXIT_HEALTH")
+    if manifest.get("application") == "CP":
+        require(record.get("child_mode") in ("PRODUCTIVE_CP", "PRODUCTIVE_CP_CONTEXT"), "PRODUCTIVE_CP_EXIT_REQUIRED")
+    else:
+        require(record.get("child_mode") == "PRODUCTIVE_PM", "PRODUCTIVE_PM_EXIT_REQUIRED")
+    require(manifest.get("process_owner_kind") in ("DIRECT_PROCESS_WAIT", "GRADLE_TEST_WORKER_NORMAL_EXIT"), "KNOWN_PROCESS_OWNER_REQUIRED")
+    proof = "ACTUAL_PROCESS_WAIT_FOR" if manifest.get("process_owner_kind") == "DIRECT_PROCESS_WAIT" else \
+        "PINNED_GRADLE_TEST_WORKER_WAIT_FOR_STOP_NORMAL_EXIT"
+    require(record.get("exit_proof") == proof, "ACTUAL_EXIT_OWNER_PROOF")
+
+def cp_checkpoints(directory, run, registered):
+    """Provisional only. All expected CP clients must be healthy before any fixture deletion."""
+    manifests = [entry for entry in registered if entry.get("application") == "CP"]
+    require(bool(manifests), "CP_GENERATION_REQUIRED")
+    states = []
+    for manifest in manifests:
+        generation = manifest["generation_id"]
+        receipt, _ = read(directory / ("kvs-mutations-" + generation + "-" + SDK["CP"][4][0] + ".json"))
+        sealed = receipt.get("phase") == "SEALED"
+        state = snapshot(directory, run, generation, "CP", sealed)
+        if not alive(manifest.get("pid")):
+            # A previously stopped worker needs its exact owner's waitFor record, never a PID guess.
+            require(sealed, "CP_PROCESS_RECONCILIATION_REQUIRED")
+            exit_directory = os.environ.get("E2E_PROCESS_EXIT_DIR")
+            require(bool(exit_directory), "CP_ACTUAL_EXIT_DIRECTORY_REQUIRED")
+            record, _ = read(Path(exit_directory) / ("process-exit-" + generation + ".json"))
+            require_exit_record(record, manifest, run)
+            state["proof"] = "PREVIOUS_CP_PROCESS_SEALED_AND_REAPED"
+        elif sealed:
+            # Cached Spring contexts may close while the same actual JUnit process remains alive.
+            state["proof"] = "PREVIOUS_CONTEXT_CLIENTS_ALREADY_SEALED"
+        states.append(state)
+    return states
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("operation", choices=("init", "checkpoint", "cp-checkpoint", "final-pm", "all-final"))
+    parser.add_argument("--directory", required=True, type=Path)
+    parser.add_argument("--run", required=True)
+    parser.add_argument("--generation")
+    parser.add_argument("--lease", type=Path)
+    parser.add_argument("--baseline", type=Path)
+    parser.add_argument("--process-exits", type=Path)
+    args = parser.parse_args()
+    directory = args.directory
+    require(directory.is_absolute() and directory.is_dir() and not directory.is_symlink()
+            and stat.S_IMODE(directory.stat().st_mode) == 0o700 and directory.stat().st_uid == os.getuid(), "PRIVATE_DIRECTORY")
+    require(re.fullmatch(r"[a-z0-9][a-z0-9_-]{7,63}", args.run) is not None, "RUN")
+    registry_path = directory / "expected-generations.json"
+    if args.operation == "init":
+        data = {"schema_version": 1, "kind": "KVS_EXPECTED_GENERATION_REGISTRY", "run_id": args.run,
+                "phase": "DECLARED_BEFORE_APPLICATIONS", "generations": []}
+        for name, raw in [("expected-generations.json", json.dumps(data).encode()), (".generation-registry.lock", b"")]:
+            descriptor = os.open(directory / name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
+            try:
+                with os.fdopen(os.dup(descriptor), "wb", closefd=True) as stream:
+                    stream.write(raw)
+                    stream.flush()
+                os.fsync(descriptor)
+            finally:
+                os.close(descriptor)
+        descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        print("REGISTRY_PREPARED_ONLY")
+        return
+    registry, _ = read(registry_path)
+    require(registry.get("schema_version") == 1 and registry.get("kind") == "KVS_EXPECTED_GENERATION_REGISTRY"
+            and registry.get("run_id") == args.run
+            and registry.get("phase") == "DECLARED_BEFORE_APPLICATIONS", "EXPECTED_REGISTRY")
+    registered = registry.get("generations", [])
+    registered_ids = [entry.get("generation_id") for entry in registered]
+    require(bool(registered_ids) and len(registered_ids) == len(set(registered_ids)), "EXPECTED_REGISTRY_IDS")
+    exact_inventory(directory, registered, args.operation == "all-final")
+    if args.operation == "cp-checkpoint":
+        print(json.dumps({"proof": "PROVISIONAL_ALL_CP_CLIENTS_HEALTHY", "run_id": args.run,
+                          "generations": cp_checkpoints(directory, args.run, registered)}, separators=(",", ":")))
+        return
+    if args.operation == "all-final":
+        require(args.process_exits is not None, "ACTUAL_PROCESS_EXIT_RECEIPTS_REQUIRED")
+        exits, _ = read(args.process_exits)
+        require(type(exits.get("schema_version")) is int and exits["schema_version"] == 1
+                and exits.get("kind") == "ALL_OWNED_GENERATION_EXITS" and exits.get("run_id") == args.run,
+                "TYPED_PROCESS_EXIT_SUMMARY_REQUIRED")
+        require(type(exits.get("test_command_exit_status")) is int and exits["test_command_exit_status"] == 0
+                and type(exits.get("owner_control_exit_status")) is int and exits["owner_control_exit_status"] == 0,
+                "TEST_OR_OWNER_COMMAND_FAILURE")
+        task = require_task_completion(exits.get("test_task_completion"), args.run)
+        manifests = sorted(directory.glob("kvs-expected-*.json"))
+        require(bool(manifests), "MISSING_MANIFESTS")
+        declared = exits.get("generations", [])
+        expected_ids = [entry.get("generation_id") for entry in declared]
+        actual_ids = [read(path)[0].get("generation_id") for path in manifests]
+        require(len(expected_ids) == len(set(expected_ids)) and set(expected_ids) == set(actual_ids)
+                and set(actual_ids) == set(registered_ids)
+                and len(actual_ids) == len(set(actual_ids)), "EXPECTED_GENERATION_SET_MISMATCH")
+        for path in manifests:
+            manifest, _ = read(path)
+            require(next((entry for entry in registered if entry.get("generation_id") == manifest.get("generation_id")), None)
+                    == manifest, "EXPECTED_REGISTRY_MANIFEST_BINDING")
+        result = []
+        for path in manifests:
+            manifest, _ = read(path)
+            generation = manifest.get("generation_id", "")
+            uuid.UUID(generation)
+            process = next((entry for entry in exits.get("generations", []) if entry.get("generation_id") == generation), None)
+            require(process is not None, "ACTUAL_GENERATION_EXIT_REQUIRED")
+            require_exit_record(process, manifest, args.run)
+            if manifest.get("process_owner_kind") == "GRADLE_TEST_WORKER_NORMAL_EXIT":
+                require_worker_generation(manifest, process, task)
+            require(process.get("pid") == manifest.get("pid")
+                    and process.get("process_start_instant") == manifest.get("process_start_instant")
+                    and process.get("exit_status") in (0, 143) and process.get("forced_stop") is False
+                    and (process["exit_status"] == 0 or process.get("stop_requested") is True)
+                    and not alive(manifest.get("pid")), "ACTUAL_GENERATION_EXIT_REQUIRED")
+            result.append(snapshot(directory, args.run, generation, manifest["application"], True))
+        print(json.dumps({"proof": "ALL_EXPECTED_GENERATIONS_SEALED", "generations": result}, separators=(",", ":")))
+        return
+    require(args.generation is not None and args.lease is not None, "LEASE_REQUIRED")
+    uuid.UUID(args.generation)
+    manifest, _ = read(directory / ("kvs-expected-" + args.generation + ".json"))
+    require(next((entry for entry in registered if entry.get("generation_id") == args.generation), None)
+            == manifest, "EXPECTED_REGISTRY_MANIFEST_BINDING")
+    lease, _ = read(args.lease)
+    require(lease.get("schema_version") == 1 and lease.get("kind") == "PLAYMAKER_PROCESS_LEASE"
+            and lease.get("run_id") == args.run and lease.get("generation") == args.generation
+            and lease.get("consumer_group") == "e2e_" + args.run + "_playmaker_results", "LEASE")
+    final = args.operation == "final-pm"
+    if final:
+        require(lease.get("phase") == "STOPPED" and lease.get("exit_status") in (0, 143)
+                and lease.get("forced_stop") is False
+                and (lease["exit_status"] == 0 or lease.get("stop_requested") is True)
+                and not alive(lease.get("pm_pid")), "ACTUAL_STOP_REQUIRED")
+    else:
+        require(lease.get("phase") == "READY" and alive(lease.get("pm_pid")), "LIVE_PROCESS")
+    state = snapshot(directory, args.run, args.generation, "PM", final, lease)
+    if final:
+        state["cp_checkpoints"] = cp_checkpoints(directory, args.run, registered)
+    if args.baseline:
+        baseline, _ = read(args.baseline)
+        require(all(baseline.get(k) == state.get(k) for k in ("run_id", "generation_id", "application", "pid", "process_start_instant")), "BASELINE_IDENTITY")
+        for name, client in state["clients"].items():
+            before = baseline.get("clients", {}).get(name, {})
+            require(before.get("receipt_id") == client["receipt_id"]
+                    and before.get("attempt_count") == client["attempt_count"]
+                    and before.get("attempt_counts") == client["attempt_counts"], "DENIAL_MUTATION_OBSERVED")
+    print(json.dumps(state, separators=(",", ":")))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
+        code = str(error) if isinstance(error, RuntimeError) else "KVS_MUTATION_PROOF_UNVERIFIED:INVALID"
+        print(code, file=sys.stderr)
+        raise SystemExit(2)
