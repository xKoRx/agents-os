+  @Test
+  void actualCrashAfterBrokerAcceptedActionBeforeFinalizeCanDuplicateOnStaleRecovery() throws Exception {
+    Workflow flow = workflow("ACTION");
+    try (ToolkitSandboxFaults faults = ToolkitSandboxFaults.openResolved()) {
+      try (RealControlplaneProcess child = RealControlplaneProcess.start(fixture, faults.childEnvironment())) {
+        faults.write().arm(new Rule("PUT", flow.id(), "COMPLETED", Phase.REQUEST, Action.HOLD));
+        assertEquals(200, child.postJson(flow.path(), flow.json()).statusCode());
+        faults.write().awaitReached(WINDOW_DEADLINE);
+        assertPhysicalSuccess(flow);
+        JsonNode pending = mapper.readTree(kvs.get(flow.key()).getValue());
+        assertEquals("IN_PROGRESS", pending.path("state").asString());
+        assertEquals("PUBLISH_PENDING", pending.path("outcome_code").asString());
+        child.crash();
+        faults.write().abortHeld();
+      }
+      Item<byte[]> afterCrash = kvs.get(flow.key());
+      assertEquals("PUBLISH_PENDING", mapper.readTree(afterCrash.getValue()).path("outcome_code").asString(),
+          "Aborting held requests must prevent any late terminal CAS after the worker is dead");
+      kvs.update(Item.builder(flow.key(), mapper.writeValueAsBytes(TriggerStatusRecord.publishPending(
+          System.currentTimeMillis() - Duration.ofMinutes(2).toMillis())))
+          .withVersion(afterCrash.getVersion()).withTtl(120).build());
+      // A new pass-through window clears the old hold and cannot revive its aborted requests.
+      faults.write().arm(new Rule("PUT", "no_matching_run_key", "", Phase.REQUEST, Action.RESET));
+      try (RealControlplaneProcess restarted = RealControlplaneProcess.start(fixture, faults.childEnvironment())) {
+        assertEquals(200, restarted.postJson(flow.path(), flow.json()).statusCode());
+        Awaitility.await().atMost(Duration.ofSeconds(90)).until(() -> {
+          fixture.drain(Duration.ofMillis(200));
+          return fixture.resultsFor(flow.id()).stream().filter(event -> "COMPLETED".equals(event.path("status").asString())).count() == 2;
+        });
+        fixture.awaitKvs(flow.key(), "COMPLETED");
+        assertEquals(2, fixture.resultsFor(flow.id()).stream().filter(event -> "COMPLETED".equals(event.path("status").asString())).count(),
+            "The explicit publish-before-finalize action contract permits duplicate delivery after this physical crash window");
+        assertEquals(2, fixture.resultsFor(flow.id()).stream().filter(event -> "STARTED".equals(event.path("status").asString())).count());
+        fixture.assertNoMoreResults(flow.id(), 4, Duration.ofSeconds(1));
+      }
+    }
+  }
