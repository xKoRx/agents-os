+++ b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/ToolkitSandboxFaults.java
@@ -0,0 +1,141 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import com.fury.toolkit.shared.SegmentationUtils;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsClientFactory;
+import java.net.URI;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Locale;
+import java.util.Map;
+
+/** Owns network proxies and a fresh SCP artifact directory for one CP child using normal Toolkit exports. */
+public final class ToolkitSandboxFaults implements AutoCloseable {
+  private final RealHttpFaultProxy read;
+  private final RealHttpFaultProxy write;
+  private final Path artifacts;
+  private final Map<String, String> environment;
+
+  private ToolkitSandboxFaults(RealHttpFaultProxy read, RealHttpFaultProxy write, Path artifacts,
+      Map<String, String> environment) {
+    this.read = read;
+    this.write = write;
+    this.artifacts = artifacts;
+    this.environment = Map.copyOf(environment);
+  }
+
+  /** Resolves the exact generated prefix with the same audited Toolkit v1/v2 alias/segment contract. */
+  public static ToolkitSandboxFaults openResolved() throws Exception {
+    final String container = requireExport("E2E_KVS_CONTAINER_NAME");
+    final String segment = System.getenv().getOrDefault("E2E_KVS_SEGMENT_ID", "");
+    RealE2eKvsClientFactory.requireSandboxMapping(container, segment);
+    final String alias = container.split("__", 2)[0].replace('-', '_').replace('.', '_').toUpperCase(Locale.ROOT);
+    final String base = "KEY_VALUE_STORE_" + alias;
+    final String effectiveSegment = segment.isBlank() ? SegmentationUtils.getSegmentId() : segment;
+    final String versionPrefix = SegmentationUtils.isDefaultSegment(effectiveSegment)
+        ? base : base + "_" + effectiveSegment.toUpperCase(Locale.ROOT);
+    final String prefix = "v2".equals(System.getenv(versionPrefix + "_SEGMENTATION_VERSION"))
+        ? base + "_" + effectiveSegment.toUpperCase(Locale.ROOT) : base;
+    return open(prefix);
+  }
+
+  /** Uses the exact generated v1/v2 export prefix whose CONTAINER_NAME is an actual sbox container. */
+  public static ToolkitSandboxFaults open(String generatedPrefix) throws Exception {
+    if (generatedPrefix == null || !generatedPrefix.matches("KEY_VALUE_STORE_[A-Z0-9_]{1,200}")) {
+      throw new IllegalArgumentException("GENERATED_TOOLKIT_SANDBOX_PREFIX_REQUIRED");
+    }
+    requireExport("E2E_SANDBOX_BC");
+    requireExport("E2E_SANDBOX_INSTANCE");
+    final String physical = requireExport(generatedPrefix + "_CONTAINER_NAME");
+    final String readExport = generatedPrefix + "_END_POINT_READ";
+    final String writeExport = generatedPrefix + "_END_POINT_WRITE";
+    final URI readUpstream = parseEndpoint(requireExport(readExport));
+    final URI writeUpstream = parseEndpoint(requireExport(writeExport));
+    final Path artifacts = Files.createTempDirectory("e2e-kvs-child-artifacts-",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
+    final RealHttpFaultProxy read;
+    try {
+      read = RealHttpFaultProxy.startKvs(readUpstream, physical);
+    } catch (Exception | AssertionError failure) {
+      Files.deleteIfExists(artifacts);
+      throw failure;
+    }
+    try {
+      final RealHttpFaultProxy write = RealHttpFaultProxy.startKvs(writeUpstream, physical);
+      return new ToolkitSandboxFaults(read, write, artifacts, Map.of(readExport, read.address().toString(),
+          writeExport, write.address().toString(), "ARTIFACT_DELIVERY_FILE_PREFIX", artifacts.toString()));
+    } catch (Exception | AssertionError failure) {
+      try {
+        read.close();
+        Files.deleteIfExists(artifacts);
+      } catch (Exception cleanupFailure) {
+        failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  /** Returns only child-specific overrides; pass to RealControlplaneProcess.start(environment, properties). */
+  public Map<String, String> childEnvironment() {
+    return environment;
+  }
+
+  /** GET faults use the exact decoded /containers/sbox/namespace:key path. */
+  public RealHttpFaultProxy read() {
+    return read;
+  }
+
+  /** SAVE is POST with key/value; CAS is PUT with x-kvs-versions/x-kvs-ttls passed unchanged. */
+  public RealHttpFaultProxy write() {
+    return write;
+  }
+
+  private static URI parseEndpoint(String endpoint) {
+    try {
+      return URI.create(endpoint);
+    } catch (IllegalArgumentException failure) {
+      // URI parser exception text can echo configuration; never attach it to diagnostics.
+      throw new IllegalStateException("GENERATED_SANDBOX_ENDPOINT_INVALID");
+    }
+  }
+
+  private static String requireExport(String name) {
+    final String value = System.getenv(name);
+    if (value == null || value.isBlank()) {
+      throw new IllegalStateException("GENERATED_SANDBOX_FAULT_EXPORT_REQUIRED: " + name);
+    }
+    return value;
+  }
+
+  /** Reaps both proxies and removes only this empty owned SCP directory, propagating all cleanup failures. */
+  @Override
+  public void close() throws Exception {
+    Exception failure = null;
+    try {
+      read.close();
+    } catch (Exception cleanupFailure) {
+      failure = cleanupFailure;
+    }
+    try {
+      write.close();
+    } catch (Exception cleanupFailure) {
+      if (failure == null) {
+        failure = cleanupFailure;
+      } else {
+        failure.addSuppressed(cleanupFailure);
+      }
+    }
+    try {
+      Files.deleteIfExists(artifacts);
+    } catch (Exception cleanupFailure) {
+      if (failure == null) {
+        failure = cleanupFailure;
+      } else {
+        failure.addSuppressed(cleanupFailure);
+      }
+    }
+    if (failure != null) {
+      throw failure;
+    }
+  }
+}
