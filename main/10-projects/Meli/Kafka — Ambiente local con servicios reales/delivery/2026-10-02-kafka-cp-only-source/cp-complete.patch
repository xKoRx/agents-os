+  /** Declarative PM params and an actual own Kafka input; no PM/CP terminal or output is seeded. */
+  private PhysicalInputs seedPhysicalInputs(PlaymakerPipelineFixture.Topology topology) throws Exception {
+    try {
+      Map<String, Object> params = new LinkedHashMap<>(fixture.mapper().convertValue(
+          fixture.database().active(topology.kafka()).params(), Map.class));
+      params.put("retention_ms", 86_400_000L);
+      assertEquals(200, fixture.config(topology.kafka(), topology.environment(), params).statusCode());
+      JsonNode persisted = fixture.database().active(topology.kafka()).params();
+      assertEquals(86_400_000L, persisted.path("retention_ms").asLong(), "Actual admitted SQL input must retain retention");
+      assertFalse(fixture.cp().admin().listTopics().names().get(30, TimeUnit.SECONDS).contains(topology.topic()),
+          "Do not adopt an existing Kafka input even inside this own namespace");
+      fixture.cp().createTopic(topology.topic(), 2, (short) 2, Map.of("retention.ms", "86400000"));
+      KafkaInputs actual = kafkaInputs(topology.topic());
+      assertEquals(2, actual.partitions().size());
+      assertTrue(actual.partitions().stream().allMatch(partition -> partition.replicas().size() == 2));
+      assertEquals("86400000", actual.configs().get("retention.ms"));
+      return new PhysicalInputs(nonEntityParams(persisted), actual);
+    } catch (Exception | Error failure) {
+      // Any failed PM/SQL/Kafka seed mutation or observation must retain the owned lifecycle before teardown.
+      try { fixture.lifecycle().markUnknown("OWN_PHYSICAL_INPUT_SEED_OR_ORACLE_UNKNOWN"); }
+      catch (Exception | Error ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
