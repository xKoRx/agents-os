+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/** Executes Docker commands only for an explicitly named, run-owned Compose project. */
+final class OwnedCompose {
+  private static final Duration COMMAND_DEADLINE = Duration.ofMinutes(4);
+  private final String context;
+  private final String project;
+  private final String runId;
+  private final Path composeFile;
+  private final Path environmentFile;
+
+  OwnedCompose(String context, String project, String runId, Path composeFile, Path environmentFile) {
+    if (context == null || !context.matches("[a-zA-Z0-9_-]{1,100}")
+        || runId == null || !runId.matches("[a-z0-9][a-z0-9_-]{7,63}")
+        || project == null || !project.startsWith("rio-kafka-e2e-") || !project.contains(runId)
+        || !project.matches("[a-z0-9_-]{1,160}")) {
+      throw new IllegalArgumentException("EXPLICIT_OWNED_COMPOSE_CONTEXT_AND_PROJECT_REQUIRED");
+    }
+    if (!Files.isRegularFile(composeFile) || !Files.isRegularFile(environmentFile)) {
+      throw new IllegalArgumentException("OWNED_COMPOSE_FILES_REQUIRED");
+    }
+    this.context = context;
+    this.project = project;
+    this.runId = runId;
+    this.composeFile = composeFile.toAbsolutePath();
+    this.environmentFile = environmentFile.toAbsolutePath();
+  }
+
+  String command(String... arguments) throws IOException, InterruptedException {
+    final List<String> command = new ArrayList<>(List.of("docker", "--context", context, "compose",
+        "--project-name", project, "--env-file", environmentFile.toString(), "--file", composeFile.toString()));
+    command.addAll(List.of(arguments));
+    return execute(command);
+  }
+
+  void requireOwnedService(String service) throws IOException, InterruptedException {
+    final String id = command("ps", "--all", "--quiet", service).strip();
+    if (id.isEmpty() || id.lines().count() != 1) {
+      throw new IllegalStateException("EXACT_OWNED_SERVICE_REQUIRED");
+    }
+    final String labels = execute(List.of("docker", "--context", context, "inspect", "--format",
+        "{{index .Config.Labels \"com.docker.compose.project\"}} "
+            + "{{index .Config.Labels \"com.docker.compose.service\"}} "
+            + "{{index .Config.Labels \"io.rio.e2e.owned\"}} {{index .Config.Labels \"io.rio.e2e.run\"}}", id)).strip();
+    if (!labels.equals(project + " " + service + " true " + runId)) {
+      throw new IllegalStateException("COMPOSE_OWNERSHIP_MISMATCH");
+    }
+  }
+
+  void certifyAbsent() throws IOException, InterruptedException {
+    for (String kind : List.of("container", "network", "volume")) {
+      final List<String> arguments = new ArrayList<>(List.of("docker", "--context", context));
+      arguments.addAll(kind.equals("container") ? List.of("ps", "--all", "--quiet") : List.of(kind, "ls", "--quiet"));
+      arguments.addAll(List.of("--filter", "label=com.docker.compose.project=" + project));
+      if (!execute(arguments).isBlank()) {
+        throw new IllegalStateException("OWNED_COMPOSE_CLEANUP_NOT_CERTIFIED");
+      }
+    }
+  }
+
+  private String execute(List<String> command) throws IOException, InterruptedException {
+    final Path output = Files.createTempFile("e2e-owned-docker-", ".log");
+    final Process process = new ProcessBuilder(command).redirectErrorStream(true).redirectOutput(output.toFile()).start();
+    try {
+      if (!process.waitFor(COMMAND_DEADLINE.toSeconds(), TimeUnit.SECONDS)) {
+        process.destroyForcibly();
+        process.waitFor(10, TimeUnit.SECONDS);
+        throw new IllegalStateException("OWNED_DOCKER_COMMAND_DEADLINE_EXCEEDED");
+      }
+      if (process.exitValue() != 0) {
+        throw new IllegalStateException("OWNED_DOCKER_COMMAND_FAILED");
+      }
+      return Files.readString(output);
+    } finally {
+      if (process.isAlive()) {
+        process.destroyForcibly();
+      }
+      Files.deleteIfExists(output);
+    }
+  }
+}
