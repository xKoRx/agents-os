+  public static OwnedPlaymakerLifecycle beginFixture(RealE2eFixture fixture,
+      MutationReceiptVerifier verifier) throws Exception {
+    OwnedPlaymakerLifecycle lifecycle = new OwnedPlaymakerLifecycle(fixture, verifier);
+    try { lifecycle.start(); return lifecycle; }
+    catch (Exception | AssertionError failure) {
+      try { lifecycle.markUnknown("PM_START_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      try { lifecycle.close(); } catch (Exception stopFailure) { failure.addSuppressed(stopFailure); }
+      throw failure;
+    }
