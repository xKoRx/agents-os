+  /** Polls real result transport and checks correlation keys, without committing consumer offsets. */
+  public void drain(Duration duration) {
+    for (var record : results.poll(duration)) {
+      JsonNode payload = mapper.readTree(record.value());
+      assertTrue(!payload.has("msg"), "Local Kafka transport must carry direct SDK payload, never a double envelope");
+      String id = payload.has("deployment_id") ? payload.path("deployment_id").asString() : payload.path("action_id").asString();
+      assertEquals(id, record.key(), "Real result transport uses the SDK correlation id as key");
+      observedResults.computeIfAbsent(id, ignored -> new ArrayList<>()).add(payload);
+    }
+  }
