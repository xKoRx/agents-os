+++ b/e2e/owned_test_worker_proof.py
@@ -0,0 +1,67 @@
+"""Common strict task/worker contract for collection and independent final gates."""
+from datetime import datetime
+import re
+
+TASKS = ("realIntegrationTest", "e2eTest", "e2eCanonicalPlaymakerTest", "e2eCandidatePlaymakerTest")
+GRADLE_PRIMARY_CLASSES = {
+    "org.gradle.api.internal.tasks.testing.worker.ForkingTestDefinitionProcessor":
+        "ebdbf25204440cfa88ec70783126625a40b31890ac3808d22e8b55f016b544c3",
+    "org.gradle.process.internal.worker.DefaultWorkerProcess":
+        "75175385ef55b0418ab460a3835fc6e55fc3fc9af64c078cceac1b82b81e5101"
+}
+
+
+def require(condition, code):
+    if not condition:
+        raise RuntimeError("OWNED_TEST_WORKER_PROOF_UNVERIFIED:" + code)
+
+
+def birth(value):
+    require(isinstance(value, str) and len(value) <= 64, "NATIVE_BIRTH_FORMAT")
+    try:
+        actual = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        require(False, "NATIVE_BIRTH_FORMAT")
+    require(actual.tzinfo is not None and actual.utcoffset().total_seconds() == 0, "NATIVE_BIRTH_FORMAT")
+
+
+def require_task_completion(task, run, selected_task=None):
+    require(isinstance(task, dict), "TASK_PROOF_REQUIRED")
+    require(type(task.get("schema_version")) is int and task["schema_version"] == 1 and task.get("kind") == "ACTUAL_GRADLE_TEST_TASK_COMPLETION"
+            and task.get("run_id") == run and task.get("task") in TASKS
+            and (selected_task is None or task["task"] == selected_task)
+            and task.get("task_outcome") == "SUCCESS_WITH_WORKERS_REAPED_NORMAL_EXIT"
+            and task.get("gradle_version") == "9.3.1"
+            and task.get("primary_classes") == GRADLE_PRIMARY_CLASSES, "TASK_PROOF")
+    require(type(task.get("test_count")) is int and task["test_count"] > 0
+            and type(task.get("failed_count")) is int and task["failed_count"] == 0
+            and type(task.get("skipped_count")) is int and task["skipped_count"] == 0
+            and type(task.get("owner_pid")) is int and task["owner_pid"] > 0, "TASK_TOTALS_OR_OWNER")
+    birth(task.get("owner_start_instant"))
+    workers = task.get("workers")
+    require(isinstance(workers, list) and 1 <= len(workers) <= 1000
+            and all(isinstance(worker, dict) for worker in workers), "NATIVE_TASK_WORKERS_REQUIRED")
+    ids = []
+    for worker in workers:
+        require(type(worker.get("schema_version")) is int and worker["schema_version"] == 1 and worker.get("kind") == "OWNED_JUNIT_TEST_WORKER"
+                and worker.get("run_id") == run and worker.get("task") == task["task"]
+                and type(worker.get("process_owner_pid")) is int and worker["process_owner_pid"] > 0
+                and worker["process_owner_pid"] == task["owner_pid"]
+                and worker.get("process_owner_start_instant") == task["owner_start_instant"]
+                and worker.get("process_owner_kind") == "GRADLE_TEST_WORKER_NORMAL_EXIT"
+                and type(worker.get("pid")) is int and worker["pid"] > 0
+                and isinstance(worker.get("gradle_worker_id"), str)
+                and re.fullmatch(r"[a-zA-Z0-9_.-]{1,128}", worker["gradle_worker_id"]), "NATIVE_TASK_WORKER_BINDING")
+        birth(worker.get("process_start_instant"))
+        ids.append(worker["pid"])
+    require(len(ids) == len(set(ids)), "DUPLICATE_NATIVE_TASK_WORKER")
+    return task
+
+
+def require_worker_generation(manifest, record, task):
+    require(record.get("test_task") == task["task"]
+            and task["owner_pid"] == manifest.get("process_owner_pid")
+            and task["owner_start_instant"] == manifest.get("process_owner_start_instant")
+            and any(worker["pid"] == manifest.get("pid")
+                    and worker["process_start_instant"] == manifest.get("process_start_instant")
+                    for worker in task["workers"]), "TASK_GENERATION_OWNER_BINDING")
diff --git a/e2e/playmaker-artifact.py b/e2e/playmaker-artifact.py
new file mode 100755
index 0000000000000000000000000000000000000000..f20bd719bdf922c0f30df8ff033348099970c202
--- /dev/null
+++ b/e2e/playmaker-artifact.py
@@ -0,0 +1,201 @@
+#!/usr/bin/env python3
+"""Bind an own built artifact to exact source and adapter-only canonical/candidate policy."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import subprocess
+import tempfile
+
+BASES = {"canonical": "0c83575c54cb198d238be7d83f3b4d8de27abbc8",
+         "candidate": "1b4b8e1554c37357e4b39e1860be6ad43f9aa640",
+         "cp": "eee5b9091b332a975c78823679a1e99b517632bc"}
+POLICY = {"canonical": BASES["canonical"],
+          "candidate": "7673f4bffc286f0f24d4214938df53c4c5eb9c38", "cp": BASES["cp"]}
+PM_ROOT = "src/main/java/com/mercadolibre/rio/playmaker/"
+PM_ALLOW = {PM_ROOT + p for p in (
+    "localintegration/LocalKafkaActionTriggerProducer.java",
+    "localintegration/LocalKafkaActionResultListener.java",
+    "localintegration/RealE2eActionKafkaConfiguration.java",
+    "localintegration/RealE2ePlaymakerConfiguration.java",
+    "localintegration/RealE2eOwnedProcessLeaseVerifier.java",
+    "localintegration/RealE2eObservedKvsClient.java",
+    "localintegration/RealE2eKvsMutationJournal.java",
+    "localintegration/RealE2eKvsObservationConfiguration.java",
+    )}
+PM_ALLOW |= {"src/main/resources/application-real-e2e.yml", "src/main/resources/META-INF/spring.factories"}
+
+# Existing productive bodies remain exact baseline bytes. Only these reviewed
+# adapter-selection annotations may differ; filename exemptions cannot prove policy.
+PM_PROFILE_DELTAS = {
+    PM_ROOT + "config/ActionResultKvsConfig.java": (
+        b'@Profile({"local", "integration_test"})',
+        b'@Profile({"local & !real-e2e", "integration_test & !real-e2e"})'),
+    PM_ROOT + "config/ActionLockKvsConfig.java": (
+        b'  @Bean("actionLockKvsClient")\n  @ConditionalOnMissingBean(name = "actionLockKvsClient")',
+        b'  @Bean("actionLockKvsClient")\n  @Profile("!real-e2e")\n  @ConditionalOnMissingBean(name = "actionLockKvsClient")'),
+    PM_ROOT + "restclient/impl/BigQueueActionsProducerLocal.java": (
+        b'@Profile({"local", "integration_test"})',
+        b'@Profile({"local & !real-e2e", "integration_test & !real-e2e"})'),
+    PM_ROOT + "restclient/impl/KafkaControlPlaneClientImpl.java": (
+        b'@Profile("!local & !integration_test")',
+        b'@Profile("(!local & !integration_test) | (local & local-integration & real-e2e)")'),
+    PM_ROOT + "restclient/impl/KafkaControlPlaneClientImplLocal.java": (
+        b'@Profile({"local", "integration_test"})',
+        b'@Profile({"local & !real-e2e", "integration_test & !real-e2e"})'),
+    PM_ROOT + "restclient/impl/EntityServiceClientImpl.java": (
+        b'@Profile("!local & !integration_test")',
+        b'@Profile("(!local & !integration_test) | real-e2e")'),
+    PM_ROOT + "restclient/impl/EntityServiceClientImplLocal.java": (
+        b'@Profile({"local", "integration_test"})',
+        b'@Profile("(local | integration_test) & !real-e2e")')
+}
+
+
+def exact_profile_overlay(repo, base, name, path):
+    if not path.is_file():
+        fail("PRODUCTIVE_POLICY_DRIFT")
+    original = git(repo, "show", base + ":" + name)
+    before, after = PM_PROFILE_DELTAS[name]
+    if original.count(before) == 1 and original.count(after) == 0:
+        approved = (original, original.replace(before, after, 1))
+    elif original.count(before) == 0 and original.count(after) == 1:
+        # Candidate baseline already contains five reviewed profile adapters.
+        approved = (original,)
+    else:
+        fail("REVIEWED_PROFILE_BASELINE_CHANGED")
+    if path.read_bytes() not in approved:
+        fail("PRODUCTIVE_POLICY_DRIFT")
+
+
+def git(repo, *arguments):
+    return subprocess.run(["git", "-C", str(repo), *arguments], check=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
+
+
+def sha(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(65536), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def fail(code):
+    raise RuntimeError("PLAYMAKER_ARTIFACT_GATE:" + code)
+
+
+def source(repo, mode, run):
+    base = BASES[mode]
+    git(repo, "cat-file", "-e", base + "^{commit}")
+    tracked = git(repo, "ls-tree", "-r", "--name-only", base, "--", "src/main").decode().splitlines()
+    actual = sorted(p.relative_to(repo).as_posix() for p in (repo / "src/main").rglob("*") if p.is_file())
+    for name in sorted(set(tracked) | set(actual)):
+        path = repo / name
+        if path.is_symlink():
+            fail("SOURCE_SYMLINK")
+        allowed = name in PM_ALLOW if mode != "cp" else (
+            name.startswith("src/main/java/com/mercadolibre/rio_controlplane_kafka/reale2e/")
+            or name == "src/main/resources/application-real-e2e.yml")
+        if mode != "cp" and name in PM_PROFILE_DELTAS:
+            exact_profile_overlay(repo, base, name, path)
+        elif not allowed:
+            if name not in tracked or not path.is_file():
+                fail("UNPLANNED_PRODUCTIVE_SOURCE")
+            if git(repo, "show", base + ":" + name) != path.read_bytes():
+                fail("PRODUCTIVE_POLICY_DRIFT")
+    inputs = actual + ["build.gradle", "settings.gradle", "gradle/wrapper/gradle-wrapper.properties"]
+    if mode == "cp":
+        # The worker proof and launcher sources are part of this run's immutable
+        # source binding even though they are not packaged in the main application jar.
+        for directory in ("e2e", "src/realIntegrationTest", "src/e2eTest"):
+            for path in sorted((repo / directory).rglob("*")):
+                if "__pycache__" in path.parts or not path.is_file():
+                    continue
+                if path.is_symlink():
+                    fail("SOURCE_SYMLINK")
+                if path.suffix in (".java", ".py", ".sh", ".gradle", ".yaml", ".yml") \
+                        or path.name == "org.junit.jupiter.api.extension.Extension":
+                    inputs.append(path.relative_to(repo).as_posix())
+    inputs = sorted(set(inputs))
+    files = [{"path": name, "sha256": sha(repo / name)} for name in inputs if (repo / name).is_file()]
+    encoded = json.dumps(files, sort_keys=True, separators=(",", ":")).encode()
+    return {"schema_version": 1, "kind": "REAL_E2E_SOURCE_ARTIFACT", "run_id": run,
+            "contract_mode": mode, "source_commit": git(repo, "rev-parse", "HEAD").decode().strip(),
+            "policy_source_commit": POLICY[mode], "protected_source_baseline": base,
+            "source_manifest_sha256": hashlib.sha256(encoded).hexdigest(), "source_files": files}
+
+
+def write(path, value):
+    parent = path.parent
+    if not parent.is_dir() or parent.is_symlink() or stat.S_IMODE(parent.stat().st_mode) != 0o700:
+        fail("PRIVATE_OUTPUT_DIRECTORY_REQUIRED")
+    if parent.stat().st_uid != os.getuid() or path.is_symlink():
+        fail("OUTPUT_OWNERSHIP_UNVERIFIED")
+    fd, temporary = tempfile.mkstemp(prefix=".artifact-", dir=parent)
+    try:
+        with os.fdopen(fd, "w") as stream:
+            json.dump(value, stream, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+        descriptor = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+    finally:
+        Path(temporary).unlink(missing_ok=True)
+
+
+def private_json(path):
+    if path.is_symlink() or not path.is_file() or path.stat().st_uid != os.getuid() \
+            or stat.S_IMODE(path.stat().st_mode) != 0o600 or path.stat().st_size > 4_000_000:
+        fail("PRIVATE_RECEIPT_REQUIRED")
+    with path.open() as stream:
+        return json.load(stream)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("operation", choices=("snapshot", "prepare", "verify"))
+    parser.add_argument("--repo", type=Path, required=True)
+    parser.add_argument("--mode", choices=tuple(BASES), required=True)
+    parser.add_argument("--run", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--snapshot", type=Path)
+    args = parser.parse_args()
+    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{7,63}", args.run):
+        fail("RUN_ID_REQUIRED")
+    repo = args.repo.resolve(strict=True)
+    current = source(repo, args.mode, args.run)
+    if args.operation == "snapshot":
+        write(args.output, current)
+        return
+    if args.operation == "prepare":
+        if args.snapshot is None or private_json(args.snapshot) != current:
