+  @ParameterizedTest(name = "{0}: complete Playmaker peek action with real persisted result")
+  @ValueSource(strings = {"aws-msk-topic", "gcp-kafka-topic"})
+  void peekActionTraversesActualPlaymakerKafkaCpResultAndPersistentActionKvs(String provider) throws Exception {
+    String topic = fixture.uniqueTopic("playmaker_action");
+    database.seed(provider, mapper.writeValueAsString(fixture.paramsFor(provider, topic, 2, (short) 2)));
+    deploy();
+    assertCorrelatedOutcome(provider, awaitDeployment("deploy_completed"), "COMPLETED");
+    fixture.awaitTopic(topic);
+    fixture.seed(topic, 0, "owned-key", "owned-real-value");
+    HttpResponse<String> accepted = request("POST", database.actionPath(),
+        Map.of("timeout", 40, "data", Map.of("topic_name", topic, "num_msgs", 1, "offset", "EARLIEST", "timeout_ms", 2_000)), true);
+    assertEquals(202, accepted.statusCode(), "Action must be accepted by the genuine Playmaker dispatcher");
+    JsonNode dispatched = mapper.readTree(accepted.body());
+    actionId = dispatched.path("action_id").asString();
+    assertFalse(actionId.isBlank(), "Action must return a real correlation id");
+    fixture.registerKey("action:" + actionId);
+    JsonNode cpResult = fixture.awaitAction(actionId);
+    assertEquals("COMPLETED", cpResult.path("status").asString());
+    fixture.awaitKvs("action:" + actionId, "COMPLETED");
+    Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+      HttpResponse<String> polled = request("GET", "/v2/actions/" + actionId, null, true);
+      assertEquals(200, polled.statusCode());
+      JsonNode state = mapper.readTree(polled.body());
+      assertEquals("COMPLETED", state.path("status").asString());
+      assertTrue(state.toString().contains("owned-real-value"), "Playmaker must return the value produced to Kafka");
+    });
+    var persisted = actionKvs.get("actions:" + actionId);
+    assertTrue(persisted != null, "The action result must exist in real Fury Sandbox KVS");
+    JsonNode stored = mapper.readTree(persisted.getValue());
+    assertEquals(actionId, stored.path("action_id").asString());
+    assertEquals("COMPLETED", stored.path("status").asString());
+    assertTrue(stored.toString().contains("owned-real-value"), "Persist the actual produced value");
+    evidence("PM-PEEK-ACTION-" + provider, Map.of("topic", topic, "action_id", actionId, "cp_state", "COMPLETED",
+        "playmaker_state", "COMPLETED", "physical_value_verified", true));
+  }
