+
+/** Verifies server-assigned versions, exclusive creates, CAS and TTL on actual Fury Sandbox KVS. */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = {"SCOPE_SUFFIX=local", "kafka.bootstrap-servers=${E2E_BOOTSTRAP_SERVERS}",
+        "kafka.provisioning.timeout-minutes=1", "e2e.bridge.enabled=false"})
+@ActiveProfiles({"local", "real-e2e"})
+class RealKvsIntegrationTest {
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+  @Autowired private ObjectMapper mapper;
+  private final List<String> keys = new ArrayList<>();
+
+  @AfterEach
+  void cleanupActualSandboxKeys() throws Exception {
+    Throwable failure = null;
+    for (String key : List.copyOf(keys)) {
+      try {
+        kvs.delete(key);
+        assertTrue(kvs.get(key) == null, "Run-owned KVS key must be absent after cleanup");
+        keys.remove(key);
+      } catch (Exception | AssertionError cleanupFailure) {
+        if (failure == null) {
+          failure = cleanupFailure;
+        } else {
+          failure.addSuppressed(cleanupFailure);
+        }
+      }
+    }
+    if (failure instanceof Error error) {
+      throw error;
+    }
+    if (failure instanceof Exception exception) {
+      throw exception;
+    }
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"deployment:", "gcp-deployment:", "action:"})
+  void exclusiveCreateAndVersionedUpdateUseServerVersionAndRejectStaleCas(String prefix) throws Exception {
+    String key = key(prefix);
+    kvs.save(item(key, TriggerStatusRecord.inProgress(System.currentTimeMillis()), 0, 60));
+    Item<byte[]> saved = kvs.get(key);
+    assertNotNull(saved);
+    KvsClientException duplicate = assertThrows(KvsClientException.class,
+        () -> kvs.save(item(key, TriggerStatusRecord.inProgress(System.currentTimeMillis()), 0, 60)));
+    assertEquals(ErrorCode.CONFLICT, duplicate.getErrorCode());
+    int version = saved.getVersion();
+    kvs.update(item(key, TriggerStatusRecord.publishPending(System.currentTimeMillis()), version, 60));
+    assertEquals(version + 1, kvs.get(key).getVersion());
+    KvsClientException stale = assertThrows(KvsClientException.class,
+        () -> kvs.update(item(key, TriggerStatusRecord.inProgress(System.currentTimeMillis()), version, 60)));
+    assertEquals(ErrorCode.CONFLICT, stale.getErrorCode());
+  }
+
+  @ParameterizedTest
+  @MethodSource("domainTerminalStates")
+  void terminalStatesDropRedeliveryAndPersistOutcome(String prefix, String state) throws Exception {
+    String key = key(prefix);
+    IdempotencyGuard guard = guard();
+    ClaimResult.Proceed claim = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(key));
+    assertFalse(claim.kvsError());
+    boolean finalized = "COMPLETED".equals(state) ? guard.finalizeCompleted(key, claim.version())
+        : guard.finalizeFailed(key, claim.version(), "INVALID_PARAMS");
+    assertTrue(finalized);
+    TriggerStatusRecord terminal = mapper.readValue(kvs.get(key).getValue(), TriggerStatusRecord.class);
+    assertEquals(state, terminal.state().name());
+    assertNotNull(terminal.finishedAt());
+    assertEquals(terminal.startedAt(), terminal.finishedAt());
+    assertEquals(ClaimResult.DropReason.TERMINAL, assertInstanceOf(ClaimResult.Drop.class, guard.claim(key)).reason());
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"deployment:", "gcp-deployment:", "action:"})
+  void selfRetryUsesExistingVersionButPublicationReservationHasOneOwner(String prefix) throws Exception {
+    String key = key(prefix);
+    IdempotencyGuard guard = guard();
+    ClaimResult.Proceed first = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(key));
+    ClaimResult.Proceed retry = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(key));
+    assertEquals(first.version(), retry.version());
+    ClaimResult.Proceed pending = assertInstanceOf(ClaimResult.Proceed.class,
+        guard.preparePublication(key, first.version()));
+    assertEquals(first.version() + 1, pending.version());
+    assertEquals(ClaimResult.DropReason.TAKEOVER_LOST,
+        assertInstanceOf(ClaimResult.Drop.class, guard.preparePublication(key, retry.version())).reason());
+    assertTrue(mapper.readValue(kvs.get(key).getValue(), TriggerStatusRecord.class).isPublicationPending());
+    assertEquals(ClaimResult.DropReason.IN_PROGRESS,
+        assertInstanceOf(ClaimResult.Drop.class, guard.claim(key)).reason());
+  }
+
+  @ParameterizedTest
+  @MethodSource("domainStaleStates")
+  void staleInProgressAndPublicationPendingCanBeTakenOver(String prefix, boolean publicationPending) throws Exception {
+    String key = key(prefix);
+    long staleTime = System.currentTimeMillis() - Duration.ofMinutes(2).toMillis();
+    TriggerStatusRecord state = publicationPending ? TriggerStatusRecord.publishPending(staleTime)
+        : TriggerStatusRecord.inProgress(staleTime);
+    kvs.save(item(key, state, 0, 60));
+    int initialVersion = kvs.get(key).getVersion();
+    ClaimResult.Proceed takeover = assertInstanceOf(ClaimResult.Proceed.class, guard().claim(key));
+    assertFalse(takeover.kvsError());
+    assertEquals(initialVersion + 1, takeover.version());
+    TriggerStatusRecord refreshed = mapper.readValue(kvs.get(key).getValue(), TriggerStatusRecord.class);
+    assertTrue(refreshed.startedAt() > staleTime);
+    assertFalse(refreshed.isPublicationPending());
+  }
+
+  @Test
+  void concurrentWorkersReserveOnlyOneTerminalPublicationUsingRealCas() throws Exception {
+    String key = key();
+    IdempotencyGuard guard = guard();
+    List<ClaimResult> claims;
+    try (var workers = Executors.newVirtualThreadPerTaskExecutor()) {
+      var one = workers.submit(() -> guard.claim(key));
+      var two = workers.submit(() -> guard.claim(key));
+      claims = List.of(one.get(), two.get());
+    }
+    int publicationOwners = 0;
+    for (ClaimResult claim : claims) {
+      if (claim instanceof ClaimResult.Proceed proceed && !proceed.kvsError()
+          && guard.preparePublication(key, proceed.version()) instanceof ClaimResult.Proceed reservation
+          && !reservation.kvsError()) {
+        publicationOwners++;
+      }
+    }
+    assertEquals(1, publicationOwners, "Only one CAS reservation may own a healthy result publication");
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"deployment:", "gcp-deployment:", "action:"})
+  void realServerTtlExpiresRecordAndAllowsSameKeyAgain(String prefix) throws Exception {
+    String key = key(prefix);
+    kvs.save(item(key, TriggerStatusRecord.inProgress(System.currentTimeMillis()), 0, 2));
+    assertNotNull(kvs.get(key));
+    Awaitility.await().atMost(Duration.ofSeconds(30)).pollInterval(Duration.ofMillis(300))
+        .until(() -> kvs.get(key) == null);
+    ClaimResult.Proceed fresh = assertInstanceOf(ClaimResult.Proceed.class, guard().claim(key));
+    assertFalse(fresh.kvsError());
+    assertNotNull(kvs.get(key));
+  }
+
+  @ParameterizedTest
+  @MethodSource("domainCorruptRecords")
+  void actualCorruptRecordsEnterExplicitDegradedModeWithoutReplacingStoredData(String prefix, String json) throws Exception {
+    String key = key(prefix);
+    byte[] value = json.getBytes(StandardCharsets.UTF_8);
+    kvs.save(Item.builder(key, value).withTtl(60).build());
+    int version = kvs.get(key).getVersion();
+    ClaimResult.Proceed degraded = assertInstanceOf(ClaimResult.Proceed.class, guard().claim(key));
+    assertTrue(degraded.kvsError());
+    assertEquals(version, kvs.get(key).getVersion());
+    assertEquals(json, new String(kvs.get(key).getValue(), StandardCharsets.UTF_8));
+  }
+
+  static Stream<Arguments> domainCorruptRecords() {
+    return Stream.of("deployment:", "gcp-deployment:", "action:").flatMap(prefix -> Stream.of(
+        Arguments.of(prefix, "not-json"), Arguments.of(prefix, "{\"state\":null,\"started_at\":0}")));
+  }
+
+  @ParameterizedTest
+  @MethodSource("domainClockBoundaries")
+  void ownWindowAndStaleEqualityUseActualKvsCasWithDeterministicClock(String prefix, long age) throws Exception {
+    String key = key(prefix);
+    long now = System.currentTimeMillis();
+    kvs.save(item(key, TriggerStatusRecord.inProgress(now - age), 0, 60));
+    int version = kvs.get(key).getVersion();
+    IdempotencyGuard fixedClockGuard = new IdempotencyGuard(kvs, mapper, 60, 30_000, 10_000,
+        Clock.fixed(Instant.ofEpochMilli(now), ZoneOffset.UTC));
+    ClaimResult claim = fixedClockGuard.claim(key);
+    if (age == 10_000) {
+      assertEquals(ClaimResult.DropReason.IN_PROGRESS, assertInstanceOf(ClaimResult.Drop.class, claim).reason());
+      assertEquals(version, kvs.get(key).getVersion());
+    } else {
+      assertFalse(assertInstanceOf(ClaimResult.Proceed.class, claim).kvsError());
+      assertEquals(version + 1, kvs.get(key).getVersion());
+    }
+  }
+
+  static Stream<Arguments> domainClockBoundaries() {
+    return Stream.of("deployment:", "gcp-deployment:", "action:").flatMap(prefix ->
+        Stream.of(Arguments.of(prefix, 10_000L), Arguments.of(prefix, 30_000L)));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"deployment:", "gcp-deployment:", "action:"})
+  void lostFinalizeCasPreservesWinningRealRecord(String prefix) throws Exception {
+    String key = key(prefix);
+    IdempotencyGuard guard = guard();
+    ClaimResult.Proceed claim = assertInstanceOf(ClaimResult.Proceed.class, guard.claim(key));
+    Item<byte[]> saved = kvs.get(key);
+    kvs.update(item(key, TriggerStatusRecord.publishPending(System.currentTimeMillis()), saved.getVersion(), 60));
+    int winner = kvs.get(key).getVersion();
+    assertFalse(guard.finalizeCompleted(key, claim.version()));
+    assertEquals(winner, kvs.get(key).getVersion());
+    assertTrue(mapper.readValue(kvs.get(key).getValue(), TriggerStatusRecord.class).isPublicationPending());
+  }
+
+  private String key(String prefix) {
+    String key = prefix + "e2e_" + RealE2eFixtureRun.runId() + "_" + UUID.randomUUID();
+    keys.add(key);
+    return key;
+  }
+
+  static Stream<Arguments> domainTerminalStates() {
+    return Stream.of("deployment:", "gcp-deployment:", "action:").flatMap(prefix ->
+        Stream.of(Arguments.of(prefix, "COMPLETED"), Arguments.of(prefix, "FAILED")));
+  }
+
+  static Stream<Arguments> domainStaleStates() {
+    return Stream.of("deployment:", "gcp-deployment:", "action:").flatMap(prefix ->
+        Stream.of(Arguments.of(prefix, false), Arguments.of(prefix, true)));
+  }
+
+  private String key() {
+    String key = "action:e2e_" + RealE2eFixtureRun.runId() + "_" + UUID.randomUUID();
+    keys.add(key);
+    return key;
+  }
+
+  private Item<byte[]> item(String key, TriggerStatusRecord record, int version, int ttl) {
+    return Item.builder(key, mapper.writeValueAsBytes(record)).withVersion(version).withTtl(ttl).build();
+  }
+
+  private IdempotencyGuard guard() {
+    return new IdempotencyGuard(kvs, mapper, 60, 30_000, 10_000, Clock.systemUTC());
+  }
+
+  private static final class RealE2eFixtureRun {
+    private RealE2eFixtureRun() {}
+
+    private static String runId() {
+      return com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture.requiredEnv("E2E_RUN_ID");
+    }
+  }
+}
