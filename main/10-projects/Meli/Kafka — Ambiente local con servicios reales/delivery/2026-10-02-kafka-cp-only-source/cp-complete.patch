+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.admin.AdminClient;
+import org.junit.jupiter.api.Test;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+
+/** Focused live-Kafka pool/auth-key and actual Spring bean shutdown contracts, without domain substitutes. */
+class RealKafkaPoolLifecycleIntegrationTest {
+  @Test
+  void realPooledClientsNormalizeBrokerSetsIsolateAuthAndCloseOnSpringContextShutdown() throws Exception {
+    String bootstrap = E2eSafety.loopbackBootstrap(RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS"));
+    List<String> seeds = new ArrayList<>(Arrays.asList(bootstrap.split(",")));
+    Collections.reverse(seeds);
+    String reordered = String.join(" , ", seeds) + "," + seeds.get(0);
+    AdminClient plaintext;
+    AdminClient authOne;
+    AdminClient authTwo;
+    ExecutorService executor;
+    try (AnnotationConfigApplicationContext context = new AnnotationConfigApplicationContext()) {
+      context.register(KafkaAdminClientPoolImpl.class, ExecutorConfig.class);
+      context.refresh();
+      var pool = context.getBean(KafkaAdminClientPoolImpl.class);
+      plaintext = pool.getClient(ClusterConnection.plaintext(bootstrap));
+      assertEquals(5, plaintext.describeCluster().nodes().get(30, TimeUnit.SECONDS).size());
+      assertSame(plaintext, pool.getClient(ClusterConnection.plaintext(reordered)),
+          "Reordering, whitespace and duplicate seeds must reuse the actual connected AdminClient");
+      Map<String, Object> firstAuth = authConfig("synthetic-one");
+      Map<String, Object> secondAuth = authConfig("synthetic-two");
+      authOne = pool.getClient(new ClusterConnection(bootstrap, firstAuth));
+      authTwo = pool.getClient(new ClusterConnection(reordered, secondAuth));
+      assertNotSame(plaintext, authOne);
+      assertNotSame(authOne, authTwo, "Different SASL material must not share the plaintext or another auth client");
+      assertSame(authOne, pool.getClient(new ClusterConnection(reordered, firstAuth)));
+      assertThrows(Exception.class, () -> authOne.describeCluster().nodes().get(10, TimeUnit.SECONDS),
+          "The real plaintext listener must not accidentally authenticate an incompatible SASL client");
+      assertThrows(Exception.class, () -> authTwo.describeCluster().nodes().get(10, TimeUnit.SECONDS));
+      assertEquals(5, plaintext.describeCluster().nodes().get(30, TimeUnit.SECONDS).size());
+      executor = context.getBean(ExecutorConfig.ASYNC_EXECUTOR, ExecutorService.class);
+      assertEquals(7, executor.submit(() -> 7).get(10, TimeUnit.SECONDS));
+    }
+    assertTrue(executor.isShutdown(), "The production async executor bean must receive its actual destroy method");
+    assertTrue(executor.awaitTermination(10, TimeUnit.SECONDS));
+    for (AdminClient closed : List.of(plaintext, authOne, authTwo)) {
+      Exception closedFailure = assertThrows(Exception.class, () -> closed.describeCluster().nodes().get(5, TimeUnit.SECONDS),
+          "Every real pooled AdminClient must be closed by the actual Spring PreDestroy callback");
+      Throwable cause = closedFailure instanceof java.util.concurrent.ExecutionException
+          ? closedFailure.getCause() : closedFailure;
+      assertTrue((cause instanceof IllegalStateException && cause.getMessage().contains("AdminClient is closing"))
+          || (cause instanceof org.apache.kafka.common.errors.TimeoutException
+              && "The AdminClient thread has exited.".equals(cause.getMessage())),
+          "Resolved Kafka3.9.2 must report actual client shutdown, not another incompatible-auth connection failure");
+    }
+  }
+
+  private Map<String, Object> authConfig(String syntheticPassword) {
+    return Map.of("security.protocol", "SASL_PLAINTEXT", "sasl.mechanism", "PLAIN",
+        "sasl.jaas.config", "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"e2e\" password=\""
+            + syntheticPassword + "\";", "default.api.timeout.ms", 1000, "request.timeout.ms", 1000);
+  }
+}
