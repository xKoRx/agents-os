+  /** Fixed per-fixture durable journal; all fields describe ownership, never business payloads or environment. */
+  private synchronized void persistJournal() throws Exception {
+    assertTrue(Files.isDirectory(reconciliationDirectory, LinkOption.NOFOLLOW_LINKS),
+        "Durable journal needs the existing private run directory");
+    Set<Integer> exactPorts = new LinkedHashSet<>(ownedWorkerPorts);
+    exactPorts.addAll(plannedWorkerPorts);
+    ownedWorkerProcesses.forEach(process -> exactPorts.add(process.port()));
+    Map<String, Object> ledger = new LinkedHashMap<>();
+    ledger.put("schema_version", 2);
+    ledger.put("journal_id", journalId.toString());
+    ledger.put("run_id", runId);
+    ledger.put("phase", journalPhase);
+    ledger.put("reason", journalReason);
+    ledger.put("topics", List.copyOf(ownedTopics));
+    ledger.put("kvs_keys", List.copyOf(ownedKeys));
+    ledger.put("declared_topics", List.copyOf(declaredTopics));
+    ledger.put("declared_kvs_keys", List.copyOf(declaredKeys));
+    ledger.put("consumer_groups", groupAbsent ? List.of() : List.of(resultGroup));
+    ledger.put("declared_consumer_group", resultGroup);
+    ledger.put("worker_ports", List.copyOf(exactPorts));
+    ledger.put("worker_pids", ownedWorkerProcesses.stream().map(RealControlplaneProcess::pid).toList());
+    ledger.put("worker_thread_ids", ownedServiceWorkers.stream().map(Thread::threadId).toList());
+    ledger.put("fixture_pid", ProcessHandle.current().pid());
+    ledger.put("kafka_bootstrap", bootstrap);
+    ledger.put("fault_namespaces", List.copyOf(ownedFaultNamespaces));
+    ledger.put("private_configuration_files", List.copyOf(privateConfigurationFiles));
+    ledger.put("owned_private_configuration_files", List.copyOf(ownedPrivateConfigurationFiles));
+    ledger.put("declared_owned_private_configuration_files", List.copyOf(declaredOwnedPrivateConfigurationFiles));
+    ledger.put("quiescence_verified", quiescenceVerified);
+    ledger.put("clients_closed", clientsClosed);
+    ledger.put("authorized_cleanup_children", List.copyOf(cleanupChildPermits.values()));
+    ledger.put("cleanup_child_pids", cleanupChildPids.entrySet().stream().collect(java.util.stream.Collectors.toMap(
+        entry -> entry.getKey().toString(), Map.Entry::getValue)));
+    if (parentPermit != null) { ledger.put("parent_permit", parentPermit); }
+    if (!ownedBridgeTopics.isEmpty()) {
+      ledger.put("bridge_group", "e2e_" + runId + "_cp_bridge");
+      ledger.put("bridge_topics", List.copyOf(ownedBridgeTopics));
+    }
+    Path temporary = Files.createTempFile(reconciliationDirectory, ".pending-retention-", ".json",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    try {
+      byte[] bytes = mapper.writeValueAsBytes(ledger);
+      try (FileChannel file = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
+        ByteBuffer buffer = ByteBuffer.wrap(bytes);
+        while (buffer.hasRemaining()) { file.write(buffer); }
+        file.force(true);
+      }
+      Files.move(temporary, journalPath, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      forceDirectory(reconciliationDirectory);
+    } finally { Files.deleteIfExists(temporary); }
+  }
+
+  private static void forceDirectory(Path directory) throws Exception {
+    try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ)) { channel.force(true); }
+  }
+
+  private synchronized void setJournalState(String phase, String reason) throws Exception {
+    journalPhase = phase;
+    journalReason = reason;
+    persistJournal();
+  }
+
+  private synchronized void persistIntent() {
+    if (closed || "UNKNOWN".equals(journalPhase)) {
+      throw new IllegalStateException("A closed or UNKNOWN fixture cannot acquire resources or dispatch requests");
+    }
+    quiescenceVerified = false;
+    try { persistJournal(); }
+    catch (Exception failure) { throw new IllegalStateException("Durable fixture ownership could not be recorded before mutation", failure); }
+  }
