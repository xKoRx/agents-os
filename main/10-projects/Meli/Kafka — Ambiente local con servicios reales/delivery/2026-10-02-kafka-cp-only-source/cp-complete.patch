@@ -0,0 +1,171 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.ExecutionException;
+import org.apache.kafka.common.errors.TopicAuthorizationException;
+import org.apache.kafka.clients.admin.Admin;
+import org.apache.kafka.clients.admin.AdminClientConfig;
+import org.apache.kafka.common.acl.AccessControlEntry;
+import org.apache.kafka.common.acl.AclBinding;
+import org.apache.kafka.common.acl.AclOperation;
+import org.apache.kafka.common.acl.AclPermissionType;
+import org.apache.kafka.common.resource.PatternType;
+import org.apache.kafka.common.resource.Resource;
+import org.apache.kafka.common.resource.ResourcePattern;
+import org.apache.kafka.common.resource.ResourceType;
+import org.awaitility.Awaitility;
+
+/** Owns a separate, real KRaft StandardAuthorizer cluster for plaintext authorization failures. */
+public final class OwnedAuthorizationBroker implements AutoCloseable {
+  private static final String PRINCIPAL = "User:ANONYMOUS";
+  private static final int ADMIN_DEADLINE_SECONDS = 30;
+  private final OwnedCompose compose;
+  private final Path environmentFile;
+  private final Map<String, String> reconciliationMetadata;
+  private final String bootstrap;
+  private final String topicPrefix;
+  private final List<AclBinding> denials = new ArrayList<>();
+  private final Admin admin;
+  private boolean hasStarted;
+
+  private OwnedAuthorizationBroker(OwnedCompose compose, Path environmentFile, String bootstrap, String runId,
+      String context, String project, Path composeFile) {
+    this.compose = compose;
+    this.environmentFile = environmentFile;
+    this.reconciliationMetadata = Map.of("run_id", runId, "docker_context", context,
+        "compose_project", project, "compose_file", composeFile.toAbsolutePath().toString(),
+        "environment_file", environmentFile.toAbsolutePath().toString());
+    this.bootstrap = bootstrap;
+    this.topicPrefix = "e2e_" + runId + "_";
+    this.admin = Admin.create(Map.of(AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap,
+        AdminClientConfig.REQUEST_TIMEOUT_MS_CONFIG, 10000, AdminClientConfig.DEFAULT_API_TIMEOUT_MS_CONFIG, 15000));
+  }
+
+  /** Starts one independently owned broker; absence of Docker or readiness fails visibly. */
+  public static OwnedAuthorizationBroker start() throws Exception {
+    final String runId = System.getenv("E2E_RUN_ID");
+    final String context = System.getenv("DOCKER_CONTEXT");
+    if (runId == null || !runId.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+      throw new IllegalStateException("OWNED_RUN_ID_REQUIRED");
+    }
+    if (context == null || !context.matches("[a-zA-Z0-9_-]{1,100}")) {
+      throw new IllegalStateException("EXPLICIT_DOCKER_CONTEXT_REQUIRED");
+    }
+    final Path environmentFile = Files.createTempFile("e2e-auth-broker-", ".env");
+    final int port;
+    try (ServerSocket reservation = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      port = reservation.getLocalPort();
+    }
+    final byte[] identity = new byte[16];
+    java.security.SecureRandom.getInstanceStrong().nextBytes(identity);
+    final String clusterId = Base64.getUrlEncoder().withoutPadding().encodeToString(identity);
+    Files.writeString(environmentFile, "E2E_RUN_ID=" + runId + "\nE2E_KAFKA_AUTH_PORT=" + port + "\nE2E_KAFKA_AUTH_CLUSTER_ID=" + clusterId
+        + "\nE2E_JAVA_TOOL_OPTIONS=" + System.getenv().getOrDefault("E2E_JAVA_TOOL_OPTIONS", "") + "\n");
+    final String project = "rio-kafka-e2e-auth-" + runId + "-" + UUID.randomUUID().toString().substring(0, 8);
+    final Path composeFile = Path.of("e2e/faults/compose.authorization.yaml").toAbsolutePath();
+    final OwnedCompose compose = new OwnedCompose(context, project, runId, composeFile, environmentFile);
+    final OwnedAuthorizationBroker broker = new OwnedAuthorizationBroker(compose, environmentFile,
+        "127.0.0.1:" + port, runId, context, project, composeFile);
+    try {
+      compose.certifyAbsent();
+      broker.hasStarted = true;
+      compose.command("up", "--detach", "--wait", "--wait-timeout", "180");
+      compose.requireOwnedService("authbroker");
+      Awaitility.await().atMost(Duration.ofSeconds(60)).until(() -> broker.admin.describeCluster().nodes()
+          .get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS).size() == 1);
+      return broker;
+    } catch (Exception | AssertionError failure) {
+      try {
+        broker.close();
+      } catch (Exception cleanupFailure) {
+        failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  /**
+   * Immutable exact-run references for a private reconciliation ledger, with no configuration contents.
+   * Paths are references, not deletion authority; the authorization compose file is checked-in source.
+   * Authorization has no owned configuration directory and never claims ownership of shared TMPDIR.
+   */
+  public Map<String, String> reconciliationMetadata() {
+    if (!reconciliationMetadata.get("run_id").equals(System.getenv("E2E_RUN_ID"))) {
+      throw new IllegalStateException("RECONCILIATION_METADATA_RUN_MISMATCH");
+    }
+    return reconciliationMetadata;
+  }
+
+  /** Returns the actual broker endpoint for the CP's existing plaintext connection factory. */
+  public String bootstrap() {
+    return bootstrap;
+  }
+
+  /** Installs real deny ACLs for one exact run topic, including the CreateTopics cluster bypass. */
+  public void denyTopic(String topic) throws Exception {
+    if (topic == null || !topic.startsWith(topicPrefix) || !topic.matches("[a-zA-Z0-9._-]{1,249}")) {
+      throw new IllegalArgumentException("EXACT_RUN_TOPIC_REQUIRED");
+    }
+    final ResourcePattern cluster = new ResourcePattern(ResourceType.CLUSTER, Resource.CLUSTER_NAME, PatternType.LITERAL);
+    // Alter remains allowed so ACL restoration can never depend on denied topic access.
+    admin.createAcls(List.of(binding(cluster, AclOperation.ALL, AclPermissionType.ALLOW)))
+        .all().get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS);
+    final List<AclBinding> added = List.of(binding(cluster, AclOperation.CREATE, AclPermissionType.DENY),
+        binding(new ResourcePattern(ResourceType.TOPIC, topic, PatternType.LITERAL), AclOperation.ALL, AclPermissionType.DENY));
+    denials.addAll(added);
+    admin.createAcls(added).all().get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS);
+    Awaitility.await().atMost(Duration.ofSeconds(30)).until(() ->
+        admin.describeAcls(added.get(1).toFilter()).values().get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS).contains(added.get(1)));
+    // Controller ACL acknowledgement alone does not establish broker data-plane enforcement.
+    Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> isTopicDenied(topic));
+  }
+
+  /** Removes only denials installed by this instance, restoring real topic operations. */
+  public void restoreAuthorization() throws Exception {
+    if (!denials.isEmpty()) {
+      admin.deleteAcls(denials.stream().map(AclBinding::toFilter).toList()).all()
+          .get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS);
+      denials.clear();
+    }
+  }
+
+  private boolean isTopicDenied(String topic) throws Exception {
+    try {
+      admin.describeTopics(List.of(topic)).allTopicNames().get(ADMIN_DEADLINE_SECONDS, TimeUnit.SECONDS);
+      return false;
+    } catch (ExecutionException failure) {
+      return failure.getCause() instanceof TopicAuthorizationException;
+    }
+  }
+
+  private AclBinding binding(ResourcePattern pattern, AclOperation operation, AclPermissionType permission) {
+    return new AclBinding(pattern, new AccessControlEntry(PRINCIPAL, "*", operation, permission));
+  }
+
+  /** Deletes only this independent cluster and verifies no owned Docker resource remains. */
+  @Override
+  public void close() throws Exception {
+    try {
+      try {
+        admin.close(Duration.ofSeconds(10));
+      } finally {
+        if (hasStarted) {
+          compose.command("down", "--volumes", "--remove-orphans");
+          compose.certifyAbsent();
+        }
+      }
+    } finally {
+      Files.deleteIfExists(environmentFile);
+    }
+  }
+}
