+  /** Posts exact JSON for malformed-input and wire compatibility scenarios. */
+  public HttpResponse<String> postJson(String path, String body) throws Exception {
+    HttpRequest request = HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + path))
+        .timeout(Duration.ofSeconds(45)).header("Content-Type", "application/json")
+        .POST(HttpRequest.BodyPublishers.ofString(body)).build();
+    boolean asynchronous = "/triggers/actions".equals(path) || "/triggers/deployments".equals(path);
+    persistIntent();
+    if (asynchronous) {
+      synchronized (this) {
+        markAsyncDispatchAtPort(port);
+        inFlightAsyncRequests.incrementAndGet();
+      }
+    }
+    try {
+      return http.send(request, HttpResponse.BodyHandlers.ofString());
+    } finally {
+      if (asynchronous) {
+        inFlightAsyncRequests.decrementAndGet();
+      }
+    }
+  }
