+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+/** Only explicitly declared nonprod targets are accepted by the managed capability gate. */
+final class ManagedGateInputs {
+  private ManagedGateInputs() {}
+
+  static String required(String name) {
+    String value = System.getenv(name);
+    if (value == null || value.isBlank()) {
+      throw new IllegalStateException("MANAGED_REQUIRED_INPUT:" + name);
+    }
+    return value;
+  }
+
+  static void requireNonprodScope() {
+    String scope = required("E2E_MANAGED_SCOPE");
+    if (!scope.matches("[a-z0-9_-]{1,100}")
+        || !(scope.contains("test") || scope.contains("nonprod"))
+        || scope.matches(".*(^|[-_])(prod|production|stage|staging|stg)([-_]|$).*")) {
+      throw new IllegalStateException("MANAGED_EXPLICIT_NONPROD_SCOPE_REQUIRED");
+    }
+    if ("local".equalsIgnoreCase(System.getenv("SCOPE"))) {
+      throw new IllegalStateException("MANAGED_FILE_BIGQUEUE_PROFILE_FORBIDDEN");
+    }
+  }
+}
