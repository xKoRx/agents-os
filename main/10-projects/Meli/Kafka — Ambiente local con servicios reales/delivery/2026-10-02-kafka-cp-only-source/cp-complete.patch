+  private void positionResultConsumer() {
+    results.subscribe(List.of(requiredEnv("E2E_DEPLOYMENT_RESULT_TOPIC"), requiredEnv("E2E_ACTION_RESULT_TOPIC")));
+    Awaitility.await().atMost(DEADLINE).until(() -> {
+      drain(POLL);
+      return !results.assignment().isEmpty();
+    });
+  }
