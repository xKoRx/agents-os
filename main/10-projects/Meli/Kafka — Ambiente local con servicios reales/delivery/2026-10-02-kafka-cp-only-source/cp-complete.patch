diff --git a/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eKvsMutationJournalTest.java b/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eKvsMutationJournalTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..40ae504f580a2c94bc873bc9d986b3516ff84f80
