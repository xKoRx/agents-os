+#!/usr/bin/env python3
+"""Physical private filesystem checks only; not a business E2E certificate."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+with tempfile.TemporaryDirectory(prefix='rio-reconciliation-status-') as temporary:
+    root = Path(temporary)
+    clean = root / 'clean'
+    clean.mkdir(mode=0o700)
+    retained = root / 'retained'
+    retained.mkdir(mode=0o700)
+    (retained / 'owned.json').write_text('{}\n')
+    public = root / 'public'
+    public.mkdir(mode=0o755)
+    public.chmod(0o755)  # CI umask077 must not turn this negative fixture into a private directory.
+    linked = root / 'linked'
+    linked.symlink_to(clean, target_is_directory=True)
+    file = root / 'file'
+    file.touch()
+    cases = [('empty-owned', clean, 0), ('retained', retained, 1), ('missing', root/'missing', 2),
+             ('public-mode', public, 2), ('symlink', linked, 2), ('file', file, 2), ('relative', Path('relative'), 2)]
+    for label, path, expected in cases:
+        result = subprocess.run([sys.executable, str(ROOT/'e2e/reconciliation-status.py'), str(path)],
+                                capture_output=True, text=True, timeout=10)
+        if result.returncode != expected:
+            raise SystemExit(f'RECONCILIATION_INSPECTION_FAIL:{label}:{result.returncode}')
+        if str(root) in result.stdout + result.stderr:
+            raise SystemExit(f'RECONCILIATION_INSPECTION_FAIL:{label}:private-path-exposed')
+        print(f'RECONCILIATION_INSPECTION_PASS:{label}')
