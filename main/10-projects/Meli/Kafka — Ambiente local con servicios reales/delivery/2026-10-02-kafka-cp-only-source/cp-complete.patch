+  private JsonNode deploy() throws Exception {
+    HttpResponse<String> response = request("POST", database.deploymentPath(), Map.of("definition_id", database.definitionId()), true);
+    assertEquals(201, response.statusCode(), "Check genuine Tiger identity/ACME owner-project grants; no auth bypass is permitted");
+    return mapper.readTree(response.body());
+  }
+
+  private OwnedPlaymakerDatabase.Snapshot awaitDeployment(String expected) throws Exception {
+    Awaitility.await().atMost(DEADLINE)
+        .ignoreExceptionsMatching(failure -> failure instanceof IllegalStateException
+            && "E2E_DEPLOYMENT_NOT_YET_PERSISTED".equals(failure.getMessage()))
+        .untilAsserted(() -> assertEquals(expected, database.latest().status()));
+    return database.latest();
+  }
+
+  private OwnedPlaymakerDatabase.Snapshot awaitRequestedDeployment(JsonNode requested, String status) {
+    long id = requested.path("id").asLong();
+    Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+      var current = database.latest();
+      assertEquals(id, current.id());
+      assertEquals(status, current.status());
+    });
+    try {
+      return database.latest();
+    } catch (Exception exception) {
+      throw new IllegalStateException("E2E_REQUESTED_DEPLOYMENT_READ_FAILED", exception);
+    }
+  }
+
+  private JsonNode assertCorrelatedOutcome(String provider, OwnedPlaymakerDatabase.Snapshot deployment, String status) throws Exception {
+    assertFalse(deployment.correlationId().isBlank());
+    UUID id = UUID.fromString(deployment.correlationId());
+    String key = (provider.equals("gcp-kafka-topic") ? "gcp-deployment:" : "deployment:") + id;
+    fixture.registerKey(key);
+    JsonNode event = fixture.awaitDeployment(id);
+    assertEquals(status, event.path("status").asString());
+    assertEquals(provider, event.path("component_type").asString());
+    fixture.awaitKvs(key, status);
+    return event;
+  }
+
+  private HttpResponse<String> request(String method, String path, Object body, boolean authenticated) throws Exception {
+    HttpRequest.Builder builder = HttpRequest.newBuilder(playmaker.resolve(path)).timeout(Duration.ofSeconds(15));
+    if (authenticated) {
+      String token = OwnedPlaymakerDatabase.required("E2E_PLAYMAKER_TIGER_TOKEN");
+      builder.header("X-Tiger-Token", token.startsWith("Bearer ") ? token : "Bearer " + token);
+    }
+    if (body != null) {
+      builder.header("Content-Type", "application/json");
+    }
+    builder.method(method, body == null ? HttpRequest.BodyPublishers.noBody()
+        : HttpRequest.BodyPublishers.ofString(mapper.writeValueAsString(body)));
+    UUID intent = null;
+    if (lifecycle != null && List.of("POST", "PUT", "PATCH", "DELETE").contains(method)) {
+      intent = lifecycle.beforeHttpDispatch(method, path);
+    }
+    try {
+      HttpResponse<String> response = http.send(builder.build(), HttpResponse.BodyHandlers.ofString());
+      if (intent != null) {
+        Map<String, String> ids = new LinkedHashMap<>();
+        if (response.statusCode() == 201 && path.endsWith("/deployments")) {
+          long actualId = mapper.readTree(response.body()).path("id").asLong();
+          if (actualId < 1) { throw new IllegalStateException("E2E_PM_DEPLOYMENT_RESPONSE_ID_UNKNOWN"); }
+          ids.put("http_deployment." + actualId, Long.toString(actualId));
+        }
+        if (response.statusCode() == 202 && path.endsWith("/actions/peek")) {
+          String actualId = mapper.readTree(response.body()).path("action_id").asString();
+          UUID.fromString(actualId);
+          ids.put("action_id", actualId);
+        }
+        lifecycle.recordHttpOutcome(intent, response.statusCode(), ids);
+      }
+      return response;
+    } catch (Exception | AssertionError failure) {
+      if (intent != null) {
+        try { lifecycle.markUnknown("HTTP_DISPATCH_OUTCOME_UNVERIFIED"); }
+        catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      }
+      throw failure;
+    }
+
+  }
+
+  private static URI loopback(String base) {
+    URI uri = URI.create(base);
+    if (!"http".equals(uri.getScheme()) || !"127.0.0.1".equals(uri.getHost()) || uri.getPort() < 1024
+        || uri.getUserInfo() != null || uri.getQuery() != null || uri.getFragment() != null) {
+      throw new IllegalArgumentException("E2E_API_MUST_BE_EXPLICIT_OWNED_LOOPBACK_ENDPOINT");
+    }
+    return uri;
+  }
+
+  private void evidence(String scenario, Map<String, Object> proof) throws Exception {
+    Map<String, Object> record = new LinkedHashMap<>(proof);
+    record.put("run_id", OwnedPlaymakerDatabase.required("E2E_RUN_ID"));
+    record.put("scenario", scenario);
+    record.put("status", "ASSERTIONS_PASSED");
+    pendingEvidence.add(record);
+  }
+}
