+  /** CROSS-HEADER-CORRELATION: observe real async MDC; approval of the upstream header remains external. */
+  @ParameterizedTest
+  @MethodSource("correlationHeaders")
+  void currentConfiguredHeaderPropagatesActualSanitizedMdcIntoAsyncResultPublication(String variant, String header) throws Exception {
+    String topic = fixture.uniqueTopic("correlation");
+    var trigger = fixture.trigger(DeploymentOperation.PROVISION, MSK, fixture.paramsFor(MSK, topic, 1, (short) 1));
+    Logger logger = (Logger) LoggerFactory.getLogger(DeploymentResultPublisher.class);
+    Level previous = logger.getLevel();
+    ObservedLogs logs = new ObservedLogs(trigger.deploymentId().toString());
+    logs.setContext(logger.getLoggerContext());
+    logs.start();
+    logger.addAppender(logs);
+    logger.setLevel(Level.INFO);
+    try {
+      Map<String, String> headers = header == null ? Map.of()
+          : Map.of(environment.getRequiredProperty("tracing.correlation.header"), header);
+      assertEquals(200, send("/triggers/deployments", mapper.writeValueAsString(Map.of("msg", trigger)), "application/json", headers).statusCode());
+      assertEquals("COMPLETED", fixture.awaitDeployment(trigger.deploymentId()).path("status").asString());
+      fixture.awaitKvs("deployment:" + trigger.deploymentId(), "COMPLETED");
+      Awaitility.await().atMost(Duration.ofSeconds(5)).until(() -> !logs.correlations.isEmpty());
+      String expected = header == null ? logs.correlations.peek() : header.substring(0, Math.min(128, header.length())).replaceAll("[^A-Za-z0-9._:-]", "_");
+      if (header == null) { UUID.fromString(expected); }
+      assertTrue(logs.correlations.stream().allMatch(expected::equals), "Actual async publisher must retain the request's sanitized correlation id");
+    } finally {
+      logger.detachAppender(logs);
+      logger.setLevel(previous);
+      logs.stop();
+    }
+  }
