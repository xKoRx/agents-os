+  @Test
+  void unauthenticatedRequestCannotCreateDeployment() throws Exception {
+    String topic = fixture.uniqueTopic("playmaker_auth");
+    database.seed("aws-msk-topic", mapper.writeValueAsString(fixture.paramsFor("aws-msk-topic", topic, 1, (short) 1)));
