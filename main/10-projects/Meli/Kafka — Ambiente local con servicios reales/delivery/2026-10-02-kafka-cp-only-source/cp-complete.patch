+++ b/src/managedIntegrationTest/resources/fury_bigqueue_observer.py
@@ -0,0 +1,29 @@
+# Read-only current Fury ServicesApi routes; no pause, forward, callback or service mutation.
+import json,os,re,sys
+from cli_services.services_commands.rest.servicesapi import ServicesApi
+application,topic,consumer,probe_id=sys.argv[1:]
+if application!='rio-controlplane-kafka' or not all(re.fullmatch(r'[a-zA-Z0-9_-]{1,200}',v) for v in (topic,consumer,probe_id)):
+ raise SystemExit('MANAGED_INVALID_OBSERVER_INPUT')
+run_id=os.environ.get('E2E_MANAGED_RUN_ID','')
+if not re.fullmatch(r'[a-z0-9][a-z0-9_-]{7,63}',run_id) or not all(value.startswith('e2e_'+run_id+'_') for value in (topic,consumer)):
+ raise SystemExit('MANAGED_OBSERVER_REQUIRES_RUN_OWNED_NAMES')
+api=ServicesApi()
+def read(route):
+ payload,status=api.make_api_call(route)
+ if status!=200: raise SystemExit('MANAGED_OBSERVER_API_FAILED')
+ return payload
+topic_state=read(f'application/{application}/bigq/topics/{topic}')
+consumer_state=read(f'application/{application}/bigq/consumers/{consumer}')
+if topic_state.get('metadata',{}).get('test') is not True or consumer_state.get('metadata',{}).get('topic')!=topic:
+ raise SystemExit('MANAGED_OBSERVER_REQUIRES_OWN_TEST_TOPIC_CONSUMER')
+messages=read(f'application/{application}/bigq/consumers/{consumer}/peek?amount_of_messages=10')
+def matches(value):
+ if isinstance(value,dict):
+  if value.get('probe_id')==probe_id and value.get('probe_namespace')==run_id: return True
+  return any(matches(child) for child in value.values())
+ if isinstance(value,list): return any(matches(child) for child in value)
+ if isinstance(value,str) and value.startswith('{'):
+  try: return matches(json.loads(value))
+  except (ValueError,TypeError): return False
+ return False
+print(json.dumps({'correlated_probe_observed':matches(messages)}))
