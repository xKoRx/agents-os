+  Map<Integer, Long> endOffsets(String topic) throws Exception {
+    Map<TopicPartition, OffsetSpec> request = new LinkedHashMap<>();
+    for (var partition : describe(topic).partitions()) request.put(new TopicPartition(topic, partition.partition()), OffsetSpec.latest());
+    Map<Integer, Long> observed = new LinkedHashMap<>();
+    for (var entry : admin.listOffsets(request).all().get(30, TimeUnit.SECONDS).entrySet())
+      observed.put(entry.getKey().partition(), entry.getValue().offset());
+    return observed;
+  }
+
+  void awaitAbsent(String topic) throws Exception {
+    requireOwnedTopic(topic);
+    long end = System.nanoTime() + DEADLINE.toNanos();
+    while (System.nanoTime() < end) {
+      if (!admin.listTopics().names().get(30, TimeUnit.SECONDS).contains(topic)) return;
+      TimeUnit.MILLISECONDS.sleep(250);
+    }
+    throw new IllegalStateException("MANAGED_RUN_OWNED_TOPIC_STILL_PRESENT");
+  }
+
+  private void requireOwnedTopic(String topic) {
+    assertTrue(topic.startsWith(prefix) && ownedTopics.contains(topic), "Only this run's ledger topics may be accessed");
+  }
+
+  private void writeLedger(String cleanupState) throws Exception {
+    byte[] bytes = mapper.writeValueAsBytes(Map.of(
+        "run_id", ManagedGateInputs.required("E2E_MANAGED_RUN_ID"), "cleanup_state", cleanupState,
+        "owned_topics", List.copyOf(ownedTopics), "owned_kvs_keys", List.copyOf(ownedKeys),
+        "dispatched_kvs_keys", List.copyOf(dispatchedKeys)));
+    Path pending = Files.createTempFile(cleanupLedger.getParent(), "managed-intent-", ".json",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    try (var channel = java.nio.channels.FileChannel.open(pending, java.nio.file.StandardOpenOption.WRITE)) {
+      var buffer = java.nio.ByteBuffer.wrap(bytes);
+      while (buffer.hasRemaining()) channel.write(buffer);
+      channel.force(true);
+    }
+    Files.move(pending, cleanupLedger, java.nio.file.StandardCopyOption.ATOMIC_MOVE,
+        java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+    forceLedgerDirectory();
+  }
+
+  private void forceLedgerDirectory() throws Exception {
+    try (var channel = java.nio.channels.FileChannel.open(cleanupLedger.getParent(), java.nio.file.StandardOpenOption.READ)) {
+      channel.force(true);
+    }
+  }
+
+  private Map<String, ManagedBusinessResultObserver.Observation> awaitOriginalBusinessReceipts() throws Exception {
+    Set<String> deployments = new LinkedHashSet<>();
+    Set<String> actions = new LinkedHashSet<>();
+    for (String key : dispatchedKeys) {
+      boolean deployment = key.startsWith("gcp-deployment:");
+      String id = key.substring(key.indexOf(':') + 1);
+      (deployment ? deployments : actions).add(id);
+      var kind = deployment ? ManagedBusinessResultObserver.Kind.DEPLOYMENT : ManagedBusinessResultObserver.Kind.ACTION;
+      // Receipt and guard are readiness sensors: terminal originals have already submitted nested action work.
+      // They are not quiescence oracles and do not count independently queued redeliveries.
+      var actual = observer.awaitLifecycle(kind, id);
+      awaitState(key, actual.status());
+    }
+    return observer.snapshotCompleteRun(deployments, actions);
+  }
+
+  private void stopIngressAndDrainOwnedExecutor() throws Exception {
+    assertEquals(port, owningWebContext.getWebServer().getPort());
+    owningWebContext.getWebServer().stop();
+    long listenerDeadline = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+    boolean listenerClosed = false;
+    do {
+      try (Socket connection = new Socket()) {
+        connection.connect(new InetSocketAddress("127.0.0.1", port), 500);
+      } catch (java.net.ConnectException actualClosedListener) {
+        listenerClosed = true;
+        break;
+      }
+      TimeUnit.MILLISECONDS.sleep(100);
+    } while (System.nanoTime() < listenerDeadline);
+    if (!listenerClosed) throw new IllegalStateException("MANAGED_OWN_INGRESS_NOT_VERIFIED_CLOSED");
+
+    // Stop admission first, then wait for original real receipts before shutdown. Immediate shutdown
+    // could reject ActionProcessor's nested supplyAsync on the same productive executor.
+    var baseline = awaitOriginalBusinessReceipts();
+    asyncExecutor.shutdown();
+    if (!asyncExecutor.awaitTermination(DEADLINE.toMillis(), TimeUnit.MILLISECONDS)
+        || !asyncExecutor.isShutdown() || !asyncExecutor.isTerminated()) {
+      throw new IllegalStateException("MANAGED_OWN_ASYNC_EXECUTOR_NOT_VERIFIED_TERMINATED");
+    }
+    // This checks every prior UUID/provider identity after the actual task tree has ended.
+    // A rejected nested task, unknown outcome or late duplicate must retain resources, never certify cleanup.
+    observer.verifyNoAdditionalRunResults(baseline);
+  }
+
+  /** Deletes own resources only after own ingress closes and the real executor terminates. */
+  @Override public void close() throws Exception {
+    try {
+      stopIngressAndDrainOwnedExecutor();
+    } catch (Exception | AssertionError failure) {
+      try { writeLedger("BLOCKED_UNVERIFIED_QUIESCENCE"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      try { producer.close(Duration.ofSeconds(10)); } catch (Exception closeFailure) { failure.addSuppressed(closeFailure); }
+      // No destructive cleanup on an unverified task tree or result window; retain the own-resource ledger.
+      if (failure instanceof InterruptedException) Thread.currentThread().interrupt();
+      throw new IllegalStateException("MANAGED_CLEANUP_BLOCKED_UNVERIFIED_QUIESCENCE:ledger=" + cleanupLedger, failure);
+    }
+    Throwable failure = null;
+    try { producer.close(Duration.ofSeconds(10)); } catch (Exception | AssertionError exception) { failure = accumulate(failure, exception); }
+    for (String topic : List.copyOf(ownedTopics)) {
+      try {
+        requireOwnedTopic(topic);
+        try { admin.deleteTopics(List.of(topic)).all().get(30, TimeUnit.SECONDS); }
+        catch (ExecutionException exception) {
+          if (!(exception.getCause() instanceof UnknownTopicOrPartitionException)) throw exception;
+        }
+        awaitAbsent(topic);
+        ownedTopics.remove(topic);
+      } catch (Exception | AssertionError exception) { failure = accumulate(failure, exception); }
+    }
+    for (String key : List.copyOf(ownedKeys)) {
+      try {
+        assertTrue(key.matches("(gcp-deployment|action):[a-f0-9-]{36}"));
+        kvs.delete(key);
+        assertNull(kvs.get(key), "Actual owned KVS key must be absent after delete");
+        ownedKeys.remove(key);
+      } catch (Exception | AssertionError exception) { failure = accumulate(failure, exception); }
+    }
+    try { observer.close(); } catch (Exception | AssertionError exception) { failure = accumulate(failure, exception); }
+    try {
+      writeLedger(failure == null ? "CLEANED" : "CLEANUP_FAILED");
+      if (failure == null) { Files.delete(cleanupLedger); forceLedgerDirectory(); }
+    } catch (Exception ledgerFailure) { failure = accumulate(failure, ledgerFailure); }
+    if (failure instanceof Error error) throw error;
+    if (failure instanceof Exception exception)
+      throw new IllegalStateException("MANAGED_CLEANUP_FAILED:ledger=" + cleanupLedger, exception);
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) return next;
+    first.addSuppressed(next);
+    return first;
+  }
+}
