+  public synchronized void beforeSqlMutation(Map<String, Long> rowIds) throws Exception {
+    requireRunning();
+    for (var row : rowIds.entrySet()) {
+      if (!row.getKey().matches("[a-zA-Z0-9_.-]{1,128}") || row.getValue() == null || row.getValue() < 1) {
+        throw failure("SQL_IDENTITY_INVALID");
+      }
+      Long previous = sqlIds.putIfAbsent(row.getKey(), row.getValue());
+      if (previous != null && !previous.equals(row.getValue())) { throw failure("SQL_IDENTITY_CHANGED"); }
+    }
+    reason = "BEFORE_SQL_MUTATION";
+    persist();
+  }
+
+  public synchronized UUID beforeHttpDispatch(String method, String path) throws Exception {
+    requireRunning();
+    if (!Set.of("POST", "PUT", "PATCH", "DELETE").contains(method) || !path.startsWith("/")
+        || path.indexOf('\n') >= 0 || path.length() > 512) { throw failure("HTTP_INTENT_INVALID"); }
+    UUID intent = UUID.randomUUID();
+    httpIntents.put(intent, new LinkedHashMap<>(Map.of("method", method, "path", path, "state", "OPEN")));
+    reason = "BEFORE_HTTP_DISPATCH";
+    persist();
+    return intent;
+  }
+
+  public synchronized void recordHttpOutcome(UUID intent, int status, Map<String, String> ids) throws Exception {
+    requireRunning();
+    Map<String, Object> request = httpIntents.get(intent);
+    if (request == null || !"OPEN".equals(request.get("state")) || status < 100 || status > 599) {
+      throw failure("HTTP_RECEIPT_INVALID");
+    }
+    bindObservedResponseIds(ids);
+    request.put("status", status);
+    request.put("state", "RESPONSE_OBSERVED");
+    reason = "ACTUAL_HTTP_RESPONSE_OBSERVED";
+    persist();
+  }
+
+  public synchronized void bindObservedResponseIds(Map<String, String> ids) throws Exception {
+    if (unknown || finished) { throw failure("UNKNOWN_CANNOT_BIND"); }
+    for (var id : ids.entrySet()) {
+      if (!id.getKey().matches("[a-zA-Z0-9_.-]{1,160}")
+          || id.getValue() == null || !id.getValue().matches("[a-zA-Z0-9_-]{1,128}")) {
+        throw failure("OBSERVED_ID_INVALID_NO_GLOBAL_KEY_ADOPTION");
+      }
+      String previous = observedIds.putIfAbsent(id.getKey(), id.getValue());
+      if (previous != null && !previous.equals(id.getValue())) { throw failure("OBSERVED_ID_CHANGED"); }
+    }
+    persist();
+  }
