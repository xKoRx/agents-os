+#!/usr/bin/env python3
+"""Own plaintext Kafka frame proxy; exact Apache Kafka 3.9.2 schemas, no fabricated response.
+
+Authority: apache/kafka tag3.9.2 clients/src/main/resources/common/message/*Request.json
+and generated RequestHeader/DescribeTopicPartitionsRequestData from resolved clients3.9.2.
+Unsupported API/version requests pass byte-for-byte and cannot be armed as certified rules.
+Records/configuration values/client IDs are skipped, never decoded, retained or logged.
+"""
+import argparse
+from collections import Counter, deque
+import http.server
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import socket
+import socketserver
+import struct
+import threading
+import time
+
+MAX_FRAME_BYTES = 32 * 1024 * 1024
+MAX_PENDING = 1024
+# key: (oldest schema version, newest schema version, first flexible version)
+SUPPORTED = {0: (0, 11, 9), 2: (0, 9, 6), 3: (0, 12, 9), 19: (0, 7, 5), 20: (0, 6, 4),
+             32: (0, 4, 4), 37: (0, 3, 2), 44: (0, 1, 1), 75: (0, 0, 0)}
+
+class Cursor:
+    def __init__(self, payload):
+        self.payload = memoryview(payload)
+        self.offset = 0
+
+    def take(self, count):
+        if count < 0 or self.offset + count > len(self.payload):
+            raise ValueError('INVALID_FRAME_BOUNDS')
+        value = self.payload[self.offset:self.offset + count]
+        self.offset += count
+        return value
+
+    def integer(self, format_code):
+        size = struct.calcsize(format_code)
+        return struct.unpack(format_code, self.take(size))[0]
+
+    def varint(self):
+        value = 0
+        for shift in range(0, 35, 7):
+            octet = self.integer('!B')
+            value |= (octet & 127) << shift
+            if not octet & 128:
+                return value
+        raise ValueError('INVALID_UNSIGNED_VARINT')
+
+    def length(self, flexible, old_format='!i', nullable=False):
+        count = self.varint() - 1 if flexible else self.integer(old_format)
+        if count == -1 and nullable:
+            return -1
+        if not 0 <= count <= MAX_FRAME_BYTES:
+            raise ValueError('INVALID_SCHEMA_LENGTH')
+        return count
+
+    def string(self, flexible, nullable=False, decode=True):
+        count = self.length(flexible, '!h', nullable)
+        if count == -1:
+            return None
+        value = self.take(count)
+        return bytes(value).decode('utf-8') if decode else None
+
+    def array(self, flexible, nullable=False):
+        count = self.length(flexible, nullable=nullable)
+        if count > len(self.payload) - self.offset:
+            raise ValueError('INVALID_ARRAY_COUNT')
+        return range(max(0, count))
+
+    def tags(self, flexible):
+        if flexible:
+            for _ in range(self.varint()):
+                self.varint()
+                self.take(self.varint())
+
+    def finish(self):
+        if self.offset != len(self.payload):
+            raise ValueError('UNPARSED_KAFKA_SCHEMA_BYTES')
+
+
+def request_metadata(frame, connection_id):
+    reader = Cursor(frame)
+    api_key = reader.integer('!h')
+    version = reader.integer('!h')
+    correlation = reader.integer('!i')
+    metadata = {'api_key': api_key, 'api_version': version, 'correlation_id': correlation,
+                'connection_id': connection_id, 'topics': frozenset(), 'supported': False, 'has_response': True}
+    specification = SUPPORTED.get(api_key)
+    if not specification or not specification[0] <= version <= specification[1]:
+        return metadata
+    flexible = version >= specification[2]
+    # RequestHeader v2 retains a legacy nullable clientId, followed by tagged fields.
+    reader.string(False, nullable=True, decode=False)
+    reader.tags(flexible)
+    topics = set()
+    if api_key == 0:
+        if version >= 3:
+            reader.string(flexible, nullable=True, decode=False)
+        acks = reader.integer('!h')
+        metadata['has_response'] = acks != 0
+        reader.take(4)
+        for _ in reader.array(flexible):
+            topics.add(reader.string(flexible))
+            for _ in reader.array(flexible):
+                reader.take(4)
+                record_length = reader.length(flexible, nullable=True)
+                if record_length >= 0:
+                    reader.take(record_length)
+                reader.tags(flexible)
+            reader.tags(flexible)
+    elif api_key == 2:
+        reader.take(4)
+        if version >= 2:
+            reader.take(1)
+        for _ in reader.array(flexible):
+            topics.add(reader.string(flexible))
+            for _ in reader.array(flexible):
+                reader.take(4)
+                if version >= 4:
+                    reader.take(4)
+                reader.take(8)
+                if version == 0:
+                    reader.take(4)
+                reader.tags(flexible)
+            reader.tags(flexible)
+    elif api_key == 3:
+        for _ in reader.array(flexible, nullable=version >= 1):
+            if version >= 10:
+                reader.take(16)
+            name = reader.string(flexible, nullable=version >= 10)
+            if name is not None:
+                topics.add(name)
+            reader.tags(flexible)
+        if version >= 4:
+            reader.take(1)
+        if 8 <= version <= 10:
+            reader.take(1)
+        if version >= 8:
+            reader.take(1)
+    elif api_key == 19:
+        for _ in reader.array(flexible):
+            topics.add(reader.string(flexible))
+            reader.take(6)
+            for _ in reader.array(flexible):
+                reader.take(4)
+                for _ in reader.array(flexible):
+                    reader.take(4)
+                reader.tags(flexible)
+            for _ in reader.array(flexible):
+                reader.string(flexible, decode=False)
+                reader.string(flexible, nullable=True, decode=False)
+                reader.tags(flexible)
+            reader.tags(flexible)
+        reader.take(4)
+        if version >= 1:
+            reader.take(1)
+    elif api_key == 20:
+        for _ in reader.array(flexible):
+            name = reader.string(flexible, nullable=version >= 6)
+            if name is not None:
+                topics.add(name)
+            if version >= 6:
+                reader.take(16)
+                reader.tags(flexible)
+        reader.take(4)
+    elif api_key == 32:
+        for _ in reader.array(flexible):
+            resource_type = reader.integer('!b')
+            name = reader.string(flexible)
+            if resource_type == 2:
+                topics.add(name)
+            for _ in reader.array(flexible, nullable=True):
+                reader.string(flexible, decode=False)
+            reader.tags(flexible)
+        if version >= 1:
+            reader.take(1)
+        if version >= 3:
+            reader.take(1)
+    elif api_key == 37:
+        for _ in reader.array(flexible):
+            topics.add(reader.string(flexible))
+            reader.take(4)
+            for _ in reader.array(flexible, nullable=True):
+                for _ in reader.array(flexible):
+                    reader.take(4)
+                reader.tags(flexible)
+            reader.tags(flexible)
+        reader.take(5)
+    elif api_key == 44:
+        for _ in reader.array(flexible):
+            resource_type = reader.integer('!b')
+            name = reader.string(flexible)
+            if resource_type == 2:
+                topics.add(name)
+            for _ in reader.array(flexible):
+                reader.string(flexible, decode=False)
+                reader.take(1)
+                reader.string(flexible, nullable=True, decode=False)
+                reader.tags(flexible)
+            reader.tags(flexible)
+        reader.take(1)
+    elif api_key == 75:
+        for _ in reader.array(flexible):
+            topics.add(reader.string(flexible))
+            reader.tags(flexible)
+        reader.take(4)
+        # The resolved generated reader uses signed readByte()<0 for null Cursor.
+        if reader.integer('!b') >= 0:
+            topics.add(reader.string(flexible))
+            reader.take(4)
+            reader.tags(flexible)
+    reader.tags(flexible)
+    reader.finish()
+    metadata['topics'] = frozenset(topics)
+    metadata['supported'] = True
+    return metadata
+
+
+def read_exact(connection, count):
+    chunks = bytearray()
+    while len(chunks) < count:
+        chunk = connection.recv(min(65536, count - len(chunks)))
+        if not chunk:
+            if not chunks:
+                return None
+            raise OSError('INCOMPLETE_KAFKA_FRAME')
+        chunks.extend(chunk)
+    return bytes(chunks)
+
+
+def read_frame(connection):
+    prefix = read_exact(connection, 4)
+    if prefix is None:
+        return None
+    count = struct.unpack('!i', prefix)[0]
+    if not 4 <= count <= MAX_FRAME_BYTES:
+        raise OSError('KAFKA_FRAME_OUT_OF_BOUNDS')
+    body = read_exact(connection, count)
+    if body is None:
+        raise OSError('INCOMPLETE_KAFKA_FRAME')
+    return prefix, body
+
+class Controller:
+    def __init__(self, run_id):
+        self.run_id = run_id
+        self.condition = threading.Condition()
+        self.rule = None
+        self.closed = False
+        self.next_connection = 0
+        self.connections = {}
+        self.counters = Counter()
+        self.recent = deque(maxlen=32)
+
+    def arm(self, requested):
+        fields = {'api_key', 'api_version', 'correlation_id', 'topic', 'phase', 'action',
+                  'skip_matches', 'hits', 'hold_seconds'}
+        if set(requested) - fields:
+            raise ValueError('INVALID_RULE_FIELDS')
+        specification = SUPPORTED.get(requested.get('api_key'))
+        version = requested.get('api_version')
+        if not specification or not isinstance(version, int) or not specification[0] <= version <= specification[1]:
+            raise ValueError('UNSUPPORTED_KAFKA_API_VERSION')
+        topic = requested.get('topic')
+        if not isinstance(topic, str) or not topic.startswith('e2e_' + self.run_id + '_') or not re.fullmatch(r'[a-zA-Z0-9._-]{1,249}', topic):
+            raise ValueError('EXACT_RUN_TOPIC_REQUIRED')
+        if requested.get('phase') not in ('request', 'response') or requested.get('action') not in ('hold', 'reset'):
+            raise ValueError('INVALID_NETWORK_ACTION')
+        correlation = requested.get('correlation_id')
+        if correlation is not None and (not isinstance(correlation, int) or not -(2**31) <= correlation < 2**31):
+            raise ValueError('INVALID_CORRELATION')
+        if not 0 <= requested.get('skip_matches', 0) <= 10000 or not 1 <= requested.get('hits', 1) <= 1000:
+            raise ValueError('INVALID_MATCH_BUDGET')
+        if not 0 < requested.get('hold_seconds', 60) <= 120:
+            raise ValueError('INVALID_HOLD_DEADLINE')
+        with self.condition:
+            if self.rule and not self.rule['released']:
+                raise ValueError('PREVIOUS_WINDOW_STILL_ARMED')
+            self.rule = dict(requested, released=False, aborted=False, matched=0, reached=0, held=0, expired=0)
+            self.condition.notify_all()
+
+    def observe(self, metadata, phase):
+        with self.condition:
+            self.counters[phase + '_frames'] += 1
+            self.counters['supported_' + phase if metadata['supported'] else 'unsupported_' + phase] += 1
+            observation = {key: metadata[key] for key in ('api_key', 'api_version', 'correlation_id', 'connection_id', 'supported')}
+            observation['phase'] = phase
+            self.recent.append(observation)
+            rule = self.rule
+            if not rule or rule['released'] or phase != rule['phase'] or metadata['api_key'] != rule['api_key']:
+                return None
+            if metadata['api_version'] != rule['api_version'] or rule['topic'] not in metadata['topics']:
+                return None
+            if rule.get('correlation_id') is not None and rule['correlation_id'] != metadata['correlation_id']:
+                return None
+            rule['matched'] += 1
+            if rule['matched'] <= rule.get('skip_matches', 0) or rule['reached'] >= rule.get('hits', 1):
+                return None
+            rule['reached'] += 1
+            rule['last_reached'] = observation
+            self.condition.notify_all()
+            if rule['action'] == 'reset':
+                return 'reset'
+            rule['held'] += 1
+            deadline = time.monotonic() + rule.get('hold_seconds', 60)
+            while not rule['released'] and not self.closed:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    rule['expired'] += 1
+                    rule['held'] -= 1
+                    self.condition.notify_all()
+                    return 'reset'
+                self.condition.wait(remaining)
+            rule['held'] -= 1
+            self.condition.notify_all()
+            return 'reset' if rule['aborted'] or self.closed else None
+
+    def release(self, abort=False):
+        with self.condition:
+            if self.rule:
+                self.rule['released'] = True
+                if abort:
+                    self.rule['aborted'] = True
+            self.condition.notify_all()
+
+    def register(self, client, upstream):
+        with self.condition:
+            self.next_connection += 1
+            identity = self.next_connection
+            self.connections[identity] = (client, upstream)
+            return identity
+
+    def close_pair(self, identity):
+        with self.condition:
+            connections = self.connections.pop(identity, ())
+        for connection in connections:
+            try:
+                connection.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            connection.close()
+
+    def snapshot(self):
+        with self.condition:
+            window = {} if not self.rule else {key: self.rule[key] for key in
+                ('matched', 'reached', 'held', 'expired', 'released', 'aborted')}
+            if self.rule and 'last_reached' in self.rule:
+                window['last_reached'] = dict(self.rule['last_reached'])
+            return {'window': window, 'counters': dict(self.counters), 'recent_frames': list(self.recent),
+                    'active_connections': len(self.connections)}
+
+    def reset_connections(self):
+        with self.condition:
+            identities = tuple(self.connections)
+        for identity in identities:
+            self.close_pair(identity)
+
+class KafkaHandler(socketserver.BaseRequestHandler):
+    def handle(self):
+        controller = self.server.controller
+        identity = None
+        reverse = None
+        pending = {}
+        pending_lock = threading.Lock()
+        try:
+            upstream = socket.create_connection(self.server.target, timeout=5)
+            upstream.settimeout(None)
+            identity = controller.register(self.request, upstream)
+            def responses():
+                try:
+                    while True:
+                        frame = read_frame(upstream)
+                        if frame is None:
+                            break
+                        correlation = struct.unpack_from('!i', frame[1])[0]
+                        with pending_lock:
+                            metadata = pending.pop(correlation, None)
+                        if metadata is None:
+                            with controller.condition:
+                                controller.counters['unpaired_response_frames'] += 1
+                        elif controller.observe(metadata, 'response') == 'reset':
+                            break
+                        self.request.sendall(frame[0] + frame[1])
+                except OSError:
+                    pass
+                finally:
+                    controller.close_pair(identity)
+            reverse = threading.Thread(target=responses, daemon=True)
+            reverse.start()
+            while True:
+                frame = read_frame(self.request)
+                if frame is None:
+                    break
+                if len(frame[1]) < 8:
+                    with controller.condition:
+                        controller.counters['short_request_passthrough'] += 1
+                    upstream.sendall(frame[0] + frame[1])
+                    continue
+                try:
+                    metadata = request_metadata(frame[1], identity)
+                except (ValueError, struct.error, UnicodeDecodeError):
+                    # Parser failure never alters frames. The window cannot claim a certified hit.
+                    api_key, version, correlation = struct.unpack_from('!hhi', frame[1])
+                    metadata = {'api_key': api_key, 'api_version': version, 'correlation_id': correlation,
+                                'connection_id': identity, 'topics': frozenset(), 'supported': False, 'has_response': True}
+                    with controller.condition:
+                        controller.counters['schema_parse_errors'] += 1
+                if metadata['has_response']:
+                    with pending_lock:
+                        if len(pending) >= MAX_PENDING:
+                            # Evict only match metadata; raw request/response bytes keep flowing.
+                            pending.pop(next(iter(pending)))
+                            with controller.condition:
+                                controller.counters['pending_metadata_evictions'] += 1
+                        pending[metadata['correlation_id']] = metadata
+                if controller.observe(metadata, 'request') == 'reset':
+                    break
+                upstream.sendall(frame[0] + frame[1])
+        except OSError:
+            pass
+        finally:
+            if identity is not None:
+                controller.close_pair(identity)
+            if reverse is not None:
+                reverse.join(2)
+
+class KafkaServer(socketserver.ThreadingTCPServer):
+    daemon_threads = True
+    allow_reuse_address = False
+
+class ControlHandler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *_):
+        pass
+
+    def reply(self, payload, status=200):
+        encoded = json.dumps(payload).encode()
+        self.send_response(status)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Length', str(len(encoded)))
+        self.end_headers()
+        self.wfile.write(encoded)
+
+    def do_GET(self):
+        if self.path != '/state':
+            self.reply({'error': 'UNKNOWN_CONTROL'}, 404)
+            return
+        self.reply(self.server.controller.snapshot())
+
+    def do_POST(self):
+        try:
+            size = int(self.headers.get('Content-Length', 0))
+            if not 0 <= size <= 4096:
+                raise ValueError('CONTROL_SIZE_EXCEEDED')
+            requested = json.loads(self.rfile.read(size) or b'{}')
+            controller = self.server.controller
+            if self.path == '/arm':
+                controller.arm(requested)
+            elif self.path == '/release':
+                controller.release()
+            elif self.path == '/abort-held':
+                controller.release(abort=True)
+            elif self.path == '/reset-connections':
+                controller.reset_connections()
+            else:
+                self.reply({'error': 'UNKNOWN_CONTROL'}, 404)
+                return
+            self.reply(controller.snapshot())
+        except (ValueError, TypeError, KeyError):
+            self.reply({'error': 'INVALID_OR_UNSUPPORTED_KAFKA_RULE'}, 400)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--config', required=True)
+    arguments = parser.parse_args()
+    configuration = json.loads(Path(arguments.config).read_text())
+    run_id = configuration['run_id']
+    port = configuration['upstream_port']
+    if not re.fullmatch(r'[a-z0-9][a-z0-9_-]{7,63}', run_id) or not 1024 <= port <= 65535:
+        raise SystemExit('OWNED_KAFKA_CONFIG_REQUIRED')
+    controller = Controller(run_id)
+    excluded = set(configuration.get('excluded_ports', [port]))
+    while True:
+        proxy = KafkaServer(('127.0.0.1', 0), KafkaHandler)
+        if proxy.server_address[1] not in excluded:
+            break
+        proxy.server_close()
+    proxy.target = ('127.0.0.1', port)
+    proxy.controller = controller
+    while True:
+        control = http.server.ThreadingHTTPServer(('127.0.0.1', 0), ControlHandler)
+        if control.server_address[1] not in excluded:
+            break
+        control.server_close()
+    control.daemon_threads = True
+    control.controller = controller
+    ready = Path(configuration['ready_file'])
+    pending = ready.with_suffix('.pending')
+    pending.write_text(json.dumps({'proxy_port': proxy.server_address[1], 'control_port': control.server_address[1]}))
+    os.chmod(pending, 0o600)
+    os.replace(pending, ready)
+    stopped = threading.Event()
+    signal.signal(signal.SIGTERM, lambda *_: stopped.set())
+    signal.signal(signal.SIGINT, lambda *_: stopped.set())
+    proxy_worker = threading.Thread(target=proxy.serve_forever, kwargs={'poll_interval': 0.1}, daemon=True)
+    control_worker = threading.Thread(target=control.serve_forever, kwargs={'poll_interval': 0.1}, daemon=True)
+    proxy_worker.start()
+    control_worker.start()
+    try:
+        stopped.wait()
+    finally:
+        with controller.condition:
+            controller.closed = True
+            controller.condition.notify_all()
+        controller.reset_connections()
+        proxy.shutdown()
+        control.shutdown()
+        proxy.server_close()
+        control.server_close()
+        proxy_worker.join(2)
+        control_worker.join(2)
+
+if __name__ == '__main__':
+    main()
