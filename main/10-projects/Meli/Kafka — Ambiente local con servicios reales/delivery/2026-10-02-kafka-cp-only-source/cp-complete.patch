+      throw new IllegalStateException("OWN_ACTIVE_DEFINITION_MISSING");
+    }
+    return new Definition(Long.parseLong(fields[0]), mapper.readTree(fields[1]));
+  }
+
+  List<Definition> definitions(Component component) throws Exception {
+    List<Definition> definitions = new ArrayList<>();
+    for (String row : query("SELECT id,parameters FROM component_definition WHERE component_id=? ORDER BY id",
+        component.id()).lines().toList()) {
+      String[] fields = row.split("\t", 2);
+      definitions.add(new Definition(Long.parseLong(fields[0]), mapper.readTree(fields[1])));
+    }
+    return List.copyOf(definitions);
+  }
+
+  List<Slot> slots(Component component) throws Exception {
+    List<Slot> slots = new ArrayList<>();
+    for (String row : query("SELECT id,environment_id,component_definition_id,status,COALESCE(CAST(_values AS CHAR),'null')"
+        + " FROM service WHERE component_id=? ORDER BY environment_id,id", component.id()).lines().toList()) {
+      String[] fields = row.split("\t", 5);
+      slots.add(new Slot(Long.parseLong(fields[0]), Long.parseLong(fields[1]), Long.parseLong(fields[2]),
