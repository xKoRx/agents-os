+  /** Parent reconciles only a reaped, verified failed-cleanup child and actual absence of every declared resource. */
+  public synchronized void reconcileCleanupChild(CleanupChildPermit permit, Process child) throws Exception {
+    verifyCleanupChildOutcome(permit, child);
+    Path childJournal = reconciliationDirectory.resolve("retained-" + permit.childJournalId() + ".json");
+    assertTrue(!admin.listTopics().names().get(30, TimeUnit.SECONDS).contains(permit.topic()));
+    for (String key : permit.keys()) { assertTrue(kvs.get(key) == null, "Every declared child key must actually be absent"); }
+    assertTrue(admin.listConsumerGroups().all().get(30, TimeUnit.SECONDS).stream()
+        .noneMatch(group -> permit.childGroup().equals(group.groupId())));
+    awaitOwnedWorkersQuiescent();
+    Files.delete(childJournal);
+    forceDirectory(reconciliationDirectory);
+    cleanupChildPermits.remove(permit.childJournalId());
+    cleanupChildPids.remove(permit.childJournalId());
+    cleanupChildProcesses.remove(permit.childJournalId());
+    persistJournal();
+  }
