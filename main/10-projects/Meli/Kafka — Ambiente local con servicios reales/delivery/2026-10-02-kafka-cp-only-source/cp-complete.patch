+#!/usr/bin/env python3
+"""Control-flow regression only: failed Docker queries never certify teardown.
+
+This invokes the launcher's actual cleanup function with shell command faults;
+it is not a business mock or evidence of a Kafka/KVS/Playmaker E2E run.
+"""
+import pathlib
+import subprocess
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+source = (ROOT / "e2e/run.sh").read_text()
+start = source.index("cleanup() {\n")
+end = source.index("\npublish_evidence() {", start)
+cleanup = source[start:end]
+for fault in ("none", "container-query", "network-query", "volume-query", "leftover"):
+    with tempfile.TemporaryDirectory(prefix="rio-cleanup-contract-") as directory:
+        owned = pathlib.Path(directory)
+        (owned / "private").mkdir()
+        (owned / "reconciliation").mkdir(mode=0o700)
+        script = """set -euo pipefail
+PROJECT=rio-kafka-e2e-contract-only
+stack_started=true
+cp_pid=''
+compose() { return 0; }
+docker() {
+  local kind
+  if [[ "$1" == ps ]]; then kind=container; else kind="$1"; fi
+  printf '%s\\n' "$kind" >>"${EVIDENCE_DIR}/queries"
+  if [[ "${FAULT}" == "${kind}-query" ]]; then return 42; fi
+  if [[ "${FAULT}" == leftover && "$kind" == volume ]]; then echo owned-leftover; fi
+}
+""" + cleanup + "\nresult=0\ncleanup || result=$?\nexit \"$result\"\n"
+        outcome = subprocess.run(["bash", "-c", script], capture_output=True, text=True,
+                                 env={"PATH": "/usr/bin:/bin", "EVIDENCE_DIR": str(owned),
+                                      "RUN_DIR": str(owned / "private"), "FAULT": fault,
+                                      "SCRIPT_DIR": str(ROOT / "e2e"), "E2E_RECONCILIATION_DIR": str(owned / "reconciliation")}, timeout=10)
+        expected = 0 if fault == "none" else 1
+        if outcome.returncode != expected:
+            raise SystemExit(f"CLEANUP_CONTRACT_FAIL:{fault}:exit={outcome.returncode}")
+        queries = (owned / "queries").read_text().splitlines()
+        if queries != ["container", "network", "volume"]:
+            raise SystemExit(f"CLEANUP_CONTRACT_FAIL:{fault}:query-short-circuit")
+        verdict = (owned / "cleanup.txt").read_text()
+        if ("CLEANUP_CERTIFIED:" in verdict) != (fault == "none"):
+            raise SystemExit(f"CLEANUP_CONTRACT_FAIL:{fault}:false-certification")
+        if (owned / "private").exists():
+            raise SystemExit(f"CLEANUP_CONTRACT_FAIL:{fault}:private-directory-remained")
+        print(f"CLEANUP_CONTROL_FLOW_PASS:{fault}")
diff --git a/e2e/tests/controlplane-owner-contract.py b/e2e/tests/controlplane-owner-contract.py
new file mode 100644
index 0000000000000000000000000000000000000000..067571fa355e6f4034561554a9e3d012f2aa4cea
--- /dev/null
+++ b/e2e/tests/controlplane-owner-contract.py
@@ -0,0 +1,309 @@
+#!/usr/bin/env python3
+"""L0 private filesystem, actual JDK processes and loopback ports only; no CP/KVS business."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+import signal
+import socket
+import stat
+import subprocess
+import tempfile
+import time
+import uuid
+
+ROOT = Path(os.environ.get("CP_OWNER_CONTRACT_ROOT", Path(__file__).resolve().parents[2]))
+JAVA_HOME = Path(os.environ["JAVA_HOME"]) if os.environ.get("JAVA_HOME") else None
+JAVA = str(JAVA_HOME / "bin/java") if JAVA_HOME else shutil.which("java")
+JAVAC = str(JAVA_HOME / "bin/javac") if JAVA_HOME else shutil.which("javac")
+JAR = str(JAVA_HOME / "bin/jar") if JAVA_HOME else shutil.which("jar")
+if not all((JAVA, JAVAC, JAR)):
+    raise SystemExit("CP_OWNER_CONTROL_JDK_REQUIRED")
+
+NEUTRAL = r"""
+import java.net.*;
+import java.nio.file.*;
+import java.nio.charset.StandardCharsets;
+public final class NeutralControlChild {
+  public static void main(String[] args) throws Exception {
+    int port = 0;
+    for (String arg: args) if (arg.startsWith("--server.port=")) port = Integer.parseInt(arg.substring(14));
+    Path control = Path.of(NeutralControlChild.class.getProtectionDomain().getCodeSource().getLocation().toURI()).getParent();
+    if (Files.exists(control.resolve("HOLD_TERM"))) Runtime.getRuntime().addShutdownHook(new Thread(() -> {
+      for (;;) try { Thread.sleep(1000); } catch (InterruptedException ignored) { }
+    }));
+    if (Files.exists(control.resolve("TERM_DELAY"))) Runtime.getRuntime().addShutdownHook(new Thread(() -> {
+      try { Thread.sleep(2000); } catch (InterruptedException ignored) { }
+    }));
+    try (ServerSocket server = new ServerSocket()) {
+      server.setReuseAddress(true);
+      server.bind(new InetSocketAddress(InetAddress.getByName("127.0.0.1"), port));
+      for (;;) try (Socket socket = server.accept()) {
+        byte[] bytes = socket.getInputStream().readNBytes(4);
+        String command = new String(bytes, StandardCharsets.US_ASCII);
+        if (command.equals("ZERO")) System.exit(0);
+        if (command.equals("FAIL")) System.exit(79);
+        socket.getOutputStream().write("L0OK".getBytes(StandardCharsets.US_ASCII));
+      }
+    }
+  }
+}
+"""
+
+
+def wait_until(predicate, message, seconds=20):
+    deadline = time.monotonic() + seconds
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(.05)
+    raise AssertionError(message)
+
+
+def closed(port):
+    with socket.socket() as probe:
+        probe.settimeout(.25)
+        try:
+            probe.connect(("127.0.0.1", port))
+            probe.sendall(b"PING")
+            return False
+        except (ConnectionRefusedError, ConnectionResetError):
+            return True
+
+
+def command(port, value):
+    with socket.create_connection(("127.0.0.1", port), timeout=2) as connection:
+        connection.sendall(value.encode())
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+with tempfile.TemporaryDirectory(prefix="rio-cp-owner-l0-", dir="/private/tmp") as directory:
+    workspace = Path(directory)
+    classes = workspace / "classes"
+    classes.mkdir(mode=0o700)
+    subprocess.run([JAVAC, "-d", str(classes), str(ROOT / "e2e/ControlplaneProcessOwner.java")],
+                   check=True, capture_output=True, timeout=30)
+    source = workspace / "NeutralControlChild.java"
+    source.write_text(NEUTRAL)
+    subprocess.run([JAVAC, "-d", str(classes), str(source)], check=True, capture_output=True, timeout=30)
+    neutral_jar = workspace / "neutral.jar"
+    subprocess.run([JAR, "--create", "--file", str(neutral_jar), "--main-class", "NeutralControlChild",
+                    "-C", str(classes), "NeutralControlChild.class"], check=True, capture_output=True, timeout=30)
+
+    def identity(pid):
+        result = subprocess.run([JAVA, "-cp", str(classes), "ControlplaneProcessOwner", "identity", str(pid)],
+                                check=True, capture_output=True, text=True, timeout=10)
+        return result.stdout.strip().split("\t")
+
+    def run_case(case):
+        case_dir = workspace / case
+        case_dir.mkdir(mode=0o700)
+        control = case_dir / "control"
+        exits = case_dir / "exits"
+        reconciliation = case_dir / "reconciliation"
+        for folder in (control, exits, reconciliation):
+            folder.mkdir(mode=0o700)
+        jar = control / "application.jar"
+        shutil.copyfile(neutral_jar, jar)
+        jar.chmod(0o600)
+        with socket.socket() as free:
+            free.bind(("127.0.0.1", 0))
+            port = free.getsockname()[1]
+        run = "owned_run_" + uuid.uuid4().hex
+        generation = str(uuid.uuid4())
+        parent_pid, parent_start = identity(os.getpid())
+        watched_parent = None
+        if case == "parent-loss":
+            watched_parent = subprocess.Popen([JAVA, "-cp", str(classes), "NeutralWatchParent"],
+                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            parent_pid, parent_start = identity(watched_parent.pid)
+        props = {"run_id": run, "generation_id": generation, "parent_pid": parent_pid,
+                 "parent_start": parent_start, "jar_path": str(jar),
+                 "jar_sha256": hashlib.sha256(jar.read_bytes()).hexdigest(),
+                 "source_commit": "0" * 40, "source_manifest_sha256": "1" * 64,
+                 "port": str(port), "process_exit_directory": str(exits),
+                 "reconciliation_directory": str(reconciliation),
+                 "child_mode": "PRODUCTIVE_CP" if case == "productive-requires-CP" else "NEUTRAL_PROCESS_CONTROL"}
+        if case == "wrong-birth":
+            props["parent_start"] = "1970-01-01T00:00:00Z"
+        if case == "invalid-run":
+            props["run_id"] = "bad"
+        if case == "wrong-jar":
+            props["jar_sha256"] = "f" * 64
+        if case == "forced-stop":
+            (control / "HOLD_TERM").write_bytes(b"")
+            (control / "HOLD_TERM").chmod(0o600)
+        if case == "owner-signal-during-stop":
+            (control / "TERM_DELAY").write_bytes(b"")
+            (control / "TERM_DELAY").chmod(0o600)
+        config = control / "owner.properties"
+        config.write_text("".join(key + "=" + value.replace("\\", "\\\\").replace(":", "\\:") + "\n"
+                                  for key, value in props.items()))
+        config.chmod(0o600)
+        existing = exits / ("process-exit-" + generation + ".json")
+        if case == "existing-exit":
+            existing.write_bytes(b'{"kind":"EXISTING_MUST_BE_PRESERVED"}')
+            existing.chmod(0o600)
+        if case == "public-directory":
+            control.chmod(0o755)
+        if case == "public-config":
+            config.chmod(0o644)
+        if case == "symlink-jar":
+            jar.unlink()
+            jar.symlink_to(neutral_jar)
+        journal = control / "child.json"
+        marker = reconciliation / ("cp-process-owner-" + generation + ".json")
+        owner = None
+        child_pid = None
+        child_start = None
+        checks = 0
+        try:
+            with (case_dir / "owner.log").open("wb") as log:
+                owner = subprocess.Popen([JAVA, "-cp", str(classes), "ControlplaneProcessOwner", "serve", str(control)],
+                                         stdout=log, stderr=log)
+            prefork = case in ("productive-requires-CP", "wrong-birth", "wrong-jar", "existing-exit",
+                               "public-directory", "public-config", "symlink-jar", "invalid-run")
+            if prefork:
+                assert owner.wait(timeout=10) == 1
+                checks += 1
+                assert closed(port)
+                checks += 1
+                assert not journal.exists()
+                checks += 1
+                if case == "existing-exit":
+                    assert existing.read_bytes() == b'{"kind":"EXISTING_MUST_BE_PRESERVED"}'
+                    checks += 1
+                if case in ("productive-requires-CP", "wrong-birth", "wrong-jar", "existing-exit", "symlink-jar"):
+                    assert read_json(marker)["phase"] == "UNKNOWN"
+                    checks += 1
+                return checks
+            wait_until(lambda: journal.exists() and read_json(journal).get("phase") == "RUNNING",
+                       "ACTUAL_CHILD_NOT_REGISTERED")
+            control_record = read_json(journal)
+            child_pid = control_record["pid"]
+            child_start = control_record["process_start_instant"]
+            assert child_pid > 0 and child_pid != owner.pid
+            checks += 1
+            assert control_record["process_owner_pid"] == owner.pid
+            checks += 1
+            assert control_record["process_start_instant"] == identity(child_pid)[1]
+            checks += 1
+            assert control_record["child_mode"] == "NEUTRAL_PROCESS_CONTROL"
+            checks += 1
+            assert stat.S_IMODE(journal.stat().st_mode) == 0o600
+            checks += 1
+            wait_until(lambda: not closed(port), "OWN_CHILD_PORT_NOT_OPEN")
+            if case == "natural-zero":
+                command(port, "ZERO")
+            elif case == "unsafe-exit":
+                command(port, "FAIL")
+            elif case == "unsolicited-child-term":
+                os.kill(child_pid, signal.SIGTERM)
+            elif case == "parent-loss":
+                watched_parent.terminate()
+                watched_parent.wait(timeout=5)
+            elif case == "owner-signal":
+                owner.terminate()
+            elif case == "changed-jar":
+                with jar.open("ab") as output:
+                    output.write(b"changed")
+                    output.flush()
+                    os.fsync(output.fileno())
+            elif case == "changed-config":
+                with config.open("a") as output:
+                    output.write("changed=true\n")
+                    output.flush()
+                    os.fsync(output.fileno())
+            elif case == "changed-journal":
+                journal.write_text('{"phase":"FAKE_STOPPED"}')
+            elif case == "journal-write-failure":
+                journal.unlink()
+                journal.mkdir(mode=0o700)
+            elif case == "exit-write-failure":
+                existing.mkdir(mode=0o700)
+                stop = control / "STOP"
+                stop.write_text(run)
+                stop.chmod(0o600)
+            else:
+                stop = control / "STOP"
+                stop.write_text("foreign_run_123456" if case == "wrong-stop" else run)
+                stop.chmod(0o600)
+                if case == "owner-signal-during-stop":
+                    wait_until(lambda: read_json(journal).get("phase") == "STOP_REQUESTED", "STOP_INTENT_NOT_OBSERVED")
+                    owner.terminate()
+            owner_code = owner.wait(timeout=55)
+            expected_healthy = case in ("normal", "natural-zero")
+            assert owner_code == (0 if expected_healthy else 1), (case, owner_code)
+            checks += 1
+            assert closed(port)
+            checks += 1
+            # An independent native lookup must find the exact reaped child absent.
+            lookup = subprocess.run([JAVA, "-cp", str(classes), "ControlplaneProcessOwner", "identity", str(child_pid)],
+                                    capture_output=True, timeout=10)
+            assert lookup.returncode != 0
+            checks += 1
+            if case != "exit-write-failure":
+                receipt = read_json(existing)
+                assert receipt["kind"] == "OWNED_GENERATION_PROCESS_EXIT" and receipt["schema_version"] == 1
+                checks += 1
+                assert receipt["pid"] == child_pid and receipt["process_owner_pid"] == owner.pid
+                checks += 1
+                assert receipt["exit_proof"] == "ACTUAL_PROCESS_WAIT_FOR" and receipt["process_owner_kind"] == "DIRECT_PROCESS_WAIT"
+                checks += 1
+                assert receipt["child_mode"] == "NEUTRAL_PROCESS_CONTROL"
+                checks += 1
+                assert receipt["forced_stop"] is (case == "forced-stop")
+                checks += 1
+                expected_exit = 0 if case == "natural-zero" else (79 if case == "unsafe-exit" else (137 if case == "forced-stop" else 143))
+                assert receipt["exit_status"] == expected_exit
+                checks += 1
+                assert stat.S_IMODE(existing.stat().st_mode) == 0o600
+                checks += 1
+            if expected_healthy:
+                assert not marker.exists() and read_json(journal)["phase"] == "STOPPED"
+                checks += 1
+            else:
+                assert read_json(marker)["phase"] == "UNKNOWN"
+                checks += 1
+                assert read_json(marker)["run_id"] == run and read_json(marker)["generation_id"] == generation
+                checks += 1
+                assert stat.S_IMODE(marker.stat().st_mode) == 0o600
+                checks += 1
+            return checks
+        finally:
+            # Driver cleanup targets only processes created in this exact case.
+            if owner is not None and owner.poll() is None:
+                owner.terminate()
+                try:
+                    owner.wait(timeout=50)
+                except subprocess.TimeoutExpired:
+                    owner.kill()
+                    owner.wait(timeout=5)
+            if child_pid is not None and not closed(port):
+                assert identity(child_pid) == [str(child_pid), child_start], "OWN_CHILD_CLEANUP_IDENTITY_CHANGED"
+                os.kill(child_pid, signal.SIGKILL)
+                wait_until(lambda: closed(port), "CONTROL_CHILD_CLEANUP_FAILED")
+            if watched_parent is not None and watched_parent.poll() is None:
+                watched_parent.terminate()
+                watched_parent.wait(timeout=5)
+
+    # This real JVM is merely a watched owner identity, never an application or backend.
+    parent_source = workspace / "NeutralWatchParent.java"
+    parent_source.write_text("public final class NeutralWatchParent { public static void main(String[] args) throws Exception { Thread.sleep(120000); } }")
+    subprocess.run([JAVAC, "-d", str(classes), str(parent_source)], check=True, capture_output=True, timeout=30)
+    cases = ("normal", "natural-zero", "unsafe-exit", "unsolicited-child-term", "parent-loss", "owner-signal", "owner-signal-during-stop",
+             "wrong-stop", "changed-jar", "changed-config", "changed-journal", "journal-write-failure",
+             "exit-write-failure", "forced-stop", "productive-requires-CP", "wrong-birth", "wrong-jar",
+             "existing-exit", "public-directory", "public-config", "symlink-jar", "invalid-run")
+    results = []
+    for case in cases:
+        checks = run_case(case)
+        results.append({"case": case, "checks": checks, "status": "PASS"})
+        print(json.dumps(results[-1], separators=(",", ":")), flush=True)
+    print(json.dumps({"scope": "L0_PRIVATE_FS_NATIVE_PROCESS_LOOPBACK_ONLY", "cases": len(results),
+                      "checks": sum(result["checks"] for result in results), "business_executed": False,
+                      "status": "PASS"}, separators=(",", ":")), flush=True)
