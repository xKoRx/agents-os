+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.fury.toolkit.kvs.KvsClient;
+import com.fury.toolkit.shared.SegmentationUtils;
+import com.mercadolibre.rio_controlplane_kafka.config.KvsConfig;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Locale;
+
+/** Standalone suite access to the exact production Toolkit builder and generated sandbox exports. */
+public final class RealE2eKvsClientFactory {
+  private RealE2eKvsClientFactory() {}
+
+  /** Creates the real production client; endpoints/auth retain Toolkit's normal config resolution. */
+  public static KvsClient create(String containerName, String segmentId, int timeoutMs) {
+    requireSandboxMapping(containerName, segmentId == null ? "" : segmentId);
+    return new KvsConfig().idempotencyKvsClient(timeoutMs, containerName, segmentId == null ? "" : segmentId);
+  }
+
+  /** Requires a generated sandbox physical container behind the configured logical/physical alias. */
+  public static void requireSandboxMapping(String containerName) {
+    requireSandboxMapping(containerName, System.getenv("E2E_KVS_SEGMENT_ID"));
+  }
+
+  /** Validates the exact Toolkit v1/v2 mapping and prevents inherited SCP config overriding it. */
+  public static void requireSandboxMapping(String containerName, String segmentId) {
+    if (containerName == null || !containerName.matches("[a-zA-Z0-9_.-]{1,200}")) {
+      throw new IllegalStateException("REAL_E2E_SANDBOX_CONTAINER_REQUIRED");
+    }
+    requireIsolatedArtifactRoot();
+    String alias = containerName.split("__", 2)[0].replace('-', '_').replace('.', '_').toUpperCase(Locale.ROOT);
+    String base = "KEY_VALUE_STORE_" + alias;
+    String effectiveSegment = segmentId == null || segmentId.isBlank()
+        ? SegmentationUtils.getSegmentId() : segmentId;
+    String versionPrefix = SegmentationUtils.isDefaultSegment(effectiveSegment)
+        ? base : base + "_" + effectiveSegment.toUpperCase(Locale.ROOT);
+    String mappingPrefix = "v2".equals(System.getenv(versionPrefix + "_SEGMENTATION_VERSION"))
+        ? base + "_" + effectiveSegment.toUpperCase(Locale.ROOT) : base;
+    String physical = System.getenv(mappingPrefix + "_CONTAINER_NAME");
+    if (physical == null || !physical.matches("sbox[a-zA-Z0-9_-]+")) {
+      throw new IllegalStateException("REAL_E2E_REQUIRES_GENERATED_FURY_SANDBOX_MAPPING");
+    }
+  }
+
+  /** The normal SCP watcher must see only a fresh empty run-owned directory. */
+  public static void requireIsolatedArtifactRoot() {
+    String root = System.getenv("ARTIFACT_DELIVERY_FILE_PREFIX");
+    if (root == null || !Path.of(root).isAbsolute() || !Files.isDirectory(Path.of(root))) {
+      throw new IllegalStateException("REAL_E2E_ISOLATED_ARTIFACT_ROOT_REQUIRED");
+    }
+    try (var entries = Files.list(Path.of(root))) {
+      if (entries.findAny().isPresent()) {
+        throw new IllegalStateException("REAL_E2E_ARTIFACT_ROOT_MUST_BE_EMPTY");
+      }
+    } catch (IOException exception) {
+      throw new IllegalStateException("REAL_E2E_ARTIFACT_ROOT_UNAVAILABLE");
+    }
+  }
+}
