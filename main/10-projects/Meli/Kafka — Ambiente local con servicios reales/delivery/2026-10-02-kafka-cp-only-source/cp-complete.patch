+  public synchronized void recordDltSend(String probeId, int partition, long offset) throws Exception {
+    requireRunning();
+    Map<String, Object> intent = dltIntents.get(probeId);
+    if (intent == null || !"OPEN".equals(intent.get("state")) || partition < 0 || offset < 0) {
