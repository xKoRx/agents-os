+  private Map<TopicPartition, Long> observeStoppedOffsets() throws Exception {
+    assertProcessAbsent();
+    ResultOffsetSnapshot snapshot = inspectRunOwnedResultOffsets(admin, run, group, resultTopics);
+    offsetReceipt = snapshot.receipt();
+    return snapshot.tails();
+  }
+
+  /** Read-only real Kafka observation; this snapshot alone never grants cleanup or proves PM reap. */
+  public static ResultOffsetSnapshot inspectRunOwnedResultOffsets(AdminClient admin, String run,
+      String group, List<String> resultTopics) throws Exception {
+    if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}") || !group.equals("e2e_" + run + "_playmaker_results")
+        || resultTopics.size() != 2 || resultTopics.stream().anyMatch(topic -> !topic.startsWith("e2e_" + run + "_"))) {
+      throw failure("OFFSET_SCOPE_NOT_EXACT_RUN");
+    }
+    long end = System.nanoTime() + DEADLINE.toNanos();
+    while (true) {
+      try {
+        var description = admin.describeConsumerGroups(List.of(group)).all().get(10, TimeUnit.SECONDS).get(group);
+        if (!description.members().isEmpty()) {
+          if (System.nanoTime() >= end) { throw failure("PM_GROUP_HAS_LIVE_MEMBERS_AFTER_REAP"); }
+          TimeUnit.MILLISECONDS.sleep(100);
+          continue;
+        }
+      } catch (java.util.concurrent.ExecutionException error) {
+        if (!(error.getCause() instanceof GroupIdNotFoundException)) { throw error; }
+      }
+      break;
+    }
+    Set<TopicPartition> partitions = partitions(admin, resultTopics);
+    Map<TopicPartition, Long> latest = offsets(admin, partitions, OffsetSpec.latest());
+    Map<TopicPartition, Long> earliest = offsets(admin, partitions, OffsetSpec.earliest());
+    Map<TopicPartition, OffsetAndMetadata> commits;
+    try { commits = admin.listConsumerGroupOffsets(group).partitionsToOffsetAndMetadata().get(20, TimeUnit.SECONDS); }
+    catch (java.util.concurrent.ExecutionException error) {
+      if (!(error.getCause() instanceof GroupIdNotFoundException)) { throw error; }
+      commits = Map.of();
+    }
+    Map<String, Object> proof = new LinkedHashMap<>();
+    for (TopicPartition partition : partitions) {
+      OffsetAndMetadata committed = commits.get(partition);
+      long tail = latest.get(partition);
+      if (committed == null) {
+        if (tail != 0 || earliest.get(partition) != 0) { throw failure("UNCOMMITTED_RESULT_BACKLOG"); }
+        proof.put(partition.topic() + ":" + partition.partition(),
+            Map.of("earliest", 0L, "latest", 0L, "commit", "NULL_AND_PHYSICALLY_EMPTY"));
+      } else {
+        if (committed.offset() < tail) { throw failure("RESULT_GROUP_BEHIND_TAIL"); }
+        proof.put(partition.topic() + ":" + partition.partition(),
+            Map.of("earliest", earliest.get(partition), "latest", tail, "committed", committed.offset()));
+      }
+    }
+    if (!partitions.equals(partitions(admin, resultTopics))) { throw failure("RESULT_PARTITION_SET_CHANGED"); }
+    return new ResultOffsetSnapshot(latest, proof);
+  }
+
+  private Set<TopicPartition> partitions() throws Exception { return partitions(admin, resultTopics); }
+
+  private static Set<TopicPartition> partitions(AdminClient admin, List<String> resultTopics) throws Exception {
+    var metadata = admin.describeTopics(resultTopics).allTopicNames().get(20, TimeUnit.SECONDS);
+    Set<TopicPartition> partitions = new LinkedHashSet<>();
+    for (String topic : resultTopics) {
+      var description = metadata.get(topic);
+      if (description == null || description.partitions().isEmpty()) { throw failure("RESULT_TOPIC_MISSING"); }
+      description.partitions().forEach(partition -> partitions.add(new TopicPartition(topic, partition.partition())));
+    }
+    return partitions;
+  }
+
+  private static Map<TopicPartition, Long> offsets(AdminClient admin, Set<TopicPartition> partitions, OffsetSpec spec) throws Exception {
+    Map<TopicPartition, OffsetSpec> requests = new LinkedHashMap<>();
+    partitions.forEach(partition -> requests.put(partition, spec));
+    var responses = admin.listOffsets(requests).all().get(20, TimeUnit.SECONDS);
+    Map<TopicPartition, Long> values = new LinkedHashMap<>();
+    for (TopicPartition partition : partitions) {
+      var response = responses.get(partition);
+      if (response == null || response.offset() < 0) { throw failure("OFFSET_OBSERVATION_UNKNOWN"); }
+      values.put(partition, response.offset());
+    }
+    return values;
+  }
+
+  private void verifyLease(boolean alive) throws Exception {
+    JsonNode lease = mapper.readTree(Files.readString(privateFile(identity.leasePath())));
+    if (!"PLAYMAKER_PROCESS_LEASE".equals(lease.path("kind").asString())
+        || !run.equals(lease.path("run_id").asString())
+        || !fixtureId.toString().equals(lease.path("fixture_id").asString())
+        || !identity.generation().toString().equals(lease.path("generation").asString())
+        || identity.pmPid() != lease.path("pm_pid").asLong()
+        || !identity.pmStartInstant().toString().equals(lease.path("pm_start").asString())
+        || !identity.jarPath().toString().equals(lease.path("jar_path").asString())
+        || !identity.jarSha256().equals(lease.path("jar_sha256").asString())
+        || !identity.sourceCommit().equals(lease.path("source_commit").asString())
+        || !identity.sourceManifestSha256().equals(lease.path("source_manifest_sha256").asString())
+        || !group.equals(lease.path("consumer_group").asString())
+        || lease.path("unknown").asBoolean() || lease.path("forced_stop").asBoolean()) {
+      throw failure("LEASE_NOT_EXACT_KNOWN_GENERATION");
+    }
+    if (alive) {
+      ProcessHandle process = ProcessHandle.of(identity.pmPid()).orElseThrow(() -> failure("PM_PID_ABSENT"));
+      if (!process.isAlive() || !process.info().startInstant().map(identity.pmStartInstant()::equals).orElse(false)
+          || !Set.of("REGISTERED", "READY").contains(lease.path("phase").asString())) {
+        throw failure("PM_LIVE_IDENTITY_CHANGED");
+      }
+    } else if (!"STOPPED".equals(lease.path("phase").asString()) || !lease.path("stop_requested").asBoolean()
+        || (lease.path("exit_status").asInt() != 0 && lease.path("exit_status").asInt() != 143)
+        || lease.path("exit_status").asInt() != stoppedExitStatus) { throw failure("LEASE_NOT_SAFE_STOPPED"); }
+  }
+
+  private void assertProcessAbsent() throws Exception {
+    if (identity == null) { throw failure("UNKNOWN_PROCESS_IDENTITY"); }
+    ProcessHandle process = ProcessHandle.of(identity.pmPid()).orElse(null);
+    if (process != null && process.isAlive()) { throw failure("PM_OR_REUSED_PID_STILL_LIVE"); }
+    try (java.net.Socket socket = new java.net.Socket()) {
+      try { socket.connect(new InetSocketAddress(InetAddress.getByName("127.0.0.1"), identity.port()), 250); }
+      catch (java.net.ConnectException refused) { return; }
+      throw failure("PM_LISTENER_STILL_ACCEPTS_CONNECTIONS");
+    }
+  }
+
+  private synchronized void requireRunning() throws Exception {
+    if (unknown || stopped || finished || !"RUNNING".equals(phase)) { throw failure("DISPATCH_BLOCKED"); }
+    verifyLease(true);
+  }
+
+  private void requireOwnedTopic(String topic) throws Exception {
+    if (!topic.startsWith("e2e_" + run + "_") || topic.length() > 249) { throw failure("TOPIC_OUTSIDE_EXACT_RUN"); }
+  }
+
+  private synchronized void persist() throws Exception {
+    try { persistOnce(); }
+    catch (Exception persistenceFailure) {
+      unknown = true;
+      gated = false;
+      phase = "UNKNOWN";
+      reason = "JOURNAL_DURABILITY_UNVERIFIED";
+      try { fixture.retainUnverifiedPlaymakerWork(); }
+      catch (Exception | AssertionError failure) { persistenceFailure.addSuppressed(failure); }
+      try { control("UNKNOWN", "JOURNAL_DURABILITY_UNVERIFIED"); }
+      catch (Exception failure) { persistenceFailure.addSuppressed(failure); }
+      throw persistenceFailure;
+    }
+  }
+
+  private synchronized void persistOnce() throws Exception {
+    privateDirectory(reconciliationDirectory);
+    Map<String, Object> record = new LinkedHashMap<>();
+    record.put("schema_version", 1);
+    record.put("kind", "PLAYMAKER_FIXTURE");
+    record.put("run_id", run);
+    record.put("fixture_id", fixtureId.toString());
+    record.put("fixture_pid", ProcessHandle.current().pid());
+    record.put("fixture_start", ProcessHandle.current().info().startInstant().orElseThrow().toString());
+    record.put("phase", unknown ? "UNKNOWN" : phase);
+    record.put("reason", reason);
+    record.put("unknown", unknown);
+    record.put("sql_ids", Map.copyOf(sqlIds));
+    record.put("observed_ids", Map.copyOf(observedIds));
+    record.put("http_intents", httpIntents.entrySet().stream().collect(java.util.stream.Collectors.toMap(
+        entry -> entry.getKey().toString(), Map.Entry::getValue)));
+    record.put("dlt_intents", dltIntents);
+    record.put("result_topics", resultTopics);
+    record.put("result_group", group);
+    record.put("kafka_bootstrap", bootstrap);
+    record.put("cleanup_absences", List.copyOf(absenceChecks.keySet()));
+    record.put("verified_absences", List.copyOf(completedAbsenceChecks));
+    record.put("offset_receipt", offsetReceipt);
+    record.put("pm_stopped", stopped);
+    record.put("pm_exit_status", stoppedExitStatus);
+    record.put("ordered_gate_verified", gated);
+    record.put("controlplane_closed", controlplaneClosed);
+    record.put("clients_closed", clientsClosed);
+    if (identity != null) {
+      record.put("generation", identity.generation().toString());
+      record.put("pm_pid", identity.pmPid());
+      record.put("pm_start", identity.pmStartInstant().toString());
+      record.put("lease_path", identity.leasePath().toString());
+      record.put("jar_sha256", identity.jarSha256());
+      record.put("source_manifest_sha256", identity.sourceManifestSha256());
+    }
+    Path temporary = Files.createTempFile(reconciliationDirectory, ".pm-fixture-", ".tmp",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    try {
+      try (FileChannel channel = FileChannel.open(temporary, StandardOpenOption.WRITE)) {
+        ByteBuffer data = ByteBuffer.wrap(mapper.writeValueAsBytes(record));
+        while (data.hasRemaining()) { channel.write(data); }
+        channel.force(true);
+      }
+      Files.move(temporary, journal, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      forceDirectory(reconciliationDirectory);
+    } finally { Files.deleteIfExists(temporary); }
+  }
+
+  private String[] control(String... request) throws Exception {
+    List<String> fields = new ArrayList<>();
+    fields.add(property("control_token"));
+    fields.addAll(List.of(request));
+    for (String field : fields) {
+      if (field == null || field.length() > 1024 || field.indexOf('\t') >= 0 || field.indexOf('\n') >= 0) {
+        throw failure("CONTROL_FIELD_INVALID");
+      }
+    }
+    try (SocketChannel channel = SocketChannel.open(StandardProtocolFamily.UNIX)) {
+      channel.configureBlocking(false);
+      Path socket = Path.of(property("socket_path"));
+      privateDirectory(socket.getParent());
+      channel.connect(UnixDomainSocketAddress.of(socket));
+      long deadline = System.nanoTime() + Duration.ofSeconds("START".equals(request[0]) ? 140 : 45).toNanos();
+      while (!channel.finishConnect()) {
+        if (System.nanoTime() >= deadline) { throw failure("CONTROL_CONNECT_TIMEOUT"); }
+        TimeUnit.MILLISECONDS.sleep(10);
+      }
+      byte[] bytes = String.join("\t", fields).getBytes(java.nio.charset.StandardCharsets.UTF_8);
+      ByteBuffer output = ByteBuffer.allocate(4 + bytes.length).putInt(bytes.length).put(bytes);
+      output.flip();
+      transfer(channel, output, true, deadline);
+      ByteBuffer size = ByteBuffer.allocate(4);
+      transfer(channel, size, false, deadline);
+      size.flip();
+      int length = size.getInt();
+      if (length < 1 || length > 8192) { throw failure("CONTROL_RESPONSE_INVALID"); }
+      ByteBuffer input = ByteBuffer.allocate(length);
+      transfer(channel, input, false, deadline);
+      String[] response = new String(input.array(), java.nio.charset.StandardCharsets.UTF_8).split("\t", -1);
+      if (response.length < 2 || !"OK".equals(response[0])) { throw failure("OWNER_REJECTED_OPERATION"); }
+      return response;
+    }
+  }
+
+  private static void transfer(SocketChannel channel, ByteBuffer data, boolean write, long deadline) throws Exception {
+    while (data.hasRemaining()) {
+      int count = write ? channel.write(data) : channel.read(data);
+      if (count < 0 || System.nanoTime() >= deadline) { throw failure("CONTROL_CHANNEL_UNVERIFIED"); }
+      if (count == 0) { TimeUnit.MILLISECONDS.sleep(5); }
+    }
+  }
+
+  private String property(String name) throws Exception {
+    String value = configuration.getProperty(name);
+    if (value == null || value.isBlank()) { throw failure("OWNER_CONFIGURATION_INCOMPLETE"); }
+    return value;
+  }
+
+  private static String required(String name) throws Exception {
+    String value = System.getenv(name);
+    if (value == null || value.isBlank()) { throw failure("CONFIGURATION_MISSING_" + name); }
+    return value;
+  }
+
+  private static void rejectSymlinks(Path path) throws Exception {
+    if (!path.isAbsolute() || !path.normalize().equals(path)) { throw failure("ABSOLUTE_NORMALIZED_PATH_REQUIRED"); }
+    for (Path current = path; current != null; current = current.getParent()) {
+      if (Files.isSymbolicLink(current)) { throw failure("SYMLINK_ANCESTOR_REJECTED"); }
+    }
+  }
+
+  private static Path privateDirectory(Path path) throws Exception {
+    rejectSymlinks(path);
+    if (!Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(path).equals(PosixFilePermissions.fromString("rwx------"))
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).getName().equals(System.getProperty("user.name"))) {
+      throw failure("PRIVATE_DIRECTORY_REQUIRED");
+    }
+    forceDirectory(path);
+    return path;
+  }
+
+  private static Path privateFile(Path path) throws Exception {
+    rejectSymlinks(path);
+    if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(path).equals(PosixFilePermissions.fromString("rw-------"))
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).getName().equals(System.getProperty("user.name"))) {
+      throw failure("PRIVATE_FILE_REQUIRED");
+    }
+    return path;
+  }
+
+  private static void forceDirectory(Path path) throws IOException {
+    try (FileChannel channel = FileChannel.open(path, StandardOpenOption.READ)) { channel.force(true); }
+  }
+
+  /** Stop and close remain independent; this does not delete resources or retire unverified work. */
+  @Override
+  public void close() throws Exception {
+    if (finished) { return; }
+    Throwable failure = null;
+    try {
+      if (!stopped && identity != null) { stopAndReap(Duration.ofSeconds(30)); }
+      if (!unknown) { markUnknown("LIFECYCLE_CLOSED_WITHOUT_VERIFIED_CLEANUP"); }
+    } catch (Exception | AssertionError error) { failure = error; }
+    if (!stopped || identity == null) {
+      try { control("ABORT_FIXTURE", fixtureId.toString()); }
+      catch (Exception error) { failure = accumulate(failure, error); }
+    }
+    if (admin != null) {
+      try { admin.close(Duration.ofSeconds(10)); admin = null; }
+      catch (Exception error) { failure = accumulate(failure, error); }
+    }
+    rethrow(failure);
+  }
+
+  private static IOException failure(String reason) { return new IOException("E2E_PM_" + reason); }
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) { return next; } first.addSuppressed(next); return first;
+  }
+  private static void rethrow(Throwable error) throws Exception {
+    if (error instanceof Error failure) { throw failure; }
+    if (error instanceof Exception failure) { throw failure; }
+  }
+}
