+#!/usr/bin/env python3
+"""Actual launcher/CI control flow only; does not certify business or provider E2E."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+ROOT = Path(os.environ.get('RETENTION_LAUNCHER_ROOT', Path(__file__).resolve().parents[2]))
+
+def function(path, start, end):
+    source = (ROOT / path).read_text()
+    first = source.index(start)
+    return source[first:source.index(end, first)]
+
+functions = {
+    'cp': function('e2e/run.sh', 'cleanup() {\n', '\npublish_evidence() {'),
+    'playmaker': function('e2e/playmaker-runner.sh', 'cleanup_playmaker_e2e() {\n', '\n}') + '\n}',
+    'ci': function('e2e/ci.sh', 'cleanup_owned_sandbox() {\n', '\nrun_local_family() ('),
+    'managed': function('e2e/managed.sh', 'publish_and_cleanup() {\n', '\non_managed_exit() {'),
+}
+for kind, body, mode in [(kind, body, mode) for kind, body in functions.items()
+                         for mode in ("retained", "missing", "public-mode", "symlink")]:
+    with tempfile.TemporaryDirectory(prefix='rio-retention-contract-') as temporary:
+        root = Path(temporary)
+        private = root / 'private'
+        private.mkdir(mode=0o700)
+        (private / 'state.json').write_text('{}\n')
+        reconciliation = root / 'reconciliation'
+        reconciliation.mkdir(mode=0o700)
+        marker = reconciliation / 'retained-own.json'
+        marker.write_text('{"schema_version":1}\n')
+        if mode in ('missing', 'symlink'):
+            moved = root / 'reconciliation-moved'
+            reconciliation.rename(moved)
+            marker = moved / 'retained-own.json'
+            if mode == 'symlink': reconciliation.symlink_to(moved, target_is_directory=True)
+        elif mode == 'public-mode': reconciliation.chmod(0o755)
+        evidence = root / 'build/ci-e2e'
+        evidence.mkdir(parents=True)
+        commands = root / 'destructive-commands'
+        prelude = r'''set -euo pipefail
+PROJECT=rio-kafka-e2e-retention-contract-only
+stack_started=true
+cp_pid=''
+pm_pid=''
+pm_started=true
+sandbox_dir="${RUN_DIR}"
+compose() { echo compose >>"${DESTRUCTIVE}"; }
+pm_compose() { echo mysql >>"${DESTRUCTIVE}"; }
+docker() { echo docker >>"${DESTRUCTIVE}"; }
+stop_process_tree() { echo unexpected-process >>"${DESTRUCTIVE}"; return 1; }
+'''
+        call = {'cp': 'cleanup', 'playmaker': 'cleanup_playmaker_e2e',
+                'ci': 'cleanup_owned_sandbox', 'managed': 'publish_and_cleanup'}[kind]
+        if kind == 'ci':
+            prelude += 'family_dir="${RUN_DIR}"\nfamily_name=cp-functional\nfamily_run=retentiononlyrun\nlauncher_attempted=true\nlauncher_status=0\nsandbox_attempted=true\n'
+        if kind == 'managed':
+            prelude += 'python3() { if [[ "$1" == */sanitize-evidence.py ]]; then return 0; else command python3 "$@"; fi; }\n'  # Do not run unrelated sanitizer in this control-flow assertion.
+        script = prelude + body + '\nresult=0\n' + call + ' || result=$?\nexit "$result"\n'
+        env = {'PATH': '/usr/bin:/bin', 'ROOT': str(root), 'SCRIPT_DIR': str(ROOT / 'e2e'),
+               'RUN_DIR': str(private), 'PRIVATE_DIR': str(private), 'EVIDENCE_DIR': str(evidence),
+               'E2E_RECONCILIATION_DIR': str(reconciliation), 'test_task': 'retention-only',
+               'E2E_FURY_PYTHON': str(root / 'unexpected-sandbox-down'), 'DESTRUCTIVE': str(commands)}
+        down = Path(env['E2E_FURY_PYTHON'])
+        down.write_text('#!/bin/sh\necho sandbox-down >>"${DESTRUCTIVE}"\n')
+        down.chmod(0o700)
+        outcome = subprocess.run(['bash', '-c', script], env=env, capture_output=True, text=True, timeout=10)
+        if outcome.returncode != 1:
+            raise SystemExit(f'RETENTION_CONTRACT_FAIL:{kind}:exit={outcome.returncode}')
+        if commands.exists():
+            raise SystemExit(f'RETENTION_CONTRACT_FAIL:{kind}:destructive-command-called')
+        if not private.is_dir() or not marker.exists():
+            raise SystemExit(f'RETENTION_CONTRACT_FAIL:{kind}:owned-evidence-deleted')
+        if kind == 'cp' and 'CLEANUP_CERTIFIED' in (evidence / 'cleanup.txt').read_text():
+            raise SystemExit('RETENTION_CONTRACT_FAIL:cp:false-certification')
+        if kind == 'ci' and (private / 'sandbox-cleanup.status').read_text() != '1\n':
+            raise SystemExit('RETENTION_CONTRACT_FAIL:ci:false-green-status')
+        print(f'RETENTION_CONTROL_FLOW_PASS:{kind}:{mode}')
