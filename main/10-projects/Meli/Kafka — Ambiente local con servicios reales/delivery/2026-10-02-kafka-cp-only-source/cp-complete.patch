+  private OwnedPlaymakerLifecycle(RealE2eFixture fixture, MutationReceiptVerifier verifier) throws Exception {
+    this.fixture = java.util.Objects.requireNonNull(fixture);
+    this.mutationVerifier = verifier;
+    run = required("E2E_RUN_ID");
+    if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) { throw failure("RUN_ID_INVALID"); }
+    controlDirectory = privateDirectory(Path.of(required("E2E_PLAYMAKER_CONTROL_DIR")));
+    reconciliationDirectory = privateDirectory(Path.of(required("E2E_RECONCILIATION_DIR")));
+    Path config = privateFile(controlDirectory.resolve("owner.properties"));
+    try (var reader = Files.newBufferedReader(config)) { configuration.load(reader); }
+    if (!run.equals(property("run_id"))
+        || !"PRODUCTIVE_PM".equals(property("child_mode"))
+        || !reconciliationDirectory.toString().equals(property("reconciliation_directory"))) {
+      throw failure("OWNER_CONFIGURATION_NOT_EXACT_RUN");
+    }
+    group = "e2e_" + run + "_playmaker_results";
+    if (!group.equals(property("consumer_group"))) { throw failure("EFFECTIVE_GROUP_MISMATCH"); }
+    bootstrap = fixture.bootstrap();
+    if (!bootstrap.equals(required("E2E_BOOTSTRAP_SERVERS"))
+        || !bootstrap.matches("127\\.0\\.0\\.1:[0-9]+(,127\\.0\\.0\\.1:[0-9]+)*")) {
+      throw failure("KAFKA_MUST_BE_OWNED_LOOPBACK");
+    }
+    resultTopics = List.of(required("E2E_DEPLOYMENT_RESULT_TOPIC"), required("E2E_ACTION_RESULT_TOPIC"));
+    for (String topic : resultTopics) { requireOwnedTopic(topic); }
+    journal = reconciliationDirectory.resolve("pm-fixture-" + fixtureId + ".json");
+    persist(); // Durable before Admin clients, guardian START, SQL or HTTP dispatch.
+  }
