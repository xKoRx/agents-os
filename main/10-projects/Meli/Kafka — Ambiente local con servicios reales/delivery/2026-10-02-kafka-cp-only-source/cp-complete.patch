+  private static final class ObservedLogs extends AppenderBase<ILoggingEvent> {
+    private final String id;
+    private final ConcurrentLinkedQueue<String> messages = new ConcurrentLinkedQueue<>();
+    private final ConcurrentLinkedQueue<String> correlations = new ConcurrentLinkedQueue<>();
+    private ObservedLogs(String id) { this.id = id; }
+    @Override
+    protected void append(ILoggingEvent event) {
+      String message = event.getFormattedMessage();
+      messages.add(message);
+      if (message.contains(id)) {
+        String correlation = event.getMDCPropertyMap().get("correlation_id");
+        if (correlation != null) { correlations.add(correlation); }
+      }
+    }
+  }
