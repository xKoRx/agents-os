+#!/usr/bin/env python3
+"""Transport component check against a real stdlib HTTP file server, never KVS storage."""
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import http.client
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+root = Path(__file__).resolve().parents[2]
+run_id = uuid.uuid4().hex
+evidence = root / 'build/real-e2e' / run_id / 'fault-controls'
+evidence.mkdir(parents=True)
+os.chmod(evidence, 0o700)
+ledger = {'run_id': run_id, 'scope': 'transparent HTTP/TCP transport component only',
+          'cp_kvs_pm_managed': 'NOT_EXECUTED', 'upstream': 'stdlib static HTTP file server; no KVS implementation',
+          'assertions': [], 'verdict': 'NOT_EXECUTED'}
+processes = []
+ports = []
+
+def available_port():
+    with socket.socket() as reservation:
+        reservation.bind(('127.0.0.1', 0))
+        return reservation.getsockname()[1]
+
+def await_condition(predicate):
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.02)
+    raise RuntimeError('TRANSPORT_CONDITION_DEADLINE')
+
+def listening(port):
+    with socket.socket() as connection:
+        connection.settimeout(0.2)
+        return connection.connect_ex(('127.0.0.1', port)) == 0
+
+def request(port, method, path, body=None):
+    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=10)
+    try:
+        connection.request(method, path, body)
+        response = connection.getresponse()
+        return response.status, response.read()
+    finally:
+        connection.close()
+
+status = 0
+with tempfile.TemporaryDirectory(prefix='e2e-network-control-') as private:
+    folder = Path(private)
+    token = 'sbox' + run_id
+    artifact = folder / 'containers' / token / 'artifact.txt'
+    artifact.parent.mkdir(parents=True)
+    payload = ('transport-opaque-' + run_id).encode()
+    artifact.write_bytes(payload)
+    upstream_port = available_port()
+    ports.append(upstream_port)
+    access = folder / 'http-access.log'
+    access_log = access.open('wb')
+    upstream = subprocess.Popen([sys.executable, '-m', 'http.server', str(upstream_port), '--bind', '127.0.0.1',
+                                 '--directory', private], stdout=subprocess.DEVNULL, stderr=access_log)
+    processes.append(upstream)
+    ready = folder / 'ready.json'
