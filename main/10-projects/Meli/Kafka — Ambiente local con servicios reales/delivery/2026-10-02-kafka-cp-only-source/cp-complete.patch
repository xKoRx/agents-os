+  void assertTopology(String topic, int partitions, int replication, long retention) throws Exception {
+    long end = System.nanoTime() + DEADLINE.toNanos();
+    do {
+      TopicDescription actual = describe(topic);
+      boolean ready = actual.partitions().size() == partitions && actual.partitions().stream()
+          .allMatch(partition -> partition.replicas().size() == replication && partition.isr().size() == replication);
+      var resource = new ConfigResource(ConfigResource.Type.TOPIC, topic);
+      String actualRetention = admin.describeConfigs(List.of(resource)).all().get(30, TimeUnit.SECONDS)
+          .get(resource).get("retention.ms").value();
+      if (ready && Long.toString(retention).equals(actualRetention)) return;
+      TimeUnit.MILLISECONDS.sleep(250);
+    } while (System.nanoTime() < end);
+    throw new IllegalStateException("MANAGED_OAUTH_TOPOLOGY_OR_CONFIG_EFFECT_NOT_OBSERVED");
+  }
