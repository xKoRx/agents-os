+/** Real authenticated requests, MySQL state, Kafka effects/results and Fury Sandbox KVS. */
+class PlaymakerKafkaE2ETest {
+  private static final Duration DEADLINE = Duration.ofSeconds(90);
+  private final JsonMapper mapper = JsonMapper.builder().findAndAddModules().build();
+  private final HttpClient http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build();
+  private OwnedPlaymakerDatabase database;
+  private RealE2eFixture fixture;
+  private OwnedPlaymakerLifecycle lifecycle;
+  private KvsClient cpKvs;
+  private KvsClient actionKvs;
+  private KvsClient actionLockKvs;
+  private URI playmaker;
+  private String actionId;
+  private boolean bodyFailed;
+  private final List<Map<String, Object>> pendingEvidence = new ArrayList<>();
+  @RegisterExtension
+  final TestExecutionExceptionHandler bodyFailureTracker = (context, failure) -> {
+    bodyFailed = true;
+    throw failure;
+  };
