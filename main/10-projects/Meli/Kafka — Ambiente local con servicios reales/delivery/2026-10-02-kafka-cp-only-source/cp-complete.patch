+  OwnedPipelineDatabase(OwnedPlaymakerLifecycle lifecycle, JsonMapper mapper) throws Exception {
+    this.lifecycle = lifecycle;
+    this.mapper = mapper;
+    container = required("E2E_MYSQL_CONTAINER");
