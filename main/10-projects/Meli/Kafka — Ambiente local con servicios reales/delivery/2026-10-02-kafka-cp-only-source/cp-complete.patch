+  private void start() throws Exception {
+    admin = AdminClient.create(Map.of("bootstrap.servers", bootstrap));
+    ProcessHandle worker = ProcessHandle.current();
+    Instant birth = worker.info().startInstant().orElseThrow(() -> failure("WORKER_BIRTH_UNAVAILABLE"));
+    String[] response = control("START", fixtureId.toString(), Long.toString(worker.pid()), birth.toString());
+    if (response.length != 6 || !"READY".equals(response[1])) { throw failure("START_RECEIPT_INVALID"); }
+    UUID generation = UUID.fromString(response[2]);
+    long pid = Long.parseLong(response[3]);
+    Instant pmStart = Instant.parse(response[4]);
+    Path leasePath = Path.of(response[5]);
+    if (!leasePath.equals(reconciliationDirectory.resolve("pm-lease-" + generation + ".json"))) {
+      throw failure("LEASE_PATH_CHANGED");
+    }
+    int port = Integer.parseInt(property("port"));
+    identity = new FixtureIdentity(run, fixtureId, generation, pid, pmStart, leasePath, port, group,
+        Path.of(property("jar_path")), property("jar_sha256"), property("source_commit"),
+        property("source_manifest_sha256"));
+    verifyLease(true);
+    phase = "RUNNING";
+    reason = "EXACT_PM_GENERATION_REGISTERED";
+    persist();
+    long deadline = System.nanoTime() + DEADLINE.toNanos();
+    while (!groupJoined()) {
+      if (System.nanoTime() >= deadline) { throw failure("ACTUAL_PM_GROUP_JOIN_UNVERIFIED"); }
+      verifyLease(true);
+      TimeUnit.MILLISECONDS.sleep(200);
+    }
+    persist();
+  }
+
+  private boolean groupJoined() throws Exception {
+    try {
+      var description = admin.describeConsumerGroups(List.of(group)).all().get(10, TimeUnit.SECONDS).get(group);
+      Set<TopicPartition> assigned = new LinkedHashSet<>();
+      String clientPrefix = "e2e_" + run + "_pm_" + identity.generation();
+      for (var member : description.members()) {
+        if (!member.clientId().startsWith(clientPrefix)) { throw failure("FOREIGN_RESULT_GROUP_MEMBER"); }
+        assigned.addAll(member.assignment().topicPartitions());
+      }
+      return assigned.containsAll(partitions()) && !description.members().isEmpty();
+    } catch (java.util.concurrent.ExecutionException error) {
+      if (error.getCause() instanceof GroupIdNotFoundException) { return false; }
+      throw error;
+    }
+  }
