+  private void verifyDeniedOwnerProjectGrant(String mrn, String token) throws Exception {
+    int fetched = 0;
+    int total = Integer.MAX_VALUE;
+    for (int page = 1; fetched < total && page <= 100; page++) {
+      String team = URLEncoder.encode(required("E2E_OWNER_TEAM"), StandardCharsets.UTF_8);
+      String identity = URLEncoder.encode(mrn, StandardCharsets.UTF_8);
+      URI target = URI.create("https://acme-api.melioffice.com/grants/owner-project?team_name=" + team
+          + "&identity=" + identity + "&page=" + page + "&page_size=100");
+      var reply = http.send(HttpRequest.newBuilder(target).timeout(DEADLINE).header("X-Tiger-Token", bearer(token)).GET().build(),
+          HttpResponse.BodyHandlers.ofString());
+      assertEquals(200, reply.statusCode(), "Actual ACME availability must precede a role-denial assertion");
+      JsonNode response = mapper.readTree(reply.body());
+      assertTrue(response.path("total_count").isIntegralNumber());
+      total = response.path("total_count").asInt();
+      assertTrue(total >= 0);
+      if (response.path("results").isEmpty() && fetched < total) {
+        throw new IllegalStateException("DENIED_IDENTITY_GRANTS_SHORT_READ");
+      }
+      for (JsonNode grant : response.path("results")) {
+        assertTrue(mrn.equals(grant.path("identity").asString()), "OWNER_PROJECT_IDENTITY_FILTER_UNVERIFIED");
+        if (required("E2E_OWNER_TEAM").equals(grant.path("team_name").asString())
+            && required("E2E_OWNER_PROJECT").equals(grant.path("project").path("name").asString())) {
+          for (JsonNode role : grant.path("roles")) {
+            assertFalse(List.of("admin", "maintainer", "deployer", "committer")
+                .contains(role.path("name").asString().toLowerCase(Locale.ROOT)), "DENIED_IDENTITY_HAS_REQUIRED_ROLE");
+          }
+        }
+      }
+      fetched += response.path("results").size();
+    }
+    assertEquals(total, fetched, "Full actual grants pagination required, never infer denial from a truncated page");
+  }
