+        + "updated_at,created_by,updated_by,deleted_by) VALUES (?,?,?,?,?,'active',?,NOW(),NOW(),'e2e','e2e','')",
+        id, name, "Owned pipeline fixture", required("E2E_OWNER_TEAM"), required("E2E_OWNER_PROJECT"),
+        isPublic ? "public" : "private");
+    query("INSERT INTO pipeline (id,data_product_id,version,created_by,updated_by) VALUES (?,?,0,'e2e','e2e')",
+        product.pipelineId(), id);
