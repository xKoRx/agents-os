@@ -0,0 +1,186 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.fury.toolkit.kvs.KvsClient;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentOperation;
+import com.mercadolibre.rio_controlplane_kafka.Application;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.faults.OwnedKafkaFaults;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.admin.AlterConfigOp;
+import org.apache.kafka.clients.admin.Config;
+import org.apache.kafka.clients.admin.ConfigEntry;
+import org.apache.kafka.clients.admin.NewTopic;
+import org.apache.kafka.common.TopicPartition;
+import org.apache.kafka.common.config.ConfigResource;
+import org.apache.kafka.common.errors.NoReassignmentInProgressException;
+import org.apache.kafka.common.errors.UnknownTopicOrPartitionException;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.test.context.ActiveProfiles;
+import tools.jackson.databind.ObjectMapper;
+
+/** Actual pending RF reassignment reaches the configured one-minute service deadline on owned five-broker Kafka. */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = {"SCOPE_SUFFIX=local", "kafka.bootstrap-servers=${E2E_BOOTSTRAP_SERVERS}",
+        "kafka.provisioning.timeout-minutes=1", "e2e.bridge.enabled=false"})
+@ActiveProfiles({"local", "real-e2e"})
+class RealReplicationDeadlineIntegrationTest {
+  private static final String RATE = "follower.replication.throttled.rate";
+  private static final int BATCH_BYTES = 512 * 1024;
+  private static final int BATCH_COUNT = 32;
+  private record Snapshot(String value, ConfigEntry.ConfigSource source) { }
+  @LocalServerPort private int port;
+  @Autowired private ObjectMapper mapper;
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+  private RealE2eFixture fixture;
+
+  @BeforeEach
+  void openMandatoryRealFiveBrokerClients() throws Exception {
+    fixture = new RealE2eFixture(port, mapper, kvs, RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS"));
+  }
+
+  @AfterEach
+  void removeOnlyRunOwnedTopicAndKvsKeysAfterBrokerRestoration() throws Exception {
+    if (fixture != null) { fixture.close(); }
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"aws-msk-topic", "gcp-kafka-topic"})
+  void actualThrottledRfReassignmentRemainsPendingAtDeadlineAndRestoresBeforeNewId(String provider) throws Throwable {
+    // open validates all five exact compose labels/project and loopback bootstrap before any config mutation.
+    try (OwnedKafkaFaults ownership = OwnedKafkaFaults.open()) {
+      var nodes = fixture.admin().describeCluster().nodes().get(20, TimeUnit.SECONDS);
+      assertEquals(Set.of(1, 2, 3, 4, 5), nodes.stream().map(node -> node.id()).collect(java.util.stream.Collectors.toSet()));
+      String topic = fixture.uniqueTopic("real_rf_deadline");
+      TopicPartition partition = new TopicPartition(topic, 0);
+      Map<ConfigResource, Snapshot> snapshots = snapshotOwnedBrokerRates(nodes.stream().map(node -> node.id()).toList());
+      var params = fixture.paramsFor(provider, topic, 1, (short) 3);
+      var failedTrigger = fixture.trigger(DeploymentOperation.UPDATE, provider, params);
+      Throwable failure = null;
+      try {
+        fixture.admin().createTopics(List.of(new NewTopic(topic, Map.of(0, List.of(1)))
+            .configs(Map.of("retention.ms", "1234567", "follower.replication.throttled.replicas", "*"))))
+            .all().get(20, TimeUnit.SECONDS);
+        String payload = "r".repeat(BATCH_BYTES);
+        assertEquals(BATCH_BYTES, payload.getBytes(StandardCharsets.UTF_8).length);
+        for (int batch = 0; batch < BATCH_COUNT; batch++) {
+          // Waiting for each real ack keeps these uncompressed records in separate physical batches.
+          assertEquals(batch, fixture.seed(topic, 0, "deadline-batch-" + batch, payload));
+        }
+        assertEquals(16L * 1024 * 1024, (long) BATCH_COUNT * BATCH_BYTES);
+        for (ConfigResource broker : snapshots.keySet()) {
+          fixture.admin().incrementalAlterConfigs(Map.of(broker, List.of(new AlterConfigOp(
+              new ConfigEntry(RATE, "1"), AlterConfigOp.OpType.SET)))).all().get(20, TimeUnit.SECONDS);
+          assertEquals("1", brokerConfig(broker).get(RATE).value());
+        }
+        assertEquals("*", fixture.topicConfigs(topic).get("follower.replication.throttled.replicas"));
+        assertEquals(200, fixture.postDeployment(failedTrigger).statusCode());
+        Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> pending(partition));
+        var failed = fixture.awaitDeployment(failedTrigger.deploymentId());
+        assertEquals("FAILED", failed.path("status").asString());
+        assertEquals("TIMEOUT", failed.path("error").path("code").asString());
+        String key = ("gcp-kafka-topic".equals(provider) ? "gcp-deployment:" : "deployment:") + failedTrigger.deploymentId();
+        fixture.awaitKvs(key, "FAILED");
+        var actual = fixture.admin().listPartitionReassignments(Set.of(partition)).reassignments()
+            .get(20, TimeUnit.SECONDS).get(partition);
+        assertNotNull(actual, "FAILED timeout does not cancel the actual outstanding reassignment");
+        assertEquals(3, actual.replicas().size());
+        assertTrue(!actual.addingReplicas().isEmpty());
+        assertEquals(5, fixture.admin().describeCluster().nodes().get(20, TimeUnit.SECONDS).size(),
+            "This is real replication progress failure with all nodes alive, not insufficient-broker validation");
+        assertEquals("1234567", fixture.topicConfigs(topic).get("retention.ms"));
+        assertEquals(200, fixture.postDeployment(failedTrigger).statusCode());
+        fixture.assertNoMoreResults(failedTrigger.deploymentId().toString(), 2, Duration.ofSeconds(1));
+      } catch (Throwable primary) {
+        failure = primary;
+      } finally {
+        // Attempt every cancellation/restoration even if a prior operation or independent assertion failed.
+        try { cancelOnlyOwnedAssignment(partition); }
+        catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+        for (var entry : snapshots.entrySet()) {
+          try { restoreExactBrokerRate(entry.getKey(), entry.getValue()); }
+          catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+        }
+      }
+      if (failure != null) { throw failure; }
+      var recovery = fixture.trigger(DeploymentOperation.PROVISION, provider, params);
+      assertEquals(200, fixture.postDeployment(recovery).statusCode());
+      assertEquals("COMPLETED", fixture.awaitDeployment(recovery.deploymentId()).path("status").asString());
+      fixture.awaitKvs(("gcp-kafka-topic".equals(provider) ? "gcp-deployment:" : "deployment:") + recovery.deploymentId(), "COMPLETED");
+      Awaitility.await().atMost(Duration.ofSeconds(90)).until(() -> fixture.awaitTopic(topic).partitions().stream()
+          .allMatch(value -> value.replicas().size() == 3 && value.isr().size() == 3));
+      assertTrue(!pending(partition));
+    }
+  }
+
+  private Map<ConfigResource, Snapshot> snapshotOwnedBrokerRates(List<Integer> ids) throws Exception {
+    Map<ConfigResource, Snapshot> snapshots = new LinkedHashMap<>();
+    for (int id : ids) {
+      ConfigResource broker = new ConfigResource(ConfigResource.Type.BROKER, Integer.toString(id));
+      Config config = brokerConfig(broker);
+      ConfigEntry rate = config.get(RATE);
+      assertNotNull(rate);
+      assertNotNull(rate.value());
+      // This pinned image's actual fetch/quota windows must keep16MiB physically outstanding beyond60s.
+      assertTrue(Long.parseLong(config.get("replica.fetch.max.bytes").value()) <= 1024 * 1024);
+      assertTrue(Long.parseLong(config.get("replication.quota.window.num").value()) >= 10);
+      assertTrue(Long.parseLong(config.get("replication.quota.window.size.seconds").value()) >= 1);
+      snapshots.put(broker, new Snapshot(rate.value(), rate.source()));
+    }
+    return snapshots;
+  }
+
+  private Config brokerConfig(ConfigResource broker) throws Exception {
+    return fixture.admin().describeConfigs(List.of(broker)).all().get(20, TimeUnit.SECONDS).get(broker);
+  }
+
+  private boolean pending(TopicPartition partition) throws Exception {
+    return fixture.admin().listPartitionReassignments(Set.of(partition)).reassignments()
+        .get(20, TimeUnit.SECONDS).containsKey(partition);
+  }
+
+  private void cancelOnlyOwnedAssignment(TopicPartition partition) throws Exception {
+    try {
+      fixture.admin().alterPartitionReassignments(Map.of(partition, Optional.empty())).all().get(20, TimeUnit.SECONDS);
+    } catch (ExecutionException error) {
+      if (!(error.getCause() instanceof NoReassignmentInProgressException)
+          && !(error.getCause() instanceof UnknownTopicOrPartitionException)) { throw error; }
+    }
+    Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> !pending(partition));
+  }
+
+  private void restoreExactBrokerRate(ConfigResource broker, Snapshot snapshot) throws Exception {
+    boolean directOverride = snapshot.source() == ConfigEntry.ConfigSource.DYNAMIC_BROKER_CONFIG;
+    AlterConfigOp operation = new AlterConfigOp(new ConfigEntry(RATE, directOverride ? snapshot.value() : null),
+        directOverride ? AlterConfigOp.OpType.SET : AlterConfigOp.OpType.DELETE);
+    fixture.admin().incrementalAlterConfigs(Map.of(broker, List.of(operation))).all().get(20, TimeUnit.SECONDS);
+    ConfigEntry restored = brokerConfig(broker).get(RATE);
+    assertEquals(snapshot.value(), restored.value(), "Restore actual original rate value");
+    assertEquals(snapshot.source(), restored.source(), "Restore original SET/DELETE source, not a new override with the same number");
+  }
+
+  private Throwable append(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    first.addSuppressed(next);
+    return first;
+  }
+}
