+/** JDK-only owner of one private CP JVM. Process controls are never business or KVS proof. */
+public final class ControlplaneProcessOwner {
+  private static final long USER_ID = new com.sun.security.auth.module.UnixSystem().getUid();
+  private static final Duration GRACE = Duration.ofSeconds(30);
+  private static final Duration FORCE = Duration.ofSeconds(15);
+  private static final String APPLICATION_ENTRY =
+      "BOOT-INF/classes/com/mercadolibre/rio_controlplane_kafka/Application.class";
+  private static final String OBSERVER_ENTRY =
+      "BOOT-INF/classes/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eKvsObservationConfiguration.class";
+  private final Path directory;
+  private final Path reconciliation;
+  private final Path exits;
+  private final Path jar;
+  private final Path configFile;
+  private final Path childJournal;
+  private final Path marker;
+  private final String run;
+  private final String generation;
+  private final String jarHash;
+  private final String sourceCommit;
+  private final String sourceManifest;
+  private final String mode;
+  private final int port;
+  private final ProcessHandle parent;
+  private final Instant parentBirth;
+  private final long ownerPid = ProcessHandle.current().pid();
+  private final Instant ownerBirth = birth(ProcessHandle.current());
+  private final Fingerprint jarIdentity;
+  private final Fingerprint configIdentity;
+  private final String configHash;
+  private final List<String> reasons = new ArrayList<>();
+  private volatile Process child;
+  private Instant childBirth;
+  private boolean unknown;
+  private boolean forced;
+  private boolean stopRequested;
+  private boolean finalized;
+  private boolean finalHealthy;
+  private Integer exitStatus;
+  private long sequence;
+  private String journalHash;
+  private Fingerprint journalIdentity;
+  private String markerHash;
+  private Fingerprint markerIdentity;
+
+  private ControlplaneProcessOwner(Path requested) throws Exception {
+    directory = privateDirectory(requested);
+    configFile = privateFile(directory.resolve("owner.properties"));
+    configIdentity = fingerprint(configFile);
+    byte[] configuration = Files.readAllBytes(configFile);
+    if (configuration.length > 16_384) { throw invalid(); }
+    configHash = digest(configuration);
+    Properties properties = new Properties();
+    try (var stream = new java.io.ByteArrayInputStream(configuration)) { properties.load(stream); }
+    run = required(properties, "run_id");
+    if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) { throw invalid(); }
+    generation = required(properties, "generation_id");
+    UUID id = UUID.fromString(generation);
+    if (id.version() != 4 || !id.toString().equals(generation)) { throw invalid(); }
+    reconciliation = privateDirectory(Path.of(required(properties, "reconciliation_directory")));
+    exits = privateDirectory(Path.of(required(properties, "process_exit_directory")));
+    if (reconciliation.equals(exits) || directory.equals(reconciliation) || directory.equals(exits)) {
+      throw invalid();
+    }
+    jar = privateFile(Path.of(required(properties, "jar_path")));
+    if (!jar.startsWith(directory) || jar.equals(configFile)) { throw invalid(); }
+    jarHash = required(properties, "jar_sha256");
+    sourceCommit = required(properties, "source_commit");
+    sourceManifest = required(properties, "source_manifest_sha256");
+    if (!jarHash.matches("[a-f0-9]{64}") || !sourceCommit.matches("[a-f0-9]{40}")
+        || !sourceManifest.matches("[a-f0-9]{64}")) { throw invalid(); }
+    mode = properties.getProperty("child_mode", "PRODUCTIVE_CP");
+    if (!List.of("PRODUCTIVE_CP", "NEUTRAL_PROCESS_CONTROL").contains(mode)) { throw invalid(); }
+    port = Integer.parseInt(required(properties, "port"));
+    if (port < 1024 || port > 65535) { throw invalid(); }
+    parent = ProcessHandle.of(Long.parseLong(required(properties, "parent_pid"))).orElseThrow(
+        ControlplaneProcessOwner::invalid);
+    parentBirth = Instant.parse(required(properties, "parent_start"));
+    if (parent.pid() == ownerPid) { throw invalid(); }
+    verifyParent();
+    jarIdentity = fingerprint(jar);
+    verifyInputs(true);
+    childJournal = directory.resolve("child.json");
+    marker = reconciliation.resolve("cp-process-owner-" + generation + ".json");
+    if (Files.exists(childJournal, LinkOption.NOFOLLOW_LINKS)
+        || Files.exists(marker, LinkOption.NOFOLLOW_LINKS)
+        || Files.exists(exits.resolve("process-exit-" + generation + ".json"), LinkOption.NOFOLLOW_LINKS)
+        || Files.exists(directory.resolve("STOP"), LinkOption.NOFOLLOW_LINKS)) { throw invalid(); }
+    // Prove file and directory durability before an owned JVM can be forked.
+    forceFile(configFile);
+    forceFile(jar);
+    durabilityProbe(directory);
+    durabilityProbe(reconciliation);
+    durabilityProbe(exits);
+    persistChild("STARTING");
+  }
+
+  public static void main(String[] args) {
+    if (args.length == 2 && "identity".equals(args[0])) {
+      try {
+        ProcessHandle process = ProcessHandle.of(Long.parseLong(args[1])).orElseThrow(
+            ControlplaneProcessOwner::invalid);
+        System.out.println(process.pid() + "\t" + birth(process));
+        return;
+      } catch (Exception failure) { System.err.println("CP_OWNER_IDENTITY_FAILED"); System.exit(1); }
+    }
+    ControlplaneProcessOwner owner = null;
+    try {
+      if (args.length != 2 || !"serve".equals(args[0])) { throw invalid(); }
+      owner = new ControlplaneProcessOwner(Path.of(args[1]));
+      ControlplaneProcessOwner registered = owner;
+      Thread hook = new Thread(() -> {
+        registered.finish("OWNER_SIGNAL", false);
+        // Unsolicited owner shutdown is UNKNOWN, never the JVM's ordinary SIGTERM exit143.
+        Runtime.getRuntime().halt(1);
+      }, "owned-cp-shutdown");
+      Runtime.getRuntime().addShutdownHook(hook);
+      boolean healthy = owner.serve();
+      try { Runtime.getRuntime().removeShutdownHook(hook); }
+      catch (IllegalStateException shuttingDown) { healthy = false; }
+      if (!healthy) { System.err.println("CP_OWNER_RETAINED"); System.exit(1); }
+    } catch (Exception failure) {
+      if (owner != null) { owner.finish("OWNER_OPERATION_FAILED", false); }
+      else if (args.length == 2 && "serve".equals(args[0])) { bootstrapRetain(Path.of(args[1])); }
+      System.err.println("CP_OWNER_FAILED");
+      System.exit(1);
+    }
+  }
+
+  private boolean serve() throws Exception {
+    launch();
+    while (child.isAlive()) {
+      try {
+        verifyParent();
+        verifyInputs(false);
+        verifyJournal();
+        Path stop = directory.resolve("STOP");
+        if (Files.exists(stop, LinkOption.NOFOLLOW_LINKS)) {
+          if (!run.equals(Files.readString(privateFile(stop)))) {
+            return finish("INVALID_STOP_REQUEST", false);
+          }
+          forceFile(stop);
+          forceDirectory(directory);
+          synchronized (this) { stopRequested = true; persistChild("STOP_REQUESTED"); }
+          return finish(null, true);
+        }
+      } catch (Exception failure) { return finish("OWNER_OBSERVATION_FAILED", false); }
+      child.waitFor(100, TimeUnit.MILLISECONDS);
+    }
+    return finish(null, false);
+  }
+
+  private synchronized void launch() throws Exception {
+    if (finalized || unknown) { throw invalid(); }
+    verifyParent();
+    verifyInputs(true);
+    verifyJournal();
+    if (Files.exists(directory.resolve("STOP"), LinkOption.NOFOLLOW_LINKS)) { throw invalid(); }
+    Path log = directory.resolve("cp-child.log");
+    createPrivate(log, new byte[0]);
+    String java = Path.of(System.getProperty("java.home"), "bin", "java").toString();
+    List<String> command = List.of(java, "-jar", jar.toString(),
+        "--spring.profiles.active=real-e2e", "--e2e.bridge.enabled=true",
+        "--server.port=" + port, "--e2e.kvs-observation.generation=" + generation);
+    child = new ProcessBuilder(command).redirectErrorStream(true).redirectOutput(log.toFile()).start();
+    childBirth = birth(child.toHandle());
+    persistChild("RUNNING");
+  }
+
+  /** Direct Process authority remains available even if all journal storage has failed. */
+  private synchronized boolean finish(String failureReason, boolean requested) {
+    if (failureReason != null) { retain(failureReason); }
+    if (finalized) { return finalHealthy && !unknown; }
+    if (requested && !stopRequested) { retain("STOP_INTENT_NOT_DURABLE"); }
+    Process owned = child;
+    if (owned != null) {
+      boolean interrupted = Thread.interrupted();
+      try {
+        if (owned.isAlive()) {
+          // The actual Process object is authority; no PID lookup is used to signal another JVM.
+          owned.destroy();
+          if (!waitUninterruptibly(owned, GRACE)) {
+            forced = true;
+            retain("FORCED_OWN_PROCESS_STOP");
+            owned.destroyForcibly();
+            if (!waitUninterruptibly(owned, FORCE)) { retain("OWN_PROCESS_REAP_DEADLINE"); }
+          }
+        }
+        if (owned.isAlive()) { retain("OWN_PROCESS_STILL_ALIVE"); }
+        else {
+          exitStatus = owned.waitFor();
+          if (childBirth == null) { retain("CHILD_BIRTH_UNAVAILABLE"); }
+          if (exitStatus != 0 && !(exitStatus == 143 && stopRequested)) {
+            retain("UNEXPECTED_ACTUAL_EXIT");
+          }
+        }
+        try { verifyInputs(true); verifyJournal(); }
+        catch (Exception failedObservation) { retain("FINAL_IDENTITY_OR_JOURNAL_FAILED"); }
+        if (exitStatus != null && childBirth != null) {
+          if (unknown) { retain("PROCESS_EXIT_UNVERIFIED"); }
+          try { writeExitReceipt(); }
+          catch (Exception failedReceipt) { retain("PROCESS_EXIT_RECEIPT_FAILED"); }
+        }
+      } catch (InterruptedException impossible) {
+        interrupted = true;
+        retain("WAIT_FOR_INTERRUPTED");
+      } finally { if (interrupted) { Thread.currentThread().interrupt(); } }
+    } else { retain("CHILD_NOT_FORKED"); }
+    try { persistChild(unknown ? "UNKNOWN" : "STOPPED"); }
+    catch (Exception failedJournal) { retain("FINAL_CHILD_JOURNAL_FAILED"); }
+    finalized = true;
+    finalHealthy = !unknown && !forced && exitStatus != null
+        && (exitStatus == 0 || (exitStatus == 143 && stopRequested));
+    if (!finalHealthy) { retain("OWNER_FINAL_UNVERIFIED"); }
+    return finalHealthy;
+  }
+
+  private static boolean waitUninterruptibly(Process process, Duration deadline) {
+    long end = System.nanoTime() + deadline.toNanos();
+    boolean interrupted = false;
+    try {
+      while (process.isAlive()) {
+        long remaining = end - System.nanoTime();
+        if (remaining <= 0) { return false; }
+        try { process.waitFor(Math.min(TimeUnit.NANOSECONDS.toMillis(remaining) + 1, 200), TimeUnit.MILLISECONDS); }
+        catch (InterruptedException interruption) { interrupted = true; }
+      }
+      return true;
+    } finally { if (interrupted) { Thread.currentThread().interrupt(); } }
+  }
+
+  private void verifyParent() throws Exception {
+    if (!parent.isAlive() || !parentBirth.equals(birth(parent))) { throw invalid(); }
+  }
+
+  private void verifyInputs(boolean fullHash) throws Exception {
+    if (!configIdentity.equals(fingerprint(privateFile(configFile)))
+        || !jarIdentity.equals(fingerprint(privateFile(jar)))) { throw invalid(); }
+    if (fullHash && (!jarHash.equals(digest(Files.readAllBytes(jar)))
+        || !configHash.equals(digest(Files.readAllBytes(configFile))))) { throw invalid(); }
+    if (fullHash && "PRODUCTIVE_CP".equals(mode)) {
+      try (ZipFile archive = new ZipFile(jar.toFile())) {
+        if (archive.getEntry(APPLICATION_ENTRY) == null || archive.getEntry(OBSERVER_ENTRY) == null) {
+          throw invalid();
+        }
+      }
+    }
+  }
+
+  private Map<String, Object> identity() {
+    Map<String, Object> record = new LinkedHashMap<>();
+    record.put("schema_version", 1);
+    record.put("run_id", run);
+    record.put("generation_id", generation);
+    record.put("application", "CP");
+    record.put("child_mode", mode);
+    record.put("pid", child == null ? null : child.pid());
+    record.put("start_instant", childBirth == null ? null : childBirth.toString());
+    record.put("process_start_instant", childBirth == null ? null : childBirth.toString());
+    record.put("process_owner_pid", ownerPid);
+    record.put("process_owner_start_instant", ownerBirth.toString());
+    record.put("parent_pid", parent.pid());
+    record.put("parent_start_instant", parentBirth.toString());
+    record.put("jar_path", jar.toString());
+    record.put("jar_sha256", jarHash);
+    record.put("source_commit", sourceCommit);
+    record.put("source_manifest_sha256", sourceManifest);
+    record.put("port", port);
+    return record;
+  }
+
+  private void persistChild(String phase) throws Exception {
+    if (journalHash != null) { verifyJournal(); }
+    Map<String, Object> record = identity();
+    record.put("kind", "OWNED_CP_PROCESS_CONTROL");
+    record.put("phase", phase);
+    record.put("sequence", ++sequence);
+    record.put("forced_stop", forced);
+    record.put("stop_requested", stopRequested);
+    record.put("exit_status", exitStatus);
+    record.put("unknown_reasons", List.copyOf(reasons));
+    atomicPrivate(childJournal, bytes(record), journalHash == null);
+    journalHash = digest(Files.readAllBytes(childJournal));
+    journalIdentity = fingerprint(childJournal);
+  }
+
+  private void verifyJournal() throws Exception {
+    if (journalHash == null || !journalIdentity.equals(fingerprint(privateFile(childJournal)))
+        || !journalHash.equals(digest(Files.readAllBytes(childJournal)))) { throw invalid(); }
+  }
+
+  private void writeExitReceipt() throws Exception {
+    Map<String, Object> record = identity();
+    record.put("kind", "OWNED_GENERATION_PROCESS_EXIT");
+    record.put("process_owner_kind", "DIRECT_PROCESS_WAIT");
+    record.put("exit_proof", "ACTUAL_PROCESS_WAIT_FOR");
+    record.put("exit_status", exitStatus);
+    record.put("forced_stop", forced);
+    record.put("stop_requested", stopRequested);
+    record.put("healthy", !unknown && !forced);
+    record.put("unknown_reasons", List.copyOf(reasons));
+    createPrivate(exits.resolve("process-exit-" + generation + ".json"), bytes(record));
+  }
+
+  private void retain(String reason) {
+    unknown = true;
+    if (!reasons.contains(reason)) { reasons.add(reason); }
+    try {
+      if (markerHash != null && (!markerIdentity.equals(fingerprint(privateFile(marker)))
+          || !markerHash.equals(digest(Files.readAllBytes(marker))))) { throw invalid(); }
+      Map<String, Object> record = identity();
+      record.put("kind", "CP_PROCESS_OWNER_RECONCILIATION_REQUIRED");
+      record.put("phase", "UNKNOWN");
+      record.put("reason_codes", List.copyOf(reasons));
+      atomicPrivate(marker, bytes(record), markerHash == null);
+      markerHash = digest(Files.readAllBytes(marker));
+      markerIdentity = fingerprint(marker);
+    } catch (Exception journalFailure) {
+      // No delegate/process action is gated on writing this diagnostic: reaping remains mandatory.
+      if (!reasons.contains("RECONCILIATION_JOURNAL_FAILED")) { reasons.add("RECONCILIATION_JOURNAL_FAILED"); }
+    }
+  }
+
+  private static void bootstrapRetain(Path requested) {
+    try {
+      Path directory = privateDirectory(requested);
+      Properties config = new Properties();
+      try (var stream = Files.newInputStream(privateFile(directory.resolve("owner.properties")))) { config.load(stream); }
+      String run = required(config, "run_id");
+      String generation = required(config, "generation_id");
+      if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}") || UUID.fromString(generation).version() != 4) { return; }
+      Path reconciliation = privateDirectory(Path.of(required(config, "reconciliation_directory")));
+      Map<String, Object> record = new LinkedHashMap<>();
+      record.put("schema_version", 1);
+      record.put("kind", "CP_PROCESS_OWNER_RECONCILIATION_REQUIRED");
+      record.put("run_id", run);
+      record.put("generation_id", generation);
+      record.put("phase", "UNKNOWN");
+      record.put("reason_codes", List.of("OWNER_PREFORK_FAILED"));
+      createPrivate(reconciliation.resolve("cp-process-owner-" + generation + ".json"), bytes(record));
+    } catch (Exception ignored) { /* Stable nonzero exit is the independent failure signal. */ }
+  }
+
+  private static Path privateDirectory(Path requested) throws Exception {
+    Path path = requested.toAbsolutePath().normalize();
+    if (!path.equals(path.toRealPath()) || !Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS)
+        || ((Number) Files.getAttribute(path, "unix:uid", LinkOption.NOFOLLOW_LINKS)).longValue() != USER_ID
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rwx------"))) { throw invalid(); }
+    return path;
+  }
+
+  private static Path privateFile(Path requested) throws Exception {
+    Path path = requested.toAbsolutePath().normalize();
+    if (!path.equals(path.toRealPath()) || !Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || ((Number) Files.getAttribute(path, "unix:uid", LinkOption.NOFOLLOW_LINKS)).longValue() != USER_ID
+        || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rw-------"))) { throw invalid(); }
+    return path;
+  }
+
+  private record Fingerprint(Object key, long size, java.nio.file.attribute.FileTime modified) { }
+  private static Fingerprint fingerprint(Path path) throws Exception {
+    BasicFileAttributes stat = Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+    if (!stat.isRegularFile() || stat.fileKey() == null) { throw invalid(); }
+    return new Fingerprint(stat.fileKey(), stat.size(), stat.lastModifiedTime());
+  }
+
+  private static Instant birth(ProcessHandle process) {
+    return process.info().startInstant().orElseThrow(ControlplaneProcessOwner::invalid);
+  }
+
+  private static void createPrivate(Path target, byte[] content) throws Exception {
+    privateDirectory(target.getParent());
+    try (FileChannel file = FileChannel.open(target, java.util.Set.of(StandardOpenOption.CREATE_NEW,
+        StandardOpenOption.WRITE), PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+      ByteBuffer buffer = ByteBuffer.wrap(content);
+      while (buffer.hasRemaining()) { file.write(buffer); }
+      file.force(true);
+    }
+    forceDirectory(target.getParent());
+  }
+
+  private static void atomicPrivate(Path target, byte[] content, boolean first) throws Exception {
+    privateDirectory(target.getParent());
+    if (first && Files.exists(target, LinkOption.NOFOLLOW_LINKS)) { throw invalid(); }
+    Path staging = target.resolveSibling("." + target.getFileName() + "." + UUID.randomUUID() + ".partial");
+    createPrivate(staging, content);
+    if (first) {
+      // CREATE_NEW publication preserves an existing record even across a same-user collision.
+      Files.createLink(target, staging);
+      forceDirectory(target.getParent());
+      Files.delete(staging);
+    } else {
+      Files.move(staging, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+    }
+    forceDirectory(target.getParent());
+    // Failed staging writes remain private evidence; they are never cleanup authority.
+  }
+
+  private static void forceDirectory(Path directory) throws Exception {
+    privateDirectory(directory);
+    try (FileChannel file = FileChannel.open(directory, StandardOpenOption.READ)) { file.force(true); }
+  }
+  private static void forceFile(Path file) throws Exception {
+    try (FileChannel channel = FileChannel.open(privateFile(file), StandardOpenOption.WRITE)) { channel.force(true); }
+  }
+  private static void durabilityProbe(Path directory) throws Exception {
+    Path probe = directory.resolve(".cp-owner-durability-" + UUID.randomUUID());
+    createPrivate(probe, new byte[0]);
+    Files.delete(probe);
+    forceDirectory(directory);
+  }
+  private static String required(Properties values, String name) {
+    String value = values.getProperty(name);
+    if (value == null || value.isBlank()) { throw invalid(); }
+    return value;
+  }
+  private static String digest(byte[] content) throws Exception {
+    return java.util.HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(content));
+  }
+  private static byte[] bytes(Object value) {
+    return (json(value) + "\n").getBytes(java.nio.charset.StandardCharsets.UTF_8);
+  }
+  private static String json(Object value) {
+    if (value == null) { return "null"; }
+    if (value instanceof Number || value instanceof Boolean) { return value.toString(); }
+    if (value instanceof Map<?, ?> map) {
+      List<String> entries = new ArrayList<>();
+      map.forEach((key, item) -> entries.add(json(key.toString()) + ":" + json(item)));
+      return "{" + String.join(",", entries) + "}";
+    }
+    if (value instanceof List<?> list) { return "[" + String.join(",", list.stream().map(ControlplaneProcessOwner::json).toList()) + "]"; }
+    StringBuilder quoted = new StringBuilder("\"");
+    for (char character : value.toString().toCharArray()) {
+      if (character == '"' || character == '\\') { quoted.append('\\').append(character); }
+      else if (character < 32) { quoted.append(String.format("\\u%04x", (int) character)); }
+      else { quoted.append(character); }
+    }
+    return quoted.append('"').toString();
+  }
+  private static IllegalStateException invalid() { return new IllegalStateException("CP_OWNER_CONTROL_INVALID"); }
+}
