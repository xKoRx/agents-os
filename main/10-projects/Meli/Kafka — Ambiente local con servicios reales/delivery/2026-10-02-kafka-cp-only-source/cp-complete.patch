+  public void verifyStoppedOffsetsAndAbsenceInputs(SqlQuiescenceProbe sql) throws Exception {
+    try {
+      if (!stopped || unknown) { throw failure("PM_NOT_VERIFIED_STOPPED"); }
+      assertProcessAbsent();
+      fixture.awaitWorkersQuiescent(); // Actual CP/bridge barrier runs only after PM reap.
+      Map<TopicPartition, Long> tails = observeStoppedOffsets();
+      fixture.awaitWorkersQuiescent();
+      if (!tails.equals(observeStoppedOffsets())) { throw failure("RESULT_TAIL_CHANGED"); }
+      java.util.Objects.requireNonNull(sql, "An actual owned SQL quiescence probe is required").assertNoPmSessions();
+      if (mutationVerifier == null) { throw failure("MUTATION_PROOF_NOT_CONFIGURED"); }
+      mutationVerifier.verify(identity);
+      frozenTails = Map.copyOf(tails);
+      gated = true;
+      phase = "GATED";
+      reason = "PM_CP_BRIDGE_OFFSETS_SQL_AND_MUTATION_PROOF_VERIFIED";
+      persist();
+    } catch (Exception | AssertionError failure) {
+      try { markUnknown("ORDERED_CLEANUP_GATE_UNVERIFIED"); } catch (Exception ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
