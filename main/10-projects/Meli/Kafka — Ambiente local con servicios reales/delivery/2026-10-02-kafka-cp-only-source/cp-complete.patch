+      assertTrue(kvs.get(second) == null, "First DELETE failure must not prevent the second actual DELETE");
+      Awaitility.await().atMost(Duration.ofSeconds(30)).until(() ->
+          !parent.admin().listTopics().names().get(10, TimeUnit.SECONDS).contains(topic));
+      Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> !groups(parent.admin()).contains(childGroup));
+    } catch (Exception | AssertionError scenarioFailure) {
+      failure = scenarioFailure;
+    } finally {
+      try {
+        reap(child);
+      } catch (Exception | AssertionError cleanupFailure) {
+        failure = accumulate(failure, cleanupFailure);
+      }
+      if (faults != null) {
+        try {
+          faults.write().abortHeld();
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = accumulate(failure, cleanupFailure);
+        }
+        try {
+          faults.close();
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = accumulate(failure, cleanupFailure);
+        }
+      }
+      try {
+        if (child != null) {
+          assertTrue(!child.isAlive() && child.waitFor(15, TimeUnit.SECONDS), "Exact cleanup child must be reaped before mutations");
+          assertEquals(EXPECTED_CLEANUP_FAILURE, child.exitValue(), "An unverifiable child outcome retains both journals");
+          parent.cleanup();
+          deleteExactGroup(parent.admin(), childGroup);
+          parent.reconcileCleanupChild(permit, child);
+        } else {
+          assertTrue(permit == null, "A started-but-unrecorded cleanup child retains its authorization journal");
+        }
+      } catch (Exception | AssertionError cleanupFailure) {
+        failure = accumulate(failure, cleanupFailure);
+      }
+      try {
+        parent.close();
+      } catch (Exception | AssertionError cleanupFailure) {
+        failure = accumulate(failure, cleanupFailure);
+      }
+    }
+    rethrow(failure);
+  }
+
+  private static Process startCleanupChild(Map<String, String> overrides, String first, String second,
+      String topic, String childGroup, String permitJson) throws Exception {
+    String classpath = System.getProperty("e2e.real.classpath");
+    assertNotNull(classpath, "e2e.real.classpath must supply the actual sourceSet runtime; no fallback is allowed");
+    assertTrue(!classpath.isBlank(), "Actual child runtime classpath must not be blank");
+    ProcessBuilder builder = new ProcessBuilder(Path.of(System.getProperty("java.home"), "bin", "java").toString(),
+        "-Xmx256m", "-cp", classpath, RealKvsFixtureCleanupIntegrationTest.class.getName(),
+        "cleanup-child", first, second, topic, childGroup, permitJson);
+    builder.environment().putAll(overrides);
+    return builder.redirectOutput(ProcessBuilder.Redirect.DISCARD)
+        .redirectError(ProcessBuilder.Redirect.DISCARD).start();
+  }
+
+  /** Separate JVM preserves Toolkit's environment resolution without changing the parent process. */
+  public static void main(String[] args) {
+    int exit = UNEXPECTED_CHILD_FAILURE;
+    try {
+      if (args.length == 6 && "cleanup-child".equals(args[0])) {
+        exit = cleanupChild(args[1], args[2], args[3], args[4],
+            JsonMapper.builder().build().readValue(args[5], RealE2eFixture.CleanupChildPermit.class));
+      }
+    } catch (Exception | AssertionError failure) {
+      // SDK failures can contain endpoint/auth material. Parent observes only the stable exit and real effects.
+      exit = UNEXPECTED_CHILD_FAILURE;
+    }
+    System.exit(exit);
+  }
+
+  private static int cleanupChild(String first, String second, String topic, String childGroup,
+      RealE2eFixture.CleanupChildPermit permit) throws Exception {
+    String run = RealE2eFixture.requiredEnv("E2E_RUN_ID");
+    String keyPrefix = "e2e:" + run + ":cleanup:";
+    assertTrue(first.startsWith(keyPrefix) && second.startsWith(keyPrefix) && !first.equals(second));
+    assertTrue(topic.startsWith("e2e_" + run + "_kvs_cleanup_failure_"));
+    KvsClient actual = RealE2eKvsClientFactory.create(RealE2eFixture.requiredEnv("E2E_KVS_CONTAINER_NAME"),
+        System.getenv().getOrDefault("E2E_KVS_SEGMENT_ID", ""), 1000);
+    String bootstrap = RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS");
+    RealE2eFixture fixture = new RealE2eFixture(0, JsonMapper.builder().build(), actual, bootstrap, 5, childGroup, permit);
+    boolean closeInvoked = false;
+    Throwable failure = null;
+    int exit = CLEANUP_DID_NOT_FAIL;
+    try {
+      fixture.registerKey(first);
+      fixture.registerKey(second);
+      fixture.createTopic(topic, 1, (short) 1, Map.of());
+      assertTrue(actual.get(first) == null && actual.get(second) == null);
+      actual.save(Item.builder(first, PROBE).withTtl(600).build());
+      actual.save(Item.builder(second, PROBE).withTtl(600).build());
+      assertArrayEquals(PROBE, actual.get(first).getValue());
+      assertArrayEquals(PROBE, actual.get(second).getValue());
+      closeInvoked = true;
+      Throwable cleanupFailure = null;
+      try {
+        fixture.close();
+      } catch (Exception | AssertionError expectedFailure) {
+        cleanupFailure = expectedFailure;
+      }
+      if (cleanupFailure != null) {
+        assertInstanceOf(KvsClientException.class, cleanupFailure, "The preserved primary failure must come from real KVS cleanup");
+        assertNotNull(actual.get(first));
+        assertArrayEquals(PROBE, actual.get(first).getValue());
+        assertTrue(actual.get(second) == null);
+        fixture.assertProducerClosed(topic);
+        try (AdminClient independent = AdminClient.create(Map.of("bootstrap.servers", bootstrap))) {
+          assertTrue(!independent.listTopics().names().get(30, TimeUnit.SECONDS).contains(topic));
+          assertTrue(!groups(independent).contains(fixture.resultGroup()));
+        }
+        exit = EXPECTED_CLEANUP_FAILURE;
+      }
+    } catch (Exception | AssertionError scenarioFailure) {
+      failure = scenarioFailure;
+    } finally {
+      if (!closeInvoked) {
+        try {
+          fixture.close();
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = accumulate(failure, cleanupFailure);
+        }
+      }
+    }
+    rethrow(failure);
+    return exit;
+  }
+
+  private static void deleteExactGroup(AdminClient admin, String group) throws Exception {
+    try {
+      admin.deleteConsumerGroups(java.util.List.of(group)).all().get(30, TimeUnit.SECONDS);
+    } catch (java.util.concurrent.ExecutionException exception) {
+      if (!(exception.getCause() instanceof org.apache.kafka.common.errors.GroupIdNotFoundException)) {
+        throw exception;
+      }
+    }
+    Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> !groups(admin).contains(group));
+  }
+
+  private static Set<String> groups(AdminClient admin) throws Exception {
+    return admin.listConsumerGroups().all().get(30, TimeUnit.SECONDS).stream()
+        .map(group -> group.groupId()).collect(Collectors.toSet());
+  }
+
+  private static void reap(Process child) throws Exception {
+    if (child != null) {
+      if (child.isAlive()) {
+        child.destroy();
+        if (!child.waitFor(10, TimeUnit.SECONDS)) { child.destroyForcibly(); }
+      }
+      assertTrue(child.waitFor(15, TimeUnit.SECONDS), "Only the owned child must be reaped");
+      assertTrue(!child.isAlive(), "Exact cleanup child remained alive");
+    }
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) {
+      return next;
+    }
+    first.addSuppressed(next);
+    return first;
+  }
+
+  private static void rethrow(Throwable failure) throws Exception {
+    if (failure instanceof Error error) {
+      throw error;
+    }
+    if (failure instanceof Exception exception) {
+      throw exception;
+    }
+  }
+}
