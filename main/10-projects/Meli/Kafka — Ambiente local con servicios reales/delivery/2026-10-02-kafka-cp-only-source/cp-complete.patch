+  @Test
+  void servicePeekUsesPersistedOutputAndRealHttpCpClient() throws Exception {
+    String topic = fixture.uniqueTopic("playmaker_service_peek");
+    database.seed("aws-msk-topic", mapper.writeValueAsString(fixture.paramsFor("aws-msk-topic", topic, 1, (short) 1)));
+    JsonNode requested = deploy();
+    assertCorrelatedOutcome("aws-msk-topic", awaitRequestedDeployment(requested, "deploy_completed"), "COMPLETED");
