+  private void persistExitReceipt(Generation value) throws Exception {
+    if (value.process == null || value.process.isAlive() || !"STOPPED".equals(value.phase)) {
+      throw failure("ACTUAL_EXIT_NOT_REAPED");
+    }
+    // The direct Process object supplies this value. No absent-PID or successful-close inference.
+    int actualExit = value.process.exitValue();
+    if (actualExit != value.exitStatus) { throw failure("EXIT_STATUS_CHANGED"); }
+    Path exitDirectory = privateDirectory(Path.of(required(config, "process_exit_directory")));
+    Map<String, Object> fields = new LinkedHashMap<>();
+    fields.put("schema_version", 1);
+    fields.put("kind", "OWNED_GENERATION_PROCESS_EXIT");
+    fields.put("run_id", run);
+    fields.put("generation_id", value.id.toString());
+    fields.put("application", "PM");
+    fields.put("pid", value.process.pid());
+    fields.put("process_start_instant", value.birth.toString());
+    fields.put("process_owner_pid", ProcessHandle.current().pid());
+    fields.put("process_owner_start_instant", start(ProcessHandle.current()).toString());
+    fields.put("process_owner_kind", "DIRECT_PROCESS_WAIT");
+    fields.put("exit_status", actualExit);
+    fields.put("forced_stop", value.forced);
+    fields.put("stop_requested", value.stopRequested);
+    fields.put("exit_proof", "ACTUAL_PROCESS_WAIT_FOR");
+    fields.put("child_mode", config.getProperty("child_mode"));
+    fields.put("healthy", !unknown);
+    fields.put("unknown_reasons", unknown ? List.of("OWNER_UNKNOWN") : List.of());
+    Path target = exitDirectory.resolve("process-exit-" + value.id + ".json");
+    if (Files.exists(target, LinkOption.NOFOLLOW_LINKS)) { throw failure("EXIT_RECEIPT_ALREADY_EXISTS"); }
+    writeJournal(target, fields);
+  }
+
+  private void persistLease(Generation generation, String phase, String reason) throws Exception {
+    generation.phase = phase;
+    Map<String, Object> fields = common("PLAYMAKER_PROCESS_LEASE");
+    fields.put("lease_id", generation.id.toString());
+    fields.put("generation", generation.id.toString());
+    fields.put("fixture_id", generation.fixture.toString());
+    fields.put("phase", phase);
+    fields.put("reason", reason);
+    fields.put("pm_pid", generation.process == null ? 0L : generation.process.pid());
+    fields.put("pm_start", generation.birth == null ? "" : generation.birth.toString());
+    fields.put("worker_pid", generation.worker.pid());
+    fields.put("worker_start", generation.workerBirth.toString());
+    fields.put("forced_stop", generation.forced);
+    fields.put("stop_requested", generation.stopRequested);
+    fields.put("exit_status", generation.exitStatus);
+    fields.put("log_sha256", generation.logSha256);
+    fields.put("log_path", generation.log.toString());
+    fields.put("unknown", unknown);
+    writeJournal(generation.lease, fields);
+  }
+
+  private boolean noOtherFixtureJournals(String permitted) throws Exception {
+    try (var paths = Files.list(reconciliation)) {
+      return paths.filter(path -> path.getFileName().toString().startsWith("pm-fixture-"))
+          .noneMatch(path -> !path.getFileName().toString().equals("pm-fixture-" + permitted + ".json"));
+    }
+  }
+
+  private boolean noFixtureJournals() throws Exception {
+    try (var paths = Files.list(reconciliation)) {
+      return paths.noneMatch(path -> path.getFileName().toString().startsWith("pm-fixture-"));
+    }
+  }
+
+  private void verifyJar() throws Exception {
+    if (!hash(jar).equals(jarHash)) { throw failure("IMMUTABLE_JAR_CHANGED"); }
+    String mode = required(config, "child_mode");
+    if ("PRODUCTIVE_PM".equals(mode)) {
+      try (ZipFile zip = new ZipFile(jar.toFile())) {
+        if (zip.getEntry(VERIFIER_ENTRY) == null) { throw failure("STARTUP_LEASE_VERIFIER_MISSING"); }
+        var factories = zip.getEntry("BOOT-INF/classes/META-INF/spring.factories");
+        if (factories == null) { throw failure("STARTUP_INITIALIZER_REGISTRATION_MISSING"); }
+        Properties registration = new Properties();
+        try (var input = zip.getInputStream(factories)) { registration.load(input); }
+        String initializers = registration.getProperty("org.springframework.context.ApplicationContextInitializer", "");
+        if (List.of(initializers.split(",")).stream().map(String::strip).noneMatch(
+            "com.mercadolibre.rio.playmaker.localintegration.RealE2eOwnedProcessLeaseVerifier"::equals)) {
+          throw failure("STARTUP_INITIALIZER_REGISTRATION_MISSING");
+        }
+      }
+    } else if (!"NEUTRAL_PROCESS_CONTROL".equals(mode)) { throw failure("CHILD_MODE_INVALID"); }
+  }
