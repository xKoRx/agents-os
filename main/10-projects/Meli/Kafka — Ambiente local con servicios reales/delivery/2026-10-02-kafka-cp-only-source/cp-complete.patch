+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+
+/** PM-KAFKA-AUTH-VERSION-FRONTIER: one actual stopped generation per policy case, no auth mocks. */
+class PlaymakerKafkaAuthorizationVersionE2ETest {
+  private PlaymakerPipelineFixture fixture;
+
+  @BeforeEach
+  void bindExactVersionAndOwnedGeneration() throws Exception {
+    fixture = new PlaymakerPipelineFixture();
+  }
+
+  @AfterEach
+  void verifyFinalStoppedMutationReceiptBeforeAnyCleanup() throws Exception {
+    if (fixture != null) {
+      fixture.close();
+    }
+  }
+
+  @Test
+  void tigerMissingIsRejectedBeforeSqlWireKafkaOrKvsMutation() throws Exception {
+    var topology = fixture.topology("aws-msk-topic", true);
+    String before = fixture.database().snapshot(topology.product());
+    int baseline = fixture.wire().count();
+    var denied = fixture.requestExpectingNoKvsMutation("POST", fixture.actionPath(topology, "peek"),
+        Map.of("data", Map.of("topic_name", topology.topic())), PlaymakerPipelineFixture.Identity.MISSING);
+    assertEquals(401, denied.statusCode());
+    assertNoEffects(topology, before, baseline);
+  }
+
+  @Test
+  void actualConfiguredAcmeDenialPrecedesDispatchUnderItsSourcePolicy() throws Exception {
+    var topology = fixture.topology("catalog-signal", true);
+    // start is configured on catalog-signal in both snapshots. No deployment context is needed before authorization fails.
+    String before = fixture.database().snapshot(topology.product());
+    int baseline = fixture.wire().count();
+    var denied = fixture.requestExpectingNoKvsMutation("POST", fixture.actionPath(topology, "start"),
+        Map.of("data", Map.of()), PlaymakerPipelineFixture.Identity.DENIED);
+    assertEquals(403, denied.statusCode(), "A genuine valid identity lacking the exact owner-project role must be denied");
+    assertNoEffects(topology, before, baseline);
+  }
+
+  @Test
+  void unconfiguredActionUsesCanonicalConfiguredOnlyOrCandidateStrictPolicy() throws Exception {
+    var topology = fixture.topology("aws-msk-topic", true);
+    if (fixture.canonical()) {
+      fixture.deploy(topology.kafka(), topology.environment(), "COMPLETED", false);
+    }
+    String before = fixture.database().snapshot(topology.product());
+    int baseline = fixture.wire().count();
+    String path = fixture.actionPath(topology, "e2e_unknown_action");
+    if (fixture.canonical()) {
+      var admitted = fixture.request("POST", path, Map.of("data", Map.of()), PlaymakerPipelineFixture.Identity.ADMITTED);
+      fixture.awaitActualAction(admitted, "FAILED");
+      assertEquals(before, fixture.database().snapshot(topology.product()));
+      assertEquals(baseline + 1, fixture.wire().count());
+    } else {
+      assertEquals(403, fixture.requestExpectingNoKvsMutation("POST", path, Map.of("data", Map.of()),
+          PlaymakerPipelineFixture.Identity.ADMITTED).statusCode());
+      assertEquals(before, fixture.database().snapshot(topology.product()));
+      fixture.wire().assertNoDelta(baseline);
+    }
+    if (fixture.canonical()) {
+      assertEquals(2, fixture.cp().awaitTopic(topology.topic()).partitions().size());
+    } else {
+      assertFalse(fixture.cp().admin().listTopics().names().get(30, TimeUnit.SECONDS).contains(topology.topic()));
+    }
+  }
+
+  @Test
+  void configuredBlankOwnerFailsBeforeDispatchForBothActualPolicies() throws Exception {
+    var topology = fixture.topology("catalog-signal", true);
+    // Blank ownership is declarative run-owned SQL input; no grants, roles or terminals are fabricated.
+    fixture.database().setOwner(topology.product(), "", "");
+    String before = fixture.database().snapshot(topology.product());
+    int baseline = fixture.wire().count();
+    assertEquals(403, fixture.requestExpectingNoKvsMutation("POST", fixture.actionPath(topology, "start"),
+        Map.of("data", Map.of()), PlaymakerPipelineFixture.Identity.ADMITTED).statusCode());
+    assertNoEffects(topology, before, baseline);
+  }
+
+  @Test
+  void canonicalPrecreationPublishesNullEnvironmentWhileCandidateRejectsUnknownAction() throws Exception {
+    var topology = fixture.topology("aws-msk-topic", true);
+    String before = fixture.database().snapshot(topology.product());
+    int baseline = fixture.wire().count();
+    String path = "/data-products/" + topology.product().id() + "/actions/e2e_unknown_action?component_type=aws-msk-topic";
+    if (fixture.canonical()) {
+      var admitted = fixture.request("POST", path, Map.of("data", Map.of()), PlaymakerPipelineFixture.Identity.ADMITTED);
+      String id = fixture.awaitActualAction(admitted, "FAILED");
+      JsonNode wire = fixture.wire().await(id).payload();
+      assertTrue(wire.path("component_id").isNull() || wire.path("component_id").isMissingNode());
+      assertTrue(wire.path("environment_id").isNull() || wire.path("environment_id").isMissingNode());
+      assertTrue(wire.path("deployment_context").isNull() || wire.path("deployment_context").isMissingNode());
+      assertEquals(before, fixture.database().snapshot(topology.product()));
+    } else {
+      assertEquals(403, fixture.requestExpectingNoKvsMutation("POST", path, Map.of("data", Map.of()),
+          PlaymakerPipelineFixture.Identity.ADMITTED).statusCode());
+      assertNoEffects(topology, before, baseline);
+    }
+    assertFalse(fixture.cp().admin().listTopics().names().get(30, TimeUnit.SECONDS).contains(topology.topic()));
+  }
+
+  private void assertNoEffects(PlaymakerPipelineFixture.Topology topology, String before, int baseline) throws Exception {
+    assertEquals(before, fixture.database().snapshot(topology.product()));
+    fixture.assertConfigurationOnly(topology, baseline);
+    // Provisional assertions become final only when T25 stops the actual generation and T26 seals both real KVS counters.
+  }
+}
