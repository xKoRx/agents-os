+++ b/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserverTest.java
@@ -0,0 +1,104 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import static org.junit.jupiter.api.Assertions.*;
+import com.mercadolibre.threading.executor.MeliExecutors;
+import java.time.Duration;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.TimeUnit;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.api.Test;
+import org.slf4j.MDC;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+
+class RealE2eWorkerObserverTest {
+  private static final String RUN = "1234567890abcdef1234567890abcdef";
+  @Test void timeoutOfCallerDoesNotDeclareRetainedActualWorkerIdle() throws Exception {
+    var ledger = new RealE2eWorkerObserver.WorkerLedger(RUN);
+    var entered = new CountDownLatch(1);
+    var release = new CountDownLatch(1);
+    try (var executor = new RealE2eWorkerObserver.ObservedExecutor(Executors.newVirtualThreadPerTaskExecutor(), ledger)) {
+      var caller = CompletableFuture.runAsync(() -> { entered.countDown(); await(release); }, executor);
+      assertTrue(entered.await(5, TimeUnit.SECONDS));
+      assertThrows(java.util.concurrent.ExecutionException.class,
+          () -> caller.orTimeout(20, TimeUnit.MILLISECONDS).get(5, TimeUnit.SECONDS));
+      assertFalse(ledger.snapshot().idle());
+      assertEquals(1, ledger.snapshot().active());
+      release.countDown();
+      Awaitility.await().atMost(Duration.ofSeconds(5)).until(() -> ledger.snapshot().idle());
+      assertEquals(1, ledger.snapshot().finished());
+    } finally { release.countDown(); }
+  }
+
+  @Test void nestedWorkRemainsObservedAfterParentCompletesAndTraceContextIsPreserved() throws Exception {
+    var ledger = new RealE2eWorkerObserver.WorkerLedger(RUN);
+    var childEntered = new CountDownLatch(1);
+    var childRelease = new CountDownLatch(1);
+    var childContext = new CompletableFuture<String>();
+    MDC.put("correlation_id", "owned-observer-unit");
+    try (var executor = new RealE2eWorkerObserver.ObservedExecutor(
+        MeliExecutors.trace(Executors.newVirtualThreadPerTaskExecutor()), ledger)) {
+      CompletableFuture.runAsync(() -> CompletableFuture.runAsync(() -> {
+        childContext.complete(MDC.get("correlation_id"));
+        childEntered.countDown();
+        await(childRelease);
+      }, executor), executor).get(5, TimeUnit.SECONDS);
+      assertTrue(childEntered.await(5, TimeUnit.SECONDS));
+      assertEquals("owned-observer-unit", childContext.get(5, TimeUnit.SECONDS));
+      assertFalse(ledger.snapshot().idle());
+      assertEquals(1, ledger.snapshot().active());
+      childRelease.countDown();
+      Awaitility.await().atMost(Duration.ofSeconds(5)).until(() -> ledger.snapshot().idle());
+      assertEquals(2, ledger.snapshot().submitted());
+      assertEquals(2, ledger.snapshot().finished());
+    } finally { childRelease.countDown(); MDC.remove("correlation_id"); }
+  }
+
+  @Test void actualExecutorRejectionIsPropagatedWithoutLeavingFalseActiveWork() {
+    var ledger = new RealE2eWorkerObserver.WorkerLedger(RUN);
+    try (var executor = new RealE2eWorkerObserver.ObservedExecutor(Executors.newVirtualThreadPerTaskExecutor(), ledger)) {
+      executor.shutdown();
+      assertThrows(RejectedExecutionException.class, () -> executor.execute(() -> fail("Rejected task ran")));
+      assertTrue(ledger.snapshot().idle());
+      assertEquals(1, ledger.snapshot().rejected());
+      assertEquals(0, ledger.snapshot().finished());
+    }
+  }
+
+  @Test void observerAndItsCounterAreAbsentOutsideTheExplicitRealProfile() {
+    try (var context = new AnnotationConfigApplicationContext()) {
+      context.register(RealE2eWorkerObserver.class, RealE2eWorkerObserver.Controller.class);
+      context.refresh();
+      assertTrue(context.getBeansOfType(RealE2eWorkerObserver.WorkerLedger.class).isEmpty());
+      assertTrue(context.getBeansOfType(RealE2eWorkerObserver.Controller.class).isEmpty());
+    }
+  }
+
+  @Test void postProcessorDecoratesTheActualNamedExecutorOnlyInTheRealProfile() throws Exception {
+    try (var context = new AnnotationConfigApplicationContext()) {
+      context.getEnvironment().setActiveProfiles("real-e2e");
+      context.getEnvironment().getPropertySources().addFirst(new org.springframework.core.env.MapPropertySource(
+          "owned-observer-unit", java.util.Map.of("e2e.run-id", RUN)));
+      context.register(RealE2eWorkerObserver.class, RealE2eWorkerObserver.Controller.class,
+          com.mercadolibre.rio_controlplane_kafka.config.ExecutorConfig.class);
+      context.refresh();
+      var executor = context.getBean("asyncExecutor", java.util.concurrent.ExecutorService.class);
+      assertInstanceOf(RealE2eWorkerObserver.ObservedExecutor.class, executor);
+      var controller = context.getBean(RealE2eWorkerObserver.Controller.class);
+      assertTrue(controller.workers().idle());
+      assertEquals(RUN, controller.workers().runId());
+      assertEquals(ProcessHandle.current().pid(), controller.workers().pid());
+      CompletableFuture.runAsync(() -> {}, executor).get(5, TimeUnit.SECONDS);
+      Awaitility.await().atMost(Duration.ofSeconds(5)).until(() -> controller.workers().idle());
+      assertEquals(1, controller.workers().submitted());
+      assertEquals(1, controller.workers().finished());
+    }
+  }
+
+  private static void await(CountDownLatch latch) {
+    try { if (!latch.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("Owned latch timed out"); }
+    catch (InterruptedException failure) { Thread.currentThread().interrupt(); throw new IllegalStateException(failure); }
+  }
+}
