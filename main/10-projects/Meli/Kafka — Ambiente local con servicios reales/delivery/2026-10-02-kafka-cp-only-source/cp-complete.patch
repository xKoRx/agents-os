+package com.mercadolibre.rio_controlplane_kafka.managed;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.mercadolibre.rio_controlplane_kafka.Application;
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentOperation;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.context.ApplicationContextInitializer;
+import org.springframework.context.ConfigurableApplicationContext;
+import org.springframework.core.env.MapPropertySource;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.context.ContextConfiguration;
+import org.springframework.test.annotation.DirtiesContext;
+import tools.jackson.databind.JsonNode;
+
+/**
+ * HTTP -> full CP -> managed OAuth Kafka -> own Fury KVS -> actual BigQueue business results.
+ * Mandatory preparation is not runtime evidence: the lifecycle registry fails before beans until
+ * effective SDK, own BigQueue lifecycle/cleanup and observer contracts have been physically verified.
+ * BigQueue callback -> CP and result callback -> Playmaker remain separate, unverified frontiers.
+ */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+@ActiveProfiles("managed-integration")
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+@ContextConfiguration(initializers = ManagedControlplaneJourneyIntegrationTest.ManagedInitializer.class)
+class ManagedControlplaneJourneyIntegrationTest {
+  @Autowired private ConfigurableApplicationContext context;
+  @LocalServerPort private int port;
+
+  /** A single fresh consumer window contains all RF1..3 scenarios and retains provider identities. */
+  @Test
+  void actualApplicationCrudPeekFailureAndRedeliveryAcrossManagedReplicationFactors() throws Exception {
+    try (var fixture = new ManagedControlplaneFixture(context, port)) {
+      for (int rf = 1; rf <= 3; rf++) {
+        String topic = fixture.topic(rf);
+        var provision = fixture.deployment(DeploymentOperation.PROVISION,
+            fixture.params(topic, 1, rf, 3_600_000));
+        JsonNode created = fixture.dispatch(provision, "COMPLETED");
+        assertEquals(topic, created.path("output").path("topic_name").asString());
+        assertFalse(created.path("output").path("already_existed").asBoolean());
+        assertEquals("DEFAULT", created.path("output").path("routing_mode").asString());
+        fixture.assertTopology(topic, 1, rf, 3_600_000);
+        fixture.redeliver(provision, "COMPLETED", topic);
+
+        String key = "managed-key-rf" + rf;
+        String value = "{\"managed_rf\":" + rf + "}";
+        long actualOffset = fixture.seed(topic, key, value);
+        Map<Integer, Long> offsets = fixture.endOffsets(topic);
+        var peek = fixture.peek(topic);
+        JsonNode peeked = fixture.dispatch(peek);
+        JsonNode messages = peeked.path("result").path("messages");
+        assertTrue(messages.isArray());
+        assertEquals(1, messages.size());
+        JsonNode message = messages.get(0);
+        assertEquals(key, message.path("key").asString());
+        assertEquals("JSON", message.path("value_format").asString());
+        assertEquals(rf, message.path("value").path("managed_rf").asInt());
+        assertEquals(0, message.path("partition").asInt());
+        assertEquals(actualOffset, message.path("offset").asLong());
+        assertEquals(offsets, fixture.endOffsets(topic), "OAuth PEEK must not append Kafka data");
+        fixture.redeliver(peek, topic);
+
+        var update = fixture.deployment(DeploymentOperation.UPDATE,
+            fixture.params(topic, 2, rf, 7_200_000));
+        JsonNode updated = fixture.dispatch(update, "COMPLETED");
+        assertEquals(topic, updated.path("output").path("topic_name").asString());
+        assertEquals(2, updated.path("output").path("partitions_size").asInt());
+        fixture.assertTopology(topic, 2, rf, 7_200_000);
+
+        var decrease = fixture.deployment(DeploymentOperation.UPDATE,
+            fixture.params(topic, 1, rf, 7_200_000));
+        JsonNode failed = fixture.dispatch(decrease, "FAILED");
+        assertEquals("TOPIC_PARTITION_CONFLICT", failed.path("error").path("code").asString());
+        assertEquals("TOPIC_PARTITION_CONFLICT", context.getBean(tools.jackson.databind.ObjectMapper.class)
+            .readValue(fixture.awaitState("gcp-deployment:" + decrease.deploymentId(), "FAILED").getValue(),
+                com.mercadolibre.rio_controlplane_kafka.idempotency.TriggerStatusRecord.class).outcomeCode());
+        fixture.assertTopology(topic, 2, rf, 7_200_000);
+        fixture.redeliver(decrease, "FAILED", topic);
+
+        var remove = fixture.deployment(DeploymentOperation.DEPROVISION, Map.of("topic_name", topic));
+        JsonNode deleted = fixture.dispatch(remove, "COMPLETED");
+        assertTrue(deleted.path("output").path("deleted").asBoolean());
+        fixture.awaitAbsent(topic);
+      }
+    }
+  }
+
+  public static final class ManagedInitializer implements ApplicationContextInitializer<ConfigurableApplicationContext> {
+    @Override public void initialize(ConfigurableApplicationContext context) {
+      // Required before productive BigQueue/OAuth/KVS beans perform any connection or publication.
+      ManagedBigQueueLifecycleRegistry.requireVerifiedPublicationLifecycle();
+      ManagedGateInputs.requireNonprodScope();
+      String scope = required("E2E_MANAGED_SCOPE");
+      if (!scope.equals(required("SCOPE")) || !scope.equals(required("SCOPE_SUFFIX")))
+        throw new IllegalStateException("MANAGED_EXACT_NONPROD_SCOPE_ENV_REQUIRED");
+      String run = required("E2E_MANAGED_RUN_ID");
+      if (!run.matches("[a-f0-9]{32}") || !run.equals(required("E2E_RUN_ID"))
+          || !run.equals(required("E2E_KVS_EXCLUSIVE_RUN_ID")))
+        throw new IllegalStateException("MANAGED_RUN_SANDBOX_OWNERSHIP_MISMATCH");
+      if (!"rio-controlplane-kafka".equals(required("E2E_MANAGED_APPLICATION")))
+        throw new IllegalStateException("MANAGED_OWN_CP_APPLICATION_REQUIRED");
+      verifySandboxAndArtifactDirectory();
+      Map<String, Object> properties = new LinkedHashMap<>();
+      properties.put("rio.config.cloud-provider.profile-name", required("E2E_MANAGED_CLOUD_PROVIDER_PROFILE_NAME"));
+      properties.put("rio.config.cloud-provider.location", required("E2E_MANAGED_CLOUD_PROVIDER_CONFIG_LOCATION"));
+      properties.put("rio.gcp.kafka.credentials.secret-name", required("E2E_MANAGED_GCP_SECRET_NAME"));
+      properties.put("rio.gcp.kafka.credentials.secret-segment", required("E2E_MANAGED_GCP_SECRET_SEGMENT"));
+      properties.put("rio.gcp.kafka.fury-secrets.segment-id", required("E2E_MANAGED_GCP_SECRET_SEGMENT"));
+      properties.put("rio.gcp.kafka.connectivity.bootstrap-servers", required("E2E_MANAGED_GCP_BOOTSTRAP_SERVERS"));
+      properties.put("rio.gcp.kafka.connectivity.probe-on-startup", true);
+      properties.put("rio.gcp.kafka.connectivity.fail-fast-on-probe-failure", true);
+      properties.put("rio.gcp.kafka.connectivity.probe-timeout", "15s");
+      properties.put("kvs.triggers-status.container-name", required("E2E_KVS_CONTAINER_NAME"));
+      properties.put("kvs.triggers-status.segment-id", required("E2E_KVS_SEGMENT_ID"));
+      properties.put("events.bigqueue.publisher-name", "rio-controlplane-kafka");
+      resultProperties(properties, 0, "rio-deployment-result", "DEPLOYMENT");
+      resultProperties(properties, 1, "rio-action-result", "ACTION");
+      properties.put("logging.level.com.mercadolibre.rio_core_java.gcpkafka", "INFO");
+      properties.put("logging.level.com.mercadolibre.rio_controlplane_kafka.deployment.gcp.config", "INFO");
+      context.getEnvironment().getPropertySources().addFirst(new MapPropertySource("managed-owned-journey", properties));
+    }
+
+    private static String required(String name) { return ManagedGateInputs.required(name); }
+
+    private static void resultProperties(Map<String, Object> properties, int index, String alias, String type) {
+      String key = "events.bigqueue.topics[" + index + "].";
+      String ownedPrefix = "e2e_" + required("E2E_MANAGED_RUN_ID") + "_";
+      for (String suffix : new String[]{"TOPIC", "TOPIC_NAME", "CONSUMER"}) {
+        if (!required("E2E_MANAGED_" + type + "_RESULT_" + suffix).startsWith(ownedPrefix))
+          throw new IllegalStateException("MANAGED_RUN_OWNED_RESULT_CHANNEL_REQUIRED");
+      }
+      properties.put(key + "name", alias);
+      properties.put(key + "topic-name", required("E2E_MANAGED_" + type + "_RESULT_TOPIC_NAME"));
+      properties.put(key + "segment-id", required("E2E_MANAGED_BIGQUEUE_SEGMENT_ID"));
+      properties.put(key + "description", "Run-owned managed CP result");
+      properties.put(key + "socket-timeout-ms", 5000);
+      properties.put(key + "connection-timeout-ms", 3000);
+      properties.put(key + "max-retries", 3);
+      properties.put(key + "retry-delay-ms", 1000);
+      properties.put(key + "enable-buffering", false);
+    }
+
+    private static void verifySandboxAndArtifactDirectory() {
+      Process child = null;
+      Path diagnostic = null;
+      try {
+        Path provenance = Path.of(required("E2E_KVS_SANDBOX_PROVENANCE")).toRealPath();
+        if (!provenance.getFileName().toString().equals("state.json"))
+          throw new IllegalStateException("MANAGED_CANONICAL_SANDBOX_RECEIPT_REQUIRED");
+        Path script = Path.of("e2e", "sandbox.py").toRealPath();
+        diagnostic = Files.createTempFile("rio-managed-sandbox-", ".log",
+            PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+        child = new ProcessBuilder(required("E2E_FURY_PYTHON"), script.toString(), "verify", "--directory",
+            provenance.getParent().toString()).redirectErrorStream(true).redirectOutput(diagnostic.toFile()).start();
+        if (!child.waitFor(90, TimeUnit.SECONDS) || child.exitValue() != 0)
+          throw new IllegalStateException("MANAGED_FRESH_SANDBOX_EXPORTS_VERIFICATION_FAILED");
+        Path suppliedArtifacts = Path.of(required("ARTIFACT_DELIVERY_FILE_PREFIX"));
+        if (Files.isSymbolicLink(suppliedArtifacts))
+          throw new IllegalStateException("MANAGED_FRESH_ARTIFACT_DIRECTORY_REQUIRED");
+        Path artifacts = suppliedArtifacts.toRealPath();
+        if (!Files.isDirectory(artifacts)
+            || !Files.getPosixFilePermissions(artifacts).equals(PosixFilePermissions.fromString("rwx------")))
+          throw new IllegalStateException("MANAGED_FRESH_ARTIFACT_DIRECTORY_REQUIRED");
+        try (var files = Files.list(artifacts)) {
+          if (files.findAny().isPresent()) throw new IllegalStateException("MANAGED_FRESH_ARTIFACT_DIRECTORY_REQUIRED");
+        }
+      } catch (IllegalStateException exception) {
+        throw exception;
+      } catch (Exception exception) {
+        throw new IllegalStateException("MANAGED_SANDBOX_OR_ARTIFACT_PREFLIGHT_FAILED");
+      } finally {
+        try {
+          if (child != null && child.isAlive()) {
+            child.destroyForcibly();
+            if (!child.waitFor(10, TimeUnit.SECONDS))
+              throw new IllegalStateException("MANAGED_SANDBOX_VERIFIER_PROCESS_CLEANUP_FAILED");
+          }
+          if (diagnostic != null) Files.deleteIfExists(diagnostic);
+        } catch (InterruptedException exception) {
+          Thread.currentThread().interrupt();
+          throw new IllegalStateException("MANAGED_SANDBOX_VERIFIER_CLEANUP_INTERRUPTED");
+        } catch (java.io.IOException exception) {
+          throw new IllegalStateException("MANAGED_SANDBOX_VERIFIER_LOG_CLEANUP_FAILED");
+        }
+      }
+    }
+  }
+}
