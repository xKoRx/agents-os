--- /dev/null
+++ b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/OwnedKafkaProtocolFaults.java
@@ -0,0 +1,484 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.admin.Admin;
+import org.apache.kafka.clients.admin.AdminClientConfig;
+import org.awaitility.Awaitility;
+
+/** Owns a broker whose external advertised listener traverses a real Kafka frame proxy. */
+public final class OwnedKafkaProtocolFaults implements AutoCloseable {
+  private static final Duration CONTROL_DEADLINE = Duration.ofSeconds(5);
+  private final OwnedCompose compose;
+  private final Process proxy;
+  private final Path proxyScript;
+  private final String runId;
+  private final Map<Long, OwnedProxyProcess> proxyProcesses = new LinkedHashMap<>();
+  private final Path directory;
+  private final Map<String, String> reconciliationMetadata;
+  private final String bootstrap;
+  private final String independentBootstrap;
+  private final int nativePort;
+  private final URI control;
+  private final Admin observer;
+  private final ObjectMapper mapper = new ObjectMapper();
+  private final HttpClient http = HttpClient.newBuilder().connectTimeout(CONTROL_DEADLINE).build();
+  private boolean hasStartedBroker;
+  private boolean isClosed;
+
+  /** Uses an explicit official schema version, exact run topic, optional correlation and bounded match budget. */
+  public record Rule(int apiKey, int apiVersion, Integer correlationId, String topic, Phase phase,
+                     Action action, int skipMatches, int hits, int holdSeconds) {
+    /** Holds all matching retries by default; reset affects one exact frame by default. */
+    public Rule(int apiKey, int apiVersion, String topic, Phase phase, Action action) {
+      this(apiKey, apiVersion, null, topic, phase, action, 0, action == Action.HOLD ? 1000 : 1, 60);
+    }
+  }
+
+  /** Request is before forwarding; response is after receiving the complete real broker frame. */
+  public enum Phase { REQUEST, RESPONSE }
+
+  /** Pauses or closes real sockets; neither action fabricates a Kafka response. */
+  public enum Action { HOLD, RESET }
+
+  private OwnedKafkaProtocolFaults(OwnedCompose compose, Process proxy, Path directory, String bootstrap,
+      String independentBootstrap, int nativePort, URI control, String runId, Path proxyScript,
+      String context, String project) {
+    this.compose = compose;
+    this.proxy = proxy;
+    this.proxyScript = proxyScript;
+    this.runId = runId;
+    this.directory = directory;
+    this.reconciliationMetadata = Map.of("run_id", runId, "docker_context", context,
+        "compose_project", project, "configuration_directory", directory.toAbsolutePath().toString(),
+        "compose_file", directory.resolve("compose.yaml").toAbsolutePath().toString(),
+        "environment_file", directory.resolve("compose.env").toAbsolutePath().toString());
+    this.bootstrap = bootstrap;
+    this.independentBootstrap = independentBootstrap;
+    this.control = control;
+    this.nativePort = nativePort;
+    this.observer = Admin.create(Map.of(AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG, independentBootstrap,
+        AdminClientConfig.REQUEST_TIMEOUT_MS_CONFIG, 10000, AdminClientConfig.DEFAULT_API_TIMEOUT_MS_CONFIG, 15000));
+  }
+
+  /** Creates one separate run-owned Kafka cluster and proxy, retaining a bypass listener for independent observations. */
+  public static OwnedKafkaProtocolFaults start() throws Exception {
+    final String runId = requireRunId();
+    final String context = requireContext();
+    final Path directory = Files.createTempDirectory("e2e-kafka-protocol-",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
+    final int nativePort = reservePort();
+    final int independentPort = reserveDistinctPort(nativePort);
+    final Path ready = directory.resolve("ready.json");
+    new ObjectMapper().writeValue(directory.resolve("proxy.json").toFile(), Map.of("run_id", runId,
+        "upstream_port", nativePort, "excluded_ports", List.of(nativePort, independentPort), "ready_file", ready.toString()));
+    final Path proxyScript = Path.of("e2e/faults/kafka_frame_proxy.py").toAbsolutePath();
+    final Process proxy = new ProcessBuilder("python3", proxyScript.toString(),
+        "--config", directory.resolve("proxy.json").toString()).redirectOutput(ProcessBuilder.Redirect.DISCARD)
+        .redirectError(ProcessBuilder.Redirect.DISCARD).start();
+    OwnedKafkaProtocolFaults faults = null;
+    try {
+      Awaitility.await().atMost(Duration.ofSeconds(10)).until(() -> {
+        if (!proxy.isAlive()) {
+          throw new IllegalStateException("OWNED_KAFKA_PROXY_STARTUP_FAILED");
+        }
+        return Files.isRegularFile(ready);
+      });
+      final JsonNode ports = new ObjectMapper().readTree(ready.toFile());
+      final int proxyPort = ports.get("proxy_port").asInt();
+      final int controlPort = ports.get("control_port").asInt();
+      final Path composeFile = directory.resolve("compose.yaml");
+      final Path environmentFile = directory.resolve("compose.env");
+      Files.writeString(composeFile, withProxyAndObserverListeners(Files.readString(Path.of("e2e/faults/compose.authorization.yaml"))));
+      Files.writeString(environmentFile, brokerEnvironment(runId, nativePort, independentPort, proxyPort));
+      final String project = "rio-kafka-e2e-protocol-" + runId + "-" + UUID.randomUUID().toString().substring(0, 8);
+      final OwnedCompose compose = new OwnedCompose(context, project, runId, composeFile, environmentFile);
+      faults = new OwnedKafkaProtocolFaults(compose, proxy, directory, "127.0.0.1:" + proxyPort,
+          "127.0.0.1:" + independentPort, nativePort, URI.create("http://127.0.0.1:" + controlPort), runId, proxyScript, context, project);
+      captureOwnedProxyTree(proxy, proxyScript, directory, runId, faults.proxyProcesses);
+      compose.certifyAbsent();
+      faults.hasStartedBroker = true;
+      compose.command("up", "--detach", "--wait", "--wait-timeout", "180");
+      compose.requireOwnedService("authbroker");
+      faults.awaitActualBrokerListeners();
+      return faults;
+    } catch (Exception | AssertionError failure) {
+      try {
+        if (faults != null) {
+          faults.close();
+        } else {
+          final Cleanup cleanup = new Cleanup();
+          try {
+            cleanup.attempt(() -> reapProxy(proxy, proxyScript, directory, runId, new LinkedHashMap<>(), cleanup));
+            if (cleanup.failure == null) cleanup.attempt(() -> deletePrivateDirectory(directory));
+            if (cleanup.failure != null) throw cleanup.failure;
+          } finally {
+            cleanup.restoreInterrupt();
+          }
+        }
+      } catch (Exception cleanupFailure) {
+        failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  /**
+   * Immutable exact-run references for a private reconciliation ledger, with no configuration contents.
+   * Paths are references, not deletion authority; only the generated configuration directory is owned.
+   */
+  public Map<String, String> reconciliationMetadata() {
+    if (!reconciliationMetadata.get("run_id").equals(System.getenv("E2E_RUN_ID"))) {
+      throw new IllegalStateException("RECONCILIATION_METADATA_RUN_MISMATCH");
+    }
+    return reconciliationMetadata;
+  }
+
+  /** Returns the real advertised proxy endpoint for CP and ordinary producers/consumers. */
+  public String bootstrap() {
+    return bootstrap;
+  }
+
+  /** Returns a separate advertised own ADMIN listener which never traverses the fault proxy. */
+  public String independentBootstrap() {
+    return independentBootstrap;
+  }
+
+  /** Arms an exact topic/API/version/correlation window; unsupported versions fail visibly. */
+  public void arm(Rule rule) throws Exception {
+    final Map<String, Object> payload = new HashMap<>();
+    payload.put("api_key", rule.apiKey());
+    payload.put("api_version", rule.apiVersion());
+    payload.put("correlation_id", rule.correlationId());
+    payload.put("topic", rule.topic());
+    payload.put("phase", rule.phase().name().toLowerCase(Locale.ROOT));
+    payload.put("action", rule.action().name().toLowerCase(Locale.ROOT));
+    payload.put("skip_matches", rule.skipMatches());
+    payload.put("hits", rule.hits());
+    payload.put("hold_seconds", rule.holdSeconds());
+    command("/arm", payload);
+  }
+
+  /** Observes a parsed real frame reaching the armed boundary with no payload or timing shortcut. */
+  public void awaitReached(Duration deadline) {
+    Awaitility.await().atMost(deadline).until(() -> {
+      if (!proxy.isAlive()) {
+        throw new IllegalStateException("OWNED_KAFKA_PROXY_EXITED");
+      }
+      final JsonNode observation = state();
+      if (observation.path("counters").path("schema_parse_errors").asInt() > 0) {
+        throw new IllegalStateException("KAFKA_SCHEMA_MATCH_NOT_CERTIFIED");
+      }
+      return observation.path("window").path("reached").asInt() > 0;
+    });
+  }
+
+  /** Releases held actual request/response bytes unchanged. */
+  public void release() throws Exception {
+    command("/release", Map.of());
+  }
+
+  /** Aborts held frames so later rearming cannot send a previously interrupted mutation. */
+  public void abortHeld() throws Exception {
+    command("/abort-held", Map.of());
+  }
+
+  /** Closes only sockets accepted by this own proxy; the ADMIN observer remains independent. */
+  public void resetConnections() throws Exception {
+    command("/reset-connections", Map.of());
+  }
+
+  /** Exposes frame counters and API/version/correlation/connection IDs without messages, keys or client IDs. */
+  public JsonNode state() throws Exception {
+    final HttpRequest request = HttpRequest.newBuilder(control.resolve("/state")).timeout(CONTROL_DEADLINE).GET().build();
+    final HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString());
+    if (response.statusCode() != 200) {
+      throw new IllegalStateException("OWNED_KAFKA_CONTROL_UNAVAILABLE");
+    }
+    return mapper.readTree(response.body());
+  }
+
+  private void command(String path, Map<String, ?> payload) throws Exception {
+    final HttpRequest request = HttpRequest.newBuilder(control.resolve(path)).timeout(CONTROL_DEADLINE)
+        .header("Content-Type", "application/json").POST(HttpRequest.BodyPublishers.ofString(mapper.writeValueAsString(payload))).build();
+    if (http.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() != 200) {
+      throw new IllegalStateException("INVALID_OR_UNSUPPORTED_OWNED_KAFKA_RULE");
+    }
+  }
+
+  private void awaitActualBrokerListeners() throws Exception {
+    Awaitility.await().atMost(Duration.ofSeconds(60)).until(() -> {
+      final var nodes = observer.describeCluster().nodes().get(15, TimeUnit.SECONDS);
+      return nodes.size() == 1 && nodes.iterator().next().host().equals("127.0.0.1")
+          && nodes.iterator().next().port() == Integer.parseInt(independentBootstrap.split(":")[1]);
+    });
+    try (Admin client = Admin.create(Map.of(AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap))) {
+      final var nodes = client.describeCluster().nodes().get(30, TimeUnit.SECONDS);
+      if (nodes.size() != 1 || !nodes.iterator().next().host().equals("127.0.0.1")
+          || nodes.iterator().next().port() != Integer.parseInt(bootstrap.split(":")[1])) {
+        throw new IllegalStateException("KAFKA_ADVERTISED_LISTENER_BYPASSED_PROXY");
+      }
+    }
+  }
+
+  private static String withProxyAndObserverListeners(String original) {
+    String generated = replaceOnce(original,
+        "KAFKA_ADVERTISED_LISTENERS: INTERNAL://authbroker:19092,EXTERNAL://127.0.0.1:${E2E_KAFKA_AUTH_PORT}",
+        "KAFKA_ADVERTISED_LISTENERS: INTERNAL://authbroker:19092,EXTERNAL://127.0.0.1:${E2E_KAFKA_PROXY_PORT},"
+            + "ADMIN://127.0.0.1:${E2E_KAFKA_ADMIN_PORT}");
+    generated = replaceOnce(generated,
+        "KAFKA_LISTENERS: INTERNAL://0.0.0.0:19092,EXTERNAL://0.0.0.0:9092,CONTROLLER://authbroker:9093",
+        "KAFKA_LISTENERS: INTERNAL://0.0.0.0:19092,EXTERNAL://0.0.0.0:9092,ADMIN://0.0.0.0:9094,CONTROLLER://authbroker:9093");
+    generated = replaceOnce(generated,
+        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT",
+        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,ADMIN:PLAINTEXT,CONTROLLER:PLAINTEXT");
+    return replaceOnce(generated,
+        "      - \"127.0.0.1:${E2E_KAFKA_AUTH_PORT:?Required owned auth broker port}:9092\"",
+        "      - \"127.0.0.1:${E2E_KAFKA_AUTH_PORT:?Required owned auth broker port}:9092\"\n"
+            + "      - \"127.0.0.1:${E2E_KAFKA_ADMIN_PORT:?Required own observer port}:9094\"");
+  }
+
+  private static String replaceOnce(String original, String expected, String replacement) {
+    if (!original.contains(expected) || original.indexOf(expected) != original.lastIndexOf(expected)) {
+      throw new IllegalStateException("OWNED_KAFKA_COMPOSE_CONTRACT_CHANGED");
+    }
+    return original.replace(expected, replacement);
+  }
+
+  private static String brokerEnvironment(String runId, int nativePort, int independentPort, int proxyPort) {
+    final byte[] identity = new byte[16];
+    new java.security.SecureRandom().nextBytes(identity);
+    final String clusterId = Base64.getUrlEncoder().withoutPadding().encodeToString(identity);
+    final String javaOptions = System.getenv().getOrDefault("E2E_JAVA_TOOL_OPTIONS", "");
+    if (!javaOptions.isEmpty() && !javaOptions.equals("-XX:UseSVE=0")) {
+      throw new IllegalStateException("EXPLICIT_OWNED_KAFKA_JAVA_OPTIONS_REQUIRED");
+    }
+    return "E2E_RUN_ID=" + runId + "\nE2E_KAFKA_AUTH_PORT=" + nativePort + "\nE2E_KAFKA_ADMIN_PORT=" + independentPort
+        + "\nE2E_KAFKA_PROXY_PORT=" + proxyPort + "\nE2E_KAFKA_AUTH_CLUSTER_ID=" + clusterId + "\nE2E_JAVA_TOOL_OPTIONS="
+        + javaOptions + "\n";
+  }
+
+  private static int reservePort() throws Exception {
+    try (ServerSocket reservation = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      return reservation.getLocalPort();
+    }
+  }
+
+  private static int reserveDistinctPort(int reservedPort) throws Exception {
+    int candidate = reservePort();
+    while (candidate == reservedPort) {
+      candidate = reservePort();
+    }
+    return candidate;
+  }
+
+  private static String requireRunId() {
+    final String runId = System.getenv("E2E_RUN_ID");
+    if (runId == null || !runId.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+      throw new IllegalStateException("OWNED_KAFKA_RUN_ID_REQUIRED");
+    }
+    return runId;
+  }
+
+  private static String requireContext() {
+    final String context = System.getenv("DOCKER_CONTEXT");
+    if (context == null || !context.matches("[a-zA-Z0-9_-]{1,100}")) {
+      throw new IllegalStateException("EXPLICIT_OWNED_DOCKER_CONTEXT_REQUIRED");
+    }
+    return context;
+  }
+
+  /** Attempts each own cleanup stage independently, preserving failures and caller interruption. */
+  @Override
+  public void close() throws Exception {
+    if (isClosed) return;
+    final Cleanup cleanup = new Cleanup();
+    try {
+      cleanup.attempt(() -> {
+        if (proxy.isAlive()) abortHeld();
+      });
+      cleanup.attempt(() -> reapProxy(proxy, proxyScript, directory, runId, proxyProcesses, cleanup));
+      cleanup.attempt(() -> observer.close(Duration.ofSeconds(5)));
+      if (hasStartedBroker) {
+        cleanup.attempt(() -> compose.command("down", "--volumes", "--remove-orphans"));
+      }
+      cleanup.attempt(compose::certifyAbsent);
+      cleanup.attempt(() -> requireClosedPort(Integer.parseInt(bootstrap.split(":")[1])));
+      cleanup.attempt(() -> requireClosedPort(control.getPort()));
+      cleanup.attempt(() -> requireClosedPort(nativePort));
+      cleanup.attempt(() -> requireClosedPort(Integer.parseInt(independentBootstrap.split(":")[1])));
+      if (cleanup.failure == null) {
+        cleanup.attempt(() -> deletePrivateDirectory(directory));
+        isClosed = cleanup.failure == null;
+      }
+      // An uncertain stage retains the generated configuration for an exact retry/reconciliation.
+      if (cleanup.failure != null) throw cleanup.failure;
+    } finally {
+      cleanup.restoreInterrupt();
+    }
+  }
+
+  private record OwnedProxyProcess(ProcessHandle handle, Instant startedAt) {}
+
+  @FunctionalInterface
+  private interface CleanupStep { void run() throws Exception; }
+
+  /** Clears interruptions only while cleanup proceeds, then restores the caller's flag. */
+  private static final class Cleanup {
+    private Exception failure;
+    private boolean interrupted;
+
+    private Cleanup() {
+      if (Thread.interrupted()) record(new InterruptedException("OWNED_KAFKA_CLEANUP_INTERRUPTED"));
+    }
+
+    private void attempt(CleanupStep step) {
+      try {
+        step.run();
+      } catch (Exception | AssertionError error) {
+        record(error);
+      } finally {
+        if (Thread.interrupted()) record(new InterruptedException("OWNED_KAFKA_CLEANUP_INTERRUPTED"));
+      }
+    }
+
+    private void record(Throwable error) {
+      for (Throwable cause = error; cause != null; cause = cause.getCause()) {
+        if (cause instanceof InterruptedException) interrupted = true;
+      }
+      final Exception next = error instanceof Exception exception ? exception
+          : new IllegalStateException("OWNED_KAFKA_CLEANUP_ASSERTION_FAILED", error);
+      if (failure == null) failure = next;
+      else if (failure != next) failure.addSuppressed(next);
+    }
+
+    private void restoreInterrupt() {
+      if (interrupted) Thread.currentThread().interrupt();
+    }
+  }
+
+  private static void reapProxy(Process proxy, Path script, Path directory, String runId,
+      Map<Long, OwnedProxyProcess> processes, Cleanup cleanup) throws Exception {
+    cleanup.attempt(() -> captureOwnedProxyTree(proxy, script, directory, runId, processes));
+    terminateOwnedProxyTree(processes, false, cleanup);
+    awaitOwnedProxyTree(processes, Duration.ofSeconds(10), cleanup);
+    // Retain validated handles before parents exit, so an orphan cannot escape a retry.
+    cleanup.attempt(() -> captureOwnedProxyTree(proxy, script, directory, runId, processes));
+    terminateOwnedProxyTree(processes, true, cleanup);
+    awaitOwnedProxyTree(processes, Duration.ofSeconds(10), cleanup);
+    for (OwnedProxyProcess owned : processes.values()) {
+      if (isOriginalProcessAlive(owned)) throw new IllegalStateException("OWNED_KAFKA_PROXY_SUBTREE_REAP_FAILED");
+    }
+  }
+
+  private static void captureOwnedProxyTree(Process proxy, Path script, Path directory, String runId,
+      Map<Long, OwnedProxyProcess> processes) throws Exception {
+    final Path config = directory.resolve("proxy.json");
+    if (Files.isSymbolicLink(directory) || Files.isSymbolicLink(config)
+        || !runId.equals(new ObjectMapper().readTree(config.toFile()).path("run_id").asText())) {
+      throw new IllegalStateException("OWNED_KAFKA_PROXY_CONFIG_IDENTITY_UNVERIFIED");
+    }
+    final ProcessHandle root = proxy.toHandle();
+    if (proxy.isAlive() && !processes.containsKey(root.pid())) {
+      processes.put(root.pid(), new OwnedProxyProcess(root, root.info().startInstant().orElseThrow(
+          () -> new IllegalStateException("OWNED_KAFKA_PROXY_PROCESS_IDENTITY_UNVERIFIED"))));
+    }
+    // Only ancestry from the Process we spawned (or its already validated descendants) is accepted.
+    for (OwnedProxyProcess ancestor : new ArrayList<>(processes.values())) {
+      if (!isOriginalProcessAlive(ancestor)) continue;
+      for (ProcessHandle child : ancestor.handle().descendants().toList()) {
+        if (processes.containsKey(child.pid()) || !child.isAlive()) continue;
+        final List<String> arguments = List.of(child.info().arguments().orElseThrow(
+            () -> new IllegalStateException("OWNED_KAFKA_PROXY_DESCENDANT_IDENTITY_UNVERIFIED")));
+        final int configIndex = arguments.indexOf("--config");
+        if (!arguments.contains(script.toString()) || configIndex < 0 || configIndex + 1 >= arguments.size()
+            || !config.toString().equals(arguments.get(configIndex + 1))) {
+          throw new IllegalStateException("OWNED_KAFKA_PROXY_DESCENDANT_IDENTITY_UNVERIFIED");
+        }
+        processes.put(child.pid(), new OwnedProxyProcess(child, child.info().startInstant().orElseThrow(
+            () -> new IllegalStateException("OWNED_KAFKA_PROXY_DESCENDANT_IDENTITY_UNVERIFIED"))));
+      }
+    }
+  }
+
+  private static boolean isOriginalProcessAlive(OwnedProxyProcess owned) {
+    if (!owned.handle().isAlive()) return false;
+    final var actual = owned.handle().info().startInstant();
+    if (actual.isEmpty()) {
+      if (!owned.handle().isAlive()) return false;
+      throw new IllegalStateException("OWNED_KAFKA_PROXY_PROCESS_IDENTITY_UNVERIFIED");
+    }
+    // A reused PID no longer denotes the captured child and must never be signalled.
+    return owned.startedAt().equals(actual.get());
+  }
+
+  private static void terminateOwnedProxyTree(Map<Long, OwnedProxyProcess> processes, boolean forcibly, Cleanup cleanup) {
+    final List<OwnedProxyProcess> snapshot = new ArrayList<>(processes.values());
+    for (int index = snapshot.size() - 1; index >= 0; index--) {
+      final OwnedProxyProcess owned = snapshot.get(index);
+      cleanup.attempt(() -> {
+        if (isOriginalProcessAlive(owned)) {
+          if (forcibly) owned.handle().destroyForcibly();
+          else owned.handle().destroy();
+        }
+      });
+    }
+  }
+
+  private static void awaitOwnedProxyTree(Map<Long, OwnedProxyProcess> processes, Duration deadline, Cleanup cleanup) {
+    final long end = System.nanoTime() + deadline.toNanos();
+    while (System.nanoTime() < end) {
+      if (processes.values().stream().noneMatch(OwnedKafkaProtocolFaults::isOriginalProcessAlive)) return;
+      try {
+        TimeUnit.MILLISECONDS.sleep(100);
+      } catch (InterruptedException interrupted) {
+        // A real interruption is a retained failure; it cannot skip forcible reap or broker down.
+        cleanup.record(interrupted);
+      }
+    }
+  }
+
+  private static void requireClosedPort(int port) {
+    // Colima releases a published host listener asynchronously after Docker removes the container.
+    Awaitility.await().alias("OWNED_KAFKA_PROTOCOL_PORT_REMAINED_OPEN").pollInterval(Duration.ofMillis(100))
+        .atMost(Duration.ofSeconds(15)).until(() -> {
+          try (Socket connection = new Socket()) {
+            connection.connect(new InetSocketAddress("127.0.0.1", port), 500);
+            return false;
+          } catch (java.io.IOException expected) {
+            return true;
+          }
+        });
+  }
+
+  private static void deletePrivateDirectory(Path directory) throws Exception {
+    try (var entries = Files.list(directory)) {
+      for (Path entry : entries.toList()) {
+        Files.deleteIfExists(entry);
+      }
+    }
+    Files.deleteIfExists(directory);
+  }
+}
diff --git a/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/RealHttpFaultProxy.java b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/RealHttpFaultProxy.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3978ae4000690ead07968e57d8793ff2e61aaa3
--- /dev/null
+++ b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/RealHttpFaultProxy.java
@@ -0,0 +1,205 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.awaitility.Awaitility;
+
+/** Controls real network requests without replacing Toolkit clients or storing application values. */
+public final class RealHttpFaultProxy implements AutoCloseable {
+  private static final Duration CONTROL_DEADLINE = Duration.ofSeconds(5);
+  private final Process child;
+  private final Path directory;
+  private final URI address;
+  private final URI control;
+  private final ObjectMapper mapper = new ObjectMapper();
+  private final HttpClient client = HttpClient.newBuilder().connectTimeout(CONTROL_DEADLINE).build();
+
+  /** An exact network window; holds expire by aborting the connection rather than synthesizing success. */
+  public record Rule(String method, String pathContains, String bodyContains, Phase phase, Action action,
+                     int hits, int holdSeconds) {
+    /** Convenience for a single bounded deterministic window. */
+    public Rule(String method, String pathContains, String bodyContains, Phase phase, Action action) {
+      this(method, pathContains, bodyContains, phase, action, action == Action.HOLD ? 1000 : 1, 60);
+    }
+  }
+
+  /** REQUEST stops before the real server; RESPONSE stops after its actual response. */
+  public enum Phase { REQUEST, RESPONSE }
+
+  /** Failure actions affect the connection, never the business state or a successful server result. */
+  public enum Action { HOLD, RESET, FAIL503 }
+
+  private RealHttpFaultProxy(Process child, Path directory, URI address, URI control) {
+    this.child = child;
+    this.directory = directory;
+    this.address = address;
+    this.control = control;
+  }
+
+  /** Starts a loopback HTTP proxy scoped to one actual physical Fury Sandbox container. */
+  public static RealHttpFaultProxy startKvs(URI upstream, String physicalContainer) throws Exception {
+    if (physicalContainer == null || !physicalContainer.matches("sbox[a-zA-Z0-9_-]+")) {
+      throw new IllegalArgumentException("ACTUAL_FURY_SANDBOX_CONTAINER_REQUIRED");
+    }
+    return start(upstream, physicalContainer);
+  }
+
+  /** Starts a byte-transparent TCP proxy only to an explicitly owned loopback endpoint. */
+  public static RealHttpFaultProxy startTcp(int ownedPort) throws Exception {
+    if (ownedPort < 1024 || ownedPort > 65535) {
+      throw new IllegalArgumentException("OWNED_TCP_PORT_REQUIRED");
+    }
+    return start(URI.create("tcp://127.0.0.1:" + ownedPort), "");
+  }
+
+  private static RealHttpFaultProxy start(URI upstream, String physicalContainer) throws Exception {
+    if (upstream.getUserInfo() != null || upstream.getQuery() != null || upstream.getFragment() != null
+        || upstream.getHost() == null || !java.util.Set.of("http", "https", "tcp").contains(upstream.getScheme())) {
+      throw new IllegalArgumentException("GENERATED_SANDBOX_OR_OWNED_TCP_ENDPOINT_REQUIRED");
+    }
+    final Path directory = Files.createTempDirectory("e2e-network-fault-",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
+    final Path config = directory.resolve("config.json");
+    final Path ready = directory.resolve("ready.json");
+    new ObjectMapper().writeValue(config.toFile(), Map.of("upstream", upstream.toString(),
+        "allowed_authority", upstream.getRawAuthority(), "allowed_path_token", physicalContainer, "ready_file", ready.toString()));
+    final Process child = new ProcessBuilder("python3", Path.of("e2e/faults/network_proxy.py").toAbsolutePath().toString(),
+        "--config", config.toString()).redirectOutput(ProcessBuilder.Redirect.DISCARD)
+        .redirectError(ProcessBuilder.Redirect.DISCARD).start();
+    try {
+      Awaitility.await().atMost(Duration.ofSeconds(10)).until(() -> {
+        if (!child.isAlive()) {
+          throw new IllegalStateException("OWNED_NETWORK_PROXY_STARTUP_FAILED");
+        }
+        return Files.isRegularFile(ready);
+      });
+      final JsonNode ports = new ObjectMapper().readTree(ready.toFile());
+      final String scheme = upstream.getScheme().equals("tcp") ? "tcp" : "http";
+      return new RealHttpFaultProxy(child, directory, URI.create(scheme + "://127.0.0.1:" + ports.get("proxy_port").asInt()),
+          URI.create("http://127.0.0.1:" + ports.get("control_port").asInt()));
+    } catch (Exception | AssertionError failure) {
+      child.destroyForcibly();
+      child.waitFor(10, TimeUnit.SECONDS);
+      deleteDirectory(directory);
+      throw failure;
+    }
+  }
+
+  /** Returns the actual listener address to override only this child JVM's generated endpoint exports. */
+  public URI address() {
+    return address;
+  }
+
+  /** Arms one exact network window; body/path matchers are kept private and never logged. */
+  public void arm(Rule rule) throws Exception {
+    control("/arm", Map.of("method", rule.method(), "path_contains", rule.pathContains(),
+        "body_contains", rule.bodyContains(), "phase", rule.phase().name().toLowerCase(java.util.Locale.ROOT),
+        "action", rule.action().name().toLowerCase(java.util.Locale.ROOT), "hits", rule.hits(), "hold_seconds", rule.holdSeconds()));
+  }
+
+  /** Observes the real request/response boundary rather than relying on timing or a fabricated event. */
+  public void awaitReached(Duration deadline) {
+    Awaitility.await().atMost(deadline).until(() -> state().get("hits").asInt() > 0);
+  }
+
+  /** Releases the instance's held requests; use after an independent physical observation or child crash. */
+  public void release() throws Exception {
+    control("/release", Map.of());
+  }
+
+  /** Aborts a held request before forwarding, or discards a held actual response after forwarding. */
+  public void abortHeld() throws Exception {
+    control("/abort-held", Map.of());
+  }
+
+  /** Terminates only active TCP connections accepted by this proxy. */
+  public void resetConnections() throws Exception {
+    control("/reset-connections", Map.of());
+  }
+
+  /** Returns counters only, without payloads, paths, headers, tokens or upstream locations. */
+  public JsonNode state() throws Exception {
+    final HttpRequest request = HttpRequest.newBuilder(control.resolve("/state")).timeout(CONTROL_DEADLINE).GET().build();
+    final HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
+    if (response.statusCode() != 200) {
+      throw new IllegalStateException("OWNED_FAULT_CONTROL_UNAVAILABLE");
+    }
+    return mapper.readTree(response.body());
+  }
+
+  private void control(String path, Map<String, ?> payload) throws Exception {
+    final HttpRequest request = HttpRequest.newBuilder(control.resolve(path)).timeout(CONTROL_DEADLINE)
+        .header("Content-Type", "application/json").POST(HttpRequest.BodyPublishers.ofString(mapper.writeValueAsString(payload))).build();
+    if (client.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() != 200) {
+      throw new IllegalStateException("OWNED_FAULT_CONTROL_REJECTED");
+    }
+  }
+
+  /** Reaps only this proxy process and certifies that its two listeners are no longer reachable. */
+  @Override
+  public void close() throws Exception {
+    Exception failure = null;
+    try {
+      if (child.isAlive()) {
+        try {
+          abortHeld();
+          resetConnections();
+        } finally {
+          child.destroy();
+          if (!child.waitFor(10, TimeUnit.SECONDS)) {
+            child.destroyForcibly();
+            if (!child.waitFor(10, TimeUnit.SECONDS)) {
+              throw new IllegalStateException("OWNED_NETWORK_PROXY_REAP_FAILED");
+            }
+          }
+        }
+      }
+      requireClosedPort(address.getPort());
+      requireClosedPort(control.getPort());
+    } catch (Exception cleanupFailure) {
+      failure = cleanupFailure;
+    }
+    try {
+      deleteDirectory(directory);
+    } catch (Exception cleanupFailure) {
+      if (failure == null) {
+        failure = cleanupFailure;
+      } else {
+        failure.addSuppressed(cleanupFailure);
+      }
+    }
+    if (failure != null) {
+      throw failure;
+    }
+  }
+
+  private static void requireClosedPort(int port) throws Exception {
+    try (java.net.Socket connection = new java.net.Socket()) {
+      try {
+        connection.connect(new java.net.InetSocketAddress("127.0.0.1", port), 500);
+      } catch (java.io.IOException expected) {
+        return;
+      }
+      throw new IllegalStateException("OWNED_NETWORK_PROXY_LISTENER_REMAINED_OPEN");
+    }
+  }
+
+  private static void deleteDirectory(Path directory) throws Exception {
+    try (var files = Files.list(directory)) {
+      for (Path file : files.toList()) {
+        Files.deleteIfExists(file);
+      }
+    }
+    Files.deleteIfExists(directory);
+  }
+}
