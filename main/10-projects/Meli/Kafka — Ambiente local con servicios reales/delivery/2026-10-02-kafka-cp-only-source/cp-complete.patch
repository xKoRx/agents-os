+  @ParameterizedTest
+  @ValueSource(strings = {"MSK", "GCP", "ACTION"})
+  void actualFinalizeCasConflictPreservesIndependentWinnerAndDeploymentPublishGate(String domain) throws Exception {
+    Workflow flow = workflow(domain);
+    try (ToolkitSandboxFaults faults = ToolkitSandboxFaults.openResolved();
+         RealControlplaneProcess child = RealControlplaneProcess.start(fixture, faults.childEnvironment())) {
+      faults.write().arm(new Rule("PUT", flow.id(), "COMPLETED", Phase.REQUEST, Action.HOLD));
+      assertEquals(200, child.postJson(flow.path(), flow.json()).statusCode());
+      faults.write().awaitReached(WINDOW_DEADLINE);
+      assertEquals(1, fixture.awaitTopic(flow.topic()).partitions().size());
+      Item<byte[]> claimed = kvs.get(flow.key());
+      byte[] winningBytes = mapper.writeValueAsBytes(new TriggerStatusRecord(TriggerStatusRecord.State.FAILED,
+          System.currentTimeMillis(), System.currentTimeMillis(), "E2E_OTHER_WORKER"));
+      kvs.update(Item.builder(flow.key(), winningBytes).withVersion(claimed.getVersion()).withTtl(120).build());
+      Item<byte[]> winner = kvs.get(flow.key());
+      faults.write().release();
+      if ("ACTION".equals(domain)) {
+        assertEquals("COMPLETED", awaitTerminal(flow).path("status").asString());
+      }
+      Awaitility.await().atMost(WINDOW_DEADLINE).until(() -> {
+        fixture.drain(Duration.ofMillis(200));
+        return fixture.resultsFor(flow.id()).size() >= 1;
+      });
+      fixture.assertNoMoreResults(flow.id(), "ACTION".equals(domain) ? 2 : 1, Duration.ofSeconds(3));
+      assertEquals(winner.getVersion(), kvs.get(flow.key()).getVersion());
+      assertArrayEquals(winningBytes, kvs.get(flow.key()).getValue());
+      if (!"ACTION".equals(domain)) {
+        assertEquals("STARTED", fixture.resultsFor(flow.id()).get(0).path("status").asString(),
+            "Deployments gate terminal publication on the actual finalize CAS winner");
+      }
+    }
+  }
