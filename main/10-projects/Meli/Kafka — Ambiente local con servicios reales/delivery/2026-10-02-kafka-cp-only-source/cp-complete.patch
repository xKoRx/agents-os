+  @ParameterizedTest
+  @ValueSource(strings = {"MSK", "GCP", "ACTION"})
+  void actualTwoJvmStaleTakeoverCasRaceDropsHeldLoserWithoutDuplicateTerminal(String domain) throws Exception {
+    Workflow flow = workflow(domain);
+    try (ToolkitSandboxFaults faults = ToolkitSandboxFaults.openResolved();
+         RealControlplaneProcess heldWorker = RealControlplaneProcess.start(fixture, faults.childEnvironment());
+         RealControlplaneProcess winningWorker = RealControlplaneProcess.start(fixture)) {
+      kvs.save(Item.builder(flow.key(), mapper.writeValueAsBytes(TriggerStatusRecord.inProgress(
+          System.currentTimeMillis() - Duration.ofHours(1).toMillis()))).withTtl(120).build());
+      int staleVersion = kvs.get(flow.key()).getVersion();
+      faults.write().arm(new Rule("PUT", flow.id(), "IN_PROGRESS", Phase.REQUEST, Action.HOLD));
+      assertEquals(200, heldWorker.postJson(flow.path(), flow.json()).statusCode());
+      faults.write().awaitReached(WINDOW_DEADLINE);
+      assertEquals(staleVersion, kvs.get(flow.key()).getVersion());
+      assertEquals(200, winningWorker.postJson(flow.path(), flow.json()).statusCode());
+      assertPhysicalSuccess(flow);
+      Item<byte[]> winner = fixture.awaitKvs(flow.key(), "COMPLETED");
+      faults.write().release();
+      int count = fixture.resultsFor(flow.id()).size();
+      fixture.assertNoMoreResults(flow.id(), count, Duration.ofSeconds(3));
+      assertEquals(1, fixture.resultsFor(flow.id()).stream().filter(event -> "COMPLETED".equals(event.path("status").asString())).count());
+      assertEquals(winner.getVersion(), kvs.get(flow.key()).getVersion());
+      assertArrayEquals(winner.getValue(), kvs.get(flow.key()).getValue());
+    }
+  }
