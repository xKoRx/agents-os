+  private static final class Generation {
+    private final UUID id;
+    private final UUID fixture;
+    private final ProcessHandle worker;
+    private final Instant workerBirth;
+    private final Path lease;
+    private final Path log;
+    private Process process;
+    private Instant birth;
+    private String phase = "STARTING";
+    private boolean forced;
+    private boolean stopRequested;
+    private int exitStatus = Integer.MIN_VALUE;
+    private String logSha256 = "";
+    private Generation(UUID id, UUID fixture, ProcessHandle worker, Instant workerBirth, Path lease, Path log) {
+      this.id = id; this.fixture = fixture; this.worker = worker; this.workerBirth = workerBirth; this.lease = lease; this.log = log;
+    }
+  }
+
+  private record OwnedHandle(ProcessHandle handle, Instant birth) { }
+
+  public static String exchange(Path directory, List<String> fields, Duration timeout) throws Exception {
+    for (String field : fields) {
+      if (field == null || field.indexOf('\t') >= 0 || field.indexOf('\n') >= 0 || field.length() > 1024) {
+        throw failure("INVALID_CONTROL_FIELD");
+      }
+    }
+    try (SocketChannel channel = SocketChannel.open(StandardProtocolFamily.UNIX)) {
+      channel.configureBlocking(false);
+      Path socket = Path.of(required(loadConfiguration(directory), "socket_path"));
+      privateDirectory(socket.getParent());
+      channel.connect(UnixDomainSocketAddress.of(socket));
+      long end = System.nanoTime() + timeout.toNanos();
+      while (!channel.finishConnect()) {
+        if (System.nanoTime() >= end) { throw failure("CONTROL_CONNECT_DEADLINE"); }
+        TimeUnit.MILLISECONDS.sleep(10);
+      }
+      writeFrame(channel, String.join("\t", fields), timeout);
+      return readFrame(channel, timeout);
+    }
+  }
+
+  private static String readFrame(SocketChannel channel, Duration timeout) throws Exception {
+    channel.configureBlocking(false);
+    long end = System.nanoTime() + timeout.toNanos();
+    ByteBuffer size = ByteBuffer.allocate(4);
+    transfer(channel, size, false, end);
+    size.flip();
+    int length = size.getInt();
+    if (length < 1 || length > MAX_MESSAGE) { throw failure("CONTROL_MESSAGE_SIZE_INVALID"); }
+    ByteBuffer body = ByteBuffer.allocate(length);
+    transfer(channel, body, false, end);
+    return new String(body.array(), java.nio.charset.StandardCharsets.UTF_8);
+  }
+
+  private static void writeFrame(SocketChannel channel, String value, Duration timeout) throws Exception {
+    byte[] data = value.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    if (data.length > MAX_MESSAGE) { throw failure("CONTROL_MESSAGE_SIZE_INVALID"); }
+    ByteBuffer frame = ByteBuffer.allocate(4 + data.length).putInt(data.length).put(data);
+    frame.flip();
+    transfer(channel, frame, true, System.nanoTime() + timeout.toNanos());
+  }
+
+  private static void transfer(SocketChannel channel, ByteBuffer buffer, boolean write, long deadline) throws Exception {
+    while (buffer.hasRemaining()) {
+      int count = write ? channel.write(buffer) : channel.read(buffer);
+      if (count < 0) { throw failure("CONTROL_CONNECTION_CLOSED"); }
+      if (System.nanoTime() >= deadline) { throw failure("CONTROL_IO_DEADLINE"); }
+      if (count == 0) { TimeUnit.MILLISECONDS.sleep(5); }
+    }
+  }
+
+  private static Properties loadConfiguration(Path directory) throws Exception {
+    Path file = privateFile(directory.resolve("owner.properties"));
+    Properties properties = new Properties();
+    try (var reader = Files.newBufferedReader(file, java.nio.charset.StandardCharsets.UTF_8)) { properties.load(reader); }
+    return properties;
+  }
+
+  private static String required(Properties properties, String name) throws IOException {
+    String value = properties.getProperty(name);
+    if (value == null || value.isBlank()) { throw failure("CONFIGURATION_INCOMPLETE"); }
+    return value;
+  }
+
+  private static Path privateDirectory(Path path) throws Exception {
+    rejectSymlinkAncestors(path);
+    if (!path.isAbsolute() || !Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(path).equals(PosixFilePermissions.fromString("rwx------"))
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).getName().equals(System.getProperty("user.name"))) {
+      throw failure("PRIVATE_DIRECTORY_REQUIRED");
+    }
+    forceDirectory(path);
+    return path.toRealPath();
+  }
+
+  private static Path privateFile(Path path) throws Exception {
+    rejectSymlinkAncestors(path);
+    if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(path).equals(PosixFilePermissions.fromString("rw-------"))
+        || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).getName().equals(System.getProperty("user.name"))) {
+      throw failure("PRIVATE_FILE_REQUIRED");
+    }
+    return path;
+  }
+
+  private static void rejectSymlinkAncestors(Path path) throws IOException {
+    if (!path.isAbsolute() || !path.normalize().equals(path)) { throw failure("ABSOLUTE_NORMALIZED_PATH_REQUIRED"); }
+    for (Path current = path; current != null; current = current.getParent()) {
+      if (Files.isSymbolicLink(current)) { throw failure("SYMLINK_ANCESTOR_REJECTED"); }
+    }
+  }
+
+  private static Instant start(ProcessHandle handle) {
+    return handle.info().startInstant().orElseThrow(() -> new IllegalStateException("BIRTH_IDENTITY_UNAVAILABLE"));
+  }
+
+  private static void verifyIdentity(ProcessHandle handle, Instant birth) throws IOException {
+    if (!sameLiveIdentity(handle, birth)) { throw failure("PROCESS_IDENTITY_CHANGED"); }
+  }
+
+  private static boolean sameLiveIdentity(ProcessHandle handle, Instant birth) {
+    return handle.isAlive() && handle.info().startInstant().map(birth::equals).orElse(false);
+  }
+
+  private static void assertPortClosed(int port) throws IOException {
+    try (java.net.Socket socket = new java.net.Socket()) {
+      try {
+        socket.connect(new java.net.InetSocketAddress(InetAddress.getByName("127.0.0.1"), port), 250);
+      } catch (java.net.ConnectException refused) { return; }
+      throw failure("OWN_LISTENER_STILL_ACCEPTING_CONNECTIONS");
+    }
+  }
+
+  private static String hash(Path file) throws Exception {
+    MessageDigest hash = MessageDigest.getInstance("SHA-256");
+    try (var input = Files.newInputStream(file)) {
+      byte[] buffer = new byte[16384];
+      int length;
+      while ((length = input.read(buffer)) >= 0) { hash.update(buffer, 0, length); }
+    }
+    return java.util.HexFormat.of().formatHex(hash.digest());
+  }
+
+  private static void writeJournal(Path target, Map<String, Object> fields) throws Exception {
+    StringBuilder json = new StringBuilder("{");
+    boolean first = true;
+    for (var field : fields.entrySet()) {
+      if (!first) { json.append(','); }
+      first = false;
+      json.append(quote(field.getKey())).append(':');
+      Object value = field.getValue();
+      json.append(value instanceof Number || value instanceof Boolean ? value.toString() : quote(String.valueOf(value)));
+    }
+    writePrivate(target, json.append("}\n").toString());
+  }
+
+  private static String quote(String value) {
+    StringBuilder encoded = new StringBuilder("\"");
+    for (char character : value.toCharArray()) {
+      if (character == '"' || character == '\\') { encoded.append('\\').append(character); }
+      else if (character < 32) { encoded.append(String.format("\\u%04x", (int) character)); }
+      else { encoded.append(character); }
+    }
+    return encoded.append('"').toString();
+  }
+
+  private static void writePrivate(Path target, String body) throws Exception {
+    Path temp = Files.createTempFile(target.getParent(), ".pm-owner-", ".tmp",
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    try {
+      try (FileChannel channel = FileChannel.open(temp, StandardOpenOption.WRITE)) {
+        ByteBuffer bytes = ByteBuffer.wrap(body.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        while (bytes.hasRemaining()) { channel.write(bytes); }
+        channel.force(true);
+      }
+      Files.move(temp, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      forceDirectory(target.getParent());
+    } finally { Files.deleteIfExists(temp); }
+  }
+
+  private static void forceDirectory(Path path) throws IOException {
+    try (FileChannel directory = FileChannel.open(path, StandardOpenOption.READ)) { directory.force(true); }
+  }
+
+
+
+  private static void stopOwner(Path control) throws Exception {
+    Path directory = privateDirectory(control);
+    loadConfiguration(directory);
+    String[] tuple = Files.readString(privateFile(directory.resolve("guardian.identity"))).strip().split("\t");
+    if (tuple.length != 2) { throw failure("GUARDIAN_IDENTITY_INVALID"); }
+    ProcessHandle handle = ProcessHandle.of(Long.parseLong(tuple[0])).orElse(null);
+    if (handle == null || !handle.isAlive()) { return; }
+    Instant birth = Instant.parse(tuple[1]);
+    verifyIdentity(handle, birth);
+    List<String> args = List.of(handle.info().arguments().orElseThrow(() -> failure("GUARDIAN_COMMAND_UNKNOWN")));
+    if (!args.contains("PlaymakerProcessOwner") || !args.contains("serve") || !args.contains(directory.toString())) {
+      throw failure("GUARDIAN_COMMAND_CHANGED");
+    }
+    handle.destroy();
+    long end = System.nanoTime() + Duration.ofSeconds(10).toNanos();
+    while (sameLiveIdentity(handle, birth) && System.nanoTime() < end) { TimeUnit.MILLISECONDS.sleep(25); }
+    if (sameLiveIdentity(handle, birth)) { handle.destroyForcibly(); }
+    end = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+    while (sameLiveIdentity(handle, birth) && System.nanoTime() < end) { TimeUnit.MILLISECONDS.sleep(25); }
+    if (sameLiveIdentity(handle, birth)) { throw failure("GUARDIAN_REAP_FAILED"); }
+  }
+
+  /** Conservative parent fallback: signals only exact durable own tuples; never removes a journal. */
+  private static void recover(Path control) throws Exception {
+    Path directory = privateDirectory(control);
+    Properties config = loadConfiguration(directory);
+    Path reconciliation = privateDirectory(Path.of(required(config, "reconciliation_directory")));
+    Path jar = privateFile(Path.of(required(config, "jar_path"))).toRealPath();
+    if (!jar.startsWith(directory) || !hash(jar).equals(required(config, "jar_sha256"))) {
+      throw failure("RECOVERY_ARTIFACT_CHANGED");
+    }
+    boolean interrupted = Thread.interrupted();
+    Throwable failure = null;
+    try (var paths = Files.list(reconciliation)) {
+      for (Path lease : paths.filter(path -> path.getFileName().toString().startsWith("pm-lease-")
+          && path.getFileName().toString().endsWith(".json")).toList()) {
+        try {
+          Map<String, Object> record = new FlatJson(Files.readString(privateFile(lease))).parse();
+          if (!"PLAYMAKER_PROCESS_LEASE".equals(record.get("kind"))
+              || !required(config, "run_id").equals(record.get("run_id"))
+              || !jar.toString().equals(record.get("jar_path"))
+              || !required(config, "jar_sha256").equals(record.get("jar_sha256"))
+              || !required(config, "source_commit").equals(record.get("source_commit"))
+              || !required(config, "source_manifest_sha256").equals(record.get("source_manifest_sha256"))
+              || !required(config, "parent_start").equals(record.get("parent_start"))
+              || Long.parseLong(required(config, "parent_pid")) != ((Number) record.get("parent_pid")).longValue()) {
+            throw failure("RECOVERY_LEASE_NOT_EXACT");
+          }
+          UUID generation = UUID.fromString((String) record.get("generation"));
+          if (!lease.getFileName().toString().equals("pm-lease-" + generation + ".json")) {
+            throw failure("RECOVERY_LEASE_PATH_CHANGED");
+          }
+          long pid = ((Number) record.get("pm_pid")).longValue();
+          if (pid < 1 || ((String) record.get("pm_start")).isEmpty()) { throw failure("RECOVERY_STARTING_UNCERTAIN"); }
+          Instant birth = Instant.parse((String) record.get("pm_start"));
+          ProcessHandle process = ProcessHandle.of(pid).orElse(null);
+          if (process != null && process.isAlive()) {
+            verifyIdentity(process, birth);
+            String[] arguments = process.info().arguments().orElseThrow(() -> failure("RECOVERY_COMMAND_UNKNOWN"));
+            boolean correctJar = false;
+            for (int index = 0; index + 1 < arguments.length; index++) {
+              if ("-jar".equals(arguments[index]) && jar.toString().equals(arguments[index + 1])) { correctJar = true; }
+            }
+            if (!correctJar) { throw failure("RECOVERY_COMMAND_CHANGED"); }
+            List<OwnedHandle> handles = new ArrayList<>();
+            process.descendants().forEach(child -> handles.add(new OwnedHandle(child, start(child))));
+            handles.add(new OwnedHandle(process, birth));
+            for (OwnedHandle handle : handles.reversed()) {
+              if (sameLiveIdentity(handle.handle, handle.birth)) { handle.handle.destroy(); }
+            }
+            long end = System.nanoTime() + Duration.ofSeconds(10).toNanos();
+            while (handles.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth))
+                && System.nanoTime() < end) {
+              try { TimeUnit.MILLISECONDS.sleep(25); } catch (InterruptedException event) { interrupted = true; }
+            }
+            for (OwnedHandle handle : handles.reversed()) {
+              if (sameLiveIdentity(handle.handle, handle.birth)) { handle.handle.destroyForcibly(); }
+            }
+            end = System.nanoTime() + Duration.ofSeconds(15).toNanos();
+            while (handles.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth))
+                && System.nanoTime() < end) {
+              try { TimeUnit.MILLISECONDS.sleep(25); } catch (InterruptedException event) { interrupted = true; }
+            }
+            if (handles.stream().anyMatch(handle -> sameLiveIdentity(handle.handle, handle.birth))) {
+              throw failure("RECOVERY_PROCESS_STILL_ALIVE");
+            }
+          }
+        } catch (Exception event) {
+          if (failure == null) { failure = event; } else { failure.addSuppressed(event); }
+        }
+      }
+    } finally { if (interrupted) { Thread.currentThread().interrupt(); } }
+    assertPortClosed(Integer.parseInt(required(config, "port")));
+    if (failure != null) { throw failure("RECOVERY_PARTIALLY_UNVERIFIED"); }
+    System.out.println("PM_OWNER_RECOVERED_RESOURCES_RETAINED");
+  }
+
+  /** Full strict parser for the guardian's flat JSON journal, rejecting duplicate/unknown syntax. */
+  private static final class FlatJson {
+    private final String source;
+    private int position;
+    private FlatJson(String source) { this.source = source; }
+    private Map<String, Object> parse() throws IOException {
+      Map<String, Object> fields = new LinkedHashMap<>();
+      expect('{');
+      whitespace();
+      if (take('}')) { whitespace(); return fields; }
+      do {
+        String key = string();
+        expect(':');
+        Object value;
+        whitespace();
+        if (peek() == '"') { value = string(); }
+        else if (source.startsWith("true", position)) { position += 4; value = true; }
+        else if (source.startsWith("false", position)) { position += 5; value = false; }
+        else {
+          int begin = position;
+          if (peek() == '-') { position++; }
+          while (position < source.length() && Character.isDigit(source.charAt(position))) { position++; }
+          if (begin == position) { throw failure("JOURNAL_VALUE_INVALID"); }
+          try { value = Long.parseLong(source.substring(begin, position)); }
+          catch (NumberFormatException error) { throw failure("JOURNAL_NUMBER_INVALID"); }
+        }
+        if (fields.putIfAbsent(key, value) != null) { throw failure("JOURNAL_DUPLICATE_KEY"); }
+        whitespace();
+      } while (take(','));
+      expect('}');
+      whitespace();
+      if (position != source.length()) { throw failure("JOURNAL_TRAILING_BYTES"); }
+      return fields;
+    }
+    private String string() throws IOException {
+      expect('"');
+      StringBuilder value = new StringBuilder();
+      while (position < source.length()) {
+        char character = source.charAt(position++);
+        if (character == '"') { return value.toString(); }
+        if (character < 32) { throw failure("JOURNAL_STRING_INVALID"); }
+        if (character != '\\') { value.append(character); continue; }
+        if (position >= source.length()) { throw failure("JOURNAL_ESCAPE_INVALID"); }
+        char escape = source.charAt(position++);
+        switch (escape) {
+          case '"', '\\', '/' -> value.append(escape);
+          case 'b' -> value.append('\b');
+          case 'f' -> value.append('\f');
+          case 'n' -> value.append('\n');
+          case 'r' -> value.append('\r');
+          case 't' -> value.append('\t');
+          case 'u' -> {
+            if (position + 4 > source.length()) { throw failure("JOURNAL_ESCAPE_INVALID"); }
+            try { value.append((char) Integer.parseInt(source.substring(position, position + 4), 16)); }
+            catch (NumberFormatException error) { throw failure("JOURNAL_ESCAPE_INVALID"); }
+            position += 4;
+          }
+          default -> throw failure("JOURNAL_ESCAPE_INVALID");
+        }
+      }
+      throw failure("JOURNAL_STRING_UNTERMINATED");
+    }
+    private char peek() throws IOException {
+      if (position >= source.length()) { throw failure("JOURNAL_INCOMPLETE"); }
+      return source.charAt(position);
+    }
+    private void whitespace() { while (position < source.length() && Character.isWhitespace(source.charAt(position))) { position++; } }
+    private void expect(char value) throws IOException { whitespace(); if (!take(value)) { throw failure("JOURNAL_SYNTAX_INVALID"); } }
+    private boolean take(char value) { if (position < source.length() && source.charAt(position) == value) { position++; return true; } return false; }
+  }
+
+  private static IOException failure(String reason) { return new IOException("PM_OWNER_" + reason); }
+}
