--- /dev/null
+++ b/src/main/java/com/mercadolibre/rio_controlplane_kafka/reale2e/KafkaResultBigQueueClient.java
@@ -0,0 +1,151 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueClient;
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueClientException;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.time.ZonedDateTime;
+import java.util.List;
+import java.util.Properties;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.producer.KafkaProducer;
+import org.apache.kafka.clients.producer.ProducerConfig;
+import org.apache.kafka.clients.producer.ProducerRecord;
+import org.apache.kafka.common.header.internals.RecordHeader;
+import org.apache.kafka.common.serialization.StringSerializer;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Publishes unchanged SDK result JSON to real Kafka, confirming the broker acknowledgement. */
+public final class KafkaResultBigQueueClient implements BigQueueClient {
+  private static final int MAX_BYTES = 204_800;
+  private static final long SEND_TIMEOUT_SECONDS = 15;
+  private final KafkaProducer<String, String> producer;
+  private final ObjectMapper mapper;
+  private final String topic;
+
+  /** Creates a run-owned result transport; no file or in-memory fallback exists. */
+  public KafkaResultBigQueueClient(String bootstrap, String topic, String runId, ObjectMapper mapper) {
+    this.mapper = mapper;
+    this.topic = E2eSafety.topic(topic, runId);
+    Properties properties = new Properties();
+    properties.put(ProducerConfig.BOOTSTRAP_SERVERS_CONFIG, E2eSafety.loopbackBootstrap(bootstrap));
+    properties.put(ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG, StringSerializer.class.getName());
+    properties.put(ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG, StringSerializer.class.getName());
+    properties.put(ProducerConfig.ACKS_CONFIG, "all");
+    properties.put(ProducerConfig.ENABLE_IDEMPOTENCE_CONFIG, true);
+    properties.put(ProducerConfig.MAX_BLOCK_MS_CONFIG, 10_000);
+    properties.put(ProducerConfig.DELIVERY_TIMEOUT_MS_CONFIG, 10_000);
+    properties.put(ProducerConfig.REQUEST_TIMEOUT_MS_CONFIG, 5_000);
+    this.producer = new KafkaProducer<>(properties);
+  }
+
+  @Override
+  public byte[] send(Object message) {
+    return sendSerialized(mapper.writeValueAsBytes(message));
+  }
+
+  /** Sends pre-serialized SDK payload bytes without serializing them as a JSON string. */
+  public byte[] sendSerialized(byte[] payload) {
+    try {
+      return sendBytes(payload, List.of()).get(SEND_TIMEOUT_SECONDS, TimeUnit.SECONDS);
+    } catch (InterruptedException exception) {
+      Thread.currentThread().interrupt();
+      throw new BigQueueClientException("Interrupted while publishing real Kafka result", exception);
+    } catch (java.util.concurrent.ExecutionException | java.util.concurrent.TimeoutException exception) {
+      throw new BigQueueClientException("Real Kafka result publication failed", exception);
+    }
+  }
+
+  /** Compatible string overload for result publishers that already serialize their SDK DTO. */
+  public byte[] sendSerialized(String payload) {
+    if (payload == null) {
+      throw new IllegalArgumentException("Result payload is required");
+    }
+    return sendSerialized(payload.getBytes(StandardCharsets.UTF_8));
+  }
+
+  @Override
+  public CompletableFuture<byte[]> sendAsync(Object message) {
+    return sendBytes(mapper.writeValueAsBytes(message), List.of());
+  }
+
+  @Override
+  public byte[] sendWithFilters(Object message, List<String> filters) {
+    if (filters == null) {
+      throw new IllegalArgumentException("Filters are required");
+    }
+    return await(sendBytes(mapper.writeValueAsBytes(message), filters));
+  }
+
+  @Override
+  public byte[] sendScheduled(Object message, ZonedDateTime deliveryTime) {
+    if (deliveryTime == null) {
+      throw new IllegalArgumentException("Delivery time is required");
+    }
+    long delay = Math.max(0, Duration.between(ZonedDateTime.now(), deliveryTime).toMillis());
+    // This local transport waits for the actual scheduled send, never reports a synthetic ACK.
+    return CompletableFuture.supplyAsync(() -> send(message),
+        CompletableFuture.delayedExecutor(delay, TimeUnit.MILLISECONDS)).join();
+  }
+
+  @Override
+  public int bulkSend(List<Object> messages) {
+    if (messages == null || messages.isEmpty()) {
+      throw new IllegalArgumentException("Messages are required");
+    }
+    messages.forEach(this::send);
+    return messages.size();
+  }
+
+  @Override
+  public String getTopic() {
+    return topic;
+  }
+
+  @Override
+  public void close() {
+    producer.close(Duration.ofSeconds(SEND_TIMEOUT_SECONDS));
+  }
+
+  private CompletableFuture<byte[]> sendBytes(byte[] payload, List<String> filters) {
+    if (payload == null || payload.length == 0 || payload.length > MAX_BYTES) {
+      throw new IllegalArgumentException("Result payload must fit the BigQueue wire limit");
+    }
+    JsonNode json = mapper.readTree(payload);
+    if (!json.isObject() || json.has("msg")) {
+      throw new IllegalArgumentException("Local integration requires one raw SDK result payload");
+    }
+    JsonNode id = json.has("deployment_id") ? json.get("deployment_id") : json.get("action_id");
+    if (id == null || !id.isString() || id.asString().isBlank()) {
+      throw new IllegalArgumentException("Result correlation ID is required");
+    }
+    ProducerRecord<String, String> record =
+        new ProducerRecord<>(topic, id.asString(), new String(payload, StandardCharsets.UTF_8));
+    for (String filter : filters) {
+      record.headers().add(new RecordHeader("rio-filter", filter.getBytes(StandardCharsets.UTF_8)));
+    }
+    CompletableFuture<byte[]> acknowledged = new CompletableFuture<>();
+    producer.send(record, (metadata, exception) -> {
+      if (exception != null) {
+        acknowledged.completeExceptionally(exception);
+      } else {
+        String messageId = metadata.topic() + ":" + metadata.partition() + ":" + metadata.offset();
+        acknowledged.complete(messageId.getBytes(StandardCharsets.UTF_8));
+      }
+    });
+    return acknowledged;
+  }
+
+  private byte[] await(CompletableFuture<byte[]> acknowledged) {
+    try {
+      return acknowledged.get(SEND_TIMEOUT_SECONDS, TimeUnit.SECONDS);
+    } catch (InterruptedException exception) {
+      Thread.currentThread().interrupt();
+      throw new BigQueueClientException("Interrupted while publishing real Kafka result", exception);
+    } catch (java.util.concurrent.ExecutionException | java.util.concurrent.TimeoutException exception) {
+      throw new BigQueueClientException("Real Kafka result publication failed", exception);
+    }
+  }
+}
