+  @ParameterizedTest(name = "{0}: request to physical topic and completed persisted deployment")
+  @ValueSource(strings = {"aws-msk-topic", "gcp-kafka-topic"})
+  void authenticatedRequestCompletesOnlyAfterPhysicalKafkaEffectAndRealResult(String provider) throws Exception {
+    String topic = fixture.uniqueTopic("playmaker_crud");
+    database.seed(provider, mapper.writeValueAsString(fixture.paramsFor(provider, topic, 2, (short) 2)));
+    JsonNode response = deploy();
+    OwnedPlaymakerDatabase.Snapshot completed = awaitDeployment("deploy_completed");
+    assertEquals(response.path("id").asLong(), completed.id(), "Observe the exact requested deployment");
+    assertCorrelatedOutcome(provider, completed, "COMPLETED");
+    assertEquals(2, fixture.awaitTopic(topic).partitions().size());
+    assertTrue(fixture.awaitTopic(topic).partitions().stream().allMatch(partition -> partition.replicas().size() == 2));
+    evidence("PM-CRUD-" + provider, Map.of("topic", topic, "deployment_id", completed.correlationId(),
+        "mysql_status", completed.status(), "physical_partitions", 2, "physical_replication", 2));
+
+    HttpResponse<String> undeploy = request("DELETE", database.deploymentPath() + "/" + completed.id(), null, true);
+    assertEquals(200, undeploy.statusCode(), "Undeploy must dispatch through Playmaker's real service");
+    OwnedPlaymakerDatabase.Snapshot removed = awaitDeployment("undeploy_completed");
+    assertCorrelatedOutcome(provider, removed, "COMPLETED");
+    Awaitility.await().atMost(DEADLINE).until(() -> !fixture.admin().listTopics().names().get(10, TimeUnit.SECONDS).contains(topic));
+    evidence("PM-DELETE-" + provider, Map.of("topic", topic, "deployment_id", removed.correlationId(),
+        "mysql_status", removed.status(), "physically_absent", true));
+  }
