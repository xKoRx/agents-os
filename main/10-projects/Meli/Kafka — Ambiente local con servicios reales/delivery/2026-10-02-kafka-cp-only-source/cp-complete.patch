+#!/usr/bin/env python3
+"""Durably retain this run after final process/mutation proof fails."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+import tempfile
+
+
+def retain(directory, run):
+    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{7,63}", run):
+        raise ValueError("RUN_ID_REQUIRED")
+    if not directory.is_absolute() or any(p.is_symlink() for p in (directory, *directory.parents)):
+        raise ValueError("PRIVATE_CANONICAL_DIRECTORY_REQUIRED")
+    descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        identity = os.fstat(descriptor)
+        if identity.st_uid != os.getuid() or stat.S_IMODE(identity.st_mode) != 0o700:
+            raise ValueError("PRIVATE_OWNED_DIRECTORY_REQUIRED")
+        path = directory / "parent-final-proof-unknown.json"
+        data = {"schema_version": 1, "kind": "UNKNOWN_FINAL_PROCESS_OR_MUTATION_PROOF", "run_id": run}
+        if path.exists() or path.is_symlink():
+            current = path.lstat()
+            if not stat.S_ISREG(current.st_mode) or current.st_uid != os.getuid() or stat.S_IMODE(current.st_mode) != 0o600 \
+                    or current.st_size > 4096 or json.loads(path.read_bytes()) != data:
+                raise ValueError("EXISTING_UNKNOWN_MARKER_CHANGED")
+            with path.open("rb") as stream:
+                os.fsync(stream.fileno())
+        else:
+            fd, temporary = tempfile.mkstemp(prefix=".parent-unknown-", dir=directory)
+            try:
+                with os.fdopen(fd, "wb") as stream:
+                    stream.write(json.dumps(data, separators=(",", ":")).encode())
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                os.link(temporary, path, follow_symlinks=False)
+                os.fsync(descriptor)
+            finally:
+                os.unlink(temporary)
+        current = os.stat(directory, follow_symlinks=False)
+        if (current.st_dev, current.st_ino) != (identity.st_dev, identity.st_ino):
+            raise ValueError("DIRECTORY_IDENTITY_CHANGED")
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--directory", required=True, type=Path)
+    parser.add_argument("--run", required=True)
+    args = parser.parse_args()
+    try:
+        retain(args.directory, args.run)
+        print("UNKNOWN_FINAL_PROOF_DURABLY_RETAINED")
+    except (OSError, ValueError, TypeError) as error:
+        print("UNKNOWN_FINAL_PROOF_RETENTION_FAILED:" + type(error).__name__, file=sys.stderr)
+        raise SystemExit(2)
