+  @Test
+  void actualLongActionOverlapsDefaultStaleLeaseButIndependentWinnerOwnsPublication() throws Exception {
+    String topic = fixture.uniqueTopic("rpc_stale_action");
+    fixture.createTopic(topic, 1, (short) 1, Map.of());
+    fixture.seed(topic, 0, "stale-original", "actual-long-action-value");
+    var original = fixture.action(Map.of("topic_name", topic, "num_msgs", 1, "timeout_ms", 5000,
+        "offset", "LATEST"));
+    var trigger = new ActionTriggerMessage(original.actionId(), original.dataProductId(), original.componentId(),
+        original.environmentId(), original.actionName(), original.componentTemplate(), 60, original.data(),
+        null, original.triggeredBy(), original.triggeredAt(), original.componentName(),
+        original.environmentName(), original.dataProductName());
+    String json = mapper.writeValueAsString(Map.of("msg", trigger));
+    try (RealControlplaneProcess second = startChild(faults.independentBootstrap(), independentRouting)) {
+      faults.arm(requestRule(2, LIST_OFFSETS_VERSION, topic, 0, 1000));
+      assertEquals(200, child.postJson("/triggers/actions", json).statusCode());
+      requireReached(2, LIST_OFFSETS_VERSION);
+      String key = "action:" + trigger.actionId();
+      var firstClaim = fixture.awaitKvs(key, "IN_PROGRESS");
+      long claimTime = mapper.readValue(firstClaim.getValue(), TriggerStatusRecord.class).startedAt();
+      assertTrue(claimTime > 0);
+      Awaitility.await().atMost(Duration.ofSeconds(40)).pollInterval(Duration.ofMillis(200))
+          .until(() -> System.currentTimeMillis() - claimTime > 31_000);
+      assertEquals("IN_PROGRESS", mapper.readTree(kvs.get(key).getValue()).path("state").asString());
+      assertEquals(firstClaim.getVersion(), kvs.get(key).getVersion(),
+          "Default30s lease aged while the first real Kafka request remains blocked");
+      fixture.drain(Duration.ofMillis(200));
+      assertEquals(1, fixture.resultsFor(trigger.actionId()).size());
+      assertEquals("STARTED", fixture.resultsFor(trigger.actionId()).getFirst().path("status").asString());
+      assertEquals(200, second.postJson("/triggers/actions", json).statusCode());
+      var completed = fixture.awaitAction(trigger.actionId());
+      assertEquals("COMPLETED", completed.path("status").asString());
+      assertEquals("stale-original", completed.path("result").path("messages").get(0).path("key").asString());
+      var winner = fixture.awaitKvs(key, "COMPLETED");
+      assertTrue(winner.getVersion() > firstClaim.getVersion());
+      faults.release();
+      fixture.assertNoMoreResults(trigger.actionId(), 3, Duration.ofSeconds(8));
+      assertEquals(2, fixture.resultsFor(trigger.actionId()).stream()
+          .filter(event -> "STARTED".equals(event.path("status").asString())).count());
+      assertEquals(1, fixture.resultsFor(trigger.actionId()).stream()
+          .filter(event -> "COMPLETED".equals(event.path("status").asString())).count());
+      assertEquals(winner.getVersion(), kvs.get(key).getVersion());
+      Awaitility.await().atMost(Duration.ofSeconds(20)).until(() -> observer.listConsumerGroups().all().get()
+          .stream().noneMatch(group -> group.groupId().startsWith("controlplane-peek-")));
+    }
+  }
