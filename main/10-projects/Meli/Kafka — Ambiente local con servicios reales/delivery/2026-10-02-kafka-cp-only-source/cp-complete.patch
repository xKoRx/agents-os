+          recovery.deleteTopics(List.of(topic)).all().get(30, TimeUnit.SECONDS);
+        } catch (java.util.concurrent.ExecutionException exception) {
+          if (!(exception.getCause() instanceof org.apache.kafka.common.errors.UnknownTopicOrPartitionException)) {
+            throw exception;
+          }
+        }
+        Awaitility.await().atMost(Duration.ofSeconds(30)).until(() ->
+            !recovery.listTopics().names().get(10, TimeUnit.SECONDS).contains(topic));
+      } catch (Exception | AssertionError cleanupFailure) {
+        failure = accumulate(failure, cleanupFailure);
+      }
+      try {
+        try {
+          recovery.deleteConsumerGroups(List.of(fixture.resultGroup())).all().get(30, TimeUnit.SECONDS);
+        } catch (java.util.concurrent.ExecutionException exception) {
+          if (!(exception.getCause() instanceof org.apache.kafka.common.errors.GroupIdNotFoundException)) {
+            throw exception;
+          }
+        }
+        Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> recovery.listConsumerGroups().all()
+            .get(10, TimeUnit.SECONDS).stream().noneMatch(group -> fixture.resultGroup().equals(group.groupId())));
+      } catch (Exception | AssertionError cleanupFailure) {
+        failure = accumulate(failure, cleanupFailure);
+      }
+      for (String key : keys) {
+        try {
+          kvs.delete(key);
+          assertTrue(kvs.get(key) == null);
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = accumulate(failure, cleanupFailure);
+        }
+      }
+      if (failure == null) {
+        try { fixture.reconcileFailedCleanup(); }
+        catch (Exception | AssertionError reconciliationFailure) { failure = accumulate(failure, reconciliationFailure); }
+      }
+      if (failure instanceof Error error) {
+        throw error;
+      }
+      if (failure instanceof Exception exception) {
+        throw exception;
+      }
+    }
+  }
+
+  private static Throwable accumulate(Throwable first, Throwable next) {
+    if (first == null) {
+      return next;
+    }
+    first.addSuppressed(next);
+    return first;
+  }
+}
