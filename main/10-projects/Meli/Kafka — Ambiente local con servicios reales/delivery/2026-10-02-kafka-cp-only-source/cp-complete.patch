+  /** Immutable broker observation, independent from the process/receipt cleanup authorization. */
+  public record ResultOffsetSnapshot(Map<TopicPartition, Long> tails, Map<String, Object> receipt) {
+    public ResultOffsetSnapshot { tails = Map.copyOf(tails); receipt = Map.copyOf(receipt); }
+  }
