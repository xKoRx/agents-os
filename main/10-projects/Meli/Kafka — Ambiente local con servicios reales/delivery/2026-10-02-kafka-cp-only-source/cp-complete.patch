+    ConfigResource resource = new ConfigResource(ConfigResource.Type.TOPIC, topic);
+    try {
+      clusterAdmin.createAcls(acls).all().get(30, TimeUnit.SECONDS);
+      Awaitility.await().atMost(Duration.ofSeconds(30)).until(() -> {
+        try {
+          // The propagation probe requests the existing value and cannot introduce a new config effect.
+          clusterAdmin.incrementalAlterConfigs(Map.of(resource, List.of(new AlterConfigOp(
+              new ConfigEntry("retention.ms", "1234567"), AlterConfigOp.OpType.SET))))
+              .all().get(10, TimeUnit.SECONDS);
+          return false;
+        } catch (java.util.concurrent.ExecutionException exception) {
+          if (exception.getCause() instanceof org.apache.kafka.common.errors.TopicAuthorizationException) {
+            return true;
+          }
+          throw exception;
+        }
+      });
+      assertEquals(200, child.postJson("/triggers/deployments", mapper.writeValueAsString(Map.of("msg", failedTrigger))).statusCode());
