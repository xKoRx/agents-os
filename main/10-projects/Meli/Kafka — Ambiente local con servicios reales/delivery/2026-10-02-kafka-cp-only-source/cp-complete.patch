new file mode 100755
index 0000000000000000000000000000000000000000..400e08d366d946ccdb7f56671e7e60f61f3867dd
--- /dev/null
+++ b/e2e/check-kafka.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Own five-broker readiness/RF1-5 proof; never claims CP, KVS, OAuth or BigQueue coverage."""
+import base64,json,os,re,subprocess,socket,sys,tempfile,uuid
+from pathlib import Path
+
+root=Path(__file__).resolve().parents[1]
+context=os.environ.get('DOCKER_CONTEXT')
+if not context:
+ raise SystemExit('REAL_E2E_EXPLICIT_DOCKER_CONTEXT_REQUIRED')
+run_id=uuid.uuid4().hex
+project='rio-kafka-e2e-smoke-'+run_id
+base=int(os.environ.get('E2E_KAFKA_BASE_PORT','39092'))
+for port in range(base,base+5):
+ with socket.socket() as probe:
+  try: probe.bind(('127.0.0.1',port))
+  except OSError: raise SystemExit('REAL_E2E_OWNED_PORT_UNAVAILABLE')
+evidence=root/'build/real-e2e'/run_id
+evidence.mkdir(parents=True,exist_ok=True)
+os.chmod(evidence,0o700)
+ledger={'run_id':run_id,'project':project,'docker_context':context,'topics':[],
+ 'scope':'five real broker readiness and RF1-5 only','cp_kvs_managed_gates':'NOT_EXECUTED'}
+started=False
+exit_status=0
+with tempfile.TemporaryDirectory(prefix='rio-kafka-e2e-smoke-') as folder:
+ env_path=Path(folder)/'compose.env'
+ exports={'E2E_RUN_ID':run_id,'E2E_KRAFT_CLUSTER_ID':base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='),
+  **{'E2E_KAFKA_PORT_'+str(i):str(base+i-1) for i in range(1,6)}}
+ architecture=subprocess.check_output(['docker','--context',context,'info','--format','{{.Architecture}}'],text=True).strip()
+ exports['E2E_JAVA_TOOL_OPTIONS']='-XX:UseSVE=0' if architecture in ('aarch64','arm64') else ''
+ env_path.write_text(''.join(name+'='+value+'\n' for name,value in exports.items()))
+ os.chmod(env_path,0o600)
+ compose=['docker','--context',context,'compose','--project-name',project,'--env-file',str(env_path),'--file',str(root/'e2e/compose.yaml')]
+ def command(args):
+  return subprocess.run(args,text=True,capture_output=True,check=True,timeout=240).stdout
+ def kafka(script,*args):
+  return command(compose+['exec','--no-TTY','broker1','/opt/kafka/bin/'+script,'--bootstrap-server','broker1:19092',*args])
+ try:
+  started=True
+  command(compose+['up','--detach','--wait','--wait-timeout','180'])
+  readiness=kafka('kafka-broker-api-versions.sh')
+  live=set(re.findall(r'id: ([1-5]) rack:',readiness))
+  if len(live)!=5: raise RuntimeError('REAL_E2E_REQUIRES_FIVE_LIVE_BROKERS')
+  ledger['live_broker_ids']=sorted(live)
+  for replication_factor in range(1,6):
+   topic='e2e_'+run_id+'_rf_'+str(replication_factor)
+   kafka('kafka-topics.sh','--create','--topic',topic,'--partitions','3','--replication-factor',str(replication_factor))
+   ledger['topics'].append(topic)
+   description=kafka('kafka-topics.sh','--describe','--topic',topic)
+   replicas=re.findall(r'Replicas: ([0-9,]+)\s+Isr: ([0-9,]+)',description)
+   if len(replicas)!=3 or any(len(set(replica.split(',')))!=replication_factor or len(set(isr.split(',')))!=replication_factor for replica,isr in replicas):
+    raise RuntimeError('REAL_E2E_RF_ASSIGNMENT_MISMATCH')
+   (evidence/('rf-'+str(replication_factor)+'.txt')).write_text(description)
+  ledger['verdict']='PASS'
+  print('FIVE_BROKERS_RF1_TO_5_PASS:'+str(evidence))
+ except (subprocess.SubprocessError,RuntimeError) as failure:
+  ledger['verdict']='FAIL'
+  ledger['failure_type']=type(failure).__name__
+  # Only own broker logs; no application/credential payload is present in this smoke.
+  try: (evidence/'broker-failure.log').write_text(command(compose+['logs','--no-color','--tail','80']))
+  except subprocess.SubprocessError: pass
+  print('FIVE_BROKERS_RF1_TO_5_FAILED:'+type(failure).__name__,file=sys.stderr)
+  exit_status=1
+ finally:
+  print('TEST_EVIDENCE_PUBLISHED:'+str(evidence))
+  cleanup_ok=True
+  if started:
+   try:
+    command(compose+['down','--volumes','--remove-orphans'])
+    for resource in ('container','network','volume'):
+     args=['docker','--context',context]
+     args+=['ps','--all','--quiet'] if resource=='container' else [resource,'ls','--quiet']
+     if command(args+['--filter','label=com.docker.compose.project='+project]).strip(): cleanup_ok=False
+   except subprocess.SubprocessError: cleanup_ok=False
+  ledger['cleanup']='CLEANUP_CERTIFIED' if cleanup_ok else 'CLEANUP_FAILED'
+  (evidence/'ledger.json').write_text(json.dumps(ledger,indent=2)+'\n')
+  print(ledger['cleanup']+':'+project)
+  if not cleanup_ok: exit_status=1
+sys.exit(exit_status)
diff --git a/e2e/ci.sh b/e2e/ci.sh
