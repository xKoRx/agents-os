+  private boolean bridgeCaughtUp(List<String> triggerTopics) throws Exception {
+    Map<TopicPartition, OffsetSpec> latest = new LinkedHashMap<>();
+    var descriptions = admin.describeTopics(triggerTopics).allTopicNames().get(10, TimeUnit.SECONDS);
+    for (String topic : triggerTopics) {
+      TopicDescription description = descriptions.get(topic);
+      assertNotNull(description, "Every explicit trigger topic needs actual metadata");
+      assertTrue(!description.partitions().isEmpty(), "Every trigger topic must have actual partitions");
+      for (var partition : description.partitions()) {
+        latest.put(new TopicPartition(topic, partition.partition()), OffsetSpec.latest());
+      }
+    }
+    var endOffsets = admin.listOffsets(latest).all().get(10, TimeUnit.SECONDS);
+    Map<TopicPartition, org.apache.kafka.clients.consumer.OffsetAndMetadata> committed;
+    try {
+      committed = admin.listConsumerGroupOffsets("e2e_" + runId + "_cp_bridge")
+          .partitionsToOffsetAndMetadata().get(10, TimeUnit.SECONDS);
+    } catch (java.util.concurrent.ExecutionException exception) {
+      if (exception.getCause() instanceof org.apache.kafka.common.errors.GroupIdNotFoundException) {
+        return false;
+      }
+      throw exception;
+    }
+    for (TopicPartition partition : latest.keySet()) {
+      var actualEnd = endOffsets.get(partition);
+      var actualCommit = committed.get(partition);
+      if (actualEnd == null || actualEnd.offset() < 0 || actualCommit == null
+          || actualCommit.offset() < actualEnd.offset()) {
+        return false;
+      }
+    }
+    return true;
+  }
