+  }
+
+  void setOwner(Product product, String team, String project) throws Exception {
+    requireProduct(product);
+    beforeMutation(product.id());
+    query("UPDATE data_product SET team_name=?,project_code=? WHERE id=? AND name=?",
+        team, project, product.id(), product.name());
+  }
+
+  RowLock lock(Component component) throws Exception {
+    requireProduct(component.product());
+    return new RowLock(component.id());
+  }
+
+  long number(String sql, Object... values) throws Exception {
+    return Long.parseLong(query(sql, values).strip());
+  }
+
+  String query(String sql, Object... values) throws Exception {
+    return command(mysqlCommand(), prepared(sql, List.of(values)));
+  }
+
+  private String prepared(String sql, List<?> values) {
+    StringBuilder statement = new StringBuilder("PREPARE owned_stmt FROM '").append(sql.replace("'", "''")).append("';\n");
+    for (int index = 0; index < values.size(); index++) {
+      byte[] bytes = String.valueOf(values.get(index)).getBytes(StandardCharsets.UTF_8);
+      statement.append("SET @owned_").append(index).append("=CONVERT(X'")
+          .append(HexFormat.of().formatHex(bytes)).append("' USING utf8mb4);\n");
+    }
+    statement.append("EXECUTE owned_stmt");
+    if (!values.isEmpty()) {
+      statement.append(" USING ");
+      for (int index = 0; index < values.size(); index++) {
+        statement.append(index == 0 ? "" : ",").append("@owned_").append(index);
+      }
+    }
+    return statement.append(";\nDEALLOCATE PREPARE owned_stmt;\n").toString();
+  }
+
+  private List<String> mysqlCommand() {
+    return docker("exec", "-i", container, "sh", "-c", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" mysql --user=root"
+        + " --database=rioplaymakerdb --batch --raw --unbuffered --skip-column-names");
+  }
+
+  private List<String> docker(String... arguments) {
+    List<String> command = new ArrayList<>(List.of("docker", "--context", dockerContext));
+    command.addAll(List.of(arguments));
+    return List.copyOf(command);
+  }
+
+  private String command(List<String> arguments, String stdin) throws Exception {
+    Process process = new ProcessBuilder(arguments).redirectError(ProcessBuilder.Redirect.DISCARD).start();
+    FutureTask<byte[]> reader = new FutureTask<>(() -> process.getInputStream().readAllBytes());
+    Thread.ofVirtual().start(reader);
+    try {
+      try (var output = process.getOutputStream()) {
+        output.write(stdin.getBytes(StandardCharsets.UTF_8));
+      }
+      if (!process.waitFor(DEADLINE.toMillis(), TimeUnit.MILLISECONDS)) {
+        throw new IOException("OWN_MYSQL_COMMAND_TIMEOUT");
+      }
+      if (process.exitValue() != 0) {
+        throw new IOException("OWN_MYSQL_COMMAND_FAILED");
+      }
+      return new String(reader.get(DEADLINE.toMillis(), TimeUnit.MILLISECONDS), StandardCharsets.UTF_8);
+    } catch (Exception failure) {
+      reapFailedCommand(process, failure);
+      throw failure;
+    }
+  }
+
+  private static void reapFailedCommand(Process process, Exception failure) {
+    boolean interrupted = Thread.interrupted() || failure instanceof InterruptedException;
+    try {
+      try {
+        process.getOutputStream().close();
+      } catch (IOException closeFailure) {
+        failure.addSuppressed(closeFailure);
+      }
+      process.destroyForcibly();
+      long deadline = System.nanoTime() + Duration.ofSeconds(10).toNanos();
+      while (process.isAlive() && System.nanoTime() < deadline) {
+        try {
+          process.waitFor(Math.max(1, deadline - System.nanoTime()), TimeUnit.NANOSECONDS);
+        } catch (InterruptedException ignored) {
+          interrupted = true;
+        }
+      }
+      if (process.isAlive()) {
+        failure.addSuppressed(new IOException("OWN_MYSQL_CHILD_REAP_UNVERIFIED"));
+      }
+    } finally {
+      if (interrupted) {
+        Thread.currentThread().interrupt();
+      }
+    }
+  }
+
+  private void beforeMutation(long productId) throws Exception {
+    lifecycle.beforeSqlMutation(Map.of("data_product." + productId, productId));
+  }
+
+  private long nextId() {
+    return 1_000_000_000L + random.nextLong(1_000_000_000L);
+  }
+
+  private void requireProduct(Product product) throws Exception {
+    if (!product.equals(products.get(product.id()))) {
+      throw new IllegalArgumentException("UNKNOWN_PRODUCT_OWNERSHIP");
+    }
+    if (number("SELECT COUNT(*) FROM data_product WHERE id=? AND name=?", product.id(), product.name()) != 1) {
+      throw new IllegalStateException("OWN_PRODUCT_IDENTITY_CHANGED");
+    }
+  }
+
+  @Override
+  public void assertNoPmSessions() throws Exception {
+    assertEquals(0, number("SELECT COUNT(*) FROM information_schema.processlist WHERE DB='rioplaymakerdb'"
+        + " AND ID<>CONNECTION_ID()"), "No PM or fixture SQL session may survive cleanup barrier");
+  }
+
+  void assertNoExternalWorkflowReferences() throws Exception {
+    for (Product product : products.values()) {
+      assertEquals(0, number("SELECT COUNT(*) FROM import_authorization ia LEFT JOIN component c"
+          + " ON c.id=ia.source_component_id WHERE ia.requesting_data_product_id=? OR c.data_product_id=?",
+          product.id(), product.id()), "Odin workflow requires its own approved cleanup contract; retain SQL resources");
+    }
+  }
+
+  void cleanupVerified(OwnedPlaymakerLifecycle.CleanupPermit permit) throws Exception {
+    permit.assertValid();
+    assertNoPmSessions();
+    assertNoExternalWorkflowReferences();
+    for (Product product : products.values()) {
+      requireProduct(product);
+      cleanupProduct(product, permit);
+    }
+    assertOwnedAbsence();
+  }
+
+  private void cleanupProduct(Product product, OwnedPlaymakerLifecycle.CleanupPermit permit) throws Exception {
+    List<Long> componentIds = query("SELECT id FROM component WHERE data_product_id=?", product.id()).lines()
+        .map(Long::parseLong).toList();
+    for (long componentId : componentIds) {
+      delete(permit, "DELETE l FROM deployment_log l JOIN deployment d ON d.id=l.deployment_id"
+          + " JOIN service s ON s.id=d.service_id WHERE s.component_id=?", componentId);
+      delete(permit, "DELETE d FROM deployment d JOIN service s ON s.id=d.service_id WHERE s.component_id=?", componentId);
+      delete(permit, "DELETE FROM component_run WHERE component_id=?", componentId);
+      delete(permit, "DELETE FROM pipeline_version_component WHERE component_id=?", componentId);
+      delete(permit, "DELETE FROM component_relations WHERE source_component_id=? OR destination_component_id=?",
+          componentId, componentId);
+      delete(permit, "DELETE FROM service WHERE component_id=?", componentId);
+    }
+    delete(permit, "DELETE FROM deployment_group WHERE data_product_id=?", product.id());
+    delete(permit, "DELETE pe FROM pipeline_execution pe JOIN pipeline p ON p.id=pe.pipeline_id WHERE p.data_product_id=?",
+        product.id());
+    delete(permit, "DELETE pv FROM pipeline_version pv JOIN pipeline p ON p.id=pv.pipeline_id WHERE p.data_product_id=?",
+        product.id());
+    for (long componentId : componentIds) {
+      delete(permit, "DELETE FROM component_definition WHERE component_id=?", componentId);
+      delete(permit, "DELETE FROM component WHERE id=? AND data_product_id=?", componentId, product.id());
+    }
+    delete(permit, "DELETE FROM pipeline WHERE id=? AND data_product_id=?", product.pipelineId(), product.id());
+    delete(permit, "DELETE FROM environment WHERE data_product_id=?", product.id());
+    delete(permit, "DELETE FROM data_product WHERE id=? AND name=?", product.id(), product.name());
+  }
+
+  private void delete(OwnedPlaymakerLifecycle.CleanupPermit permit, String sql, Object... values) throws Exception {
+    // The permit is revalidated before every destructive statement, not only at teardown entry.
+    permit.assertValid();
+    query(sql, values);
+  }
+
+  private void assertOwnedAbsence() throws Exception {
+    for (Product product : products.values()) {
+      assertEquals(0, number("SELECT COUNT(*) FROM data_product WHERE id=? OR name=?", product.id(), product.name()));
+      assertEquals(0, number("SELECT COUNT(*) FROM component WHERE data_product_id=?", product.id()));
+      assertEquals(0, number("SELECT COUNT(*) FROM environment WHERE data_product_id=?", product.id()));
+      assertEquals(0, number("SELECT COUNT(*) FROM pipeline WHERE data_product_id=?", product.id()));
+      assertEquals(0, number("SELECT COUNT(*) FROM component_relations WHERE source_data_product_id=?"
+          + " OR destination_data_product_id=?", product.id(), product.id()));
+      assertEquals(0, number("SELECT COUNT(*) FROM deployment_group WHERE data_product_id=?", product.id()));
+    }
+  }
+
+  @Override
+  public void close() {
+    // Destruction is exclusively cleanupVerified with a current STOPPED-generation permit.
+  }
+
+  static String required(String name) {
+    return com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture.requiredEnv(name);
+  }
+
+  record Product(long id, String name, String pipelineId) { }
+  record Environment(long id, String name, Product product) { }
+  record Component(long id, String name, String template, Product product) { }
+  record Definition(long id, JsonNode params) { }
+  record Slot(long id, long environmentId, long definitionId, String status, JsonNode outputs) { }
+  record Deployment(long id, String status, String correlation, long definitionId, long environmentId, JsonNode outputs) { }
+
+  final class RowLock implements AutoCloseable {
+    private final Process process;
+    private final long componentId;
+    private long ownerSession;
+
+    private RowLock(long componentId) throws Exception {
+      this.componentId = componentId;
+      process = new ProcessBuilder(mysqlCommand()).redirectError(ProcessBuilder.Redirect.DISCARD).start();
+      try {
+        process.getOutputStream().write(("START TRANSACTION;\n"
+            + prepared("SELECT id FROM component WHERE id=? FOR UPDATE", List.of(componentId))
+            + "SELECT CONCAT('OWN_LOCK_ACQUIRED:', CONNECTION_ID());\n").getBytes(StandardCharsets.UTF_8));
+        process.getOutputStream().flush();
+        FutureTask<Boolean> locked = new FutureTask<>(() -> {
+          BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+          String line;
+          while ((line = reader.readLine()) != null) {
+            if (line.matches("OWN_LOCK_ACQUIRED:[1-9][0-9]*")) {
+              ownerSession = Long.parseLong(line.substring("OWN_LOCK_ACQUIRED:".length()));
+              return true;
+            }
+          }
+          return false;
+        });
+        Thread.ofVirtual().start(locked);
+        if (!locked.get(DEADLINE.toMillis(), TimeUnit.MILLISECONDS)) {
+          throw new IOException("OWN_SQL_LOCK_NOT_ACQUIRED");
+        }
+      } catch (Exception failure) {
+        reapFailedCommand(process, failure);
+        throw failure;
+      }
+    }
+
+    void awaitBlockedRequests(int count) {
+      if (count < 1 || ownerSession < 1 || !process.isAlive()) {
+        throw new IllegalStateException("OWN_SQL_LOCK_OWNER_UNVERIFIED");
+      }
+      Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+        assertEquals(1, number("SELECT COUNT(*) FROM information_schema.innodb_trx WHERE trx_mysql_thread_id=?",
+            ownerSession), "Exact native blocking transaction must remain live");
+        // MySQL 8.0 documented ENGINE_LOCK_ID/ENGINE joins; LOCK_DATA must equal this native PRIMARY key.
+        // A missing/null observation times out rather than crediting an unrelated global wait.
+        String sql = "SELECT COUNT(DISTINCT w.REQUESTING_ENGINE_TRANSACTION_ID,t.PROCESSLIST_ID)"
+            + " FROM performance_schema.data_lock_waits w"
+            + " JOIN performance_schema.data_locks b ON b.ENGINE=w.ENGINE AND b.ENGINE_LOCK_ID=w.BLOCKING_ENGINE_LOCK_ID"
+            + " JOIN performance_schema.threads owner_thread ON owner_thread.THREAD_ID=b.THREAD_ID"
+            + " JOIN information_schema.innodb_trx owner_trx ON owner_trx.trx_mysql_thread_id=owner_thread.PROCESSLIST_ID"
+            + " AND owner_trx.trx_id=b.ENGINE_TRANSACTION_ID"
+            + " JOIN performance_schema.data_locks r ON r.ENGINE=w.ENGINE AND r.ENGINE_LOCK_ID=w.REQUESTING_ENGINE_LOCK_ID"
+            + " JOIN performance_schema.threads t ON t.THREAD_ID=r.THREAD_ID"
+            + " JOIN information_schema.innodb_trx requester ON requester.trx_mysql_thread_id=t.PROCESSLIST_ID"
+            + " AND requester.trx_id=r.ENGINE_TRANSACTION_ID"
+            + " WHERE b.ENGINE='INNODB' AND owner_thread.PROCESSLIST_ID=? AND b.OBJECT_SCHEMA='rioplaymakerdb' AND b.OBJECT_NAME='component'"
+            + " AND b.INDEX_NAME='PRIMARY' AND b.LOCK_TYPE='RECORD' AND b.LOCK_STATUS='GRANTED' AND b.LOCK_DATA=?"
+            + " AND r.OBJECT_SCHEMA=b.OBJECT_SCHEMA AND r.OBJECT_NAME=b.OBJECT_NAME AND r.INDEX_NAME=b.INDEX_NAME"
+            + " AND r.LOCK_DATA=b.LOCK_DATA AND r.LOCK_TYPE='RECORD' AND r.LOCK_STATUS='WAITING'"
+            + " AND w.BLOCKING_ENGINE_TRANSACTION_ID=b.ENGINE_TRANSACTION_ID AND w.BLOCKING_THREAD_ID=b.THREAD_ID"
+            + " AND w.REQUESTING_ENGINE_TRANSACTION_ID=r.ENGINE_TRANSACTION_ID AND w.REQUESTING_THREAD_ID=r.THREAD_ID"
+            + " AND t.PROCESSLIST_ID<>owner_thread.PROCESSLIST_ID";
+        assertEquals(count, number(sql, ownerSession, componentId),
+            "Distinct actual sessions/transactions must wait on this exact owned PRIMARY record");
+      });
+    }
+
+    @Override
+    public void close() throws Exception {
+      try {
+        process.getOutputStream().write("COMMIT;\n".getBytes(StandardCharsets.UTF_8));
+        process.getOutputStream().close();
+        if (!process.waitFor(DEADLINE.toMillis(), TimeUnit.MILLISECONDS) || process.exitValue() != 0) {
+          throw new IOException("OWN_SQL_LOCK_RELEASE_FAILED");
+        }
+      } catch (Exception failure) {
+        reapFailedCommand(process, failure);
+        throw failure;
+      }
+
+    }
+  }
+}
