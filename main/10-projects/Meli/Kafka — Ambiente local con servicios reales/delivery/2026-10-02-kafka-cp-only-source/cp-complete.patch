+      <<: *environment
+      KAFKA_NODE_ID: 4
+      KAFKA_LISTENERS: INTERNAL://0.0.0.0:19092,EXTERNAL://0.0.0.0:9092,CONTROLLER://broker4:9093
+      KAFKA_ADVERTISED_LISTENERS: INTERNAL://broker4:19092,EXTERNAL://127.0.0.1:${E2E_KAFKA_PORT_4}
+      KAFKA_LOG_DIRS: /var/lib/kafka/data
