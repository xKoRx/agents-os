+#!/usr/bin/env python3
+"""Collect exact owned process exits. Read-only with respect to applications/services."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import sys
+import tempfile
+from owned_test_worker_proof import TASKS, GRADLE_PRIMARY_CLASSES, require_task_completion, require_worker_generation
+
+
+def require(condition, code):
+    if not condition:
+        raise RuntimeError("PROCESS_EXIT_PROOF_UNVERIFIED:" + code)
+
+
+def private(path):
+    require(path.is_absolute() and path.is_file() and not path.is_symlink()
+            and path.stat().st_uid == os.getuid() and stat.S_IMODE(path.stat().st_mode) == 0o600
+            and path.stat().st_size <= 1_000_000
+            and all(not p.is_symlink() for p in path.parents), "PRIVATE_FILE")
+    return json.loads(path.read_bytes())
+
+
+def durable(path, data):
+    require(path.is_absolute() and path.parent.is_dir() and not path.exists()
+            and not path.is_symlink() and stat.S_IMODE(path.parent.stat().st_mode) == 0o700
+            and path.parent.stat().st_uid == os.getuid(), "PRIVATE_DESTINATION")
+    fd, temporary = tempfile.mkstemp(prefix=".exit-proof-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as output:
+            output.write(json.dumps(data, separators=(",", ":")).encode())
+            output.flush()
+            os.fsync(output.fileno())
+        # link is exclusive, unlike replacement of an existing supposedly immutable proof.
+        os.link(temporary, path, follow_symlinks=False)
+        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        os.unlink(temporary)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--directory", required=True, type=Path)
+    parser.add_argument("--exit-directory", required=True, type=Path)
+    parser.add_argument("--run", required=True)
+    parser.add_argument("--command-status", required=True, type=int)
+    parser.add_argument("--owner-status", required=True, type=int)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--task", required=True, choices=TASKS)
+    args = parser.parse_args()
+    require(args.owner_status == 0, "OWNED_PROCESS_CONTROL_FAILURE")
+    registry = private(args.directory / "expected-generations.json")
+    require(registry.get("run_id") == args.run and registry.get("kind") == "KVS_EXPECTED_GENERATION_REGISTRY"
+            and registry.get("phase") == "DECLARED_BEFORE_APPLICATIONS", "EXPECTED_REGISTRY")
+    generations = registry.get("generations", [])
+    ids = [entry.get("generation_id") for entry in generations]
+    require(bool(ids) and len(ids) == len(set(ids)), "EXPECTED_GENERATIONS")
+    exits = []
+    expected_files = {"process-exit-" + generation + ".json" for generation in ids}
+    task_file = "test-task-" + args.task + ".json"
+    task_files = {task_file}
+    task = private(args.exit_directory / task_file)
+    require_task_completion(task, args.run, args.task)
+    for manifest in generations:
+        record = private(args.exit_directory / ("process-exit-" + manifest["generation_id"] + ".json"))
+        require(record.get("schema_version") == 1 and record.get("kind") == "OWNED_GENERATION_PROCESS_EXIT"
+                and record.get("run_id") == args.run, "ACTUAL_EXIT_RECORD")
+        for key in ("generation_id", "application", "pid", "process_start_instant", "process_owner_pid",
+                    "process_owner_start_instant", "process_owner_kind"):
+            require(record.get(key) == manifest.get(key), "GENERATION_OWNER_BINDING")
+        if record.get("process_owner_kind") == "DIRECT_PROCESS_WAIT":
+            require(record.get("exit_proof") == "ACTUAL_PROCESS_WAIT_FOR", "DIRECT_WAIT_REQUIRED")
+        elif record.get("process_owner_kind") == "GRADLE_TEST_WORKER_NORMAL_EXIT":
+            require(record.get("exit_proof") == "PINNED_GRADLE_TEST_WORKER_WAIT_FOR_STOP_NORMAL_EXIT", "GRADLE_PRIMARY_REQUIRED")
+            require_worker_generation(manifest, record, task)
+        else:
+            require(False, "UNKNOWN_PROCESS_OWNER")
+        exits.append(record)
+    require({path.name for path in args.exit_directory.iterdir()} == expected_files | task_files,
+            "EXACT_EXIT_FILE_INVENTORY")
+    durable(args.output, {"schema_version": 1, "kind": "ALL_OWNED_GENERATION_EXITS", "run_id": args.run,
+                          "test_command_exit_status": args.command_status, "owner_control_exit_status": args.owner_status, "generations": exits, "test_task_completion": task})
+    print("ACTUAL_OWNED_PROCESS_EXIT_RECORDS_COLLECTED")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (RuntimeError, OSError, ValueError, KeyError, TypeError) as error:
+        print(str(error) if isinstance(error, RuntimeError) else "PROCESS_EXIT_PROOF_UNVERIFIED:INVALID", file=sys.stderr)
+        raise SystemExit(2)
diff --git a/e2e/publish-ci-evidence.py b/e2e/publish-ci-evidence.py
new file mode 100755
index 0000000000000000000000000000000000000000..f8dc3df8cf916c002caf0d42003b38bbdab5b5d4
--- /dev/null
+++ b/e2e/publish-ci-evidence.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""Publish current-job whitelist only; private logs, identities, origins and journals never leave CI."""
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import stat
+import xml.etree.ElementTree as ET
+
+FAMILIES = ('cp-functional', 'playmaker-canonical', 'playmaker-candidate', 'managed-oauth-bigqueue')
+MAX_BYTES = 8_388_608
+SOURCE_NAMES = ('cp', 'playmaker-canonical', 'playmaker-candidate')
+RECEIPTS = {'gate.json': 'gate', 'sandbox/state.json': 'sandbox-lifecycle',
+            'bindings/binding.json': 'input-binding', 'evidence/cleanup.txt': 'runtime-cleanup',
+            'evidence/process-exits.json': 'process-exits',
+            'evidence/final-mutation-proof.json': 'mutation-proof',
+            'ci-final-proof.json': 'ci-final-proof'}
+
+
+def require(condition, code):
+    if not condition:
+        raise ValueError('CI_PUBLIC_EVIDENCE:' + code)
+
+
+def private_directory(path):
+    require(path.is_absolute() and not any(item.is_symlink() for item in (path, *path.parents)), 'DIRECTORY')
+    actual = path.stat()
+    require(stat.S_ISDIR(actual.st_mode) and actual.st_uid == os.getuid()
+            and stat.S_IMODE(actual.st_mode) == 0o700, 'DIRECTORY')
+
+
+def private_bytes(path):
+    private_directory(path.parent)
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        actual = os.fstat(descriptor)
+        require(stat.S_ISREG(actual.st_mode) and actual.st_uid == os.getuid()
+                and stat.S_IMODE(actual.st_mode) == 0o600 and actual.st_size <= MAX_BYTES, 'FILE')
+        with os.fdopen(os.dup(descriptor), 'rb') as source:
+            raw = source.read(MAX_BYTES + 1)
+        require(len(raw) <= MAX_BYTES, 'SIZE')
+        current = path.stat(follow_symlinks=False)
+        require((actual.st_dev, actual.st_ino) == (current.st_dev, current.st_ino), 'FILE_REPLACED')
+        return raw
+    finally:
+        os.close(descriptor)
+
+
+def allowed_tests(root):
+    classes = {}
+    for source_set in ('realIntegrationTest', 'e2eTest', 'managedIntegrationTest'):
+        for source in (root / 'src' / source_set / 'java').rglob('*.java'):
+            text = source.read_text()
+            package = re.search(r'^package ([a-zA-Z0-9_.]+);', text, re.MULTILINE)
+            if package is None:
+                continue
+            classname = package[1] + '.' + source.stem
+            methods = set(re.findall(r'\bvoid\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\(', text))
+            classes[classname] = methods
+    return classes
+
+
+def elapsed(value):
+    try:
+        number = float(value)
+        return str(number) if math.isfinite(number) and 0 <= number <= 86_400 else '0'
+    except (ValueError, TypeError):
+        return '0'
+
+
+def scrub_junit(raw, classes):
+    require(b'<!DOCTYPE' not in raw.upper() and b'<!ENTITY' not in raw.upper(), 'XML_DTD')
+    original = ET.fromstring(raw)
+    require(original.tag in ('testsuite', 'testsuites'), 'XML_ROOT')
+    clean = ET.Element('testsuite', {'name': 'real-e2e-current-job'})
+    counts = {'tests': 0, 'failures': 0, 'errors': 0, 'skipped': 0}
+    total_time = 0.0
+    testcases = list(original.findall('testcase'))
+    require(len(testcases) == len(list(original.iter('testcase'))), 'XML_NESTED_TESTCASE')
+    for testcase in testcases:
+        counts['tests'] += 1
+        require(counts['tests'] <= 100_000, 'XML_TEST_LIMIT')
+        classname = testcase.get('classname', '')
+        method = re.match(r'^([a-zA-Z_][a-zA-Z0-9_]*)(?:\(|\[|$)', testcase.get('name', ''))
+        allowed = classname in classes and method and method[1] in classes[classname]
+        name = method[1] if allowed else 'redacted_case'
+        # Parameter display names, unknown class names and all other attributes can contain runtime data.
+        child = ET.SubElement(clean, 'testcase', {'classname': classname if allowed else 'redacted',
+                                                'name': name, 'time': elapsed(testcase.get('time'))})
+        total_time += float(child.get('time'))
+        kinds = [item.tag for item in testcase if item.tag in ('failure', 'error', 'skipped')]
+        require(len(kinds) <= 1, 'XML_AMBIGUOUS_OUTCOME')
+        if kinds:
+            counts[{'failure': 'failures', 'error': 'errors', 'skipped': 'skipped'}[kinds[0]]] += 1
+            ET.SubElement(child, kinds[0], {'message': 'REAL_E2E_DETAIL_REDACTED'})
+    # A suite-level failure that has no testcase must not disappear into an empty green report.
+    require(not list(original.findall('./failure')) and not list(original.findall('./error')), 'XML_SUITE_FAILURE')
+    for name in ('tests', 'failures', 'errors', 'skipped'):
+        clean.set(name, str(counts[name]))
+    clean.set('time', str(total_time))
+    return ET.tostring(clean, encoding='utf-8', xml_declaration=True), counts
+
+
+def publish(args):
+    private_directory(args.job_directory)
+    metadata = json.loads(private_bytes(args.job_directory / 'job.json'))
+    require(metadata.get('schema_version') == 1 and metadata.get('job_id') == args.job_id, 'JOB_BINDING')
+    require(re.fullmatch('[a-zA-Z0-9_-]{1,100}', args.job_id), 'JOB_ID')
+    require(metadata.get('sources', {}).get('cp') == args.cp_sha
+            and re.fullmatch('[a-f0-9]{40}', args.cp_sha), 'CP_SOURCE')
+    sources = {}
+    for name in SOURCE_NAMES:
+        value = metadata.get('sources', {}).get(name)
+        if value is not None:
+            require(re.fullmatch('[a-f0-9]{40}', value), 'SOURCE_SHA')
+            sources[name] = value
+    require(args.destination.is_absolute() and not args.destination.exists()
+            and not args.destination.is_symlink()
+            and not any(parent.is_symlink() for parent in args.destination.parents), 'FRESH_PUBLIC_DIRECTORY')
+    classes = allowed_tests(Path(__file__).resolve().parents[1])
+    reports = []
+    artifacts = []
+    runs = []
+    invalid = False
+    for family in FAMILIES:
+        directory = args.job_directory / family
+        private_directory(directory)
+        gate = json.loads(private_bytes(directory / 'gate.json'))
+        require(gate.get('family') == family and type(gate.get('exit_status')) is int
+                and 0 <= gate['exit_status'] <= 255, 'GATE_STATUS')
+        run = gate.get('run_id')
+        if run is not None:
+            require(re.fullmatch('[a-z0-9][a-z0-9_-]{7,63}', run), 'RUN_ID')
+            runs.append(run)
+        report = {'family': family, 'exit_status': gate['exit_status'], 'command_exit_status': gate['exit_status'], 'run_id': run,
+                  'sandbox_cleanup_status': gate.get('sandbox_cleanup_status'), 'receipts': [],
+                  'junit': {'tests': 0, 'failures': 0, 'errors': 0, 'skipped': 0}}
+        for path, receipt_type in RECEIPTS.items():
+            actual = directory / path
+            if actual.exists() or actual.is_symlink():
+                raw = private_bytes(actual)
+                report['receipts'].append({'kind': receipt_type, 'sha256': hashlib.sha256(raw).hexdigest()})
+        junit = directory / 'evidence/junit'
+        if junit.exists():
+            private_directory(junit)
+            for index, path in enumerate(sorted(junit.glob('TEST-*.xml'))):
+                raw = private_bytes(path)
+                clean, counts = scrub_junit(raw, classes)
+                for name, value in counts.items():
+                    if name in report['junit']:
+                        report['junit'][name] += value
+                artifacts.append((f'junit/{family}/{index:05}.xml', clean))
+                report['receipts'].append({'kind': 'private-junit', 'sha256': hashlib.sha256(raw).hexdigest()})
+        if gate['exit_status'] == 0 and (not report['junit']['tests']
+                                       or any(report['junit'][name] for name in ('failures', 'errors', 'skipped'))):
+            invalid = True
+            report['exit_status'] = 1
+            report['evidence_status'] = 'FAILED_EMPTY_SKIPPED_OR_INCONSISTENT_GREEN'
+        else:
+            report['evidence_status'] = 'CURRENT_JOB_OUTCOMES_ONLY'
+        cleanup = report['sandbox_cleanup_status']
+        require(cleanup is None or type(cleanup) is int and 0 <= cleanup <= 255, 'CLEANUP_STATUS')
+        reports.append(report)
+    require(len(set(runs)) == len(runs), 'CROSS_FAMILY_RUN_REUSE')
+    result = {'schema_version': 1, 'job_id': args.job_id, 'sources': sources, 'families': reports,
+              'control_exit_status': metadata.get('control_exit_status'),
+              'evidence_status': 'FAILED' if invalid else 'SANITIZED_CURRENT_JOB_ONLY'}
+    control = result['control_exit_status']
+    require(type(control) is int and 0 <= control <= 255, 'CONTROL_STATUS')
+    args.destination.mkdir(mode=0o700)
+    for name, raw in artifacts:
+        path = args.destination / name
+        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        path.write_bytes(raw)
+    (args.destination / 'gates.json').write_text(json.dumps(result, indent=2) + '\n')
+    require(not invalid, 'GREEN_GATE_WITHOUT_COMPLETE_JUNIT')
+    print('CI_PUBLIC_EVIDENCE_PUBLISHED')
+
+
+def verify(args):
+    require(args.directory.is_absolute() and not any(path.is_symlink() for path in (args.directory, *args.directory.parents)),
+            'PUBLIC_DIRECTORY')
+    path = args.directory / 'gates.json'
+    require(path.is_file() and not path.is_symlink() and path.stat().st_size <= MAX_BYTES, 'PUBLIC_MANIFEST')
+    metadata = json.loads(path.read_bytes())
+    require(metadata.get('job_id') == args.job_id and metadata.get('sources', {}).get('cp') == args.cp_sha
+            and metadata.get('schema_version') == 1, 'CURRENT_JOB_PUBLIC_BINDING')
+    require(set(metadata) == {'schema_version', 'job_id', 'sources', 'families', 'control_exit_status', 'evidence_status'},
+            'PUBLIC_MANIFEST_FIELDS')
+    require(set(metadata['sources']).issubset(SOURCE_NAMES)
+            and all(re.fullmatch('[a-f0-9]{40}', value) for value in metadata['sources'].values()), 'PUBLIC_SOURCE')
+    require([row.get('family') for row in metadata['families']] == list(FAMILIES), 'PUBLIC_FAMILIES')
+    for row in metadata['families']:
+        require(set(row) == {'family', 'exit_status', 'command_exit_status', 'run_id', 'sandbox_cleanup_status', 'receipts', 'junit', 'evidence_status'},
+                'PUBLIC_GATE_FIELDS')
+        require(type(row['exit_status']) is int and 0 <= row['exit_status'] <= 255, 'PUBLIC_GATE_STATUS')
+        require(type(row['command_exit_status']) is int and 0 <= row['command_exit_status'] <= 255, 'PUBLIC_COMMAND_STATUS')
+        require(row['run_id'] is None or re.fullmatch('[a-z0-9][a-z0-9_-]{7,63}', row['run_id']), 'PUBLIC_RUN')
+        require(set(row['junit']) == {'tests', 'failures', 'errors', 'skipped'}
+                and all(type(value) is int and value >= 0 for value in row['junit'].values()), 'PUBLIC_COUNTS')
+        require(row['evidence_status'] in ('CURRENT_JOB_OUTCOMES_ONLY', 'FAILED_EMPTY_SKIPPED_OR_INCONSISTENT_GREEN'),
+                'PUBLIC_GATE_EVIDENCE')
+        require(row['sandbox_cleanup_status'] is None or type(row['sandbox_cleanup_status']) is int
+                and 0 <= row['sandbox_cleanup_status'] <= 255, 'PUBLIC_CLEANUP_STATUS')
+        for receipt in row['receipts']:
+            require(set(receipt) == {'kind', 'sha256'} and receipt['kind'] in (*RECEIPTS.values(), 'private-junit')
+                    and re.fullmatch('[a-f0-9]{64}', receipt['sha256']), 'PUBLIC_RECEIPT')
+    require(metadata['evidence_status'] in ('FAILED', 'SANITIZED_CURRENT_JOB_ONLY')
+            and type(metadata['control_exit_status']) is int and 0 <= metadata['control_exit_status'] <= 255,
+            'PUBLIC_CONTROL_STATUS')
+    classes = allowed_tests(Path(__file__).resolve().parents[1])
+    # Never approve an upload tree with arbitrary files, symlinks or retained private artifacts.
+    for child in args.directory.rglob('*'):
+        require(not child.is_symlink(), 'PUBLIC_SYMLINK')
+        if child.is_file():
+            relative = child.relative_to(args.directory).as_posix()
+            require(relative == 'gates.json' or re.fullmatch(
+                r'junit/(?:cp-functional|playmaker-canonical|playmaker-candidate|managed-oauth-bigqueue)/[0-9]{5}\.xml', relative),
+                'PUBLIC_FILE_ALLOWLIST')
+            if relative != 'gates.json':
+                require(child.stat().st_size <= MAX_BYTES, 'PUBLIC_XML_SIZE')
+                document = ET.fromstring(child.read_bytes())
+                require(document.tag == 'testsuite' and set(document.attrib) == {'name', 'tests', 'failures', 'errors', 'skipped', 'time'}
+                        and document.get('name') == 'real-e2e-current-job', 'PUBLIC_XML_ROOT')
+                require(all(re.fullmatch('[0-9]{1,8}', document.get(name, ''))
+                            for name in ('tests', 'failures', 'errors', 'skipped')), 'PUBLIC_XML_COUNTS')
+                require(math.isfinite(float(document.get('time')))
+                        and 0 <= float(document.get('time')) <= 8_640_000_000, 'PUBLIC_XML_TIME')
+                for element in document.iter():
+                    require(not (element.text or '').strip() and not (element.tail or '').strip(), 'PUBLIC_XML_TEXT')
+                    if element.tag == 'testcase':
+                        require(set(element.attrib) == {'classname', 'name', 'time'}, 'PUBLIC_XML_TEST_FIELDS')
+                        require(element.get('time') == elapsed(element.get('time')), 'PUBLIC_XML_CASE_TIME')
+                        classname, name = element.get('classname'), element.get('name')
+                        require((classname == 'redacted' and name == 'redacted_case')
+                                or classname in classes and name in classes[classname], 'PUBLIC_XML_TEST_ID')
+                    elif element.tag in ('failure', 'error', 'skipped'):
+                        require(element.attrib == {'message': 'REAL_E2E_DETAIL_REDACTED'}, 'PUBLIC_XML_OUTCOME')
+                    else:
+                        require(element is document, 'PUBLIC_XML_TAG')
+    print('CI_PUBLIC_EVIDENCE_CURRENT_JOB_VERIFIED')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest='command', required=True)
+    publisher = commands.add_parser('publish')
+    publisher.add_argument('--job-directory', type=Path, required=True)
+    publisher.add_argument('--destination', type=Path, required=True)
+    verifier = commands.add_parser('verify')
+    verifier.add_argument('--directory', type=Path, required=True)
+    for command in (publisher, verifier):
+        command.add_argument('--job-id', required=True)
+        command.add_argument('--cp-sha', required=True)
+    args = parser.parse_args()
+    {'publish': publish, 'verify': verify}[args.command](args)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (OSError, ValueError, KeyError, TypeError, ET.ParseError):
+        print('CI_PUBLIC_EVIDENCE_FAILED', file=__import__('sys').stderr)
+        raise SystemExit(2)
