+    long end = System.nanoTime() + DEADLINE.toNanos();
+    do {
+      Item<byte[]> item = kvs.get(key);
+      if (item != null) {
+        TriggerStatusRecord actual = mapper.readValue(item.getValue(), TriggerStatusRecord.class);
+        boolean matching = "PUBLISH_PENDING".equals(expected) ? actual.isPublicationPending()
+            : actual.state() != null && expected.equals(actual.state().name());
+        if (matching) {
+          assertNotNull(item.getVersion(), "Actual server item version required");
+          if (!actual.isPublicationPending()) assertNotNull(actual.finishedAt());
+          return item;
+        }
+      }
+      TimeUnit.MILLISECONDS.sleep(250);
+    } while (System.nanoTime() < end);
+    throw new IllegalStateException("MANAGED_REAL_KVS_EXPECTED_STATE_NOT_OBSERVED");
+  }
