+++ b/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eKvsMutationJournalTest.java
@@ -0,0 +1,266 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.CallKind;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Identity;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Mutation;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Outcome;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.SdkIdentity;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Ticket;
+
+/** L0 filesystem controls only: no KvsClient backend, application bean or business oracle is synthesized. */
+class RealE2eKvsMutationJournalTest {
+  private static final String RUN = "e2e_journal_control";
+  private static final String SHA = "2d8fd088e939462480a22febaefd295cefa68623e034c33dea348061f6dc89db";
+  @TempDir Path directory;
+
+  @BeforeEach
+  void makeOwnDirectoryPrivate() throws Exception {
+    Files.setPosixFilePermissions(directory, PosixFilePermissions.fromString("rwx------"));
+  }
+
+  @Test
+  void openPersistsIdentityAndPrivateZeroReceiptBeforeAnyClientExists() throws Exception {
+    var journal = open();
+    JsonNode receipt = read(journal);
+    assertEquals("OPEN", receipt.path("phase").asString());
+    assertEquals(0, receipt.path("attempt_count").asLong());
+    assertTrue(receipt.path("healthy").asBoolean());
+    assertEquals(ProcessHandle.current().pid(), receipt.path("pid").asLong());
+    assertEquals(RUN, receipt.path("run_id").asString());
+    assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(journal.receiptPath()));
+    assertFalse(receipt.has("key"));
+    assertFalse(receipt.has("value"));
+    assertFalse(receipt.has("token"));
+  }
+
+  @Test
+  void beginAndMatchedCompletionAreAlreadyPresentOnActualFilesystem() throws Exception {
+    var journal = open();
+    Ticket ticket = journal.begin(Mutation.UPDATE, CallKind.SYNC);
+    JsonNode begun = read(journal);
+    assertEquals(1, begun.path("attempt_count").asLong());
+    assertEquals(1, begun.path("inflight").asInt());
+    assertEquals(ticket.sequence(), begun.path("pending_sequences").get(0).asLong());
+    assertEquals("BEGIN", begun.path("last_event").path("type").asString());
+    journal.complete(ticket, Outcome.SUCCESS);
+    JsonNode ended = read(journal);
+    assertEquals(0, ended.path("inflight").asInt());
+    assertEquals(1, ended.path("completed_count").asLong());
+    assertEquals("SUCCESS", ended.path("last_event").path("outcome").asString());
+    assertTrue(ended.path("sequence").asLong() > begun.path("sequence").asLong());
+  }
+
+  @Test
+  void journalAccountsEveryFamilyAndKindWithoutBackendCertification() throws Exception {
+    var journal = open();
+    for (Mutation mutation : Mutation.values()) {
+      for (CallKind kind : CallKind.values()) {
+        journal.complete(journal.begin(mutation, kind), Outcome.SUCCESS);
+      }
+    }
+    JsonNode receipt = read(journal);
+    assertEquals(10, receipt.path("attempt_count").asLong());
+    assertEquals(10, receipt.path("completed_count").asLong());
+    assertEquals(0, receipt.path("inflight").asInt());
+    for (Mutation mutation : Mutation.values()) {
+      for (CallKind kind : CallKind.values()) {
+        assertEquals(1, receipt.path("attempt_counts").path(mutation.name() + "_" + kind.name()).asLong());
+      }
+    }
+  }
+
+  @Test
+  void knownBackendRejectionRemainsAuditedWithoutPoisoningNormalIdempotency() throws Exception {
+    var journal = open();
+    journal.complete(journal.begin(Mutation.SAVE, CallKind.SYNC), Outcome.BACKEND_REJECTED);
+    journal.beginClose();
+    journal.finishClose(true);
+    JsonNode receipt = read(journal);
+    assertEquals(1, receipt.path("known_rejection_count").asLong());
+    assertEquals("SEALED", receipt.path("phase").asString());
+    assertTrue(receipt.path("healthy").asBoolean());
+  }
+
+  @ParameterizedTest
+  @EnumSource(value = Outcome.class, names = {"REMOTE_OUTCOME_UNKNOWN", "CANCELLED", "PARTIAL_ERROR"})
+  void uncertainOutcomesStayUnknownAfterLaterSuccessAndClose(Outcome outcome) throws Exception {
+    var journal = open();
+    journal.complete(journal.begin(Mutation.BULK_WRITE, CallKind.ASYNC), outcome);
+    journal.complete(journal.begin(Mutation.SAVE, CallKind.SYNC), Outcome.SUCCESS);
+    journal.beginClose();
+    journal.finishClose(true);
+    JsonNode receipt = read(journal);
+    assertEquals("UNKNOWN", receipt.path("phase").asString());
+    assertFalse(receipt.path("healthy").asBoolean());
+    assertEquals(2, receipt.path("attempt_count").asLong());
+    assertTrue(receipt.path("delegate_closed").asBoolean());
+  }
+
+  @Test
+  void checkpointIsDurableFreshAndDeeplyImmutableEvenAfterClose() throws Exception {
+    var journal = open();
+    Map<String, Object> baseline = journal.checkpoint();
+    journal.beginClose();
+    journal.finishClose(true);
+    Map<String, Object> finalCheckpoint = journal.checkpoint();
+    assertTrue((long) finalCheckpoint.get("sequence") > (long) baseline.get("sequence"));
+    assertEquals("SEALED", finalCheckpoint.get("phase"));
+    var mapper = JsonMapper.builder().build();
+    assertEquals(mapper.readTree(mapper.writeValueAsString(finalCheckpoint)), read(journal));
+    assertThrows(UnsupportedOperationException.class, () -> finalCheckpoint.put("attempt_count", 0));
+    var counters = (Map<?, ?>) finalCheckpoint.get("attempt_counts");
+    assertThrows(UnsupportedOperationException.class, () -> counters.clear());
+    assertEquals("OPEN", baseline.get("phase"));
+  }
+
+  @Test
+  void unmatchedOrRepeatedCompletionCannotBecomeAZeroCertificate() throws Exception {
+    var journal = open();
+    Ticket ticket = journal.begin(Mutation.SAVE, CallKind.SYNC);
+    assertThrows(Exception.class, () -> journal.complete(new Ticket(ticket.sequence(), Mutation.DELETE, CallKind.SYNC), Outcome.SUCCESS));
+    assertEquals("UNKNOWN", read(journal).path("phase").asString());
+    assertEquals(1, read(journal).path("inflight").asInt());
+    journal.complete(ticket, Outcome.SUCCESS);
+    assertThrows(Exception.class, () -> journal.complete(ticket, Outcome.SUCCESS));
+    assertFalse(read(journal).path("healthy").asBoolean());
+  }
+
+  @Test
+  void pendingCompletionOrDelegateCloseFailureNeverSeals() throws Exception {
+    var pendingJournal = open();
+    pendingJournal.begin(Mutation.SAVE, CallKind.ASYNC);
+    pendingJournal.beginClose();
+    pendingJournal.finishClose(true);
+    assertEquals("UNKNOWN", read(pendingJournal).path("phase").asString());
+    assertEquals(1, read(pendingJournal).path("inflight").asInt());
+    var failedClose = open();
+    failedClose.beginClose();
+    failedClose.finishClose(false);
+    assertEquals("UNKNOWN", read(failedClose).path("phase").asString());
+    assertFalse(read(failedClose).path("delegate_closed").asBoolean());
+  }
+
+  @Test
+  void productivePostCloseCallInvalidatesThePriorSealedSnapshot() throws Exception {
+    var journal = open();
+    journal.beginClose();
+    journal.finishClose(true);
+    assertThrows(Exception.class, () -> journal.begin(Mutation.DELETE, CallKind.SYNC));
+    assertEquals("UNKNOWN", read(journal).path("phase").asString());
+    assertTrue(read(journal).path("unknown_reasons").toString().contains("POST_CLOSE_CALL"));
+  }
+
+  @Test
+  void directoryWithBroadPermissionsIsRejectedBeforeReceiptCreation() throws Exception {
+    Files.setPosixFilePermissions(directory, PosixFilePermissions.fromString("rwxr-xr-x"));
+    assertThrows(Exception.class, this::open);
+    try (var entries = Files.list(directory)) {
+      assertEquals(0, entries.count());
+    }
+  }
+
+  @Test
+  void deletedReceiptCannotBeReconstructedAsZero() throws Exception {
+    var journal = open();
+    Files.delete(journal.receiptPath());
+    assertThrows(Exception.class, journal::checkpoint);
+    assertThrows(Exception.class, () -> journal.begin(Mutation.SAVE, CallKind.SYNC));
+    assertFalse(Files.exists(journal.receiptPath()));
+  }
+
+  @Test
+  void corruptReceiptOnSameInodeIsNotSilentlyRewritten() throws Exception {
+    var journal = open();
+    Files.writeString(journal.receiptPath(), "{}", StandardOpenOption.TRUNCATE_EXISTING);
+    assertThrows(Exception.class, journal::checkpoint);
+    assertEquals("{}", Files.readString(journal.receiptPath()));
+  }
+
+  @Test
+  void staleZeroBytesOnSameInodeAreNotNormalized() throws Exception {
+    var journal = open();
+    String staleZero = Files.readString(journal.receiptPath());
+    journal.begin(Mutation.SAVE, CallKind.SYNC);
+    assertNotEquals(staleZero, Files.readString(journal.receiptPath()));
+    Files.writeString(journal.receiptPath(), staleZero, StandardOpenOption.TRUNCATE_EXISTING);
+    assertThrows(Exception.class, journal::checkpoint);
+    assertEquals(staleZero, Files.readString(journal.receiptPath()));
+  }
+
+  @Test
+  void replacedReceiptAndChangedPermissionsAreRejected() throws Exception {
+    var journal = open();
+    Path replaced = directory.resolve("previous-receipt.json");
+    Files.move(journal.receiptPath(), replaced);
+    Files.writeString(journal.receiptPath(), Files.readString(replaced));
+    Files.setPosixFilePermissions(journal.receiptPath(), PosixFilePermissions.fromString("rw-------"));
+    assertThrows(Exception.class, journal::checkpoint);
+    var changedPermissions = open();
+    Files.setPosixFilePermissions(changedPermissions.receiptPath(), PosixFilePermissions.fromString("rw-r--r--"));
+    assertThrows(Exception.class, changedPermissions::checkpoint);
+  }
+
+  @Test
+  void existingGenerationReceiptAndSymlinkAreNeverAdopted() throws Exception {
+    Identity identity = identity();
+    var journal = RealE2eKvsMutationJournal.open(directory, identity);
+    String original = Files.readString(journal.receiptPath());
+    assertThrows(Exception.class, () -> RealE2eKvsMutationJournal.open(directory, identity));
+    assertEquals(original, Files.readString(journal.receiptPath()));
+    Path link = directory.resolve("receipt-link");
+    Files.createSymbolicLink(link, journal.receiptPath());
+    assertThrows(Exception.class, () -> RealE2eKvsMutationJournal.open(link, identity()));
+  }
+
+  @Test
+  void replacedDirectoryDoesNotAcquireAuthorityOverNewNamespace() throws Exception {
+    var journal = open();
+    Path prior = directory.resolveSibling(directory.getFileName() + "-prior");
+    Files.move(directory, prior);
+    try {
+      Files.createDirectory(directory, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rwx------")));
+      assertThrows(Exception.class, journal::checkpoint);
+      try (var entries = Files.list(directory)) {
+        assertEquals(0, entries.count());
+      }
+    } finally {
+      Files.delete(directory);
+      Files.move(prior, directory);
+    }
+  }
+
+  private RealE2eKvsMutationJournal open() throws Exception {
+    return RealE2eKvsMutationJournal.open(directory, identity());
+  }
+
+  private static Identity identity() {
+    // This is journal-format input, never a replacement KvsClient or a runtime SDK-origin certificate.
+    SdkIdentity sdk = new SdkIdentity("1.0.5", SHA, SHA, SHA, "file:/actual-journal-control.jar",
+        "file:/actual-journal-control.jar", "com.fury.toolkit.kvs.DefaultKvsClient");
+    return new Identity(RUN, "CP", "idempotencyKvsClient", UUID.randomUUID(), ProcessHandle.current().pid(),
+        ProcessHandle.current().info().startInstant().orElseThrow().toString(), sdk);
+  }
+
+  private static JsonNode read(RealE2eKvsMutationJournal journal) throws Exception {
+    return JsonMapper.builder().build().readTree(Files.readString(journal.receiptPath()));
+  }
+}
diff --git a/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserverTest.java b/src/test/java/com/mercadolibre/rio_controlplane_kafka/reale2e/RealE2eWorkerObserverTest.java
