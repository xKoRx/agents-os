+  /** Only T17 may nest a fixture, with an exact durable parent authorization and declared child resources. */
+  public RealE2eFixture(int port, ObjectMapper mapper, KvsClient kvs, String bootstrap, int requiredBrokerCount,
+      String ownedResultGroup, CleanupChildPermit parentPermit) throws Exception {
+    assertTrue(requiredBrokerCount >= 1 && requiredBrokerCount <= 5, "Explicit real broker count must be 1..5");
+    this.port = port;
+    this.mapper = mapper;
+    this.kvs = kvs;
+    this.bootstrap = bootstrap;
+    this.runId = requiredEnv("E2E_RUN_ID");
+    this.reconciliationDirectory = Path.of(requiredEnv("E2E_RECONCILIATION_DIR"));
+    assertTrue(reconciliationDirectory.isAbsolute()
+            && Files.isDirectory(reconciliationDirectory, LinkOption.NOFOLLOW_LINKS),
+        "An existing absolute private reconciliation directory is required before real clients or dispatch");
+    assertEquals(PosixFilePermissions.fromString("rwx------"), Files.getPosixFilePermissions(reconciliationDirectory),
+        "The run-owned reconciliation directory must have mode0700");
+    this.parentPermit = parentPermit;
+    this.journalId = parentPermit == null ? UUID.randomUUID() : parentPermit.childJournalId();
+    this.journalPath = reconciliationDirectory.resolve("retained-" + journalId + ".json");
+    forceDirectory(reconciliationDirectory); // Unsupported directory durability fails before clients or mutations.
+    verifyConstructionJournals(parentPermit, ownedResultGroup);
+    String groupPrefix = "e2e_" + runId + "_results_";
+    if (ownedResultGroup != null) {
+      assertTrue(ownedResultGroup.startsWith(groupPrefix), "Explicit result group must belong to this exact run");
+      String suffix = ownedResultGroup.substring(groupPrefix.length());
+      assertEquals(UUID.fromString(suffix).toString(), suffix, "Explicit result group must have a canonical UUID suffix");
+    }
+    this.resultGroup = ownedResultGroup == null ? groupPrefix + UUID.randomUUID() : ownedResultGroup;
+    persistJournal(); // Durable resource/group intent precedes even Kafka consumer construction.
+    try {
+      this.admin = AdminClient.create(Map.of("bootstrap.servers", bootstrap));
+      this.producer = new KafkaProducer<>(Map.of("bootstrap.servers", bootstrap,
+          "key.serializer", StringSerializer.class, "value.serializer", StringSerializer.class, "acks", "all"));
+      this.results = createResultConsumer();
+      assertTrue(admin.describeCluster().nodes().get(30, TimeUnit.SECONDS).size() >= requiredBrokerCount,
+          "The explicit owned cluster broker count is required; normal CRUD coverage requires five");
+      positionResultConsumer();
+    } catch (Exception | AssertionError failure) {
+      boolean released = true;
+      for (AutoCloseable resource : new AutoCloseable[] {results, producer}) {
+        if (resource != null) {
+          try { resource.close(); } catch (Exception | AssertionError closeFailure) {
+            released = false; failure.addSuppressed(closeFailure);
+          }
+        }
+      }
+      if (admin != null) {
+        try { deleteResultGroup(); } catch (Exception | AssertionError groupFailure) {
+          released = false; failure.addSuppressed(groupFailure);
+        }
+        try { admin.close(Duration.ofSeconds(10)); } catch (Exception | AssertionError closeFailure) {
+          released = false; failure.addSuppressed(closeFailure);
+        }
+      }
+      try {
+        if (released && (admin == null || groupAbsent)) { retireJournal(); }
+        else { setJournalState("FAILED", "CONSTRUCTOR_CLEANUP_UNVERIFIED"); }
+      } catch (Exception | AssertionError ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
