+        kafka('kafka-topics.sh', '--create', '--topic', baseline, '--partitions', '1', '--replication-factor', '1')
+        kafka('kafka-acls.sh', '--add', '--allow-principal', 'User:ANONYMOUS', '--operation', 'All', '--cluster')
+        kafka('kafka-acls.sh', '--add', '--deny-principal', 'User:ANONYMOUS', '--operation', 'Create', '--cluster')
+        kafka('kafka-acls.sh', '--add', '--deny-principal', 'User:ANONYMOUS', '--operation', 'All', '--topic', topic)
