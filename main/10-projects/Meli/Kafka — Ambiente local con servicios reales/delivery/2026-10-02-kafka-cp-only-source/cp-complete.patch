+      catch (Throwable cleanupFailure) { failure = append(failure, cleanupFailure); }
+    }
+    if (failure != null) { throw failure; }
+  }
+
+  private Throwable append(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    first.addSuppressed(next);
+    return first;
+  }
+}
