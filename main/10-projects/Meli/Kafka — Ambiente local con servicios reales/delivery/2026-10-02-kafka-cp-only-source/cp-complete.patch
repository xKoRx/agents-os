index 0000000000000000000000000000000000000000..ff95faa17b4158b1d405ab0e7a05fab1f09160ff
--- /dev/null
+++ b/.github/workflows/real-e2e.yml
@@ -0,0 +1,119 @@
+name: Real Kafka ecosystem gates
+on:
+  workflow_dispatch:
+    inputs:
+      runner_labels:
+        description: 'JSON runner labels verified by the owner; Docker, JDK25 and corporate connectivity required'
+        required: true
+        type: string
+      environment:
+        description: 'Existing protected environment with dedicated Sandbox/caller/nonprod configuration'
+        required: true
+        type: string
+      playmaker_canonical_sha:
+        description: 'Full reviewed canonical Playmaker SHA with only the permitted real adapters overlay'
+        required: true
+        type: string
+      playmaker_candidate_sha:
+        description: 'Full reviewed candidate Playmaker SHA; its auth policy is evaluated separately'
+        required: true
+        type: string
+permissions:
+  contents: read
+jobs:
+  required-real-gates:
+    runs-on: ${{ fromJSON(inputs.runner_labels) }}
+    environment: ${{ inputs.environment }}
+    timeout-minutes: 360
+    steps:
+      - name: Require exact source SHAs
+        shell: bash
+        env:
+          CP_SHA: ${{ github.sha }}
+          PM_CANONICAL_SHA: ${{ inputs.playmaker_canonical_sha }}
+          PM_CANDIDATE_SHA: ${{ inputs.playmaker_candidate_sha }}
+        run: |
+          set -euo pipefail
+          for name in CP_SHA PM_CANONICAL_SHA PM_CANDIDATE_SHA; do
+            [[ "${!name}" =~ ^[a-f0-9]{40}$ ]] || { echo REAL_E2E_FULL_SOURCE_SHA_REQUIRED >&2; exit 2; }
+          done
+      - name: Checkout exact CP source
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # official v4, verified 2026-10-01
+        with:
+          ref: ${{ github.sha }}
+          path: cp
+          persist-credentials: false
+      - name: Checkout exact canonical Playmaker artifact source
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          repository: melisource/fury_rio-playmaker
+          ref: ${{ inputs.playmaker_canonical_sha }}
+          token: ${{ secrets.RIO_E2E_CHECKOUT_TOKEN }}
+          path: playmaker-canonical
+          persist-credentials: false
+      - name: Checkout exact candidate Playmaker artifact source
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          repository: melisource/fury_rio-playmaker
+          ref: ${{ inputs.playmaker_candidate_sha }}
+          token: ${{ secrets.RIO_E2E_CHECKOUT_TOKEN }}
+          path: playmaker-candidate
+          persist-credentials: false
+      - name: Run all four mandatory actual-service families
+        shell: bash
+        env:
+          CP_SHA: ${{ github.sha }}
+          PM_CANONICAL_SHA: ${{ inputs.playmaker_canonical_sha }}
+          PM_CANDIDATE_SHA: ${{ inputs.playmaker_candidate_sha }}
+          JAVA_HOME: ${{ vars.RIO_E2E_JAVA_HOME }}
+          DOCKER_CONTEXT: ${{ vars.RIO_E2E_DOCKER_CONTEXT }}
+          E2E_FURY_PYTHON: ${{ vars.RIO_E2E_FURY_PYTHON }}
+          E2E_CP_KVS_SERVICE: ${{ vars.RIO_E2E_CP_KVS_SERVICE }}
+          E2E_PM_RESULTS_KVS_SERVICE: ${{ vars.RIO_E2E_PM_RESULTS_KVS_SERVICE }}
+          E2E_PM_LOCKS_KVS_SERVICE: ${{ vars.RIO_E2E_PM_LOCKS_KVS_SERVICE }}
+          E2E_ENTITY_SERVICE_BASE_URL: ${{ vars.RIO_E2E_ENTITY_SERVICE_BASE_URL }}
+          CALLER_CONFIG: ${{ secrets.RIO_E2E_PLAYMAKER_CALLER_CONFIG }}
+          MANAGED_CONFIG: ${{ secrets.RIO_E2E_MANAGED_CONFIG }}
+          MANAGED_KVS_CONFIG: ${{ secrets.RIO_E2E_MANAGED_KVS_CONFIG }}
+          ENTITY_TEMPLATE_BUNDLE: ${{ secrets.RIO_E2E_ENTITY_SERVICE_TEMPLATE_BUNDLE }}
+          DENIED_TEMPLATE: ${{ secrets.RIO_E2E_PLAYMAKER_DENIED_IDENTITY_TEMPLATE }}
+        run: |
+          set -euo pipefail
+          umask 077
+          [[ "$(git -C cp rev-parse HEAD)" == "${CP_SHA}" ]] || exit 2
+          [[ "$(git -C playmaker-canonical rev-parse HEAD)" == "${PM_CANONICAL_SHA}" ]] || exit 2
+          [[ "$(git -C playmaker-candidate rev-parse HEAD)" == "${PM_CANDIDATE_SHA}" ]] || exit 2
+          config_dir="$(mktemp -d "${RUNNER_TEMP}/rio-e2e-config.XXXXXX")"
+          # Templates and managed receipts stay private for reconciliation; copying is never authority.
+          staging_status=0
+          python3 cp/e2e/bind-ci-family-inputs.py stage-workflow --directory "${config_dir}" || staging_status="$?"
+          unset CALLER_CONFIG MANAGED_CONFIG MANAGED_KVS_CONFIG ENTITY_TEMPLATE_BUNDLE DENIED_TEMPLATE
+          export E2E_PLAYMAKER_ENV_FILE="${config_dir}/caller.env"
+          export E2E_MANAGED_ENV_FILE="${config_dir}/managed.env"
+          export E2E_MANAGED_KVS_ENV_FILE="${config_dir}/managed-kvs.env"
+          export E2E_ENTITY_SERVICE_TEMPLATE_RECEIPT_FILE="${config_dir}/entity-template.json"
+          export E2E_PLAYMAKER_DENIED_IDENTITY_TEMPLATE_FILE="${config_dir}/denied-template.json"
+          export E2E_PLAYMAKER_CANONICAL_REPO="${GITHUB_WORKSPACE}/playmaker-canonical"
+          export E2E_PLAYMAKER_CANDIDATE_REPO="${GITHUB_WORKSPACE}/playmaker-candidate"
+          gate_status=0
+          cp/e2e/ci.sh || gate_status="$?"
+          [[ "${staging_status}" == 0 && "${gate_status}" == 0 ]] || exit 1
+      - name: Verify only current-job public evidence
+        id: public
+        if: always()
+        shell: bash
+        env:
+          CP_SHA: ${{ github.sha }}
+        run: |
+          set -euo pipefail
+          python3 cp/e2e/publish-ci-evidence.py verify --directory "${GITHUB_WORKSPACE}/cp/build/ci-e2e-public" \
+            --job-id "${GITHUB_RUN_ID}_${GITHUB_RUN_ATTEMPT}" --cp-sha "${CP_SHA}"
+          echo 'ready=true' >>"${GITHUB_OUTPUT}"
+      - name: Publish sanitized current-job JUnit and fixed gate receipts
+        if: always() && steps.public.outputs.ready == 'true'
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # official v4, verified 2026-10-01
+        with:
+          name: real-e2e-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: cp/build/ci-e2e-public
+          if-no-files-found: error
+          retention-days: 7
