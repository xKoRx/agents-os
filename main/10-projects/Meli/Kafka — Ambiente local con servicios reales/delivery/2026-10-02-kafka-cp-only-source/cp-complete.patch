+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import com.fury.toolkit.kvs.BulkResult;
+import com.fury.toolkit.kvs.ErrorCode;
+import com.fury.toolkit.kvs.Item;
+import com.fury.toolkit.kvs.ItemResult;
+import com.fury.toolkit.kvs.KeyResult;
+import com.fury.toolkit.kvs.KvsClient;
+import com.fury.toolkit.kvs.KvsClientException;
+import com.fury.toolkit.kvs.Operations;
+import java.io.IOException;
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutionException;
+import java.util.function.Supplier;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.CallKind;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Mutation;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Outcome;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Reason;
+import com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsMutationJournal.Ticket;
+
+/** Observes exact productive Toolkit invocations without changing their backend or serialized inputs. */
+public final class RealE2eObservedKvsClient implements KvsClient {
+  private static final String UNVERIFIED = "REAL_E2E_KVS_MUTATION_OBSERVATION_UNVERIFIED";
+  private static final int MAX_CAUSE_DEPTH = 16;
+  private static final System.Logger LOGGER = System.getLogger(RealE2eObservedKvsClient.class.getName());
+  private final KvsClient delegate;
+  private final RealE2eKvsMutationJournal journal;
+  private boolean closeAttempted;
+  private Throwable closeFailure;
+
+  /**
+   * Wraps one already-built official Toolkit client; its qualifiers and builder remain external to this class.
+   *
+   * @param delegate productive official client
+   * @param journal durable identity of that same client
+   */
+  public RealE2eObservedKvsClient(KvsClient delegate, RealE2eKvsMutationJournal journal) {
+    this.delegate = Objects.requireNonNull(delegate);
+    this.journal = Objects.requireNonNull(journal);
+    if (!delegate.getClass().getName().equals(journal.identity().sdk().delegateClassName())) {
+      throw new IllegalArgumentException(UNVERIFIED);
+    }
+  }
+
+  /** @return durable observer, for profile-scoped checkpoints and final verification */
+  public RealE2eKvsMutationJournal journal() { return journal; }
+
+  @Override public void save(Item<byte[]> item) throws KvsClientException {
+    mutateSync(Mutation.SAVE, () -> {
+      delegate.save(item);
+      return null;
+    });
+  }
+
+  @Override public void update(Item<byte[]> item) throws KvsClientException {
+    mutateSync(Mutation.UPDATE, () -> {
+      delegate.update(item);
+      return null;
+    });
+  }
+
+  @Override public boolean delete(String key) throws KvsClientException {
+    return mutateSync(Mutation.DELETE, () -> delegate.delete(key));
+  }
+
+  @Override public void batchWrite(Operations operations) throws KvsClientException {
+    mutateSync(Mutation.BATCH_WRITE, () -> {
+      delegate.batchWrite(operations);
+      return null;
+    });
+  }
+
+  @Override public BulkResult<KeyResult> bulkWrite(Operations operations) throws KvsClientException {
+    return mutateSync(Mutation.BULK_WRITE, () -> delegate.bulkWrite(operations));
+  }
+
+  @Override public CompletableFuture<Void> saveAsync(Item<byte[]> item) {
+    return mutateAsync(Mutation.SAVE, () -> delegate.saveAsync(item));
+  }
+
+  @Override public CompletableFuture<Void> updateAsync(Item<byte[]> item) {
+    return mutateAsync(Mutation.UPDATE, () -> delegate.updateAsync(item));
+  }
+
+  @Override public CompletableFuture<Boolean> deleteAsync(String key) {
+    return mutateAsync(Mutation.DELETE, () -> delegate.deleteAsync(key));
+  }
+
+  @Override public CompletableFuture<Void> batchWriteAsync(Operations operations) {
+    return mutateAsync(Mutation.BATCH_WRITE, () -> delegate.batchWriteAsync(operations));
+  }
+
+  @Override public CompletableFuture<BulkResult<KeyResult>> bulkWriteAsync(Operations operations) {
+    return mutateAsync(Mutation.BULK_WRITE, () -> delegate.bulkWriteAsync(operations));
+  }
+
+  @Override public Item<byte[]> get(String key) throws KvsClientException {
+    checkOpen();
+    return delegate.get(key);
+  }
+
+  @Override public <T> Item<T> get(String key, Class<T> type) throws KvsClientException {
+    checkOpen();
+    return delegate.get(key, type);
+  }
+
+  @Override public CompletableFuture<Item<byte[]>> getAsync(String key) {
+    checkOpen();
+    return delegate.getAsync(key);
+  }
+
+  @Override public <T> CompletableFuture<Item<T>> getAsync(String key, Class<T> type) {
+    checkOpen();
+    return delegate.getAsync(key, type);
+  }
+
+  @Override public List<Item<byte[]>> batchRead(List<String> keys) throws KvsClientException {
+    checkOpen();
+    return delegate.batchRead(keys);
+  }
+
+  @Override public <T> List<Item<T>> batchRead(List<String> keys, Class<T> type) throws KvsClientException {
+    checkOpen();
+    return delegate.batchRead(keys, type);
+  }
+
+  @Override public CompletableFuture<List<Item<byte[]>>> batchReadAsync(List<String> keys) {
+    checkOpen();
+    return delegate.batchReadAsync(keys);
+  }
+
+  @Override public <T> CompletableFuture<List<Item<T>>> batchReadAsync(List<String> keys, Class<T> type) {
+    checkOpen();
+    return delegate.batchReadAsync(keys, type);
+  }
+
+  @Override public BulkResult<ItemResult<byte[]>> bulkRead(List<String> keys) throws KvsClientException {
+    checkOpen();
+    return delegate.bulkRead(keys);
+  }
+
+  @Override public <T> BulkResult<ItemResult<T>> bulkRead(List<String> keys, Class<T> type) throws KvsClientException {
+    checkOpen();
+    return delegate.bulkRead(keys, type);
+  }
+
+  @Override public CompletableFuture<BulkResult<ItemResult<byte[]>>> bulkReadAsync(List<String> keys) {
+    checkOpen();
+    return delegate.bulkReadAsync(keys);
+  }
+
+  @Override public <T> CompletableFuture<BulkResult<ItemResult<T>>> bulkReadAsync(List<String> keys, Class<T> type) {
+    checkOpen();
+    return delegate.bulkReadAsync(keys, type);
+  }
+
+  @Override public synchronized void close() throws Exception {
+    if (closeAttempted) {
+      rethrowCloseFailure();
+      return;
+    }
+    closeAttempted = true;
+    Throwable failure = null;
+    try {
+      journal.beginClose();
+    } catch (IOException | RuntimeException | Error observationFailure) {
+      failure = observationFailure;
+    }
+    boolean closed = false;
+    try {
+      delegate.close();
+      closed = true;
+    } catch (Exception | Error closeFailure) {
+      failure = accumulate(failure, closeFailure);
+    }
+    try {
+      journal.finishClose(closed);
+    } catch (IOException | RuntimeException | Error observationFailure) {
+      failure = accumulate(failure, observationFailure);
+    }
+    closeFailure = failure;
+    rethrowCloseFailure();
+  }
+
+  private void rethrowCloseFailure() throws Exception {
+    if (closeFailure instanceof Exception exception) {
+      throw exception;
+    }
+    if (closeFailure instanceof Error error) {
+      throw error;
+    }
+  }
+
+  private <T> T mutateSync(Mutation mutation, SyncMutation<T> call) throws KvsClientException {
+    Ticket ticket = begin(mutation, CallKind.SYNC);
+    T actual;
+    try {
+      actual = call.invoke();
+    } catch (KvsClientException | RuntimeException | Error backendFailure) {
+      auditPreservingFailure(ticket, backendFailure);
+      throw backendFailure;
+    }
+    audit(ticket, outcome(mutation, actual));
+    return actual;
+  }
+
+  private <T> CompletableFuture<T> mutateAsync(Mutation mutation, Supplier<CompletableFuture<T>> call) {
+    Ticket ticket = begin(mutation, CallKind.ASYNC);
+    CompletableFuture<T> actual;
+    try {
+      actual = call.get();
+    } catch (RuntimeException | Error backendFailure) {
+      auditPreservingFailure(ticket, backendFailure);
+      throw backendFailure;
+    }
+    if (actual == null) {
+      recordUnknown(Reason.NULL_FUTURE);
+      throw new IllegalStateException(UNVERIFIED);
+    }
+    actual.whenComplete((value, backendFailure) -> {
+      try {
+        journal.complete(ticket, backendFailure == null ? outcome(mutation, value) : failureOutcome(backendFailure));
+      } catch (IOException | RuntimeException observationFailure) {
+        // The journal is already sticky UNKNOWN; the caller retains its actual backend future.
+        LOGGER.log(System.Logger.Level.WARNING, UNVERIFIED);
+      }
+    });
+    return actual;
+  }
+
+  private Ticket begin(Mutation mutation, CallKind callKind) {
+    try {
+      return journal.begin(mutation, callKind);
+    } catch (IOException observationFailure) {
+      // No backend method has been invoked when its BEGIN could not be durably observed.
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void audit(Ticket ticket, Outcome outcome) {
+    try {
+      journal.complete(ticket, outcome);
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void auditPreservingFailure(Ticket ticket, Throwable backendFailure) {
+    try {
+      journal.complete(ticket, failureOutcome(backendFailure));
+    } catch (IOException | RuntimeException observationFailure) {
+      backendFailure.addSuppressed(new IllegalStateException(UNVERIFIED));
+    }
+  }
+
+  private void recordUnknown(Reason reason) {
+    try {
+      journal.unknown(reason);
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void checkOpen() {
+    try {
+      journal.requireOpen();
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private static Outcome outcome(Mutation mutation, Object actual) {
+    if (mutation == Mutation.DELETE && !(actual instanceof Boolean)) {
+      return Outcome.REMOTE_OUTCOME_UNKNOWN;
+    }
+    if (mutation == Mutation.BULK_WRITE) {
+      if (!(actual instanceof BulkResult<?> bulk)) {
+        return Outcome.REMOTE_OUTCOME_UNKNOWN;
+      }
+      return bulk.hasError() ? Outcome.PARTIAL_ERROR : Outcome.SUCCESS;
+    }
+    return Outcome.SUCCESS;
+  }
+
+  private static Outcome failureOutcome(Throwable failure) {
+    Throwable cause = failure;
+    for (int depth = 0; depth < MAX_CAUSE_DEPTH
+        && (cause instanceof CompletionException || cause instanceof ExecutionException)
+        && cause.getCause() != null && cause.getCause() != cause; depth++) {
+      cause = cause.getCause();
+    }
+    if (cause instanceof java.util.concurrent.CancellationException) {
+      return Outcome.CANCELLED;
+    }
+    if (cause instanceof KvsClientException kvsFailure && ErrorCode.CONFLICT.getCode().equals(kvsFailure.getErrorCode())) {
+      return Outcome.BACKEND_REJECTED;
+    }
+    return Outcome.REMOTE_OUTCOME_UNKNOWN;
+  }
+
+  private static Throwable accumulate(Throwable previous, Throwable next) {
+    if (previous == null) {
+      return next;
+    }
+    previous.addSuppressed(next);
+    return previous;
+  }
+
+  @FunctionalInterface
+  private interface SyncMutation<T> {
+    T invoke() throws KvsClientException;
+  }
+}
