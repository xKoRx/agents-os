@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Fresh read-only Fury deployment proof; saved JSON and verified flags are not authority."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+
+SOURCE = "25b34c73b97327ad2f247689dd5e660e0d209b5b"
+ROUTE = "deployments?application=rio-entity-service&active=true"
+
+
+def require(condition, code):
+    if not condition:
+        raise RuntimeError("ENTITY_PRIMARY_GATE:" + code)
+
+
+def private(path):
+    require(path.is_absolute() and path.is_file() and not path.is_symlink()
+            and path.stat().st_uid == os.getuid() and stat.S_IMODE(path.stat().st_mode) == 0o600
+            and path.stat().st_size <= 1_000_000, "PRIVATE_BINDING")
+    require(all(not parent.is_symlink() for parent in path.parents), "PRIVATE_BINDING_ANCESTORS")
+    return json.loads(path.read_bytes())
+
+
+def pointer(document, path):
+    require(isinstance(path, str) and path.startswith("/") and len(path) <= 512, "JSON_POINTER")
+    value = document
+    for part in path[1:].split("/"):
+        key = part.replace("~1", "/").replace("~0", "~")
+        value = value[int(key)] if isinstance(value, list) else value[key]
+    return value
+
+
+def main():
+    receipt = Path(sys.argv[1])
+    binding = private(receipt)
+    require(binding.get("source_commit") == SOURCE, "SOURCE")
+    reference = binding.get("runtime_ref", {})
+    saved = Path(reference["path"])
+    require(saved.parent == receipt.parent and hashlib.sha256(saved.read_bytes()).hexdigest()
+            == reference.get("sha256"), "REFERENCE")
+    original = private(saved)
+    require(original.get("status") == 200 and original.get("request_uri") == ROUTE,
+            "ACTUAL_DOCUMENTED_DEPLOYMENT_ROUTE_REQUIRED")
+    # Official installed CLI client; only stored credentials, no interactive renewal or login mutation.
+    from furycli.core.helpers import credentials
+    from cli_scopes.clients.deployments import DeploymentsApi
+    snapshot = credentials.get_credentials()
+    token = credentials.get(credentials.TIGER_TOKEN_KEY, snapshot)
+    require(token and not credentials.tiger_token_expired(snapshot), "FURY_LOGIN_REQUIRED")
+    zero_trust = credentials.get(credentials.ZT_TOKEN_KEY, snapshot)
+    if zero_trust:
+        import time
+        require(int(credentials._decode_jwt_payload(zero_trust)["exp"]) > time.time() + 500,
+                "ZERO_TRUST_LOGIN_REQUIRED")
+    client = DeploymentsApi("rio-entity-service")
+    live, status = client.make_api_call(ROUTE, method="GET", authenticate=False, retry=False,
+                                        timeout=20, headers={"X-Tiger-Token": "Bearer " + token})
+    require(status == 200, "DEPLOYMENT_READ_FAILED")
+    # Every asserted field must belong to the SAME actual deployment object.
+    # Field pointers are relative to that object, never independent absolute response pointers.
+    deployment = pointer(live, reference["deployment_pointer"])
+    require(isinstance(deployment, dict), "SINGLE_DEPLOYMENT_OBJECT_REQUIRED")
+    names = ("source_pointer", "base_url_pointer", "scope_pointer", "release_pointer", "active_pointer", "application_pointer")
+    fields = [reference[name] for name in names]
+    # Until a deployed nested schema is independently verified, fields are scalar direct
+    # properties of that exact deployment, never selectors into other nested row objects.
+    require(all(isinstance(field, str) and field.startswith("/") and field.count("/") == 1
+                and len(field) > 1 for field in fields) and len(fields) == len(set(fields)),
+            "DIRECT_SCALAR_FIELDS_OF_ONE_DEPLOYMENT_REQUIRED")
+    source = pointer(deployment, reference["source_pointer"])
+    base = pointer(deployment, reference["base_url_pointer"])
+    scope = pointer(deployment, reference["scope_pointer"])
+    release = pointer(deployment, reference["release_pointer"])
+    active = pointer(deployment, reference["active_pointer"])
+    application = pointer(deployment, reference["application_pointer"])
+    require(source == SOURCE and base == binding["base_url"] and application == "rio-entity-service"
+            and active is True and isinstance(release, str) and release
+            and isinstance(scope, str) and re.search(r"test|nonprod", scope)
+            and not re.search(r"(^|[-_])(prod|production|stage|staging|stg)([-_]|$)", scope),
+            "LIVE_SOURCE_TARGET_SCOPE_UNVERIFIED")
+    print(json.dumps({"proof": "FRESH_OFFICIAL_DEPLOYMENT_READ", "source_commit": source,
+                      "run_id": binding["run_id"], "scope_sha256": hashlib.sha256(scope.encode()).hexdigest(),
+                      "release_sha256": hashlib.sha256(release.encode()).hexdigest()}))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        print(str(error) if isinstance(error, RuntimeError) and str(error).startswith("ENTITY_PRIMARY_GATE:")
+              else "ENTITY_PRIMARY_GATE:DEPLOYED_CONTRACT_OR_GRANT_UNVERIFIED", file=sys.stderr)
+        raise SystemExit(2)
