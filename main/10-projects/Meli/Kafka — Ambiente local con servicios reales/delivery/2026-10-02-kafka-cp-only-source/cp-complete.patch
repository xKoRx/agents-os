@@ -0,0 +1,140 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e;
+
+import jakarta.annotation.PreDestroy;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.List;
+import java.util.Properties;
+import java.util.concurrent.atomic.AtomicBoolean;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.common.errors.WakeupException;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.web.server.context.WebServerInitializedEvent;
+import org.springframework.context.ApplicationListener;
+import org.springframework.context.annotation.Profile;
+import org.springframework.stereotype.Component;
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.node.ObjectNode;
+
+/** Real Kafka-to-HTTP transport; SDK triggers reach the existing public CP controller boundary. */
+@Component
+@Profile("real-e2e")
+@org.springframework.boot.autoconfigure.condition.ConditionalOnProperty(
+    name = "e2e.bridge.enabled", havingValue = "true", matchIfMissing = true)
+@Slf4j
+public class KafkaTriggerHttpBridge implements ApplicationListener<WebServerInitializedEvent>, AutoCloseable {
+  private static final int MAX_PAYLOAD_CHARS = 262_144;
+  private final ObjectMapper mapper;
+  private final String bootstrap;
+  private final String runId;
+  private final String deploymentTopic;
+  private final String actionTopic;
+  private final AtomicBoolean running = new AtomicBoolean();
+  private volatile KafkaConsumer<String, String> consumer;
+  private volatile Thread worker;
+
+  /** Creates an isolated transport; no remote HTTP destination can be configured. */
+  public KafkaTriggerHttpBridge(ObjectMapper mapper,
+      @Value("${e2e.bootstrap-servers}") String bootstrap,
+      @Value("${e2e.run-id}") String runId,
+      @Value("${e2e.deployment-trigger-topic}") String deploymentTopic,
+      @Value("${e2e.action-trigger-topic}") String actionTopic) {
+    this.mapper = mapper;
+    this.bootstrap = E2eSafety.loopbackBootstrap(bootstrap);
+    this.runId = E2eSafety.runId(runId);
+    this.deploymentTopic = E2eSafety.topic(deploymentTopic, runId);
+    this.actionTopic = E2eSafety.topic(actionTopic, runId);
+  }
+
+  @Override
+  public void onApplicationEvent(WebServerInitializedEvent event) {
+    if (running.compareAndSet(false, true)) {
+      worker = Thread.ofPlatform().daemon().name("e2e-trigger-" + runId)
+          .start(() -> consumeTriggers(event.getWebServer().getPort()));
+    }
+  }
+
+  /** Indicates whether the worker is active; scenarios must also verify committed offsets/results. */
+  public boolean isRunning() {
+    return running.get();
+  }
+
+  private void consumeTriggers(int port) {
+    Properties properties = new Properties();
+    properties.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap);
+    properties.put(ConsumerConfig.GROUP_ID_CONFIG, "e2e_" + runId + "_cp_bridge");
+    properties.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
+    properties.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class.getName());
+    properties.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
+    properties.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "earliest");
+    properties.put(ConsumerConfig.ALLOW_AUTO_CREATE_TOPICS_CONFIG, false);
+    try (KafkaConsumer<String, String> ownedConsumer = new KafkaConsumer<>(properties);
+        HttpClient httpClient = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()) {
+      consumer = ownedConsumer;
+      ownedConsumer.subscribe(List.of(deploymentTopic, actionTopic));
+      while (running.get()) {
+        for (var record : ownedConsumer.poll(Duration.ofMillis(250))) {
+          forward(httpClient, port, record.topic(), record.value());
+        }
+        ownedConsumer.commitSync(Duration.ofSeconds(5));
+      }
+    } catch (WakeupException exception) {
+      if (running.get()) {
+        log.error("REAL_E2E_BRIDGE_FAILED cause=unexpected_wakeup");
+      }
+    } catch (InterruptedException exception) {
+      Thread.currentThread().interrupt();
+      log.error("REAL_E2E_BRIDGE_FAILED cause=interrupted");
+    } catch (RuntimeException | java.io.IOException exception) {
+      log.error("REAL_E2E_BRIDGE_FAILED causeType={}", exception.getClass().getSimpleName());
+    } finally {
+      running.set(false);
+      consumer = null;
+    }
+  }
+
+  private void forward(HttpClient httpClient, int port, String topic, String payload)
+      throws java.io.IOException, InterruptedException {
+    if (payload == null || payload.isBlank() || payload.length() > MAX_PAYLOAD_CHARS) {
+      throw new IllegalArgumentException("Invalid real E2E trigger payload");
+    }
+    var trigger = mapper.readTree(payload);
+    if (!trigger.isObject()) {
+      throw new IllegalArgumentException("Trigger must be a JSON object");
+    }
+    ObjectNode envelope = mapper.createObjectNode();
+    envelope.set("msg", trigger);
+    String path = deploymentTopic.equals(topic) ? "/triggers/deployments" : "/triggers/actions";
+    URI destination = URI.create("http://127.0.0.1:" + port + path);
+    HttpRequest request = HttpRequest.newBuilder(destination).timeout(Duration.ofSeconds(10))
+        .header("Content-Type", "application/json")
+        .POST(HttpRequest.BodyPublishers.ofByteArray(mapper.writeValueAsBytes(envelope))).build();
+    if (httpClient.send(request, HttpResponse.BodyHandlers.discarding()).statusCode() != 200) {
+      throw new IllegalStateException("Real CP rejected the Kafka trigger at HTTP boundary");
+    }
+  }
+
+  @Override
+  @PreDestroy
+  public void close() {
+    running.set(false);
+    KafkaConsumer<String, String> current = consumer;
+    if (current != null) {
+      current.wakeup();
+    }
+    Thread currentWorker = worker;
+    if (currentWorker != null) {
+      try {
+        currentWorker.join(10_000);
+      } catch (InterruptedException exception) {
+        Thread.currentThread().interrupt();
+      }
+    }
+  }
+}
