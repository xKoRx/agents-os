+  private void verifyConstructionJournals(CleanupChildPermit permit, String explicitGroup) throws Exception {
+    try (var entries = Files.list(reconciliationDirectory)) {
+      List<Path> journals = entries.filter(entry -> entry.getFileName().toString().startsWith("retained-")
+          && entry.getFileName().toString().endsWith(".json")).toList();
+      if (permit == null) {
+        assertTrue(journals.isEmpty(), "An existing journal blocks new fixture clients until reconciliation");
+        return;
+      }
+      assertEquals(runId, permit.runId());
+      assertEquals(explicitGroup, permit.childGroup());
+      assertEquals(ProcessHandle.current().parent().orElseThrow().pid(), permit.parentPid());
+      assertTrue(ProcessHandle.of(permit.parentPid()).orElseThrow().isAlive());
+      Path parent = reconciliationDirectory.resolve("retained-" + permit.parentJournalId() + ".json");
+      assertEquals(List.of(parent), journals, "Only the exact open authorizing parent journal is permitted");
+      assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(parent));
+      JsonNode record = mapper.readTree(Files.readString(parent));
+      assertEquals(2, record.path("schema_version").asInt());
+      assertEquals(runId, record.path("run_id").asString());
+      assertEquals(permit.parentJournalId().toString(), record.path("journal_id").asString());
+      assertEquals(permit.parentPid(), record.path("fixture_pid").asLong());
+      assertEquals("OPEN", record.path("phase").asString());
+      boolean authorized = false;
+      for (JsonNode candidate : record.path("authorized_cleanup_children")) {
+        if (permit.equals(mapper.treeToValue(candidate, CleanupChildPermit.class))) { authorized = true; }
+      }
+      assertTrue(authorized, "Exact child resources/group must be durably authorized before its JVM starts");
+    }
+  }
