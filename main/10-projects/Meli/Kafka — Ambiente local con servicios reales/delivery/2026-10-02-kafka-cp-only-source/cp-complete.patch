+  /** Clears only this closed FAILED fixture after actual independent absence; UNKNOWN is never an override. */
+  public synchronized void reconcileFailedCleanup() throws Exception {
+    assertTrue(closed && clientsClosed && quiescenceVerified, "Known worker quiescence and successful client close are required");
+    assertEquals("FAILED", journalPhase, "Only a verified failed cleanup may be independently reconciled");
+    assertTrue(cleanupChildPermits.isEmpty(), "Child outcome journals require their separate exact handshake");
+    assertTrue(Files.isRegularFile(journalPath, LinkOption.NOFOLLOW_LINKS));
+    assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(journalPath));
+    JsonNode record = mapper.readTree(Files.readString(journalPath));
+    assertEquals(2, record.path("schema_version").asInt());
+    assertEquals(journalId.toString(), record.path("journal_id").asString());
+    assertEquals(runId, record.path("run_id").asString());
+    assertEquals(ProcessHandle.current().pid(), record.path("fixture_pid").asLong());
+    assertEquals("FAILED", record.path("phase").asString());
+    assertTrue(record.path("clients_closed").asBoolean() && record.path("quiescence_verified").asBoolean());
+    assertEquals(declaredTopics, strings(record.path("declared_topics")));
+    assertEquals(declaredKeys, strings(record.path("declared_kvs_keys")));
+    assertEquals(resultGroup, record.path("declared_consumer_group").asString());
+    awaitOwnedWorkersQuiescent();
+    try (AdminClient independent = AdminClient.create(Map.of("bootstrap.servers", bootstrap))) {
+      Set<String> actualTopics = independent.listTopics().names().get(30, TimeUnit.SECONDS);
+      for (String topic : declaredTopics) { assertTrue(!actualTopics.contains(topic), "Every exact declared topic must be absent"); }
+      assertTrue(independent.listConsumerGroups().all().get(30, TimeUnit.SECONDS).stream()
+          .noneMatch(group -> resultGroup.equals(group.groupId())), "Exact fixture group must be absent");
+    }
+    for (String key : declaredKeys) { assertTrue(kvs.get(key) == null, "Every exact declared KVS key must be absent"); }
+    assertEquals(declaredOwnedPrivateConfigurationFiles, strings(record.path("declared_owned_private_configuration_files")));
+    for (String file : declaredOwnedPrivateConfigurationFiles) {
+      assertTrue(!Files.exists(Path.of(file), LinkOption.NOFOLLOW_LINKS), "Every exact own routing file must be absent");
+    }
+    ownedPrivateConfigurationFiles.clear();
+    ownedTopics.clear();
+    ownedKeys.clear();
+    groupAbsent = true;
+    retireJournal();
+  }
