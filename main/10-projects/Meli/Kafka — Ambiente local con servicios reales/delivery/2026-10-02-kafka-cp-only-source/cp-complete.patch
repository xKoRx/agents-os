+
+  List<String> allCorrelations() throws Exception {
+    List<String> correlations = new ArrayList<>();
+    for (Product product : products.values()) {
+      correlations.addAll(query("SELECT COALESCE(d.deployment_correlation_id,d.materialization_id,'') FROM deployment d"
+          + " JOIN service s ON s.id=d.service_id JOIN component c ON c.id=s.component_id"
+          + " WHERE c.data_product_id=? ORDER BY d.id", product.id()).lines().filter(value -> !value.isBlank()).toList());
+    }
