+
+/** Removes two actual run-owned brokers, proves fail-closed RF reconciliation, and restores all five. */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = {"SCOPE_SUFFIX=local", "kafka.bootstrap-servers=${E2E_BOOTSTRAP_SERVERS}", "e2e.bridge.enabled=false"})
+@ActiveProfiles({"local", "real-e2e"})
+class RealKafkaClusterFaultIntegrationTest {
+  @LocalServerPort private int port;
+  @Autowired private ObjectMapper mapper;
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+  private RealE2eFixture fixture;
+
+  @BeforeEach
+  void openBeforePhysicalBrokerReduction() throws Exception {
+    fixture = new RealE2eFixture(port, mapper, kvs, RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS"));
+  }
+
+  @AfterEach
+  void cleanupAfterOwnedFaultRestoration() throws Exception {
+    if (fixture != null) {
+      fixture.close();
+    }
+  }
+
+  @ParameterizedTest
+  @EnumSource(value = DeploymentOperation.class, names = {"PROVISION", "UPDATE"})
+  void actualThreeLiveBrokersRejectRfFiveReconcileAndRestoredClusterCompletesNewId(DeploymentOperation operation) throws Exception {
+    String topic = fixture.uniqueTopic("physical_broker_reduction");
+    var nodes = fixture.admin().describeCluster().nodes().get(30, TimeUnit.SECONDS);
+    assertTrue(nodes.stream().anyMatch(node -> node.id() == 1), "Owned compose broker1 must use Kafka id1");
+    fixture.admin().createTopics(List.of(new NewTopic(topic, Map.of(0, List.of(1))).configs(Map.of("retention.ms", "1234567"))))
+        .all().get(30, TimeUnit.SECONDS);
+    fixture.awaitTopic(topic);
+    var params = fixture.paramsFor("aws-msk-topic", topic, 1, (short) 5);
+    var failedTrigger = fixture.trigger(operation, "aws-msk-topic", params);
+    try (OwnedKafkaFaults fault = OwnedKafkaFaults.open()) {
+      fault.reduceToThreeBrokers();
+      assertEquals(3, fixture.admin().describeCluster().nodes().get(30, TimeUnit.SECONDS).size());
+      assertEquals(200, fixture.postDeployment(failedTrigger).statusCode());
+      var failure = fixture.awaitDeployment(failedTrigger.deploymentId());
+      assertEquals("FAILED", failure.path("status").asString());
+      assertEquals("KAFKA_ADMIN_ERROR", failure.path("error").path("code").asString());
+      fixture.awaitKvs("deployment:" + failedTrigger.deploymentId(), "FAILED");
+      assertEquals(1, fixture.awaitTopic(topic).partitions().get(0).replicas().size());
+      assertEquals("1234567", fixture.topicConfigs(topic).get("retention.ms"));
+      fault.restoreBrokers();
+      assertEquals(5, fixture.admin().describeCluster().nodes().get(30, TimeUnit.SECONDS).size());
+      var recovered = fixture.trigger(DeploymentOperation.PROVISION, "aws-msk-topic", params);
+      assertEquals(200, fixture.postDeployment(recovered).statusCode());
+      assertEquals("COMPLETED", fixture.awaitDeployment(recovered.deploymentId()).path("status").asString());
+      fixture.awaitKvs("deployment:" + recovered.deploymentId(), "COMPLETED");
+      Awaitility.await().atMost(Duration.ofSeconds(90)).until(() -> fixture.awaitTopic(topic).partitions().stream()
+          .allMatch(part -> part.replicas().size() == 5 && part.isr().size() == 5));
+      assertTrue(fixture.admin().listPartitionReassignments().reassignments().get(30, TimeUnit.SECONDS).isEmpty());
+      int originalResults = fixture.resultsFor(failedTrigger.deploymentId().toString()).size();
+      assertEquals(200, fixture.postDeployment(failedTrigger).statusCode());
+      fixture.assertNoMoreResults(failedTrigger.deploymentId().toString(), originalResults, Duration.ofSeconds(1));
+      assertEquals("FAILED", mapper.readTree(kvs.get("deployment:" + failedTrigger.deploymentId()).getValue()).path("state").asString());
+    }
+  }
+}
