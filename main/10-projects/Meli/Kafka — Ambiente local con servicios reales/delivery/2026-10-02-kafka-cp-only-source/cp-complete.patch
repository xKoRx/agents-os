+import tools.jackson.databind.ObjectMapper;
+
+/** Regression against a real, unreachable loopback Kafka address, never an AdminClient mock. */
+@SpringBootTest(classes = Application.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = {"SCOPE_SUFFIX=local", "kafka.bootstrap-servers=${E2E_BOOTSTRAP_SERVERS}",
+        "kafka.provisioning.timeout-minutes=1", "e2e.bridge.enabled=false"})
+@ActiveProfiles({"local", "real-e2e"})
+class PhysicalProvisioningFailuresTest {
+  @LocalServerPort private int port;
+  @Autowired private ObjectMapper mapper;
+  @Autowired @Qualifier("idempotencyKvsClient") private KvsClient kvs;
+
+  @Test
+  void unreachableDescribeNeverMeansAbsentOrSuccessfulDeletion() throws Exception {
+    String bootstrap = RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS");
+    try (RealE2eFixture fixture = new RealE2eFixture(port, mapper, kvs, bootstrap)) {
+      String topic = fixture.uniqueTopic("describefailure");
+      fixture.createTopic(topic, 1, (short) 1, Map.of("retention.ms", "9876543"));
+      KafkaAdminClientPoolImpl unreachablePool = new KafkaAdminClientPoolImpl();
+      try {
+        ClusterConnection unreachable = new ClusterConnection("127.0.0.1:" + unusedPort(),
+            Map.of("default.api.timeout.ms", 500, "request.timeout.ms", 200, "retries", 0));
+        var service = new KafkaProvisioningServiceImpl(unreachablePool, new ParameterValidator(1000, 5, 249, 31536000000L), 1);
+        KafkaParams params = new KafkaParams(topic, 1, (short) 1, null, Map.of());
+        assertFailure(service.provision(params, unreachable, "e2e"));
+        assertFailure(service.update(params, unreachable, "e2e"));
+        assertFailure(service.deprovision(params, unreachable, "e2e"));
+        assertEquals(1, fixture.awaitTopic(topic).partitions().size());
+        assertEquals("9876543", fixture.topicConfigs(topic).get("retention.ms"));
+      } finally {
+        unreachablePool.closeAll();
+      }
+    }
+  }
+
+  @Test
+  void unreachableGcpDescribeFailsEveryOperationAndPreservesPhysicalTopic() throws Exception {
+    String bootstrap = RealE2eFixture.requiredEnv("E2E_BOOTSTRAP_SERVERS");
+    String unreachableBootstrap = "127.0.0.1:" + unusedPort();
+    try (RealE2eFixture fixture = new RealE2eFixture(port, mapper, kvs, bootstrap);
+         AdminClient actualUnreachableClient = AdminClient.create(Map.of("bootstrap.servers", unreachableBootstrap,
+             "default.api.timeout.ms", 500, "request.timeout.ms", 200, "retries", 0))) {
+      String topic = fixture.uniqueTopic("gcp_describe_failure");
+      fixture.createTopic(topic, 1, (short) 1, Map.of("retention.ms", "9876543"));
+      GcpTopicAdminClientProvider connections = target -> actualUnreachableClient;
+      var service = new GcpTopicProvisioningServiceImpl(connections, new GcpTopicParamsValidator(1000, 249, 31536000000L),
+          new GcpTopicConfigBuilder(new GcpDeploymentProperties()), new GcpTopicProvisioner(), 1);
+      var routing = new ResolvedRouting(new BootstrapTarget("legacy", "e2e-unreachable", unreachableBootstrap));
+      var params = new GcpTopicParams(topic, 1, null, Map.of(), (short) 1);
+      assertFailure(service.provision(params, routing, "e2e", 201L, 101L));
+      assertFailure(service.update(params, routing, "e2e", 201L, 101L));
+      assertFailure(service.deprovision(params, routing, "e2e", 201L, 101L));
+      assertEquals(1, fixture.awaitTopic(topic).partitions().size());
+      assertEquals("9876543", fixture.topicConfigs(topic).get("retention.ms"));
+    }
+  }
+
+  private int unusedPort() throws Exception {
+    try (ServerSocket socket = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      return socket.getLocalPort();
+    }
+  }
+
+  private void assertFailure(ServiceResult result) {
+    assertEquals(ServiceResult.Status.FAILED, result.status());
+    assertEquals(ErrorCode.TIMEOUT, result.errorCode());
+    assertNotNull(result.details());
+  }
+}
