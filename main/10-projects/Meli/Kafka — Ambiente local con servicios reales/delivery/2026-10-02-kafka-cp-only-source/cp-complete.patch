index 0000000000000000000000000000000000000000..247d38f106251dd0ed4e1d248ccdff39f95e21e3
--- /dev/null
+++ b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/support/OwnedProcessExitReceipt.java
@@ -0,0 +1,64 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.support;
+
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+import tools.jackson.databind.json.JsonMapper;
+
+/** Durable exact-child waitFor receipts; no dead PID, backend state or business outcome is inferred. */
+final class OwnedProcessExitReceipt {
+  private OwnedProcessExitReceipt() { }
+
+  static void record(Process child, UUID generation, Instant birth, boolean stopRequested, boolean forced) throws Exception {
+    if (child.isAlive() || birth == null) { throw new IllegalStateException("OWNED_PROCESS_EXIT_UNVERIFIED"); }
+    ProcessHandle owner = ProcessHandle.current();
+    Path directory = Path.of(RealE2eFixture.requiredEnv("E2E_PROCESS_EXIT_DIR"));
+    if (!directory.isAbsolute() || Files.isSymbolicLink(directory)
+        || !Files.getPosixFilePermissions(directory).equals(PosixFilePermissions.fromString("rwx------"))) {
+      throw new IllegalStateException("OWNED_PROCESS_EXIT_DIRECTORY_UNVERIFIED");
+    }
+    Map<String, Object> fields = new LinkedHashMap<>();
+    fields.put("schema_version", 1);
+    fields.put("kind", "OWNED_GENERATION_PROCESS_EXIT");
+    fields.put("run_id", RealE2eFixture.requiredEnv("E2E_RUN_ID"));
+    fields.put("generation_id", generation.toString());
+    fields.put("application", "CP");
+    fields.put("pid", child.pid());
+    fields.put("process_start_instant", birth.toString());
+    fields.put("process_owner_pid", owner.pid());
+    fields.put("process_owner_start_instant", owner.info().startInstant().orElseThrow().toString());
+    fields.put("process_owner_kind", "DIRECT_PROCESS_WAIT");
+    fields.put("exit_status", child.exitValue());
+    fields.put("forced_stop", forced);
+    fields.put("stop_requested", stopRequested);
+    fields.put("exit_proof", "ACTUAL_PROCESS_WAIT_FOR");
+    fields.put("child_mode", "PRODUCTIVE_CP");
+    boolean healthy = !forced && (child.exitValue() == 0 || child.exitValue() == 143 && stopRequested);
+    fields.put("healthy", healthy);
+    fields.put("unknown_reasons", healthy ? java.util.List.of() : java.util.List.of("PROCESS_EXIT_UNVERIFIED"));
+    Path path = directory.resolve("process-exit-" + generation + ".json");
+    byte[] data = JsonMapper.builder().build().writeValueAsBytes(fields);
+    if (Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+      if (!JsonMapper.builder().build().readTree(Files.readAllBytes(path)).equals(JsonMapper.builder().build().readTree(data))) {
+        throw new IllegalStateException("OWNED_PROCESS_EXIT_RECEIPT_CHANGED");
+      }
+      return;
+    }
+    try (FileChannel channel = FileChannel.open(path,
+        java.util.Set.of(StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE),
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+      ByteBuffer buffer = ByteBuffer.wrap(data);
+      while (buffer.hasRemaining()) { channel.write(buffer); }
+      channel.force(true);
+    }
+    try (FileChannel parent = FileChannel.open(directory, StandardOpenOption.READ)) { parent.force(true); }
+  }
+}
