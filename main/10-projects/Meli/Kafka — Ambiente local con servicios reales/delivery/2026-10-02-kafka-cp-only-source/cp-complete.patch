+// Gradle 9.3.1 asserts normal worker exit before reaching Test.doLast.
+// Native worker registration is independent of productive KVS contexts.
+def workerProofTasks = ['realIntegrationTest', 'e2eTest', 'e2eCanonicalPlaymakerTest', 'e2eCandidatePlaymakerTest']
+def primaryWorkerClasses = [
+    'org.gradle.api.internal.tasks.testing.worker.ForkingTestDefinitionProcessor':
+        'ebdbf25204440cfa88ec70783126625a40b31890ac3808d22e8b55f016b544c3',
+    'org.gradle.process.internal.worker.DefaultWorkerProcess':
+        '75175385ef55b0418ab460a3835fc6e55fc3fc9af64c078cceac1b82b81e5101'
+]
+def privateDirectory = { java.nio.file.Path directory ->
+    if (!directory.isAbsolute() || !java.nio.file.Files.isDirectory(directory, java.nio.file.LinkOption.NOFOLLOW_LINKS)
+        || java.nio.file.Files.getPosixFilePermissions(directory) != java.nio.file.attribute.PosixFilePermissions.fromString('rwx------')
+        || java.nio.file.Files.getAttribute(directory, 'unix:uid') != java.nio.file.Files.getAttribute(projectDir.toPath(), 'unix:uid')) {
+        throw new GradleException('REAL_E2E_PRIVATE_WORKER_DIRECTORY_REQUIRED')
+    }
+    def cursor = directory
+    while (cursor != null) {
+        if (java.nio.file.Files.isSymbolicLink(cursor)) { throw new GradleException('REAL_E2E_WORKER_DIRECTORY_SYMLINK') }
+        cursor = cursor.parent
+    }
+}
+def privateRead = { java.nio.file.Path path ->
+    if (!java.nio.file.Files.isRegularFile(path, java.nio.file.LinkOption.NOFOLLOW_LINKS)
+        || java.nio.file.Files.getPosixFilePermissions(path) != java.nio.file.attribute.PosixFilePermissions.fromString('rw-------')
+        || java.nio.file.Files.getAttribute(path, 'unix:uid') != java.nio.file.Files.getAttribute(projectDir.toPath(), 'unix:uid')
+        || java.nio.file.Files.size(path) > 1000000) { throw new GradleException('REAL_E2E_PRIVATE_WORKER_FILE_REQUIRED') }
+    new groovy.json.JsonSlurper().parse(path.toFile())
+}
+def durableCreate = { java.nio.file.Path path, Map body ->
+    privateDirectory(path.parent)
+    def temporary = java.nio.file.Files.createTempFile(path.parent, '.worker-proof-', '.tmp',
+        java.nio.file.attribute.PosixFilePermissions.asFileAttribute(java.nio.file.attribute.PosixFilePermissions.fromString('rw-------')))
+    try {
+        def bytes = groovy.json.JsonOutput.toJson(body).getBytes(java.nio.charset.StandardCharsets.UTF_8)
+        java.nio.channels.FileChannel.open(temporary, java.nio.file.StandardOpenOption.WRITE).withCloseable { channel ->
+            def buffer = java.nio.ByteBuffer.wrap(bytes)
+            while (buffer.hasRemaining()) { channel.write(buffer) }
+            channel.force(true)
+        }
+        java.nio.file.Files.createLink(path, temporary)
+        java.nio.channels.FileChannel.open(path.parent, java.nio.file.StandardOpenOption.READ).withCloseable { it.force(true) }
+    } finally {
+        java.nio.file.Files.deleteIfExists(temporary)
+        java.nio.channels.FileChannel.open(path.parent, java.nio.file.StandardOpenOption.READ).withCloseable { it.force(true) }
+    }
+}
+workerProofTasks.each { taskName ->
+    tasks.named(taskName, Test) {
+        ignoreFailures = false
+        outputs.upToDateWhen { false }
+        outputs.cacheIf { false }
+        systemProperty 'junit.jupiter.extensions.autodetection.enabled', 'true'
+        systemProperty 'e2e.task', taskName
+        def actualTotals = null
+        def ownerIntent = null
+        def taskDirectory = null
+        doFirst {
+            def run = System.getenv('E2E_RUN_ID')
+            if (run == null || !(run ==~ /[a-z0-9][a-z0-9_-]{7,63}/)) { throw new GradleException('REAL_E2E_WORKER_RUN_REQUIRED') }
+            def workerRoot = java.nio.file.Path.of(System.getenv('E2E_TEST_WORKER_DIR'))
+            privateDirectory(workerRoot)
+            taskDirectory = workerRoot.resolve('task-' + taskName)
+            java.nio.file.Files.createDirectory(taskDirectory,
+                java.nio.file.attribute.PosixFilePermissions.asFileAttribute(java.nio.file.attribute.PosixFilePermissions.fromString('rwx------')))
+            def actualOwner = ProcessHandle.current()
+            ownerIntent = [schema_version: 1, kind: 'OWNED_GRADLE_TEST_TASK_INTENT', run_id: run, task: taskName,
+                owner_pid: actualOwner.pid(), owner_start_instant: actualOwner.info().startInstant().orElseThrow().toString()]
+            durableCreate(taskDirectory.resolve('owner-intent.json'), ownerIntent)
+        }
+        afterSuite { descriptor, result ->
+            if (descriptor.parent == null) {
+                actualTotals = [test_count: result.testCount, failed_count: result.failedTestCount, skipped_count: result.skippedTestCount]
+            }
+        }
+        doLast {
+            if (actualTotals == null || actualTotals.test_count < 1 || actualTotals.failed_count != 0
+                || actualTotals.skipped_count != 0 || gradle.gradleVersion != '9.3.1') {
+                throw new GradleException("${taskName} BLOCKED: complete no-skip result and pinned worker contract required")
+            }
+            primaryWorkerClasses.each { className, expectedHash ->
+                def resource = Test.class.classLoader.getResourceAsStream(className.replace('.', '/') + '.class')
+                if (resource == null) { throw new GradleException('REAL_E2E_GRADLE_PRIMARY_CLASS_MISSING') }
+                def actualHash
+                resource.withCloseable { actualHash = java.security.MessageDigest.getInstance('SHA-256').digest(it.readAllBytes()).encodeHex().toString() }
+                if (actualHash != expectedHash) { throw new GradleException('REAL_E2E_GRADLE_WORKER_CONTRACT_CHANGED') }
+            }
+            privateDirectory(taskDirectory)
+            if (privateRead(taskDirectory.resolve('owner-intent.json')) != ownerIntent) { throw new GradleException('REAL_E2E_WORKER_OWNER_INTENT_CHANGED') }
+            def workerPaths
+            java.nio.file.Files.list(taskDirectory).withCloseable { stream -> workerPaths = stream.toList().findAll { it.fileName.toString() != 'owner-intent.json' } }
+            if (workerPaths.isEmpty()) { throw new GradleException('REAL_E2E_NATIVE_TEST_WORKER_REQUIRED') }
+            def workers = workerPaths.collect { path ->
+                def worker = privateRead(path)
+                if (worker.schema_version != 1 || worker.kind != 'OWNED_JUNIT_TEST_WORKER' || worker.run_id != ownerIntent.run_id
+                    || worker.task != taskName || worker.process_owner_pid != ownerIntent.owner_pid
+                    || worker.process_owner_start_instant != ownerIntent.owner_start_instant
+                    || worker.process_owner_kind != 'GRADLE_TEST_WORKER_NORMAL_EXIT'
+                    || worker.gradle_worker_id == null || worker.process_start_instant == null
+                    || path.fileName.toString() != 'worker-' + worker.pid + '.json'
+                    || (ProcessHandle.of(worker.pid as long).isPresent() && ProcessHandle.of(worker.pid as long).get().isAlive())) {
+                    throw new GradleException('REAL_E2E_TEST_WORKER_EXACT_OWNER_BINDING_REQUIRED')
+                }
+                worker
+            }
+            def directory = java.nio.file.Path.of(System.getenv('E2E_PROCESS_EXIT_DIR'))
+            privateDirectory(directory)
+            def registry = privateRead(java.nio.file.Path.of(System.getenv('E2E_KVS_OBSERVATION_DIR')).resolve('expected-generations.json'))
+            if (registry.run_id != ownerIntent.run_id) { throw new GradleException('REAL_E2E_WORKER_REGISTRY_RUN_CHANGED') }
+            def owned = registry.generations.findAll { manifest ->
+                manifest.process_owner_kind == 'GRADLE_TEST_WORKER_NORMAL_EXIT' && workers.any {
+                    it.pid == manifest.pid && it.process_start_instant == manifest.process_start_instant
+                }
+            }
+            if (owned.any { it.process_owner_pid != ownerIntent.owner_pid || it.process_owner_start_instant != ownerIntent.owner_start_instant }) {
+                throw new GradleException('REAL_E2E_TEST_WORKER_EXACT_OWNER_BINDING_REQUIRED')
+            }
+            def taskProof = [schema_version: 1, kind: 'ACTUAL_GRADLE_TEST_TASK_COMPLETION', run_id: ownerIntent.run_id,
+                task: taskName, owner_pid: ownerIntent.owner_pid, owner_start_instant: ownerIntent.owner_start_instant,
+                gradle_version: gradle.gradleVersion, primary_classes: primaryWorkerClasses, workers: workers,
+                task_outcome: 'SUCCESS_WITH_WORKERS_REAPED_NORMAL_EXIT'] + actualTotals
+            durableCreate(directory.resolve('test-task-' + taskName + '.json'), taskProof)
+            owned.each { manifest ->
+                def exitProof = [schema_version: 1, kind: 'OWNED_GENERATION_PROCESS_EXIT', run_id: registry.run_id,
+                    generation_id: manifest.generation_id, application: manifest.application, pid: manifest.pid,
+                    process_start_instant: manifest.process_start_instant, process_owner_pid: ownerIntent.owner_pid,
+                    process_owner_start_instant: ownerIntent.owner_start_instant, process_owner_kind: manifest.process_owner_kind,
+                    exit_status: 0, forced_stop: false, stop_requested: false, test_task: taskName,
+                    exit_proof: 'PINNED_GRADLE_TEST_WORKER_WAIT_FOR_STOP_NORMAL_EXIT', child_mode: 'PRODUCTIVE_CP_CONTEXT',
+                    healthy: true, unknown_reasons: []]
+                durableCreate(directory.resolve('process-exit-' + manifest.generation_id + '.json'), exitProof)
+            }
+        }
+    }
+}
diff --git a/e2e/kvs-mutation-proof.py b/e2e/kvs-mutation-proof.py
new file mode 100755
