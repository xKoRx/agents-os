+package com.mercadolibre.rio_controlplane_kafka.reale2e.support;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import org.awaitility.Awaitility;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Reads only the passive ledger of one explicitly owned CP HTTP endpoint before destructive cleanup. */
+final class RealWorkerCleanupGate {
+  private RealWorkerCleanupGate() {}
+
+  static void awaitIdle(HttpClient http, ObjectMapper mapper, int ownedPort, String expectedRunId,
+      Long expectedPid, Duration deadline) {
+    if (ownedPort < 1 || ownedPort > 65535) {
+      throw new IllegalArgumentException("EXPLICIT_OWNED_CP_HTTP_PORT_REQUIRED");
+    }
+    Awaitility.await("actual owned CP async workers must be idle before topic/key cleanup")
+        .atMost(deadline).pollInterval(Duration.ofMillis(200))
+        .until(() -> idle(http, mapper, ownedPort, expectedRunId, expectedPid));
+  }
+
+  static boolean idle(HttpClient http, ObjectMapper mapper, int port, String expectedRunId,
+      Long expectedPid) throws Exception {
+    HttpRequest request = HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + "/internal/e2e/workers"))
+        .timeout(Duration.ofSeconds(2)).GET().build();
+    HttpResponse<String> response;
+    try {
+      response = http.send(request, HttpResponse.BodyHandlers.ofString());
+    } catch (java.io.IOException unavailable) {
+      return false;
+    }
+    if (response.statusCode() != 200) {
+      return false;
+    }
+    JsonNode snapshot = mapper.readTree(response.body());
+    if (!snapshot.has("run_id") || !snapshot.path("run_id").isString()
+        || !expectedRunId.equals(snapshot.path("run_id").asString())
+        || !snapshot.has("pid") || !snapshot.path("pid").isIntegralNumber()
+        || snapshot.path("pid").asLong() <= 0
+        || expectedPid != null && snapshot.path("pid").asLong() != expectedPid.longValue()) {
+      return false;
+    }
+    for (String field : new String[] {"submitted", "finished", "rejected", "active"}) {
+      if (!snapshot.has(field) || !snapshot.path(field).isIntegralNumber() || snapshot.path(field).asLong() < 0) {
+        return false;
+      }
+    }
+    if (!snapshot.has("idle") || !snapshot.path("idle").isBoolean()) {
+      return false;
+    }
+    long submitted = snapshot.path("submitted").asLong();
+    long finished = snapshot.path("finished").asLong();
+    long rejected = snapshot.path("rejected").asLong();
+    long active = snapshot.path("active").asLong();
+    return finished <= submitted && rejected <= submitted - finished
+        && active == submitted - finished - rejected && active == 0 && snapshot.path("idle").asBoolean();
+  }
+}
