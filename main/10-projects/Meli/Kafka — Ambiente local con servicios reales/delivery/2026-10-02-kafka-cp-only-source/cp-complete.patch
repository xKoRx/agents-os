+  @AfterAll
+  void closeSeparateResources() throws Exception {
+    Exception failure = null;
+    for (AutoCloseable resource : new AutoCloseable[] {child, clusterAdmin}) {
+      if (resource != null) {
+        try {
+          resource.close();
+        } catch (Exception cleanupFailure) {
+          if (failure == null) {
+            failure = cleanupFailure;
+          } else {
+            failure.addSuppressed(cleanupFailure);
+          }
+        }
+      }
+    }
+    boolean retain = true;
+    try { retain = RealE2eFixture.hasRetainedWork(); }
+    catch (Exception observationFailure) {
+      if (failure == null) { failure = observationFailure; } else { failure.addSuppressed(observationFailure); }
+    }
+    if (retain) {
+      Exception retained = new IllegalStateException("Durable work journal retains the owned authorization broker and private routing file");
+      if (failure == null) { failure = retained; } else { failure.addSuppressed(retained); }
+    } else {
+      try { if (broker != null) { broker.close(); } }
+      catch (Exception cleanupFailure) {
+        if (failure == null) { failure = cleanupFailure; } else { failure.addSuppressed(cleanupFailure); }
+      }
+      try { if (routing != null) { Files.deleteIfExists(routing); } }
+      catch (Exception cleanupFailure) {
+        if (failure == null) { failure = cleanupFailure; } else { failure.addSuppressed(cleanupFailure); }
+      }
+      broker = null;
+      routing = null;
+    }
+    child = null;
+    clusterAdmin = null;
+    if (failure != null) {
+      throw failure;
+    }
+  }
