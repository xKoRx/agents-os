+    def kafka(script, *arguments, must_pass=True):
+        return command(compose + ['exec', '--no-TTY', 'authbroker', '/opt/kafka/bin/' + script,
+                                  '--bootstrap-server', 'localhost:19092', *arguments], must_pass)
+    topic = 'e2e_' + run_id + '_denied'
+    baseline = 'e2e_' + run_id + '_allowed'
+    try:
