+  /**
+   * ACT-RESULT-BOUNDARY: calibrates only from actual CP-produced messages or its actual measured
+   * RESULT_TOO_LARGE failure. No constructed COMPLETED event is ever sent to the transport.
+   */
+  @Test
+  void exactly143360ByteActualResultIsAcceptedAtTheInclusiveBoundary() throws Exception {
+    String topic = fixture.uniqueTopic("exact_budget");
+    fixture.createTopic(topic, 1, (short) 1, Map.of());
+    int padding = 143_000;
+    for (int attempt = 0; attempt < 12; attempt++) {
+      fixture.seed(topic, 0, "budget-key", "x".repeat(padding));
+      var action = fixture.action(Map.of("topic_name", topic, "num_msgs", 1, "offset", "LATEST"));
+      assertEquals(200, fixture.postAction(action).statusCode());
+      JsonNode result = fixture.awaitAction(action.actionId());
+      int actualBytes;
+      if ("COMPLETED".equals(result.path("status").asString())) {
+        actualBytes = sizeGuard.measure(mapper.treeToValue(result, ActionResultMessage.class)).sizeBytes();
+        fixture.awaitKvs("action:" + action.actionId(), "COMPLETED");
+        if (actualBytes == ENVELOPE_BUDGET) {
+          assertEquals(padding, result.path("result").path("messages").get(0).path("value").asString().length());
+          return;
+        }
+        assertTrue(actualBytes < ENVELOPE_BUDGET);
+      } else {
+        assertEquals("RESULT_TOO_LARGE", result.path("error").path("code").asString());
+        actualBytes = result.path("error").path("details").path("result_size_bytes").asInt();
+        assertTrue(actualBytes > ENVELOPE_BUDGET);
+        fixture.awaitKvs("action:" + action.actionId(), "FAILED");
+      }
+      padding += ENVELOPE_BUDGET - actualBytes;
+      assertTrue(padding > 0 && padding < ENVELOPE_BUDGET);
+    }
+    throw new AssertionError("Actual Instant/offset serialization did not produce the exact byte boundary within12 physical attempts");
+  }
