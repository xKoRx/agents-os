+          "Every admitted non-entity param, including retention, must survive inheritance");
+      assertEquals(expected.kafka(), kafkaInputs(topology.topic()), "Actual Kafka assignments/configs must remain unchanged");
+      assertEquals(0, fixture.database().deployments(topology.kafka()).size());
+      fixture.wire().assertNoDelta(wireBaseline);
+    } catch (Exception | Error failure) {
+      // A failed preservation read or assertion cannot grant destructive cleanup during AfterEach.
+      try { fixture.lifecycle().markUnknown("OWN_PHYSICAL_INPUT_PRESERVATION_UNKNOWN"); }
+      catch (Exception | Error ledgerFailure) { failure.addSuppressed(ledgerFailure); }
+      throw failure;
+    }
+  }
+
+  private record PartitionInputs(int id, List<Integer> replicas) { }
+  private record KafkaInputs(List<PartitionInputs> partitions, Map<String, String> configs) { }
+  private record PhysicalInputs(JsonNode params, KafkaInputs kafka) { }
+
+  private void requireActualApprovedWorkflow() {
+    // This gate is intentionally closed until the real productive Odin workflow and own recipient/cleanup are assigned.
+    // No receipt flag, SQL APPROVED seed or fabricated callback can open it. The guarded physical body remains prepared.
+    throw new IllegalStateException("PARTIAL_OWNED_APPROVED_IMPORT_WORKFLOW_UNVERIFIED:requires_actual_Odin_client"
+        + "_distinct_authorized_requester_resolver_owned_recipient_permission_and_remote_cleanup_contract");
+  }
+
+  private CompletableFuture<Integer> asyncConnect(PlaymakerPipelineFixture.Topology topology,
+      OwnedPipelineDatabase.Component source) {
+    return CompletableFuture.supplyAsync(() -> {
+      try {
+        return fixture.connect(topology, source, false, "staging").statusCode();
+      } catch (Exception failure) {
+        throw new java.util.concurrent.CompletionException(failure);
+      }
+    });
+  }
+
+  private void assertInherited(PlaymakerPipelineFixture.Topology topology, long source,
+      OwnedEntityServiceFixture.Entity entity, int revision, String direction) throws Exception {
+    JsonNode inherited = fixture.entry(topology.kafka(), source, direction);
+    assertEquals(entity.id(), inherited.path("entityId").asString());
+    assertEquals(revision, inherited.path("version").asInt());
+    assertEquals("INHERITED", inherited.path("assignment").path("state").asString());
+    UUID.fromString(slotId(inherited));
+  }
+
+  private static String slotId(JsonNode entity) {
+    return entity.path("assignment").path("slotId").asString();
+  }
+
+  private static JsonNode findDirection(JsonNode entities, String direction) {
+    for (JsonNode entity : entities) {
+      if (direction.equals(entity.path("direction").asString())) {
+        return entity;
+      }
+    }
+    throw new IllegalStateException("REAL_OUT_ENTITY_MISSING");
+  }
+}
