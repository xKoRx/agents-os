+  private void assertPeeked(JsonNode message, long offset, String value, String format) {
+    assertNotNull(message);
+    assertEquals(0, message.path("partition").asInt());
+    assertEquals(offset, message.path("offset").asLong());
+    assertEquals("message-key", message.path("key").asString());
+    assertTrue(message.path("timestamp_ms").asLong() > 0);
+    assertEquals(format, message.path("value_format").asString());
+    if (value == null) {
+      assertTrue(message.path("value").isNull() || message.path("value").isMissingNode());
+    } else if ("JSON".equals(format)) {
+      assertEquals(mapper.readTree(value), message.path("value"));
+    } else {
+      assertEquals(value, message.path("value").asString());
+    }
+  }
