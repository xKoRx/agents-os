+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.time.Duration;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+
+/** Prepared SQL fixtures restricted to the exact run-owned Docker Compose database. */
+public final class OwnedPlaymakerDatabase implements AutoCloseable, OwnedPlaymakerLifecycle.SqlQuiescenceProbe {
+  private static final Duration COMMAND_DEADLINE = Duration.ofSeconds(30);
+  private final String container;
+  private final OwnedPlaymakerLifecycle lifecycle;
+  private List<Long> cleanupDeploymentIds = List.of();
+  private boolean closed;
+  private final long dataProductId;
+  private final long environmentId;
+  private final long componentId;
+  private final long definitionId;
+  private final long serviceId;
+
+  public OwnedPlaymakerDatabase(OwnedPlaymakerLifecycle lifecycle) throws Exception {
+    this.lifecycle = java.util.Objects.requireNonNull(lifecycle);
+    container = validateOwnedContainer();
+    long seed = 1_000_000_000L + new SecureRandom().nextInt(1_000_000_000);
+    dataProductId = seed;
+    environmentId = 1; // Explicit isolated CP cluster registry entry; database belongs to this run only.
+    componentId = seed + 2;
+    definitionId = seed + 3;
+    serviceId = seed + 4;
+    lifecycle.beforeSqlMutation(plannedIds());
+    lifecycle.registerCleanupAbsence("owned_sql_tables", this::assertOwnedAbsence);
+  }
+
+  void seed(String componentType, String parameters) throws Exception {
+    if (closed) { throw new IllegalStateException("E2E_SQL_CLIENT_CLOSED"); }
+    lifecycle.beforeSqlMutation(plannedIds());
+    try {
+    execute("INSERT INTO data_product (id,name,description,team_name,project_code,status,visibility,"
+        + "created_at,updated_at,created_by,updated_by,deleted_by) VALUES (?,?,?,?,?,'active','private',NOW(),NOW(),'e2e','e2e','')",
+        List.of(dataProductId, "e2e-" + dataProductId, "Owned real Kafka E2E fixture", required("E2E_OWNER_TEAM"),
+            required("E2E_OWNER_PROJECT")));
+    execute("INSERT INTO environment (id,name,data_product_id,type,criticality,created_at,updated_at,created_by,"
+        + "updated_by,deleted_by) VALUES (?,'staging',?,'Testing','Test',NOW(),NOW(),'e2e','e2e','')",
+        List.of(environmentId, dataProductId));
+    execute("INSERT INTO component (id,data_product_id,component_template,component_template_code,name,visibility,"
+        + "status,created_at,updated_at,created_by,updated_by,deleted_by) VALUES (?,?,?,?,?,'private','Active',"
+        + "NOW(),NOW(),'e2e','e2e','')", List.of(componentId, dataProductId, componentType, componentType,
+            "e2e-component-" + componentId));
+    execute("INSERT INTO component_definition (id,created_at,created_by,state,status,type,updated_at,component_id,"
+        + "parameters,slos) VALUES (?,NOW(),'e2e','active','valid','materialize',NOW(),?,?,'[]')",
+        List.of(definitionId, componentId, parameters));
+    execute("INSERT INTO service (id,environment_id,component_definition_id,component_id,status,created_at)"
+        + " VALUES (?,?,?,?,'materialize',NOW())", List.of(serviceId, environmentId, definitionId, componentId));
+    } catch (Exception | AssertionError error) {
+      try { lifecycle.markUnknown("SQL_SEED_UNVERIFIED"); } catch (Exception journalError) { error.addSuppressed(journalError); }
+      throw error;
+    }
+  }
+
+  String deploymentPath() {
+    return "/data-products/" + dataProductId + "/components/" + componentId + "/environments/" + environmentId
+        + "/deployments";
+  }
+
+  String actionPath() {
+    return "/data-products/" + dataProductId + "/components/" + componentId + "/environments/" + environmentId
+        + "/actions/peek";
+  }
+
+  long dataProductId() {
+    return dataProductId;
+  }
+
+  long definitionId() {
+    return definitionId;
+  }
+
+  long serviceId() {
+    return serviceId;
+  }
+
+  void updateOwnedFixtureParameters(String parameters) throws Exception {
+    if (closed) { throw new IllegalStateException("E2E_SQL_CLIENT_CLOSED"); }
+    lifecycle.beforeSqlMutation(plannedIds());
+    execute("UPDATE component_definition SET parameters=? WHERE id=? AND component_id=?",
+        List.of(parameters, definitionId, componentId));
+  }
+
+  Snapshot latest() throws Exception {
+    String row = execute("SELECT id,status,COALESCE(deployment_correlation_id,materialization_id,'') FROM deployment"
+        + " WHERE service_id=? ORDER BY id DESC LIMIT 1", List.of(serviceId)).strip();
+    if (row.isEmpty()) {
+      throw new IllegalStateException("E2E_DEPLOYMENT_NOT_YET_PERSISTED");
+    }
+    String[] fields = row.split("\t", -1);
+    if (fields.length != 3) {
+      throw new IllegalStateException("E2E_MYSQL_DEPLOYMENT_SHAPE_CHANGED");
+    }
+    return new Snapshot(Long.parseLong(fields[0]), fields[1], fields[2]);
+  }
+
+  long deploymentCount() throws Exception {
+    return Long.parseLong(execute("SELECT COUNT(*) FROM deployment WHERE service_id=?", List.of(serviceId)).strip());
+  }
+
+  List<String> correlationIds() throws Exception {
+    String rows = execute("SELECT COALESCE(deployment_correlation_id,materialization_id,'') FROM deployment"
+        + " WHERE service_id=?", List.of(serviceId));
+    return rows.lines().filter(value -> !value.isBlank()).toList();
+  }
+
+  private String execute(String sql, List<?> parameters) throws Exception {
+    StringBuilder query = new StringBuilder("PREPARE e2e_statement FROM '").append(sql.replace("'", "''")).append("';\n");
+    for (int index = 0; index < parameters.size(); index++) {
+      byte[] value = String.valueOf(parameters.get(index)).getBytes(StandardCharsets.UTF_8);
+      query.append("SET @e2e_").append(index).append("=CONVERT(X'")
+          .append(HexFormat.of().formatHex(value)).append("' USING utf8mb4);\n");
+    }
+    query.append("EXECUTE e2e_statement USING ");
+    for (int index = 0; index < parameters.size(); index++) {
+      if (index > 0) {
+        query.append(',');
+      }
+      query.append("@e2e_").append(index);
+    }
+    query.append(";\nDEALLOCATE PREPARE e2e_statement;\n");
+    try {
+      return command(List.of("docker", "exec", "-i", container, "sh", "-c",
+        "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" mysql --user=root --database=rioplaymakerdb --batch --skip-column-names"),
+        query.toString());
+    } catch (Exception failure) {
+      try { lifecycle.markUnknown("SQL_COMMAND_OUTCOME_UNVERIFIED"); }
+      catch (Exception journalFailure) { failure.addSuppressed(journalFailure); }
+      throw failure;
+    }
+  }
+
+  private static String command(List<String> arguments, String input) throws Exception {
+    Process process = new ProcessBuilder(arguments).redirectError(ProcessBuilder.Redirect.DISCARD).start();
+    try (var output = process.getOutputStream()) {
+      output.write(input.getBytes(StandardCharsets.UTF_8));
+    }
+    if (!process.waitFor(COMMAND_DEADLINE.toMillis(), TimeUnit.MILLISECONDS)) {
+      process.destroyForcibly();
+      throw new IllegalStateException("E2E_MYSQL_COMMAND_TIMEOUT");
+    }
+    if (process.exitValue() != 0) {
+      // Never emit SDK/SQL payloads or credential-bearing environment in diagnostics.
+      throw new IOException("E2E_MYSQL_COMMAND_FAILED");
+    }
+    return new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
+  }
+
+  static String required(String name) {
+    String value = System.getenv(name);
+    if (value == null || value.isBlank()) {
+      throw new IllegalStateException("E2E_REQUIRED_CONFIGURATION_MISSING:" + name);
+    }
+    return value;
+  }
+
+  /** Releases fixture access only; close never deletes SQL rows. */
+  @Override
+  public void close() { closed = true; }
+
+
+  private Map<String, Long> plannedIds() {
+    return Map.of("data_product", dataProductId, "environment", environmentId, "component", componentId,
+        "component_definition", definitionId, "service", serviceId);
+  }
+
+  /** Only this exact owned MySQL instance/user may supply the SQL quiescence proof. */
+  @Override
+  public void assertNoPmSessions() throws Exception {
+    assertRunOwnedPmSessionsAbsent();
+  }
+
+  public static void assertRunOwnedPmSessionsAbsent() throws Exception {
+    String container = validateOwnedContainer();
+    long end = System.nanoTime() + Duration.ofSeconds(30).toNanos();
+    while (true) {
+      String count = command(List.of("docker", "exec", "-i", container, "sh", "-c",
+          "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" mysql --user=root --database=rioplaymakerdb --batch --skip-column-names"),
+          "SELECT COUNT(*) FROM information_schema.processlist WHERE USER='playmakeruser';\n").strip();
+      if ("0".equals(count)) { return; }
+      if (!count.matches("[0-9]+") || System.nanoTime() >= end) {
+        throw new IllegalStateException("E2E_PM_SQL_SESSIONS_NOT_ABSENT");
+      }
+      TimeUnit.MILLISECONDS.sleep(100);
+    }
+  }
+
+  private static String validateOwnedContainer() throws Exception {
+    String container = required("E2E_MYSQL_CONTAINER");
+    String owner = command(List.of("docker", "inspect", "--format",
+        "{{ index .Config.Labels \"com.docker.compose.project\" }}|{{ index .Config.Labels \"com.docker.compose.service\" }}",
+        container), "").strip();
+    if (!owner.equals("rio-kafka-e2e-" + required("E2E_RUN_ID") + "|mysql")) {
+      throw new IllegalStateException("E2E_MYSQL_MUST_BELONG_TO_EXACT_RUN_COMPOSE_PROJECT");
+    }
+    return container;
+  }
+
+  /** Every destructive SQL operation requires the exact verified generation permit. */
+  public void cleanupVerified(OwnedPlaymakerLifecycle.CleanupPermit permit) throws Exception {
+    java.util.Objects.requireNonNull(permit).assertValid();
+    try {
+      validateOwnedContainer();
+      String rows = execute("SELECT id FROM deployment WHERE service_id=?", List.of(serviceId));
+      cleanupDeploymentIds = rows.lines().filter(value -> !value.isBlank()).map(Long::parseLong).toList();
+      Map<String, String> actual = new java.util.LinkedHashMap<>();
+      for (long id : cleanupDeploymentIds) { actual.put("deployment_row." + id, Long.toString(id)); }
+      lifecycle.bindObservedResponseIds(actual);
+      delete(permit, "DELETE FROM deployment_log WHERE deployment_id IN (SELECT id FROM deployment WHERE service_id=?)", List.of(serviceId));
+      delete(permit, "DELETE FROM deployment WHERE service_id=?", List.of(serviceId));
+      delete(permit, "DELETE FROM service WHERE id=? AND component_id=?", List.of(serviceId, componentId));
+      delete(permit, "DELETE FROM component_definition WHERE id=? AND component_id=?", List.of(definitionId, componentId));
+      delete(permit, "DELETE FROM component WHERE id=? AND data_product_id=?", List.of(componentId, dataProductId));
+      delete(permit, "DELETE FROM environment WHERE id=? AND data_product_id=?", List.of(environmentId, dataProductId));
+      delete(permit, "DELETE FROM data_product WHERE id=? AND name=?", List.of(dataProductId, "e2e-" + dataProductId));
+      assertOwnedAbsence();
+    } catch (Exception | AssertionError error) {
+      try { lifecycle.markUnknown("SQL_CLEANUP_UNVERIFIED"); }
+      catch (Exception ledgerFailure) { error.addSuppressed(ledgerFailure); }
+      throw error;
+    }
+  }
+
+  private void delete(OwnedPlaymakerLifecycle.CleanupPermit permit, String sql, List<?> parameters) throws Exception {
+    permit.assertValid();
+    execute(sql, parameters);
+  }
+
+  /** Observes each owned table; DP absence alone cannot hide orphan log/deployment/service rows. */
+  public void assertOwnedAbsence() throws Exception {
+    for (long id : cleanupDeploymentIds) {
+      absent("SELECT COUNT(*) FROM deployment_log WHERE deployment_id=?", List.of(id));
+    }
+    absent("SELECT COUNT(*) FROM deployment WHERE service_id=?", List.of(serviceId));
+    absent("SELECT COUNT(*) FROM service WHERE id=? OR component_id=?", List.of(serviceId, componentId));
+    absent("SELECT COUNT(*) FROM component_definition WHERE id=? OR component_id=?", List.of(definitionId, componentId));
+    absent("SELECT COUNT(*) FROM component WHERE id=? OR data_product_id=?", List.of(componentId, dataProductId));
+    absent("SELECT COUNT(*) FROM environment WHERE id=? OR data_product_id=?", List.of(environmentId, dataProductId));
+    absent("SELECT COUNT(*) FROM data_product WHERE id=?", List.of(dataProductId));
+  }
+
+  private void absent(String sql, List<?> ids) throws Exception {
+    if (!execute(sql, ids).strip().equals("0")) {
+      throw new IllegalStateException("E2E_MYSQL_OWNED_TABLE_NOT_ABSENT");
+    }
+  }
+
+  record Snapshot(long id, String status, String correlationId) { }
+}
