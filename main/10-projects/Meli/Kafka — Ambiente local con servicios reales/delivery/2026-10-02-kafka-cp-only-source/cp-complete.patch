+#!/usr/bin/env python3
+"""Keep machine-readable JUnit outcomes without runtime output, SDK bodies or credentials."""
+from pathlib import Path
+import sys,xml.etree.ElementTree as ET
+source,destination=map(Path,sys.argv[1:])
+destination.mkdir(parents=True,exist_ok=True)
+if source.is_dir():
+ for path in source.glob('TEST-*.xml'):
+  root=ET.parse(path).getroot()
+  root.attrib.pop('hostname',None)
+  for parent in root.iter():
+   for child in list(parent):
+    if child.tag in ('system-out','system-err','properties'): parent.remove(child)
+    elif child.tag in ('failure','error'):
+     child.set('message','REAL_E2E_FAILURE_DETAIL_REDACTED')
+     child.text=''
+  ET.ElementTree(root).write(destination/path.name,encoding='utf-8',xml_declaration=True)
