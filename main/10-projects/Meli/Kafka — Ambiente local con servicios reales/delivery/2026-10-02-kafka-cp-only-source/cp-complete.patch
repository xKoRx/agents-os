+/** SQL inputs and independent snapshots in one verified run-owned MySQL, never seeded outputs. */
+final class OwnedPipelineDatabase implements OwnedPlaymakerLifecycle.SqlQuiescenceProbe, AutoCloseable {
+  private static final Duration DEADLINE = Duration.ofSeconds(30);
+  private static final int TEXT_LIMIT = 65_535;
+  private final JsonMapper mapper;
+  private final OwnedPlaymakerLifecycle lifecycle;
