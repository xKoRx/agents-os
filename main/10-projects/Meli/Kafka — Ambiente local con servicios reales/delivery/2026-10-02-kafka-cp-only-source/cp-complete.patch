+++ b/e2e/faults/network_proxy.py
@@ -0,0 +1,338 @@
+#!/usr/bin/env python3
+"""Transparent, owned HTTP/TCP fault control. No application storage or success fabrication."""
+import argparse
+from contextlib import closing
+import http.client
+import http.server
+import json
+import os
+from pathlib import Path
+import socket
+import socketserver
+import ssl
+import threading
+import time
+from urllib.parse import urlsplit, unquote
+
+HOP_HEADERS = frozenset(('connection', 'keep-alive', 'proxy-authenticate', 'proxy-authorization',
+                         'te', 'trailer', 'transfer-encoding', 'upgrade', 'host', 'content-length'))
+MAX_BODY = 2 * 1024 * 1024
+
+class FaultControl:
+    """One controller per proxy process, scoped to its owned connections."""
+    def __init__(self):
+        self.condition = threading.Condition()
+        self.rule = None
+        self.hits = 0
+        self.completed = 0
+        self.released = False
+        self.active = set()
+        self.closed = False
+        self.aborted = False
+
+    def arm(self, rule):
+        allowed = {'method', 'path_contains', 'body_contains', 'phase', 'action', 'hits', 'hold_seconds'}
+        if set(rule) - allowed or rule.get('phase') not in ('request', 'response'):
+            raise ValueError('INVALID_RULE')
+        if rule.get('action') not in ('hold', 'reset', 'fail503'):
+            raise ValueError('INVALID_RULE')
+        if not 1 <= int(rule.get('hits', 1)) <= 1000 or not 0 < float(rule.get('hold_seconds', 30)) <= 120:
+            raise ValueError('INVALID_RULE_BOUNDS')
+        for key in ('method', 'path_contains', 'body_contains'):
+            if key in rule and (not isinstance(rule[key], str) or len(rule[key]) > 512):
+                raise ValueError('INVALID_MATCHER')
+        with self.condition:
+            if self.rule is not None and not self.released:
+                raise ValueError('PREVIOUS_RULE_NOT_RELEASED')
+            self.rule = dict(rule, _released=False, _aborted=False)
+            self.hits = self.completed = 0
+            self.released = False
+            self.aborted = False
+            self.condition.notify_all()
+
+    def hit(self, method, path, body, phase):
+        with self.condition:
+            rule = self.rule
+            if not rule or self.released or self.hits >= int(rule.get('hits', 1)) or rule['phase'] != phase:
+                return None
+            if rule.get('method') and rule['method'] != method:
+                return None
+            if rule.get('path_contains') and rule['path_contains'] not in unquote(path):
+                return None
+            if rule.get('body_contains') and rule['body_contains'].encode() not in body:
+                return None
+            self.hits += 1
+            self.condition.notify_all()
+            if rule['action'] != 'hold':
+                return rule['action']
+            deadline = time.monotonic() + float(rule.get('hold_seconds', 30))
+            while not rule['_released'] and not self.closed:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    return 'reset'
+                self.condition.wait(remaining)
+            return 'reset' if self.closed or rule['_aborted'] else None
+
+    def release(self):
+        with self.condition:
+            self.released = True
+            if self.rule is not None:
+                self.rule['_released'] = True
+            self.condition.notify_all()
+
+    def abort_held(self):
+        with self.condition:
+            self.aborted = True
+            self.released = True
+            if self.rule is not None:
+                self.rule['_released'] = True
+                self.rule['_aborted'] = True
+            self.condition.notify_all()
+
+    def snapshot(self):
+        with self.condition:
+            return {'hits': self.hits, 'completed': self.completed, 'active_connections': len(self.active),
+                    'released': self.released}
+
+    def reset_connections(self):
+        with self.condition:
+            connections = tuple(self.active)
+        for connection in connections:
+            try:
+                connection.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            connection.close()
+
+class ThreadServer(http.server.ThreadingHTTPServer):
+    daemon_threads = True
+    block_on_close = True
+
+class ControlHandler(http.server.BaseHTTPRequestHandler):
+    def log_message(self, *_):
+        pass
+
+    def do_GET(self):
+        if self.path != '/state':
+            self.send_error(404)
+            return
+        self.reply(self.server.fault.snapshot())
+
+    def do_POST(self):
+        try:
+            length = int(self.headers.get('Content-Length', 0))
+            if not 0 <= length <= 4096:
+                raise ValueError('CONTROL_BODY_TOO_LARGE')
+            payload = self.rfile.read(length)
+            if self.path == '/arm':
+                self.server.fault.arm(json.loads(payload))
+            elif self.path == '/release':
+                self.server.fault.release()
+            elif self.path == '/abort-held':
+                self.server.fault.abort_held()
+            elif self.path == '/reset-connections':
+                self.server.fault.reset_connections()
+            else:
+                self.send_error(404)
+                return
+            self.reply(self.server.fault.snapshot())
+        except (ValueError, json.JSONDecodeError):
+            self.send_error(400, 'INVALID_FAULT_CONTROL')
+
+    def reply(self, payload):
+        encoded = json.dumps(payload).encode()
+        self.send_response(200)
+        self.send_header('Content-Type', 'application/json')
+        self.send_header('Content-Length', str(len(encoded)))
+        self.end_headers()
+        self.wfile.write(encoded)
+
+class ForwardHandler(http.server.BaseHTTPRequestHandler):
+    protocol_version = 'HTTP/1.1'
+
+    def log_message(self, *_):
+        pass
+
+    def setup(self):
+        super().setup()
+        self.connection.settimeout(15)
+
+    def do_GET(self):
+        self.forward()
+
+    def do_POST(self):
+        self.forward()
+
+    def do_PUT(self):
+        self.forward()
+
+    def do_DELETE(self):
+        self.forward()
+
+    def do_PATCH(self):
+        self.forward()
+
+    def reject(self, code=503):
+        self.send_response(code)
+        self.send_header('Content-Length', '0')
+        self.send_header('Connection', 'close')
+        self.end_headers()
+        self.close_connection = True
+
+    def apply(self, body, phase):
+        action = self.server.fault.hit(self.command, self.path, body, phase)
+        if action == 'fail503':
+            self.reject()
+            return False
+        if action == 'reset':
+            try:
+                self.connection.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            self.close_connection = True
+            return False
+        return True
+
+    def forward(self):
+        # Reject out-of-sandbox destinations before connecting or forwarding credentials.
+        requested = urlsplit(self.path)
+        decoded_path = unquote(requested.path)
+        if requested.scheme or requested.netloc or '..' in decoded_path.split('/'):
+            self.reject(400)
+            return
+        segments = decoded_path.strip('/').split('/')
+        if len(segments) < 2 or segments[:2] != ['containers', self.server.allowed_path_token]:
+            self.reject(403)
+            return
+        if self.headers.get('Transfer-Encoding'):
+            self.reject(411)
+            return
+        try:
+            length = int(self.headers.get('Content-Length', 0))
+            if not 0 <= length <= MAX_BODY:
+                self.reject(413)
+                return
+            body = self.rfile.read(length)
+            if not self.apply(body, 'request'):
+                return
+            upstream = self.server.upstream
+            connection_type = http.client.HTTPSConnection if upstream.scheme == 'https' else http.client.HTTPConnection
+            options = {'timeout': self.server.upstream_timeout}
+            if upstream.scheme == 'https':
+                options['context'] = ssl.create_default_context()
+            headers = {key: value for key, value in self.headers.items() if key.lower() not in HOP_HEADERS}
+            headers['Content-Length'] = str(len(body))
+            target = upstream.path.rstrip('/') + self.path
+            with closing(connection_type(upstream.hostname, upstream.port, **options)) as connection:
+                connection.request(self.command, target, body, headers)
+                response = connection.getresponse()
+                response_body = response.read(MAX_BODY + 1)
+                if len(response_body) > MAX_BODY:
+                    self.reject(502)
+                    return
+                # A response-phase hold proves the real server already returned this response.
+                if not self.apply(body, 'response'):
+                    return
+                self.send_response_only(response.status)
+                for key, value in response.getheaders():
+                    if key.lower() not in HOP_HEADERS:
+                        self.send_header(key, value)
+                self.send_header('Content-Length', str(len(response_body)))
+                self.end_headers()
+                self.wfile.write(response_body)
+            with self.server.fault.condition:
+                self.server.fault.completed += 1
+        except (OSError, http.client.HTTPException, ValueError):
+            self.reject(502)
+
+class TcpHandler(socketserver.BaseRequestHandler):
+    def handle(self):
+        fault = self.server.fault
+        upstream = None
+        try:
+            upstream = socket.create_connection(self.server.target, timeout=10)
+            upstream.settimeout(None)
+            with fault.condition:
+                fault.active.update((self.request, upstream))
+            def pump(source, destination, phase):
+                try:
+                    while True:
+                        chunk = source.recv(65536)
+                        if not chunk or fault.hit('TCP', '/', chunk, phase) in ('reset', 'fail503'):
+                            break
+                        destination.sendall(chunk)
+                except OSError:
+                    pass
+                finally:
+                    try:
+                        destination.shutdown(socket.SHUT_WR)
+                    except OSError:
+                        pass
+            reverse = threading.Thread(target=pump, args=(upstream, self.request, 'response'), daemon=True)
+            reverse.start()
+            pump(self.request, upstream, 'request')
+            reverse.join(10)
+        except OSError:
+            pass
+        finally:
+            with fault.condition:
+                fault.active.discard(self.request)
+                if upstream:
+                    fault.active.discard(upstream)
+            if upstream:
+                upstream.close()
+
+class TcpServer(socketserver.ThreadingTCPServer):
+    daemon_threads = True
+    allow_reuse_address = False
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--config', required=True)
+    args = parser.parse_args()
+    config = json.loads(Path(args.config).read_text())
+    upstream = urlsplit(config['upstream'])
+    if upstream.scheme not in ('http', 'https', 'tcp') or upstream.username or upstream.password or upstream.query or upstream.fragment:
+        raise SystemExit('INVALID_OWNED_UPSTREAM')
+    # The config is authored by the test from generated sandbox exports, never by the inbound request.
+    if upstream.netloc != config['allowed_authority']:
+        raise SystemExit('UPSTREAM_NOT_ALLOWLISTED')
+    fault = FaultControl()
+    control = ThreadServer(('127.0.0.1', 0), ControlHandler)
+    control.fault = fault
+    if upstream.scheme == 'tcp':
+        if upstream.hostname not in ('127.0.0.1', 'localhost') or not upstream.port:
+            raise SystemExit('TCP_UPSTREAM_MUST_BE_OWNED_LOOPBACK')
+        proxy = TcpServer(('127.0.0.1', 0), TcpHandler)
+        proxy.target = (upstream.hostname, upstream.port)
+    else:
+        token = config['allowed_path_token']
+        if not token or '/' in token:
+            raise SystemExit('EXACT_OWNED_PATH_TOKEN_REQUIRED')
+        proxy = ThreadServer(('127.0.0.1', 0), ForwardHandler)
+        proxy.upstream = upstream
+        proxy.allowed_path_token = token
+        proxy.upstream_timeout = float(config.get('upstream_timeout', 15))
+    proxy.fault = fault
+    readiness = Path(config['ready_file'])
+    pending_readiness = readiness.with_suffix('.pending')
+    pending_readiness.write_text(json.dumps({'proxy_port': proxy.server_address[1], 'control_port': control.server_address[1]}))
+    os.chmod(pending_readiness, 0o600)
+    os.replace(pending_readiness, readiness)
+    control_thread = threading.Thread(target=control.serve_forever, daemon=True)
+    control_thread.start()
+    try:
+        proxy.serve_forever(poll_interval=0.1)
+    finally:
+        with fault.condition:
+            fault.closed = True
+            fault.condition.notify_all()
+        fault.reset_connections()
+        proxy.server_close()
+        control.shutdown()
+        control.server_close()
+        control_thread.join(5)
+
+if __name__ == '__main__':
+    main()
