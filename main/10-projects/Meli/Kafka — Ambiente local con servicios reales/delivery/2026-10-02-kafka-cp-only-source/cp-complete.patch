+import java.util.concurrent.atomic.AtomicBoolean;
+import org.apache.kafka.clients.admin.AdminClient;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.clients.producer.KafkaProducer;
+import org.apache.kafka.clients.producer.ProducerRecord;
+import org.apache.kafka.common.TopicPartition;
+import org.apache.kafka.common.serialization.StringDeserializer;
+import org.apache.kafka.common.serialization.StringSerializer;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import tools.jackson.databind.json.JsonMapper;
+
+/** Invalid neutral inputs exercise the real Playmaker Kafka listener and dead letter transport. */
+class PlaymakerResultTransportE2ETest {
+  @ParameterizedTest(name = "{0}: missing required result fields reaches actual DLT")
+  @CsvSource({"deployment,E2E_DEPLOYMENT_RESULT_TOPIC,E2E_DEPLOYMENT_RESULT_DLT_TOPIC",
+      "action,E2E_ACTION_RESULT_TOPIC,E2E_ACTION_RESULT_DLT_TOPIC"})
+  void missingRequiredFieldsAreRejectedAndPublishedToActualOwnedDlt(String family, String sourceVariable,
+      String dltVariable) throws Exception {
+    String bootstrap = OwnedPlaymakerDatabase.required("E2E_BOOTSTRAP_SERVERS");
+    String source = OwnedPlaymakerDatabase.required(sourceVariable);
+    String dlt = OwnedPlaymakerDatabase.required(dltVariable);
+    String run = OwnedPlaymakerDatabase.required("E2E_RUN_ID");
+    assertTrue(source.startsWith("e2e_" + run + "_") && dlt.startsWith("e2e_" + run + "_"));
+    JsonMapper mapper = JsonMapper.builder().build();
+    String probe = UUID.randomUUID().toString();
+    // No business status/result is fabricated. This intentionally lacks the required DTO fields.
+    String invalidInput = mapper.writeValueAsString(Map.of("probe_id", probe, "input_kind", "invalid_result_shape"));
+    AtomicBoolean observed = new AtomicBoolean();
+    com.fury.toolkit.kvs.KvsClient cpKvs =
+        com.mercadolibre.rio_controlplane_kafka.reale2e.RealE2eKvsClientFactory.create(
+            OwnedPlaymakerDatabase.required("E2E_KVS_CONTAINER_NAME"), System.getenv("E2E_KVS_SEGMENT_ID"), 3_000);
+    var cp = java.net.URI.create(OwnedPlaymakerDatabase.required("E2E_CP_BASE_URL"));
+    if (!"127.0.0.1".equals(cp.getHost()) || cp.getPort() < 1024) {
+      cpKvs.close();
+      throw new IllegalStateException("E2E_CP_MUST_BE_OWNED_LOOPBACK");
+    }
+    com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture fixture = null;
+    OwnedPlaymakerLifecycle lifecycle = null;
+    Throwable failure = null;
+    try {
+      fixture = new com.mercadolibre.rio_controlplane_kafka.reale2e.support.RealE2eFixture(
+          cp.getPort(), mapper, cpKvs, bootstrap);
+      fixture.registerKafkaTriggerDispatchAtPort(cp.getPort());
+      lifecycle = OwnedPlaymakerLifecycle.beginFixture(fixture, PlaymakerMutationReceiptVerifier.fromEnvironment());
+    try (AdminClient admin = AdminClient.create(Map.of("bootstrap.servers", bootstrap));
+        KafkaProducer<String, String> producer = new KafkaProducer<>(Map.of("bootstrap.servers", bootstrap,
+            "key.serializer", StringSerializer.class, "value.serializer", StringSerializer.class, "acks", "all"));
+        KafkaConsumer<String, String> consumer = new KafkaConsumer<>(Map.of(
+            ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap,
+            ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class,
+            ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, StringDeserializer.class,
+            ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false))) {
+      var metadata = admin.describeTopics(List.of(dlt)).allTopicNames().get(30, TimeUnit.SECONDS).get(dlt);
+      var partitions = metadata.partitions().stream().map(partition -> new TopicPartition(dlt, partition.partition())).toList();
+      consumer.assign(partitions);
+      consumer.seekToEnd(partitions);
+      for (TopicPartition partition : partitions) {
+        consumer.position(partition, Duration.ofSeconds(20));
+      }
+      // Empty key permits other real fixture observers to retain this neutral invalid input without interpreting a deployment.
+      lifecycle.beforeDltSend(source, dlt, probe);
+      var sent = producer.send(new ProducerRecord<>(source, 0, "", invalidInput)).get(30, TimeUnit.SECONDS);
+      lifecycle.recordDltSend(probe, sent.partition(), sent.offset());
+      Awaitility.await().atMost(Duration.ofSeconds(60)).until(() -> {
+        for (var record : consumer.poll(Duration.ofMillis(200))) {
+          if (invalidInput.equals(record.value())) {
+            assertEquals("", record.key());
+            // Wire names verified from Playmaker's resolved spring-kafka4.1.1 KafkaHeaders constants.
+            var original = record.headers().lastHeader("kafka_dlt-original-topic");
+            assertNotNull(original, "The real listener recoverer must preserve original transport metadata");
+            assertEquals(source, new String(original.value(), StandardCharsets.UTF_8));
+            assertNotNull(record.headers().lastHeader("kafka_dlt-exception-fqcn"));
+            observed.set(true);
+          }
+        }
+        return observed.get();
+      });
+      assertTrue(sent.offset() >= 0);
+    }
+    } catch (Exception | AssertionError bodyFailure) {
+      failure = bodyFailure;
+      if (lifecycle != null) {
+        try { lifecycle.markUnknown("DLT_BODY_OUTCOME_UNVERIFIED"); }
+        catch (Exception journalFailure) { failure.addSuppressed(journalFailure); }
+      } else if (fixture != null) {
+        try { fixture.retainUnverifiedPlaymakerWork(); }
+        catch (Exception journalFailure) { failure.addSuppressed(journalFailure); }
+      }
+    } finally {
+      boolean clean = false;
+      if (lifecycle != null) {
+        try {
+          lifecycle.stopAndReap(Duration.ofSeconds(30));
+          lifecycle.verifyStoppedOffsetsAndAbsenceInputs(OwnedPlaymakerDatabase::assertRunOwnedPmSessionsAbsent);
+          lifecycle.cleanupPermit();
+          lifecycle.verifyCleanupAbsence();
+          clean = true;
+        } catch (Exception | AssertionError cleanupFailure) {
+          failure = addFailure(failure, cleanupFailure);
+          try { lifecycle.markUnknown("DLT_CLEANUP_UNVERIFIED"); }
+          catch (Exception journalFailure) { failure = addFailure(failure, journalFailure); }
+        }
+      } else if (fixture != null) {
+        try { fixture.retainUnverifiedPlaymakerWork(); }
+        catch (Exception journalFailure) { failure = addFailure(failure, journalFailure); }
+      }
+      for (AutoCloseable client : new AutoCloseable[] {fixture, cpKvs}) {
+        if (client != null) {
+          try { client.close(); }
+          catch (Exception | AssertionError closeFailure) { clean = false; failure = addFailure(failure, closeFailure); }
+        }
+      }
+      if (lifecycle != null) {
+        if (clean && failure == null) {
+          try { lifecycle.recordClientsClosed(); lifecycle.finishVerifiedCleanup(); }
+          catch (Exception | AssertionError retirementFailure) { failure = addFailure(failure, retirementFailure); }
+        } else {
+          try { lifecycle.markUnknown("DLT_CLIENT_OR_BODY_UNVERIFIED"); }
+          catch (Exception journalFailure) { failure = addFailure(failure, journalFailure); }
+        }
+        try { lifecycle.close(); } catch (Exception closeFailure) { failure = addFailure(failure, closeFailure); }
+      }
+    }
+    if (failure instanceof Error error) { throw error; }
+    if (failure instanceof Exception error) { throw error; }
+    Path directory = Path.of(System.getenv().getOrDefault("E2E_EVIDENCE_DIR", "build/e2e-evidence"));
+    Files.createDirectories(directory);
+    Files.writeString(directory.resolve("PM-DLT-" + family + ".json"), mapper.writeValueAsString(Map.of(
+        "run_id", run, "scenario", "PM-DLT-" + family, "source_topic", source, "dlt_topic", dlt,
+        "input", "NEUTRAL_INVALID_REQUIRED_FIELDS", "actual_payload_and_headers_verified", observed.get(),
+        "status", "PASS", "cleanup", "OWN_PM_REAP_CP_BRIDGE_REAL_RESULT_OFFSETS_VERIFIED",
+        "scope", "Playmaker local Kafka result DLT only")));
+  }
+
+  private static Throwable addFailure(Throwable first, Throwable next) {
+    if (first == null) { return next; }
+    first.addSuppressed(next);
+    return first;
+  }
+}
