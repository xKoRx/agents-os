@@ -0,0 +1,83 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.faults;
+
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.apache.kafka.clients.admin.Admin;
+import org.apache.kafka.clients.admin.AdminClientConfig;
+import org.awaitility.Awaitility;
+
+/** Stops exactly two run-owned combined brokers while retaining the three-controller quorum. */
+public final class OwnedKafkaFaults implements AutoCloseable {
+  private final OwnedCompose compose;
+  private final Admin admin;
+  private boolean hasReducedBrokers;
+
+  private OwnedKafkaFaults(OwnedCompose compose, Admin admin) {
+    this.compose = compose;
+    this.admin = admin;
+  }
+
+  /** Opens control for the launcher's exact five-broker project, validating ownership before mutation. */
+  public static OwnedKafkaFaults open() throws Exception {
+    final OwnedCompose compose = new OwnedCompose(System.getenv("DOCKER_CONTEXT"), System.getenv("E2E_COMPOSE_PROJECT"),
+        System.getenv("E2E_RUN_ID"), Path.of(requireExport("E2E_COMPOSE_FILE")), Path.of(requireExport("E2E_ENV_FILE")));
+    for (String broker : List.of("broker1", "broker2", "broker3", "broker4", "broker5")) {
+      compose.requireOwnedService(broker);
+    }
+    final String bootstrap = requireExport("E2E_BOOTSTRAP_SERVERS");
+    final String expectedBootstrap = "127.0.0.1:" + requireExport("E2E_KAFKA_PORT_1");
+    if (!bootstrap.equals(expectedBootstrap)) {
+      throw new IllegalStateException("OWNED_KAFKA_LOOPBACK_BOOTSTRAP_REQUIRED");
+    }
+    final Admin admin = Admin.create(Map.of(AdminClientConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap,
+        AdminClientConfig.DEFAULT_API_TIMEOUT_MS_CONFIG, 15000));
+    return new OwnedKafkaFaults(compose, admin);
+  }
+
+  /** Reduces live brokers to three; the test must independently prove an RF4/5 failure. */
+  public void reduceToThreeBrokers() throws Exception {
+    hasReducedBrokers = true;
+    compose.requireOwnedService("broker4");
+    compose.requireOwnedService("broker5");
+    compose.command("stop", "--timeout", "10", "broker4", "broker5");
+    awaitBrokers(3);
+  }
+
+  /** Starts the same two owned containers and observes all five live Kafka nodes again. */
+  public void restoreBrokers() throws Exception {
+    if (!hasReducedBrokers) {
+      return;
+    }
+    compose.requireOwnedService("broker4");
+    compose.requireOwnedService("broker5");
+    compose.command("start", "broker4", "broker5");
+    awaitBrokers(5);
+    hasReducedBrokers = false;
+  }
+
+  private void awaitBrokers(int expected) {
+    Awaitility.await().atMost(Duration.ofSeconds(120)).pollInterval(Duration.ofSeconds(1)).until(() ->
+        admin.describeCluster().nodes().get(15, TimeUnit.SECONDS).size() == expected);
+  }
+
+  private static String requireExport(String name) {
+    final String value = System.getenv(name);
+    if (value == null || value.isBlank()) {
+      throw new IllegalStateException("OWNED_KAFKA_FAULT_EXPORT_REQUIRED: " + name);
+    }
+    return value;
+  }
+
+  /** Restores stopped brokers even when the scenario fails, then closes the real AdminClient. */
+  @Override
+  public void close() throws Exception {
+    try {
+      restoreBrokers();
+    } finally {
+      admin.close(Duration.ofSeconds(10));
+    }
+  }
+}
diff --git a/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/OwnedKafkaProtocolFaults.java b/src/realIntegrationTest/java/com/mercadolibre/rio_controlplane_kafka/reale2e/faults/OwnedKafkaProtocolFaults.java
