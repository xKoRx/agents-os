@@ -0,0 +1,195 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.support;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import tools.jackson.databind.ObjectMapper;
+import org.awaitility.Awaitility;
+
+/** Starts and terminates only a dedicated real CP child JVM using the built application jar. */
+public final class RealControlplaneProcess implements AutoCloseable {
+  private final Process child;
+  private final int port;
+  private final java.util.UUID generation;
+  private final java.time.Instant birth;
+  private boolean stopRequested;
+  private boolean forced;
+  private final HttpClient http = HttpClient.newHttpClient();
+  private final ObjectMapper mapper = new ObjectMapper();
+  private final AtomicInteger inFlightAsyncRequests = new AtomicInteger();
+  private volatile boolean reaped;
+  private RealE2eFixture owner;
+
+  private RealControlplaneProcess(Process child, int port, java.util.UUID generation) {
+    this.child = child;
+    this.port = port;
+    this.generation = generation;
+    this.birth = child.info().startInstant().orElseThrow();
+  }
+
+  /** Starts the real jar with inherited owned infrastructure exports and explicit test properties. */
+  public static RealControlplaneProcess start(String... properties) throws Exception {
+    return start(Map.of(), properties);
+  }
+
+  /** Registers this exact owned child with the fixture before it can receive any test dispatch. */
+  public static RealControlplaneProcess start(RealE2eFixture fixture, String... properties) throws Exception {
+    return start(fixture, Map.of(), properties);
+  }
+
+  /** Registers an environment-isolated child before exposing it to the test. */
+  public static RealControlplaneProcess start(RealE2eFixture fixture, Map<String, String> childEnvironment,
+      String... properties) throws Exception {
+    java.util.Objects.requireNonNull(fixture);
+    return startOwned(fixture, childEnvironment, properties);
+  }
+
+  /** Starts a child with explicit isolated endpoint overrides without printing its environment. */
+  public static RealControlplaneProcess start(Map<String, String> childEnvironment, String... properties) throws Exception {
+    return startOwned(null, childEnvironment, properties);
+  }
+
+  private static RealControlplaneProcess startOwned(RealE2eFixture fixture, Map<String, String> childEnvironment,
+      String... properties) throws Exception {
+    String jarProperty = System.getProperty("e2e.cp.jar");
+    assertTrue(jarProperty != null && !jarProperty.isBlank(), "e2e.cp.jar must identify the actual bootJar");
+    Path jar = Path.of(jarProperty).toAbsolutePath();
+    assertTrue(Files.isRegularFile(jar), "The actual CP bootJar is required; no in-process fallback is allowed");
+    int port;
+    try (ServerSocket reservation = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+      port = reservation.getLocalPort();
+    }
+    Path javaExecutable = Path.of(System.getProperty("java.home"), "bin", "java");
+    java.util.UUID generation = java.util.UUID.randomUUID();
+    List<String> command = new ArrayList<>(List.of(javaExecutable.toString(), "-Xmx512m", "-jar", jar.toString(),
+        "--spring.profiles.active=real-e2e", "--e2e.bridge.enabled=false", "--server.port=" + port,
+        "--SCOPE_SUFFIX=local"));
+    command.add("--e2e.kvs-observation.generation=" + generation);
+    command.addAll(List.of(properties));
+    ProcessBuilder builder = new ProcessBuilder(command).redirectOutput(ProcessBuilder.Redirect.DISCARD)
+        .redirectError(ProcessBuilder.Redirect.DISCARD);
+    builder.environment().putAll(childEnvironment);
+    if (fixture != null) { fixture.beforeWorkerStart(port); }
+    Process child = builder.start();
+    RealControlplaneProcess process = new RealControlplaneProcess(child, port, generation);
+    try {
+      if (fixture != null) { fixture.registerWorkerProcess(process); }
+      Awaitility.await().atMost(Duration.ofSeconds(90)).pollInterval(Duration.ofMillis(300)).until(() -> {
+        assertTrue(child.isAlive(), "Dedicated CP child exited during startup");
+        return process.ping();
+      });
+      return process;
+    } catch (Exception | AssertionError failure) {
+      try {
+        process.close();
+      } catch (Exception cleanupFailure) {
+        failure.addSuppressed(cleanupFailure);
+      }
+      throw failure;
+    }
+  }
+
+  private boolean ping() {
+    try {
+      HttpRequest request = HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + "/ping"))
+          .timeout(Duration.ofSeconds(2)).GET().build();
+      HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString());
+      return response.statusCode() == 200 && response.body().contains("pong");
+    } catch (java.io.IOException exception) {
+      return false;
+    } catch (InterruptedException exception) {
+      Thread.currentThread().interrupt();
+      throw new IllegalStateException("Interrupted while waiting for the dedicated CP process", exception);
+    }
+  }
+
+  /** Posts an actual HTTP request to this process with a bounded response deadline. */
+  public HttpResponse<String> postJson(String path, String json) throws Exception {
+    HttpRequest request = HttpRequest.newBuilder(URI.create("http://127.0.0.1:" + port + path))
+        .timeout(Duration.ofSeconds(45)).header("Content-Type", "application/json")
+        .POST(HttpRequest.BodyPublishers.ofString(json)).build();
+    boolean asynchronous = isAsyncTriggerPath(path);
+    assertTrue(owner != null, "A real child request must have an exact fixture journal owner before dispatch");
+    owner.beforeWorkerDispatch(this);
+    if (asynchronous) { inFlightAsyncRequests.incrementAndGet(); }
+    try {
+      return http.send(request, HttpResponse.BodyHandlers.ofString());
+    } finally {
+      if (asynchronous) {
+        inFlightAsyncRequests.decrementAndGet();
+      }
+    }
+  }
+
+  synchronized void attachOwner(RealE2eFixture fixture) { this.owner = java.util.Objects.requireNonNull(fixture); }
+
+  /** Minimal ownership metadata for the private reconciliation ledger; no environment or payload. */
+  public long pid() { return child.pid(); }
+
+  /** Returns this exact owned CP listener for passive cleanup observation. */
+  public int port() { return port; }
+
+  /** Explicit own-process idle or own-PID reap proof; never searches global processes or threads. */
+  public void awaitIdleOrReaped(Duration deadline) throws Exception {
+    if (reaped) {
+      assertTrue(!child.isAlive(), "A reaped owned CP child cannot still be alive");
+      return;
+    }
+    if (!child.isAlive()) {
+      assertTrue(child.waitFor(15, TimeUnit.SECONDS), "An exited owned CP child must be explicitly reaped");
+      reaped = true;
+      return;
+    }
+    Awaitility.await("all HTTP dispatch calls to the owned child must finish")
+        .atMost(deadline).until(() -> inFlightAsyncRequests.get() == 0);
+    RealWorkerCleanupGate.awaitIdle(http, mapper, port, RealE2eFixture.requiredEnv("E2E_RUN_ID"),
+        child.pid(), deadline);
+  }
+
+  private static boolean isAsyncTriggerPath(String path) {
+    return "/triggers/actions".equals(path) || "/triggers/deployments".equals(path);
+  }
+
+  /** Simulates abrupt worker loss by killing only the child created by this instance. */
+  public void crash() throws Exception {
+    assertTrue(child.isAlive(), "A real running child is required for process-loss coverage");
+    forced = true;
+    child.destroyForcibly();
+    assertTrue(child.waitFor(15, TimeUnit.SECONDS), "Dedicated crashed CP child must terminate");
+    assertEquals(false, child.isAlive());
+    reaped = true;
+    OwnedProcessExitReceipt.record(child, generation, birth, stopRequested, forced);
+  }
+
+  /** Terminates only this dedicated child, escalating to force after a bounded graceful deadline. */
+  @Override
+  public void close() throws Exception {
+    if (child.isAlive()) {
+      stopRequested = true;
+      child.destroy();
+      if (!child.waitFor(10, TimeUnit.SECONDS)) {
+        forced = true;
+        child.destroyForcibly();
+        assertTrue(child.waitFor(15, TimeUnit.SECONDS), "Dedicated CP child must be reaped");
+      }
+    }
+    assertTrue(child.waitFor(15, TimeUnit.SECONDS), "Dedicated CP child must be explicitly reaped");
+    assertTrue(!child.isAlive(), "Dedicated CP child remained alive after cleanup");
+    reaped = true;
+    OwnedProcessExitReceipt.record(child, generation, birth, stopRequested, forced);
+  }
+}
