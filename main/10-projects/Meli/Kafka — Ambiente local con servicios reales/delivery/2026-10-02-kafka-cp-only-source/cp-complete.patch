+package com.mercadolibre.rio_controlplane_kafka.cloud.gcp;
+
+import com.mercadolibre.rio_controlplane_kafka.cloud.CloudProvider;
+import com.mercadolibre.rio_controlplane_kafka.cloud.ClusterResolver;
+import com.mercadolibre.rio_controlplane_kafka.cloud.ResolutionContext;
+import com.mercadolibre.rio_controlplane_kafka.deployment.gcp.routing.GcpKafkaRoutingService;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import org.springframework.stereotype.Component;
+
+/** Resolves GCP peek actions through the same legacy DEFAULT routing used by GCP deployments. */
+@Component
+public class GcpKafkaClusterResolver implements ClusterResolver {
+  private final GcpKafkaRoutingService routingService;
+
+  /** Creates a resolver using the production cloud-provider routing service. */
+  public GcpKafkaClusterResolver(GcpKafkaRoutingService routingService) {
+    this.routingService = Objects.requireNonNull(routingService, "routingService");
+  }
+
+  @Override
+  public CloudProvider provider() {
+    return CloudProvider.GCP_KAFKA;
+  }
+
+  @Override
+  public Optional<String> resolveBootstrap(ResolutionContext context) {
+    if (context == null || !context.routingKeys().isEmpty()) {
+      return Optional.empty();
+    }
+    GcpKafkaRoutingService.Result resolved = routingService.resolve(Map.of());
+    if (resolved instanceof GcpKafkaRoutingService.Result.Success success) {
+      return Optional.of(success.routing().cluster().bootstrapServers());
+    }
+    return Optional.empty();
+  }
+}
