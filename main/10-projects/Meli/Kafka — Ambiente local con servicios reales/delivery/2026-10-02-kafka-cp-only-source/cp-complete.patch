@@ -0,0 +1,253 @@
+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.mercadolibre.rio.sdk.events.deployment.DeploymentTriggerMessage;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+
+/** PM-KAFKA-PIPELINE-CONTEXT uses only real source outputs and measures actual Kafka UTF8 bytes. */
+class PlaymakerPipelineContextE2ETest {
+  private static final int BUDGET_BYTES = 200 * 1024;
+  private static final int MAX_COPIES = 1024;
+  private static final int MAX_BATCH = 100;
+  private static final int MAX_ATTEMPTS = 12;
+  private static final int MAX_PADDING = 8192;
+  private PlaymakerPipelineFixture fixture;
+
+  @BeforeEach
+  void beginOwnedGeneration() throws Exception {
+    fixture = new PlaymakerPipelineFixture();
+  }
+
+  @AfterEach
+  void stopAuditAndCleanOwnedGeneration() throws Exception {
+    if (fixture != null) {
+      fixture.close();
+    }
+  }
+
+  @Test
+  void pipelineContextUsesActualRelatedAndImportedSlotsAndOldCpSdkOmitsContext() throws Exception {
+    var source = realPublicSource();
+    var target = fixture.topology("aws-msk-topic", true);
+    var copy = fixture.publicCopy(target.product(), source.component(), source.environment(), ownName(40));
+    assertEquals(200, fixture.connect(target, copy, false, "staging").statusCode());
+    var observed = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", false);
+    JsonNode context = observed.wire().payload().path("context");
+    assertTrue(context.isObject());
+    assertEquals(target.product().id(), context.path("data_product").path("id").asLong());
+    assertEquals(target.kafka().id(), context.path("component").path("id").asLong());
+    assertTrue(context.path("component").path("latest_version").isMissingNode()
+        || context.path("component").path("latest_version").isNull());
+    JsonNode imported = related(context, copy.id());
+    assertEquals(copy.name(), imported.path("name").asString());
+    assertFalse(imported.path("outputs").path("values").isEmpty(), "Copy must resolve outputs of the real deployed source");
+    assertOutputValues(source.outputs(), imported.path("outputs").path("values"));
+    var legacy = fixture.mapper().readValue(fixture.mapper().writeValueAsBytes(observed.wire().payload()), DeploymentTriggerMessage.class);
+    assertEquals(observed.deployment().correlation(), legacy.deploymentId().toString());
+    assertEquals(target.kafka().id(), legacy.componentId());
+    assertEquals(fixture.database().active(target.kafka()).params(), fixture.mapper().valueToTree(legacy.params()));
+    // CP's canonical SDK1.3.1 accepts the actual SDK1.5 wire without provisioning EntityService schemas.
+    var redeployed = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+    JsonNode latest = redeployed.wire().payload().path("context").path("component").path("latest_version");
+    assertEquals(observed.deployment().definitionId(), latest.path("version").asLong());
+    assertFalse(latest.path("outputs").path("values").isEmpty());
+    assertOutputValues(observed.deployment().outputs(), latest.path("outputs").path("values"));
+  }
+
+  @Test
+  void actualCandidateBelowAndExactlyAtBudgetKeepContextAndOverBudgetWarnsAndOmitsIt() throws Exception {
+    var source = realPublicSource();
+    var target = fixture.topology("aws-msk-topic", true);
+    List<OwnedPipelineDatabase.Component> copies = new ArrayList<>();
+    var under = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", false);
+    assertTrue(under.wire().payload().path("context").isObject());
+    assertTrue(under.wire().bytes() < BUDGET_BYTES);
+    // Use one real source output for all public copies, not seeded slot values or one broker topic per copy.
+    int lower = 0;
+    int upper = -1;
+    while (copies.size() < MAX_COPIES) {
+      List<Map<String, Object>> operations = new ArrayList<>();
+      int batch = Math.min(MAX_BATCH, MAX_COPIES - copies.size());
+      for (int index = 0; index < batch; index++) {
+        var copy = fixture.publicCopy(target.product(), source.component(), source.environment(), ownName(240));
+        copies.add(copy);
+        operations.add(relation(copy, target.kafka(), false));
+      }
+      assertEquals(200, fixture.relations(target.product(), operations, "staging", null).statusCode());
+      var candidate = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+      if (hasContext(candidate)) {
+        lower = copies.size();
+        under = candidate;
+        assertTrue(candidate.wire().bytes() <= BUDGET_BYTES);
+      } else {
+        assertActualTooLargeWarning(candidate);
+        upper = copies.size();
+        break;
+      }
+    }
+    assertTrue(upper > lower, "Admitted real topology must bracket the threshold or calibration fails");
+    int activeCount = upper;
+    while (upper - lower > 1) {
+      int next = lower + (upper - lower) / 2;
+      adjustRelations(target, copies, activeCount, next);
+      activeCount = next;
+      var candidate = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+      if (hasContext(candidate)) {
+        lower = next;
+        under = candidate;
+      } else {
+        assertActualTooLargeWarning(candidate);
+        upper = next;
+      }
+    }
+    adjustRelations(target, copies, activeCount, lower);
+    var nearby = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+    assertTrue(hasContext(nearby));
+    assertTrue(nearby.wire().bytes() < BUDGET_BYTES);
+    assertFalse(under.wire().payload().path("params").isMissingNode());
+    int padding = Math.max(0, (BUDGET_BYTES - nearby.wire().bytes()) / 2);
+    boolean exact = false;
+    for (int attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
+      assertTrue(padding <= MAX_PADDING, "Small admitted input bound cannot be bypassed");
+      patchPadding(target, padding);
+      var candidate = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+      if (!hasContext(candidate)) {
+        int measured = assertActualTooLargeWarning(candidate);
+        padding = Math.max(0, padding - Math.max(1, (measured - BUDGET_BYTES) / 2));
+        continue;
+      }
+      int delta = BUDGET_BYTES - candidate.wire().bytes();
+      if (delta == 0) {
+        assertTrue(candidate.wire().payload().path("context").isObject());
+        exact = true;
+        padding++;
+        break;
+      }
+      padding = Math.max(0, padding + (delta > 0 ? Math.max(1, delta / 2) : Math.min(-1, delta / 2)));
+    }
+    assertTrue(exact, "Exact204800 real UTF8 wire was not reached; bounded calibration fails, never skips");
+    patchPadding(target, padding + 16);
+    var over = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", true);
+    assertFalse(hasContext(over));
+    assertTrue(assertActualTooLargeWarning(over) > BUDGET_BYTES);
+    assertEquals(target.kafka().id(), over.wire().payload().path("component_id").asLong());
+    assertEquals(2, fixture.cp().awaitTopic(target.topic()).partitions().size());
+  }
+
+  @Test
+  void realUndeployedNeighbourSuppressesOnlyItsOutputsAndKeepsTheTopology() throws Exception {
+    var target = fixture.topology("aws-msk-topic", true);
+    var neighbour = fixture.database().seedComponent(target.product(), "aws-msk-topic", Map.of());
+    assertEquals(200, fixture.connect(target, neighbour, false, "staging").statusCode());
+    var observed = fixture.deploy(target.kafka(), target.environment(), "COMPLETED", false);
+    JsonNode context = observed.wire().payload().path("context");
+    assertTrue(context.isObject());
+    assertEquals(neighbour.id(), related(context, neighbour.id()).path("id").asLong());
+    assertEquals(0, related(context, neighbour.id()).path("outputs").path("values").size());
+    assertTrue(fixture.database().slots(neighbour).isEmpty());
+    // This legitimate NO_SLOT stimulus is not a forged RuntimeException or MEASUREMENT_FAILED claim.
+  }
+
+  private RealSource realPublicSource() throws Exception {
+    var product = fixture.database().seedProduct(true);
+    var environment = fixture.database().seedEnvironment(product, "staging");
+    String topic = fixture.cp().uniqueTopic("context_source");
+    var source = fixture.database().seedComponent(product, "aws-msk-topic", fixture.cp().paramsFor("aws-msk-topic", topic, 1, (short) 1));
+    fixture.database().seedUndeployedSlot(source, environment);
+    fixture.deploy(source, environment, "COMPLETED", false);
+    return new RealSource(source, environment, fixture.database().slots(source).getFirst().outputs());
+  }
+
+  private void adjustRelations(PlaymakerPipelineFixture.Topology target, List<OwnedPipelineDatabase.Component> copies,
+      int previous, int next) throws Exception {
+    List<Map<String, Object>> operations = new ArrayList<>();
+    for (int index = Math.min(previous, next); index < Math.max(previous, next); index++) {
+      operations.add(relation(copies.get(index), target.kafka(), next < previous));
+      if (operations.size() == MAX_BATCH) {
+        assertEquals(200, fixture.relations(target.product(), operations, "staging", null).statusCode());
+        operations = new ArrayList<>();
+      }
+    }
+    if (!operations.isEmpty()) {
+      assertEquals(200, fixture.relations(target.product(), operations, "staging", null).statusCode());
+    }
+  }
+
+  private void patchPadding(PlaymakerPipelineFixture.Topology target, int length) throws Exception {
+    assertTrue(length >= 0 && length <= MAX_PADDING);
+    Map<String, Object> params = new LinkedHashMap<>(fixture.mapper().convertValue(
+        fixture.database().active(target.kafka()).params(), Map.class));
+    params.put("e2e_context_padding", "x".repeat(length));
+    assertEquals(200, fixture.config(target.kafka(), target.environment(), params).statusCode());
+    assertEquals(length, fixture.database().active(target.kafka()).params().path("e2e_context_padding").asString().length());
+    assertTrue(fixture.database().number("SELECT OCTET_LENGTH(parameters) FROM component_definition WHERE id=?",
+        fixture.database().active(target.kafka()).id()) <= 65_535);
+  }
+
+  private int assertActualTooLargeWarning(PlaymakerPipelineFixture.DeploymentObservation observed) throws Exception {
+    // Log authority comes from the verified artifact/lease receipt; arbitrary env paths cannot supply the oracle.
+    Path log = fixture.lifecycle().privateLogPath();
+    if (!Files.isRegularFile(log) || Files.isSymbolicLink(log)) {
+      throw new IllegalStateException("ACTUAL_PM_PRIVATE_LOG_ORACLE_UNAVAILABLE");
+    }
+    String id = observed.deployment().correlation();
+    Pattern warning = Pattern.compile("Component context discarded from BQ trigger[^\n]*deploymentId=" + Pattern.quote(id)
+        + "[^\n]*messageSizeBytes=([0-9]+)[^\n]*limitBytes=" + BUDGET_BYTES);
+    var match = warning.matcher(Files.readString(log));
+    assertTrue(match.find(), "Actual product TOO_LARGE warning for the exact correlation is required");
+    int bytes = Integer.parseInt(match.group(1));
+    assertTrue(bytes > BUDGET_BYTES);
+    assertFalse(match.find(), "Exactly one correlated discard event");
+    return bytes;
+  }
+
+  private static boolean hasContext(PlaymakerPipelineFixture.DeploymentObservation observed) {
+    return observed.wire().payload().path("context").isObject();
+  }
+
+  private static JsonNode related(JsonNode context, long id) {
+    for (JsonNode node : context.path("sources")) {
+      if (node.path("id").asLong() == id) {
