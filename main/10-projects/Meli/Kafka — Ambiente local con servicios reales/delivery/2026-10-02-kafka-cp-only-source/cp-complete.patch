+    assertEquals(1, state.path("schema").asInt());
+    assertEquals(runId(), state.path("run_id").asString());
+    assertEquals("OWNED_CONFIG_GENERATED_NOT_KVS_CERTIFIED", state.path("status").asString());
+    JsonNode cp = null;
+    for (JsonNode resource : state.path("resources")) {
+      if ("rio-controlplane-kafka".equals(resource.path("app").asString())) {
+        assertEquals(null, cp, "Receipt must contain one CP resource");
+        cp = resource;
+      }
+    }
+    assertNotNull(cp);
+    assertTrue(cp.path("create_intent").asBoolean() && cp.path("ownership_verified").asBoolean());
+    assertEquals("e2e-" + runId(), cp.path("bc").asString());
+    assertEquals(RealE2eFixture.requiredEnv("E2E_SANDBOX_BC"), cp.path("bc").asString());
+    assertEquals(RealE2eFixture.requiredEnv("E2E_SANDBOX_INSTANCE"), cp.path("instance").asString());
+    String alias = RealE2eFixture.requiredEnv("E2E_KVS_CONTAINER_NAME");
+    assertEquals(1, cp.path("logical_services").size());
+    assertEquals(alias, cp.path("logical_services").get(0).asString());
+    RealE2eKvsClientFactory.requireSandboxMapping(alias);
+
+    // Recheck fresh server metadata and consumed exports; a receipt/flag alone proves no ownership.
+    Path script = Path.of("e2e", "sandbox.py").toAbsolutePath();
+    Path compose = Path.of(RealE2eFixture.requiredEnv("E2E_COMPOSE_FILE"));
+    assertTrue(Files.isRegularFile(script) && compose.isAbsolute());
+    assertTrue(Files.isSameFile(script, compose.getParent().resolve("sandbox.py")),
+        "Verification must use this repository's actual Sandbox lifecycle helper");
+    Process verifier = new ProcessBuilder(RealE2eFixture.requiredEnv("E2E_FURY_PYTHON"), script.toString(),
+        "verify", "--directory", receipt.getParent().toString())
+        .redirectOutput(ProcessBuilder.Redirect.DISCARD).redirectError(ProcessBuilder.Redirect.DISCARD).start();
+    try {
+      assertTrue(verifier.waitFor(90, TimeUnit.SECONDS), "Fresh Sandbox ownership verification must finish");
+      assertEquals(0, verifier.exitValue(), "Fresh Sandbox metadata/export verification is mandatory before global-shaped keys");
+    } finally {
+      if (verifier.isAlive()) {
+        verifier.destroyForcibly();
+        assertTrue(verifier.waitFor(15, TimeUnit.SECONDS), "Owned Sandbox verifier must be reaped");
+      }
+    }
+  }
