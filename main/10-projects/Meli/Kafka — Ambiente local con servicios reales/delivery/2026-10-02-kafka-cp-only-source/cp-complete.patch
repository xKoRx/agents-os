+package com.mercadolibre.rio_controlplane_kafka.reale2e.playmaker;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import org.apache.kafka.clients.consumer.ConsumerConfig;
+import org.apache.kafka.clients.consumer.KafkaConsumer;
+import org.apache.kafka.common.TopicPartition;
+import org.apache.kafka.common.serialization.ByteArrayDeserializer;
+import org.awaitility.Awaitility;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/** Passive full-partition observer of actual SDK1.5 trigger bytes, positioned before HTTP dispatch. */
+final class PlaymakerDeploymentWireObserver implements AutoCloseable {
+  private static final Duration DEADLINE = Duration.ofSeconds(90);
+  private final KafkaConsumer<byte[], byte[]> consumer;
+  private final JsonMapper mapper;
+  private final List<Wire> records = new ArrayList<>();
+  private final List<TopicPartition> partitions;
+
+  PlaymakerDeploymentWireObserver(JsonMapper mapper) {
+    this.mapper = mapper;
+    Map<String, Object> properties = new HashMap<>();
+    properties.put(ConsumerConfig.BOOTSTRAP_SERVERS_CONFIG, OwnedPipelineDatabase.required("E2E_BOOTSTRAP_SERVERS"));
+    properties.put(ConsumerConfig.GROUP_ID_CONFIG, "e2e_" + OwnedPipelineDatabase.required("E2E_RUN_ID")
+        + "_pipeline_wire_" + UUID.randomUUID());
+    properties.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
+    properties.put(ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG, ByteArrayDeserializer.class);
+    properties.put(ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG, ByteArrayDeserializer.class);
+    consumer = new KafkaConsumer<>(properties);
+    List<TopicPartition> observed = new ArrayList<>();
+    for (String name : List.of("E2E_DEPLOYMENT_TRIGGER_TOPIC", "E2E_ACTION_TRIGGER_TOPIC")) {
+      String topic = OwnedPipelineDatabase.required(name);
+      consumer.partitionsFor(topic, DEADLINE).forEach(partition -> observed.add(new TopicPartition(topic, partition.partition())));
+    }
+    partitions = List.copyOf(observed);
+    consumer.assign(partitions);
+    consumer.endOffsets(partitions).forEach(consumer::seek);
+  }
+
+  void poll() throws Exception {
+    for (var record : consumer.poll(Duration.ofMillis(200))) {
+      JsonNode payload = mapper.readTree(record.value());
+      records.add(new Wire(record.topic(), record.partition(), record.offset(),
+          record.key() == null ? "" : new String(record.key(), StandardCharsets.UTF_8),
+          record.value().length, payload));
+    }
+  }
+
+  Wire await(String correlation) {
+    Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+      poll();
+      assertEquals(1, forCorrelation(correlation).size(), "One actual trigger must match the persisted correlation");
+    });
+    return forCorrelation(correlation).getFirst();
+  }
+
+  List<Wire> forCorrelation(String correlation) {
+    return records.stream().filter(wire -> correlation.equals(wire.payload().path("deployment_id").asString())
+        || correlation.equals(wire.payload().path("action_id").asString())).toList();
+  }
+
+  int count() throws Exception {
+    poll();
+    return records.size();
+  }
+
+  void assertNoDelta(int baseline) throws Exception {
+    catchUp();
+    assertEquals(baseline, records.size(), "Configuration/auth rejection must not dispatch a trigger");
+  }
+
+  void auditAll(List<String> deploymentIds, List<String> actionIds) throws Exception {
+    catchUp();
+    List<Wire> deploymentWires = records.stream().filter(wire -> wire.payload().has("deployment_id")).toList();
+    assertEquals(deploymentIds.size(), deploymentWires.size(), "Audit every correlation after stopping the producer");
+    assertEquals(deploymentIds.size() + actionIds.size(), records.size(), "No unregistered action/trigger may be emitted");
+    for (String id : actionIds) {
+      assertEquals(1, forCorrelation(id).size());
+      assertEquals(id, forCorrelation(id).getFirst().key());
+    }
+    for (String id : deploymentIds) {
+      assertEquals(1, forCorrelation(id).size(), "No duplicate or missing trigger after final barrier");
+      assertEquals(id, forCorrelation(id).getFirst().key());
+    }
+  }
+
+  private void catchUp() {
+    Map<TopicPartition, Long> ends = consumer.endOffsets(partitions);
+    Awaitility.await().atMost(DEADLINE).untilAsserted(() -> {
+      poll();
+      assertTrue(ends.entrySet().stream().allMatch(entry -> consumer.position(entry.getKey()) >= entry.getValue()));
+    });
+  }
+
+  @Override
+  public void close() {
+    consumer.close(DEADLINE);
+  }
+
+  record Wire(String topic, int partition, long offset, String key, int bytes, JsonNode payload) { }
+}
