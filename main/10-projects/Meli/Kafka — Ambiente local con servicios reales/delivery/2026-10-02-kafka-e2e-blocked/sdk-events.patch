+package com.mercadolibre.rio.sdk.events.bigqueue.impl;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import com.mercadolibre.mqclient.config.BufferingConfiguration;
+import com.mercadolibre.mqclient.config.MQConfiguration;
+import com.mercadolibre.mqclient.producer.Producer;
+import com.mercadolibre.mqclient.producer.ProducerBuilder;
+import com.mercadolibre.rio.sdk.events.bigqueue.BigQueueTopicProperties;
+import java.time.Duration;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.mockito.Answers;
+import org.mockito.ArgumentCaptor;
+
+/** Unit regression for the configured builder being discarded; does not certify BigQueue delivery. */
+class BigQueueProducerOptionsRegressionTest {
+  @Test
+  void segmentReachesTheProducerUsedForSending() throws Exception {
+    verifyUsedBuilder("unit-segment", false);
+  }
+
+  @Test
+  void bufferingReachesTheProducerUsedForSending() throws Exception {
+    verifyUsedBuilder(null, true);
+  }
+
+  @Test
+  void segmentAndBufferingAreAppliedTogether() throws Exception {
+    verifyUsedBuilder("unit-segment", true);
+  }
+
+  @Test
+  void legacyFactoryMethodStillBuildsTopicAndConfiguration() {
+    ProducerBuilder builder = mock(ProducerBuilder.class, Answers.RETURNS_SELF);
+    Producer producer = mock(Producer.class);
+    when(builder.build()).thenReturn(producer);
+    MQConfiguration config = MQConfiguration.builder().build();
+    try (var staticBuilder = mockStatic(Producer.class)) {
+      staticBuilder.when(Producer::builder).thenReturn(builder);
+      assertEquals(producer, new ProducerFactory().createProducer("unit-topic", config));
+      verify(builder).withTopic("unit-topic");
+      verify(builder).withConfig(config);
+      verify(builder).build();
+    }
+  }
+
+  private void verifyUsedBuilder(String segment, boolean buffering) throws Exception {
+    ProducerBuilder configured = mock(ProducerBuilder.class, Answers.RETURNS_SELF);
+    ProducerBuilder discardedOptions = mock(ProducerBuilder.class, Answers.RETURNS_SELF);
+    Producer selectedProducer = mock(Producer.class);
+    Producer otherProducer = mock(Producer.class);
+    when(configured.build()).thenReturn(selectedProducer);
+    when(discardedOptions.build()).thenReturn(otherProducer);
+    byte[] actualProducerMarker = new byte[] {1, 2, 3};
+    Map<String, String> input = Map.of("probe", "unit-fixture");
+    when(selectedProducer.send(input)).thenReturn(actualProducerMarker);
+    var properties = new BigQueueTopicProperties("unit", "unit-topic", "Unit regression", segment,
+        1_000, 1_000, 2, 2, 0, 1, buffering, 17, 250);
+    try (var staticBuilder = mockStatic(Producer.class)) {
+      // Different builders make the old discard observable; returning one mock twice would hide it.
+      staticBuilder.when(Producer::builder).thenReturn(configured, discardedOptions);
+      BigQueueClientImpl client = new BigQueueClientImpl(new ProducerFactory(), properties);
+      assertArrayEquals(actualProducerMarker, client.send(input));
+      verify(configured).withTopic("unit-topic");
+      verify(configured).withConfig(any(MQConfiguration.class));
+      verify(configured).build();
+      verify(discardedOptions, never()).build();
+      if (segment != null) {
+        verify(configured).withSegmentID(segment);
+      } else {
+        verify(configured, never()).withSegmentID(anyString());
+      }
+      if (buffering) {
+        ArgumentCaptor<BufferingConfiguration> config = ArgumentCaptor.forClass(BufferingConfiguration.class);
+        verify(configured).withBuffering(config.capture());
+        assertEquals(17, config.getValue().getBufferSize());
+        assertEquals(Duration.ofMillis(250), config.getValue().getAutoFlushPeriod());
+      } else {
+        verify(configured, never()).withBuffering(any(BufferingConfiguration.class));
+      }
+    }
+  }
+}
