+package com.mercadolibre.rio.playmaker.localintegration;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.mercadolibre.rio.playmaker.service.ActionResultConsumerService;
+import com.mercadolibre.rio.sdk.events.actions.ActionResultMessage;
+import org.springframework.context.annotation.Profile;
+import org.springframework.kafka.annotation.KafkaListener;
+import org.springframework.stereotype.Component;
+
+/** Feeds actual CP results into the production action result/KVS state machine. */
+@Component
+@Profile("local & local-integration & real-e2e")
+public class LocalKafkaActionResultListener {
+  private final ObjectMapper mapper;
+  private final ActionResultConsumerService consumer;
+
+  /** Creates a listener for raw SDK result JSON. */
+  public LocalKafkaActionResultListener(ObjectMapper mapper, ActionResultConsumerService consumer) {
+    this.mapper = mapper;
+    this.consumer = consumer;
+  }
+
+  /** Rejects invalid payloads before invoking the production result consumer. */
+  @KafkaListener(topics = "${local.integration.kafka.action-result-topic}",
+      groupId = "${spring.kafka.consumer.group-id}",
+      containerFactory = "localKafkaActionListenerContainerFactory")
+  public void consume(String payload) {
+    if (payload == null || payload.isBlank() || payload.length() > 262_144) {
+      throw new InvalidLocalActionResultException();
+    }
+    try {
+      ActionResultMessage result = mapper.readValue(payload, ActionResultMessage.class);
+      if (result == null || result.actionId() == null || result.actionId().isBlank()
+          || result.status() == null) {
+        throw new InvalidLocalActionResultException();
+      }
+      consumer.consumeActionResult(result);
+    } catch (JsonProcessingException exception) {
+      throw new InvalidLocalActionResultException();
+    }
+  }
+
+  /** A stable diagnostic that never carries the rejected broker payload. */
+  public static final class InvalidLocalActionResultException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+
+    InvalidLocalActionResultException() {
+      super("Invalid real E2E action result");
+    }
+  }
+}
