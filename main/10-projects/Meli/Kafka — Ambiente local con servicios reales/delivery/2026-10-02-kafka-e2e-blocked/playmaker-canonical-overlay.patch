+# Activate with local,local-integration,real-e2e. All targets belong to this isolated run.
+server:
+  address: 127.0.0.1
+spring:
+  kafka:
+    bootstrap-servers: ${E2E_BOOTSTRAP_SERVERS}
+    consumer:
+      group-id: e2e_${E2E_RUN_ID}_playmaker_results
+e2e:
+  run-id: ${E2E_RUN_ID}
+  source-commit: ${E2E_PLAYMAKER_SOURCE_COMMIT}
+  source-manifest-sha256: ${E2E_PLAYMAKER_SOURCE_MANIFEST_SHA256}
+  kvs-observation:
+    directory: ${E2E_KVS_OBSERVATION_DIR}
+app:
+  actionsFramework:
+    enabled: true
+  entityServiceClient:
+    base-url: ${E2E_ENTITY_SERVICE_BASE_URL}
+  kafkaControlPlaneClient:
+    base-url: ${E2E_CP_BASE_URL}
+    msk-brokers-url: ${E2E_BOOTSTRAP_SERVERS}
+kvs:
+  action-results-container: ${E2E_PLAYMAKER_ACTION_RESULTS_CONTAINER}
+  action-lock-container: ${E2E_PLAYMAKER_ACTION_LOCKS_CONTAINER}
+  segment: ${E2E_PLAYMAKER_KVS_SEGMENT_ID:}
+local:
+  integration:
+    kafka:
+      deployment-trigger-topic: ${E2E_DEPLOYMENT_TRIGGER_TOPIC}
+      deployment-result-topic: ${E2E_DEPLOYMENT_RESULT_TOPIC}
+      deployment-result-dlt-topic: ${E2E_DEPLOYMENT_RESULT_DLT_TOPIC}
+      action-trigger-topic: ${E2E_ACTION_TRIGGER_TOPIC}
+      action-result-topic: ${E2E_ACTION_RESULT_TOPIC}
+      action-result-dlt-topic: ${E2E_ACTION_RESULT_DLT_TOPIC}
+controlplane:
+  deployment-routing:
+    routes:
+      - componentType: aws-msk-topic
+        version: "*"
+        transport: BIG_QUEUE
+      - componentType: kafka-topic
+        version: "*"
+        transport: BIG_QUEUE
+      - componentType: gcp-kafka-topic
+        version: "*"
+        transport: BIG_QUEUE
