+++ b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2ePlaymakerConfiguration.java
@@ -0,0 +1,157 @@
+package com.mercadolibre.rio.playmaker.localintegration;
+
+import com.mercadolibre.tiger.java.helper.TigerTokenValidation;
+import com.mercadolibre.rio.playmaker.restclient.EntityServiceClient;
+import com.mercadolibre.rio.playmaker.restclient.impl.EntityServiceClientImpl;
+import com.fury.toolkit.kvs.Item;
+import com.fury.toolkit.kvs.KvsClient;
+import com.fury.toolkit.kvs.KvsClientException;
+import com.fury.toolkit.shared.SegmentationUtils;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Locale;
+import java.util.UUID;
+import org.springframework.beans.factory.SmartInitializingSingleton;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Profile;
+import org.springframework.core.env.Environment;
+import org.springframework.core.env.Profiles;
+
+/** Requires dedicated Fury Sandbox clients and proves actual read/write/delete connectivity. */
+@Configuration
+@Profile("real-e2e")
+public class RealE2ePlaymakerConfiguration {
+
+  /** Builds the official Toolkit client using the generated sandbox configuration. */
+  @Bean(name = "actionResultKvsClient", destroyMethod = "close")
+  public KvsClient actionResultKvsClient(
+      @Value("${kvs.action-results-container}") String container,
+      @Value("${kvs.segment:}") String segment) {
+    return createClient(container, segment);
+  }
+
+  /** Builds the separate official Toolkit client for atomic action locks. */
+  @Bean(name = "actionLockKvsClient", destroyMethod = "close")
+  public KvsClient actionLockKvsClient(
+      @Value("${kvs.action-lock-container}") String container,
+      @Value("${kvs.segment:}") String segment) {
+    return createClient(container, segment);
+  }
+
+  private static KvsClient createClient(String container, String segment) {
+    requireIsolatedArtifactRoot();
+    sandboxContainer(container, segment);
+    var builder = KvsClient.builder(container).withTimeout(3_000).withConnectionTimeout(3_000);
+    if (!segment.isBlank()) {
+      builder = builder.withSegmentId(segment);
+    }
+    return builder.build();
+  }
+
+  /** Fails startup before requests are accepted when profiles, targets or real KVS are unavailable. */
+  @Bean
+  public SmartInitializingSingleton realE2ePlaymakerPreflight(Environment environment,
+      @Qualifier("realE2eOwnedProcessLeaseValidated")
+      RealE2eOwnedProcessLeaseVerifier.VerifiedLease lease,
+      TigerTokenValidation tiger, EntityServiceClient entityService,
+      @Qualifier("actionResultKvsClient") KvsClient results,
+      @Qualifier("actionLockKvsClient") KvsClient locks,
+      @Value("${kvs.action-results-container}") String resultsAlias,
+      @Value("${kvs.action-lock-container}") String locksAlias,
+      @Value("${kvs.segment:}") String segment) {
+    return () -> {
+      if (tiger.getClass() != TigerTokenValidation.class
+          || !(entityService instanceof EntityServiceClientImpl)) {
+        throw new IllegalStateException("REAL_E2E_PRODUCTIVE_AUTH_ENTITY_CLIENTS_REQUIRED");
+      }
+      if (!environment.acceptsProfiles(Profiles.of("local & local-integration"))) {
+        throw new IllegalStateException("REAL_E2E_REQUIRES_LOCAL_AND_LOCAL_INTEGRATION");
+      }
+      String runId = environment.getRequiredProperty("e2e.run-id");
+      if (!runId.equals(lease.runId())) {
+        throw new IllegalStateException("REAL_E2E_PLAYMAKER_LEASE_RUN_MISMATCH");
+      }
+      if (!runId.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+        throw new IllegalStateException("REAL_E2E_INVALID_RUN_ID");
+      }
+      String baseUrl = environment.getRequiredProperty("app.kafkaControlPlaneClient.base-url");
+      if (!baseUrl.matches("http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}")) {
+        throw new IllegalStateException("REAL_E2E_CP_MUST_BE_LOOPBACK");
+      }
+      for (String suffix : new String[] {"deployment-trigger-topic", "deployment-result-topic",
+          "deployment-result-dlt-topic", "action-trigger-topic", "action-result-topic",
+          "action-result-dlt-topic"}) {
+        String topic = environment.getRequiredProperty("local.integration.kafka." + suffix);
+        if (!topic.startsWith("e2e_" + runId + "_") || !topic.matches("[a-zA-Z0-9_-]{1,200}")) {
+          throw new IllegalStateException("REAL_E2E_TOPIC_MUST_BELONG_TO_RUN");
+        }
+      }
+      if (sandboxContainer(resultsAlias, segment).equals(sandboxContainer(locksAlias, segment))) {
+        throw new IllegalStateException("REAL_E2E_RESULTS_AND_LOCKS_REQUIRE_DISTINCT_CONTAINERS");
+      }
+      probe(results, runId);
+      probe(locks, runId);
+    };
+  }
+
+  private static String sandboxContainer(String alias, String segment) {
+    if (alias == null || !alias.matches("[a-zA-Z0-9_.-]{1,200}")
+        || !segment.matches("[a-zA-Z0-9_-]{0,64}")) {
+      throw new IllegalStateException("REAL_E2E_INVALID_SANDBOX_ALIAS");
+    }
+    String normalized = alias.split("__", 2)[0].replace('-', '_').replace('.', '_')
+        .toUpperCase(Locale.ROOT);
+    String base = "KEY_VALUE_STORE_" + normalized;
+    String effectiveSegment = segment.isBlank() ? SegmentationUtils.getSegmentId() : segment;
+    String versionPrefix = SegmentationUtils.isDefaultSegment(effectiveSegment)
+        ? base : base + "_" + effectiveSegment.toUpperCase(Locale.ROOT);
+    String mappingPrefix = "v2".equals(System.getenv(versionPrefix + "_SEGMENTATION_VERSION"))
+        ? base + "_" + effectiveSegment.toUpperCase(Locale.ROOT) : base;
+    String key = mappingPrefix + "_CONTAINER_NAME";
+    String physical = System.getenv(key);
+    if (physical == null || !physical.matches("sbox[a-zA-Z0-9_-]+")) {
+      throw new IllegalStateException("REAL_E2E_REQUIRES_GENERATED_FURY_SANDBOX_MAPPING");
+    }
+    return physical;
+  }
+
+  private static void requireIsolatedArtifactRoot() {
+    String root = System.getenv("ARTIFACT_DELIVERY_FILE_PREFIX");
+    if (root == null || !Path.of(root).isAbsolute() || !Files.isDirectory(Path.of(root))) {
+      throw new IllegalStateException("REAL_E2E_ISOLATED_ARTIFACT_ROOT_REQUIRED");
+    }
+    try (var entries = Files.list(Path.of(root))) {
+      if (entries.findAny().isPresent()) {
+        throw new IllegalStateException("REAL_E2E_ARTIFACT_ROOT_MUST_BE_EMPTY");
+      }
+    } catch (IOException exception) {
+      throw new IllegalStateException("REAL_E2E_ARTIFACT_ROOT_UNAVAILABLE");
+    }
+  }
+
+  private static void probe(KvsClient client, String runId) {
+    String key = "e2e:" + runId + ":preflight:" + UUID.randomUUID();
+    byte[] value = UUID.randomUUID().toString().getBytes(StandardCharsets.UTF_8);
+    try {
+      client.save(new Item<>(key, value, 60));
+      Item<byte[]> read = client.get(key);
+      if (read == null || !Arrays.equals(value, read.getValue())) {
+        throw new IllegalStateException("REAL_E2E_KVS_READBACK_FAILED");
+      }
+    } catch (KvsClientException | RuntimeException exception) {
+      throw new IllegalStateException("REAL_E2E_PLAYMAKER_KVS_UNAVAILABLE");
+    } finally {
+      try {
+        client.delete(key);
+      } catch (KvsClientException | RuntimeException exception) {
+        throw new IllegalStateException("REAL_E2E_PLAYMAKER_KVS_PROBE_CLEANUP_FAILED");
+      }
+    }
+  }
+}
