+/** Observes exact productive Toolkit invocations without changing their backend or serialized inputs. */
+public final class RealE2eObservedKvsClient implements KvsClient {
+  private static final String UNVERIFIED = "REAL_E2E_KVS_MUTATION_OBSERVATION_UNVERIFIED";
+  private static final int MAX_CAUSE_DEPTH = 16;
