@@ -0,0 +1,38 @@
+package com.mercadolibre.rio.playmaker.localintegration;
+
+import org.apache.kafka.common.TopicPartition;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Profile;
+import org.springframework.kafka.config.ConcurrentKafkaListenerContainerFactory;
+import org.springframework.kafka.core.ConsumerFactory;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.ContainerProperties;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
+import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.util.backoff.FixedBackOff;
+
+/** Gives action results their own bounded retry/DLT policy without replacing deployment handling. */
+@Configuration
+@Profile("local & local-integration & real-e2e")
+public class RealE2eActionKafkaConfiguration {
+
+  /** Creates an action-only listener factory that commits each successfully consumed record. */
+  @Bean("localKafkaActionListenerContainerFactory")
+  public ConcurrentKafkaListenerContainerFactory<String, String> actionListenerFactory(
+      ConsumerFactory<String, String> consumerFactory, KafkaTemplate<String, String> kafka,
+      @Value("${local.integration.kafka.action-result-dlt-topic}") String deadLetterTopic) {
+    var recoverer = new DeadLetterPublishingRecoverer(kafka,
+        (record, exception) -> new TopicPartition(deadLetterTopic, 0));
+    recoverer.setFailIfSendResultIsError(true);
+    var handler = new DefaultErrorHandler(recoverer, new FixedBackOff(1_000, 2));
+    handler.addNotRetryableExceptions(
+        LocalKafkaActionResultListener.InvalidLocalActionResultException.class);
+    var factory = new ConcurrentKafkaListenerContainerFactory<String, String>();
+    factory.setConsumerFactory(consumerFactory);
+    factory.getContainerProperties().setAckMode(ContainerProperties.AckMode.RECORD);
+    factory.setCommonErrorHandler(handler);
+    return factory;
+  }
+}
diff --git a/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eKvsMutationJournal.java b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eKvsMutationJournal.java
new file mode 100644
index 000000000..801a4fe8d
--- /dev/null
+++ b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eKvsMutationJournal.java
@@ -0,0 +1,466 @@
+package com.mercadolibre.rio.playmaker.localintegration;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HexFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Durable, nonsecret observation of calls to one productive Toolkit client in one JVM generation. */
+public final class RealE2eKvsMutationJournal {
+  private static final int SCHEMA_VERSION = 1;
+  private static final int MAX_ORIGIN_LENGTH = 4096;
+  private static final String PRIVATE_FILE = "rw-------";
+  private static final String PRIVATE_DIRECTORY = "rwx------";
+  private static final String INVALID_JOURNAL = "REAL_E2E_KVS_MUTATION_JOURNAL_UNVERIFIED";
+  private final Path directory;
+  private final Path receiptPath;
+  private final Identity identity;
+  private final UUID receiptId = UUID.randomUUID();
+  private final Object directoryKey;
+  private final String owner;
+  private final Map<String, Long> attemptCounts = new LinkedHashMap<>();
+  private final Map<String, Long> completionCounts = new LinkedHashMap<>();
+  private final Map<Long, Ticket> pending = new LinkedHashMap<>();
+  private final List<String> unknownReasons = new ArrayList<>();
+  private Object receiptKey;
+  private String receiptDigest;
+  private Map<String, Object> lastDurableSnapshot;
+  private Map<String, Object> lastEvent = Map.of("type", "OPEN");
+  private long sequence;
+  private long attempts;
+  private long completed;
+  private long rejected;
+  private String phase = "OPEN";
+  private boolean healthy = true;
+  private boolean closeStarted;
+  private boolean delegateClosed;
+
+  /** The five mutating API families; UPDATE preserves the caller's real CAS version. */
+  public enum Mutation { SAVE, UPDATE, DELETE, BATCH_WRITE, BULK_WRITE }
+
+  /** Identifies the exact synchronous or asynchronous API entry, without rewriting its route. */
+  public enum CallKind { SYNC, ASYNC }
+
+  /** Safe completion categories, never SDK error messages or stored values. */
+  public enum Outcome { SUCCESS, BACKEND_REJECTED, REMOTE_OUTCOME_UNKNOWN, CANCELLED, PARTIAL_ERROR }
+
+  /** Fixed reasons why a receipt cannot certify absence of mutations. */
+  public enum Reason {
+    PERSISTENCE_FAILURE, CANCELLED, NULL_FUTURE, REMOTE_OUTCOME_UNKNOWN, PARTIAL_ERROR,
+    INVALID_COMPLETION, POST_CLOSE_CALL, DELEGATE_CLOSE_FAILURE
+  }
+
+  /**
+   * Exact runtime artifact identity supplied by the profile-scoped wiring and checked by its verifier.
+   *
+   * @param version effective Toolkit version
+   * @param jarSha256 actual source jar digest
+   * @param interfaceSha256 loaded KvsClient bytecode digest
+   * @param delegateSha256 loaded productive delegate bytecode digest
+   * @param interfaceOrigin verified local code source of the interface
+   * @param delegateOrigin verified local code source of the delegate
+   * @param delegateClassName productive delegate class name
+   */
+  public record SdkIdentity(String version, String jarSha256, String interfaceSha256,
+      String delegateSha256, String interfaceOrigin, String delegateOrigin, String delegateClassName) {
+    public SdkIdentity {
+      require(version != null && version.matches("[0-9]+\\.[0-9]+\\.[0-9]+"));
+      requireDigest(jarSha256);
+      requireDigest(interfaceSha256);
+      requireDigest(delegateSha256);
+      requireOrigin(interfaceOrigin);
+      requireOrigin(delegateOrigin);
+      require("com.fury.toolkit.kvs.DefaultKvsClient".equals(delegateClassName));
+    }
+  }
+
+  /**
+   * Run, expected bean and actual JVM identity; callers cannot substitute a different process.
+   *
+   * @param runId owned run identifier
+   * @param application exact CP or PM application label
+   * @param clientName exact productive bean name
+   * @param generationId parent-planned generation UUID
+   * @param pid actual current JVM PID
+   * @param processStartInstant actual native process birth timestamp
+   * @param sdk effective artifact identity
+   */
+  public record Identity(String runId, String application, String clientName, UUID generationId,
+      long pid, String processStartInstant, SdkIdentity sdk) {
+    public Identity {
+      require(runId != null && runId.matches("[a-z0-9][a-z0-9_-]{7,63}"));
+      boolean validClient = "CP".equals(application) && "idempotencyKvsClient".equals(clientName)
+          || "PM".equals(application) && ("actionResultKvsClient".equals(clientName)
+          || "actionLockKvsClient".equals(clientName));
+      require(validClient);
+      require(generationId != null && generationId.version() == 4);
+      require(pid == ProcessHandle.current().pid());
+      String actualStart = ProcessHandle.current().info().startInstant().orElseThrow().toString();
+      require(actualStart.equals(processStartInstant));
+      require(sdk != null);
+    }
+  }
+
+  /** A single already-durable invocation, with no reference to its key, item or future value. */
+  public record Ticket(long sequence, Mutation mutation, CallKind callKind) {
+    public Ticket {
+      require(sequence > 0 && mutation != null && callKind != null);
+    }
+  }
+
+  /**
+   * Persists an OPEN receipt before the client is exposed to any productive caller.
+   *
+   * @param directory existing owned private directory
+   * @param identity exact expected client and process identity
+   * @return new durable journal
+   * @throws IOException if private ownership, identity or durability cannot be established
+   */
+  public static RealE2eKvsMutationJournal open(Path directory, Identity identity) throws IOException {
+    return new RealE2eKvsMutationJournal(directory, identity);
+  }
+
+  private RealE2eKvsMutationJournal(Path directory, Identity identity) throws IOException {
+    this.identity = Objects.requireNonNull(identity);
+    this.directory = Objects.requireNonNull(directory);
+    require(directory.isAbsolute() && directory.normalize().equals(directory));
+    owner = ProcessHandle.current().info().user().orElseThrow();
+    checkPrivateDirectory();
+    directoryKey = attributes(directory).fileKey();
+    require(directoryKey != null);
+    forceDirectory();
+    receiptPath = directory.resolve("kvs-mutations-" + identity.generationId() + "-" + identity.clientName() + ".json");
+    for (Mutation mutation : Mutation.values()) {
+      for (CallKind callKind : CallKind.values()) {
+        attemptCounts.put(counterName(mutation, callKind), 0L);
+      }
+    }
+    for (Outcome outcome : Outcome.values()) {
+      completionCounts.put(outcome.name(), 0L);
+    }
+    Files.createFile(receiptPath, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString(PRIVATE_FILE)));
+    receiptKey = attributes(receiptPath).fileKey();
+    receiptDigest = digest(new byte[0]);
+    persist();
+  }
+
+  /** @return exact immutable process/client identity */
+  public Identity identity() { return identity; }
+
+  /** @return exact deterministic receipt path declared by the parent before startup */
+  public Path receiptPath() { return receiptPath; }
+
+  /**
+   * Forces an immutable checkpoint. A zero snapshot is provisional until the external lifecycle gate is verified.
+   *
+   * @return nonsecret snake_case receipt fields
+   * @throws IOException when the receipt cannot be durably checked and updated
+   */
+  public synchronized Map<String, Object> checkpoint() throws IOException {
+    sequence++;
+    lastEvent = Map.of("type", "CHECKPOINT");
+    persist();
+    return lastDurableSnapshot;
+  }
+
+  /**
+   * Persists the invocation before the wrapper may call its productive delegate.
+   *
+   * @param mutation API family
+   * @param callKind exact entry kind
+   * @return already-durable invocation ticket
+   * @throws IOException when the BEGIN could not persist; the delegate must not be invoked
+   */
+  public synchronized Ticket begin(Mutation mutation, CallKind callKind) throws IOException {
+    requireOpen();
+    Ticket ticket = new Ticket(++sequence, mutation, callKind);
+    pending.put(ticket.sequence(), ticket);
+    lastEvent = Map.of("type", "BEGIN", "ticket_sequence", ticket.sequence(),
+        "operation", mutation.name(), "call_kind", callKind.name());
+    attempts++;
+    String counter = counterName(mutation, callKind);
+    attemptCounts.put(counter, attemptCounts.get(counter) + 1);
+    persist();
+    return ticket;
+  }
+
+  /**
+   * Records a matching completion without exporting the response, keys or exception message.
+   *
+   * @param ticket durable invocation ticket
+   * @param outcome safe completion category
+   * @throws IOException if completion identity or durability is unverified
+   */
+  public synchronized void complete(Ticket ticket, Outcome outcome) throws IOException {
+    if (ticket == null || outcome == null || !ticket.equals(pending.get(ticket.sequence()))) {
+      unknown(Reason.INVALID_COMPLETION);
+      throw new IOException(INVALID_JOURNAL);
+    }
+    pending.remove(ticket.sequence());
+    completed++;
+    completionCounts.put(outcome.name(), completionCounts.get(outcome.name()) + 1);
+    sequence++;
+    lastEvent = Map.of("type", "END", "ticket_sequence", ticket.sequence(),
+        "operation", ticket.mutation().name(), "call_kind", ticket.callKind().name(), "outcome", outcome.name());
+    if (outcome == Outcome.BACKEND_REJECTED) {
+      rejected++;
+    } else if (outcome != Outcome.SUCCESS) {
+      markUnknown(reasonFor(outcome));
+    }
+    persist();
+  }
+
+  /**
+   * Makes uncertainty sticky; successful later persistence never restores a zero certificate.
+   *
+   * @param reason fixed nonsecret reason
+   * @throws IOException if the UNKNOWN update cannot persist
+   */
+  public synchronized void unknown(Reason reason) throws IOException {
+    markUnknown(Objects.requireNonNull(reason));
+    sequence++;
+    lastEvent = Map.of("type", "UNKNOWN", "reason", reason.name());
+    persist();
+  }
+
+  /**
+   * Rejects any read or write attempted after close began without silently calling the backend.
+   *
+   * @throws IOException when close or its receipt makes access unsafe
+   */
+  public synchronized void requireOpen() throws IOException {
+    if (closeStarted) {
+      unknown(Reason.POST_CLOSE_CALL);
+      throw new IOException(INVALID_JOURNAL);
+    }
+  }
+
+  /**
+   * Records close intent before the wrapper independently attempts actual delegate cleanup.
+   *
+   * @throws IOException when the close intent cannot be persisted
+   */
+  public synchronized void beginClose() throws IOException {
+    requireOpen();
+    closeStarted = true;
+    if (healthy) {
+      phase = "CLOSING";
+    }
+    sequence++;
+    lastEvent = Map.of("type", "CLOSE_BEGIN");
+    persist();
+  }
+
+  /**
+   * Seals only a healthy, complete receipt. External exact process death remains mandatory for final proof.
+   *
+   * @param closed true only after the actual productive delegate close returned successfully
+   * @throws IOException when final observation cannot be durably verified
+   */
+  public synchronized void finishClose(boolean closed) throws IOException {
+    if (!closeStarted) {
+      markUnknown(Reason.INVALID_COMPLETION);
+    }
+    delegateClosed = closed;
+    if (!closed) {
+      markUnknown(Reason.DELEGATE_CLOSE_FAILURE);
+    }
+    if (!pending.isEmpty()) {
+      markUnknown(Reason.REMOTE_OUTCOME_UNKNOWN);
+    }
+    if (healthy && closeStarted && delegateClosed && pending.isEmpty()) {
+      phase = "SEALED";
+    }
+    sequence++;
+    lastEvent = Map.of("type", "CLOSE_END");
+    persist();
+  }
+
+  private void markUnknown(Reason reason) {
+    healthy = false;
+    phase = "UNKNOWN";
+    if (!unknownReasons.contains(reason.name())) {
+      unknownReasons.add(reason.name());
+    }
+  }
+
+  private static Reason reasonFor(Outcome outcome) {
+    return switch (outcome) {
+      case CANCELLED -> Reason.CANCELLED;
+      case PARTIAL_ERROR -> Reason.PARTIAL_ERROR;
+      default -> Reason.REMOTE_OUTCOME_UNKNOWN;
+    };
+  }
+
+  private Map<String, Object> snapshot() {
+    Map<String, Object> receipt = new LinkedHashMap<>();
+    receipt.put("schema_version", SCHEMA_VERSION);
+    receipt.put("run_id", identity.runId());
+    receipt.put("application", identity.application());
+    receipt.put("client_name", identity.clientName());
+    receipt.put("generation_id", identity.generationId().toString());
+    receipt.put("receipt_id", receiptId.toString());
+    receipt.put("pid", identity.pid());
+    receipt.put("process_start_instant", identity.processStartInstant());
+    receipt.put("recorded_at", Instant.now().toString());
+    receipt.put("sequence", sequence);
+    receipt.put("attempt_count", attempts);
+    receipt.put("attempt_counts", Map.copyOf(attemptCounts));
+    receipt.put("completed_count", completed);
+    receipt.put("completion_counts", Map.copyOf(completionCounts));
+    receipt.put("last_event", lastEvent);
+    receipt.put("known_rejection_count", rejected);
+    receipt.put("inflight", pending.size());
+    receipt.put("pending_sequences", List.copyOf(pending.keySet()));
+    receipt.put("phase", phase);
+    receipt.put("healthy", healthy);
+    receipt.put("close_started", closeStarted);
+    receipt.put("delegate_closed", delegateClosed);
+    receipt.put("unknown_reasons", List.copyOf(unknownReasons));
+    SdkIdentity sdk = identity.sdk();
+    receipt.put("sdk", Map.of("version", sdk.version(), "jar_sha256", sdk.jarSha256(),
+        "interface_sha256", sdk.interfaceSha256(), "delegate_sha256", sdk.delegateSha256(),
+        "interface_origin", sdk.interfaceOrigin(), "delegate_origin", sdk.delegateOrigin(),
+        "delegate_class", sdk.delegateClassName(), "interface_class", "com.fury.toolkit.kvs.KvsClient"));
+    return Collections.unmodifiableMap(receipt);
+  }
+
+  private void persist() throws IOException {
+    try {
+      checkDirectoryIdentity();
+      checkReceiptIdentity();
+      Path staged = Files.createTempFile(directory, ".kvs-stage-", ".tmp",
+          PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString(PRIVATE_FILE)));
+      Map<String, Object> candidate = snapshot();
+      byte[] encoded = (json(candidate) + "\n").getBytes(StandardCharsets.UTF_8);
+      try (FileChannel channel = FileChannel.open(staged, StandardOpenOption.WRITE, LinkOption.NOFOLLOW_LINKS)) {
+        ByteBuffer buffer = ByteBuffer.wrap(encoded);
+        while (buffer.hasRemaining()) {
+          channel.write(buffer);
+        }
+        channel.force(true);
+      }
+      checkDirectoryIdentity();
+      checkReceiptIdentity();
+      Files.move(staged, receiptPath, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      receiptKey = attributes(receiptPath).fileKey();
+      receiptDigest = digest(encoded);
+      forceDirectory();
+      checkDirectoryIdentity();
+      checkReceiptIdentity();
+      lastDurableSnapshot = candidate;
+    } catch (IOException | RuntimeException | Error failure) {
+      markUnknown(Reason.PERSISTENCE_FAILURE);
+      throw failure;
+    }
+  }
+
+  private void checkPrivateDirectory() throws IOException {
+    require(Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS));
+    require(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS).getName().equals(owner));
+    require(Files.getPosixFilePermissions(directory, LinkOption.NOFOLLOW_LINKS)
+        .equals(PosixFilePermissions.fromString(PRIVATE_DIRECTORY)));
+  }
+
+  private void checkDirectoryIdentity() throws IOException {
+    checkPrivateDirectory();
+    require(Objects.equals(directoryKey, attributes(directory).fileKey()));
+  }
+
+  private void checkReceiptIdentity() throws IOException {
+    require(Files.isRegularFile(receiptPath, LinkOption.NOFOLLOW_LINKS));
+    require(Files.getOwner(receiptPath, LinkOption.NOFOLLOW_LINKS).getName().equals(owner));
+    require(Files.getPosixFilePermissions(receiptPath, LinkOption.NOFOLLOW_LINKS)
+        .equals(PosixFilePermissions.fromString(PRIVATE_FILE)));
+    require(Objects.equals(receiptKey, attributes(receiptPath).fileKey()));
+    require(receiptDigest.equals(digest(Files.readAllBytes(receiptPath))));
+  }
+
+  private void forceDirectory() throws IOException {
+    try (FileChannel channel = FileChannel.open(directory, StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS)) {
+      channel.force(true);
+    }
+  }
+
+  private static BasicFileAttributes attributes(Path path) throws IOException {
+    return Files.readAttributes(path, BasicFileAttributes.class, LinkOption.NOFOLLOW_LINKS);
+  }
+
+  private static String digest(byte[] bytes) {
+    try {
+      return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+    } catch (NoSuchAlgorithmException unavailable) {
+      throw new IllegalStateException(INVALID_JOURNAL);
+    }
+  }
+
+  private static String counterName(Mutation mutation, CallKind callKind) {
+    return mutation.name() + "_" + callKind.name();
+  }
+
+  private static void require(boolean condition) {
+    if (!condition) {
+      throw new IllegalStateException(INVALID_JOURNAL);
+    }
+  }
+
+  private static void requireDigest(String digest) {
+    require(digest != null && digest.matches("[a-f0-9]{64}"));
+  }
+
+  private static void requireOrigin(String origin) {
+    require(origin != null && origin.length() <= MAX_ORIGIN_LENGTH
+        && (origin.startsWith("file:") || origin.startsWith("jar:file:") || origin.startsWith("jar:nested:"))
+        && origin.chars().allMatch(character -> character >= 32 && character != '?' && character != '#'));
+  }
+
+  private static String json(Object value) {
+    if (value instanceof String string) {
+      return quote(string);
+    }
+    if (value instanceof Number || value instanceof Boolean) {
+      return value.toString();
+    }
+    if (value instanceof Map<?, ?> fields) {
+      List<String> entries = new ArrayList<>();
+      for (var entry : fields.entrySet()) {
+        entries.add(quote((String) entry.getKey()) + ":" + json(entry.getValue()));
+      }
+      return "{" + String.join(",", entries) + "}";
+    }
+    if (value instanceof List<?> elements) {
+      return "[" + String.join(",", elements.stream().map(RealE2eKvsMutationJournal::json).toList()) + "]";
+    }
+    throw new IllegalStateException(INVALID_JOURNAL);
+  }
+
+  private static String quote(String value) {
+    StringBuilder escaped = new StringBuilder("\"");
+    for (char character : value.toCharArray()) {
+      if (character == '\\' || character == '"') {
+        escaped.append('\\');
+      }
+      require(character >= 32);
+      escaped.append(character);
+    }
+    return escaped.append('"').toString();
+  }
+}
