@@ -0,0 +1,48 @@
+package com.mercadolibre.rio.playmaker.localintegration;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.mercadolibre.rio.playmaker.exceptions.QueueException;
+import com.mercadolibre.rio.playmaker.restclient.ActionsTriggerProducer;
+import com.mercadolibre.rio.sdk.events.actions.ActionTriggerMessage;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Profile;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.stereotype.Component;
+
+/** Publishes the production SDK action payload and waits for the real broker acknowledgement. */
+@Component
+@Profile("local & local-integration & real-e2e")
+public class LocalKafkaActionTriggerProducer implements ActionsTriggerProducer {
+  private final KafkaTemplate<String, String> kafka;
+  private final ObjectMapper mapper;
+  private final String topic;
+
+  /** Creates the sender for the isolated run's action trigger topic. */
+  public LocalKafkaActionTriggerProducer(KafkaTemplate<String, String> kafka, ObjectMapper mapper,
+      @Value("${local.integration.kafka.action-trigger-topic}") String topic) {
+    this.kafka = kafka;
+    this.mapper = mapper;
+    this.topic = topic;
+  }
+
+  @Override
+  public void publish(ActionTriggerMessage message) {
+    if (message == null || message.actionId() == null || message.actionId().isBlank()) {
+      throw new IllegalArgumentException("Action trigger and actionId are required");
+    }
+    try {
+      kafka.send(topic, message.actionId(), mapper.writeValueAsString(message))
+          .get(10, TimeUnit.SECONDS);
+    } catch (InterruptedException exception) {
+      Thread.currentThread().interrupt();
+      throw new QueueException("Interrupted while publishing real E2E action trigger", null);
+    } catch (JsonProcessingException | ExecutionException | TimeoutException exception) {
+      // SDK/broker exception bodies can contain endpoints or payloads; use a bounded diagnostic.
+      throw new QueueException("Failed to publish real E2E action trigger", null);
+    }
+  }
+}
diff --git a/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eActionKafkaConfiguration.java b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eActionKafkaConfiguration.java
