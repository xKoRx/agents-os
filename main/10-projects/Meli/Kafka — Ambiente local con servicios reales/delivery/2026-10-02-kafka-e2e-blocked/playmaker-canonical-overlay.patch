+import org.springframework.context.annotation.Profile;
+import org.springframework.core.env.Environment;
+
+/** Observes only the productive clients of this profile; connection and KVS semantics are unchanged. */
+@Configuration
+@Profile("real-e2e")
+public class RealE2eKvsObservationConfiguration {
+
+  /** Declares the expected client receipts durably before any of their delegates can be consumed. */
+  @Bean
+  public static DestructionAwareBeanPostProcessor realE2eObservedKvsClients(
+      Environment environment, ConfigurableListableBeanFactory beanFactory) {
+    try {
+      String run = environment.getRequiredProperty("e2e.run-id");
+      if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+        throw unverified();
+      }
+      Path directory = Path.of(environment.getRequiredProperty("e2e.kvs-observation.directory"));
+      requirePrivateDirectory(directory);
+      String configured = environment.getProperty("e2e.playmaker.lease.generation", "");
+      UUID generation = configured.isBlank() ? UUID.randomUUID() : UUID.fromString(configured);
+      if (configured.isBlank()) { throw unverified(); }
+      ProcessHandle current = ProcessHandle.current();
+      String start = current.info().startInstant().orElseThrow(
+          RealE2eKvsObservationConfiguration::unverified).toString();
+      List<String> expected = List.of("actionResultKvsClient", "actionLockKvsClient");
+      for (String name : expected) {
+        if (!(beanFactory.getBeanDefinition(name) instanceof AbstractBeanDefinition definition)) {
+          throw unverified();
+        }
+        // This observer owns exactly one close plus its successful-close receipt.
+        definition.setDestroyMethodName("");
+      }
+      Map<String, Object> manifest = new LinkedHashMap<>();
+      manifest.put("schema_version", 1);
+      manifest.put("kind", "KVS_EXPECTED_CLIENTS");
+      manifest.put("run_id", run);
+      manifest.put("application", "PM");
+      manifest.put("generation_id", generation.toString());
+      manifest.put("pid", current.pid());
+      manifest.put("process_start_instant", start);
+      ProcessHandle processOwner = current.parent().orElseThrow(RealE2eKvsObservationConfiguration::unverified);
+      manifest.put("process_owner_pid", processOwner.pid());
+      manifest.put("process_owner_start_instant", processOwner.info().startInstant()
+          .orElseThrow(RealE2eKvsObservationConfiguration::unverified).toString());
+      manifest.put("process_owner_kind", System.getProperty("org.gradle.test.worker") == null
+          ? "DIRECT_PROCESS_WAIT" : "GRADLE_TEST_WORKER_NORMAL_EXIT");
+      manifest.put("sdk_version", "0.7.4");
+      manifest.put("clients", expected);
+      manifest.put("phase", "DECLARED_BEFORE_CLIENTS");
+      String source = environment.getRequiredProperty("e2e.source-commit");
+      String sourceManifest = environment.getRequiredProperty("e2e.source-manifest-sha256");
+      if (!source.matches("[a-f0-9]{40}") || !sourceManifest.matches("[a-f0-9]{64}")) {
+        throw unverified();
+      }
+      manifest.put("source_commit", source);
+      manifest.put("source_manifest_sha256", sourceManifest);
+      declareExpectedGeneration(directory, manifest);
+      writeManifest(directory.resolve("kvs-expected-" + generation + ".json"), manifest);
+      var bindings = new ConcurrentHashMap<String, ClientBinding>();
+      return new DestructionAwareBeanPostProcessor() {
+        @Override
+        public boolean requiresDestruction(Object bean) {
+          return bindings.values().stream().anyMatch(binding -> binding.original() == bean);
+        }
+
+        @Override
+        public void postProcessBeforeDestruction(Object bean, String name) {
+          if (!expected.contains(name)) { return; }
+          ClientBinding binding = bindings.get(name);
+          if (binding == null || binding.original() != bean) {
+            Runtime.getRuntime().halt(79);
+            return;
+          }
+          RealE2eObservedKvsClient observed = binding.observed();
+          try {
+            observed.close();
+            var journal = observed.journal();
+            Map<String, Object> state = journal.checkpoint();
+            if (!"SEALED".equals(state.get("phase")) || !Boolean.TRUE.equals(state.get("healthy"))
+                || !Boolean.TRUE.equals(state.get("delegate_closed"))) {
+              throw unverified();
+            }
+            String receiptDigest;
+            try (InputStream input = Files.newInputStream(journal.receiptPath(), LinkOption.NOFOLLOW_LINKS)) {
+              receiptDigest = sha(input);
+            }
+            Map<String, Object> ack = new LinkedHashMap<>();
+            ack.put("schema_version", 1);
+            ack.put("kind", "KVS_SUCCESSFUL_CLOSE_ACK");
+            ack.put("run_id", run);
+            ack.put("application", manifest.get("application"));
+            ack.put("client_name", name);
+            ack.put("generation_id", generation.toString());
+            ack.put("pid", current.pid());
+            ack.put("process_start_instant", start);
+            ack.put("receipt_sha256", receiptDigest);
+            ack.put("sequence", state.get("sequence"));
+            ack.put("receipt_id", state.get("receipt_id"));
+            writeManifest(directory.resolve("kvs-close-ack-" + generation + "-" + name + ".json"), ack);
+          } catch (Exception exception) {
+            // Spring can swallow destroy failures. An own real-e2e JVM must expose a failed exit instead.
+            Runtime.getRuntime().halt(79);
+          }
+        }
+
+        @Override
+        public Object postProcessAfterInitialization(Object bean, String name) {
+          if (!expected.contains(name)) {
+            return bean;
+          }
+          if (!(bean instanceof KvsClient client)
+              || bean instanceof RealE2eObservedKvsClient) {
+            throw unverified();
+          }
+          try {
+            var sdk = sdkIdentity(client);
+            var identity = new RealE2eKvsMutationJournal.Identity(run, "PM", name,
+                generation, current.pid(), start, sdk);
+            var journal = RealE2eKvsMutationJournal.open(directory, identity);
+            var observed = new RealE2eObservedKvsClient(client, journal);
+            if (bindings.putIfAbsent(name, new ClientBinding(client, observed)) != null) {
+              throw unverified();
+            }
+            return observed;
+          } catch (Exception exception) {
+            throw unverified();
+          }
+        }
+      };
+    } catch (Exception exception) {
+      throw unverified();
+    }
+  }
+
+  private static RealE2eKvsMutationJournal.SdkIdentity sdkIdentity(KvsClient client) throws Exception {
+    Class<?> delegate = client.getClass();
+    if (!delegate.getName().startsWith("com.fury.toolkit.kvs.")) {
+      throw unverified();
+    }
+    String apiOrigin = KvsClient.class.getProtectionDomain().getCodeSource().getLocation().toExternalForm();
+    String delegateOrigin = delegate.getProtectionDomain().getCodeSource().getLocation().toExternalForm();
+    if (!apiOrigin.equals(delegateOrigin) || !apiOrigin.contains("java-toolkit-kvs-0.7.4.jar")) {
+      throw unverified();
+    }
+    return new RealE2eKvsMutationJournal.SdkIdentity("0.7.4", jarSha(apiOrigin),
+        classSha(KvsClient.class), classSha(delegate), apiOrigin, delegateOrigin, delegate.getName());
+  }
+
+  private static String classSha(Class<?> type) throws Exception {
+    try (InputStream input = type.getResourceAsStream("/" + type.getName().replace('.', '/') + ".class")) {
+      if (input == null) {
+        throw unverified();
+      }
+      return sha(input);
+    }
+  }
+
+  private static String jarSha(String origin) throws Exception {
+    if (origin.startsWith("file:")) {
+      try (InputStream input = Files.newInputStream(Path.of(java.net.URI.create(origin)), LinkOption.NOFOLLOW_LINKS)) {
+        return sha(input);
+      }
+    }
+    // Spring Boot nested origins name the same real entry within the running immutable bootJar.
+    String[] arguments = ProcessHandle.current().info().arguments().orElseThrow(
+        RealE2eKvsObservationConfiguration::unverified);
+    for (int index = 0; index + 1 < arguments.length; index++) {
+      if ("-jar".equals(arguments[index])) {
+        try (ZipFile jar = new ZipFile(arguments[index + 1])) {
+          var entry = jar.getEntry("BOOT-INF/lib/java-toolkit-kvs-0.7.4.jar");
+          if (entry == null || !origin.contains("BOOT-INF/lib/java-toolkit-kvs-0.7.4.jar")) {
+            throw unverified();
+          }
+          try (InputStream input = jar.getInputStream(entry)) {
+            return sha(input);
+          }
+        }
+      }
+    }
+    throw unverified();
+  }
+
+  private static String sha(InputStream input) throws Exception {
+    MessageDigest digest = MessageDigest.getInstance("SHA-256");
+    byte[] buffer = new byte[65_536];
+    for (int count; (count = input.read(buffer)) >= 0;) {
+      digest.update(buffer, 0, count);
+    }
+    return HexFormat.of().formatHex(digest.digest());
+  }
+
+  private static void requirePrivateDirectory(Path directory) throws Exception {
+    if (!directory.isAbsolute() || !Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(directory, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rwx------"))) {
+      throw unverified();
+    }
+    var owner = directory.getFileSystem().getUserPrincipalLookupService()
+        .lookupPrincipalByName(System.getProperty("user.name"));
+    if (!owner.equals(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS))) {
+      throw unverified();
+    }
+    for (Path parent = directory; parent != null; parent = parent.getParent()) {
+      if (Files.isSymbolicLink(parent)) {
+        throw unverified();
+      }
+    }
+  }
+
+  private static void declareExpectedGeneration(Path directory, Map<String, Object> manifest) throws Exception {
+    Path registry = directory.resolve("expected-generations.json");
+    Path lock = directory.resolve(".generation-registry.lock");
+    for (Path path : List.of(registry, lock)) {
+      if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(path)
+          || Files.size(path) > 1_000_000
+          || !Files.getOwner(path, LinkOption.NOFOLLOW_LINKS).equals(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS))
+          || !Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS)
+              .equals(PosixFilePermissions.fromString("rw-------"))) { throw unverified(); }
+    }
+    // A separate stable lock protects the append-only registry across own JVMs and contexts.
+    try (FileChannel channel = FileChannel.open(lock, StandardOpenOption.WRITE, LinkOption.NOFOLLOW_LINKS);
+         var held = channel.lock()) {
+      ObjectMapper mapper = new ObjectMapper();
+      Map<?, ?> existing = mapper.readValue(Files.readAllBytes(registry), Map.class);
+      if (!Integer.valueOf(1).equals(existing.get("schema_version"))
+          || !"KVS_EXPECTED_GENERATION_REGISTRY".equals(existing.get("kind"))
+          || !"DECLARED_BEFORE_APPLICATIONS".equals(existing.get("phase"))
+          || !manifest.get("run_id").equals(existing.get("run_id"))
+          || !(existing.get("generations") instanceof List<?> declared)) { throw unverified(); }
+      List<Object> generations = new ArrayList<>(declared);
+      for (Object entry : generations) {
+        if (!(entry instanceof Map<?, ?> expected)
+            || !manifest.get("run_id").equals(expected.get("run_id"))
+            || manifest.get("generation_id").equals(expected.get("generation_id"))) { throw unverified(); }
+      }
+      generations.add(Map.copyOf(manifest));
+      Map<String, Object> next = new LinkedHashMap<>();
+      next.put("schema_version", 1);
+      next.put("kind", "KVS_EXPECTED_GENERATION_REGISTRY");
+      next.put("run_id", manifest.get("run_id"));
+      next.put("phase", "DECLARED_BEFORE_APPLICATIONS");
+      next.put("generations", generations);
+      Path staged = directory.resolve(".generation-registry-" + UUID.randomUUID());
+      writeManifest(staged, next);
+      Files.move(staged, registry, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+      try (FileChannel parent = FileChannel.open(directory, StandardOpenOption.READ)) { parent.force(true); }
+    }
+  }
+
+  private static void writeManifest(Path path, Map<String, Object> data) throws Exception {
+    byte[] encoded = new ObjectMapper().writeValueAsBytes(data);
+    try (FileChannel file = FileChannel.open(path,
+        java.util.Set.of(StandardOpenOption.WRITE, StandardOpenOption.CREATE_NEW),
+        PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+      ByteBuffer bytes = ByteBuffer.wrap(encoded);
+      while (bytes.hasRemaining()) {
+        file.write(bytes);
+      }
+      file.force(true);
+    }
+    try (FileChannel directory = FileChannel.open(path.getParent(), StandardOpenOption.READ)) {
+      directory.force(true);
+    }
+  }
+
+  private record ClientBinding(KvsClient original, RealE2eObservedKvsClient observed) { }
+
+  private static IllegalStateException unverified() {
+    return new IllegalStateException("REAL_E2E_KVS_OBSERVATION_UNVERIFIED");
+  }
+}
