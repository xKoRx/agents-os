+      return;
+    }
+    closeAttempted = true;
+    Throwable failure = null;
+    try {
+      journal.beginClose();
+    } catch (IOException | RuntimeException | Error observationFailure) {
+      failure = observationFailure;
+    }
+    boolean closed = false;
+    try {
+      delegate.close();
+      closed = true;
+    } catch (Exception | Error closeFailure) {
+      failure = accumulate(failure, closeFailure);
+    }
+    try {
+      journal.finishClose(closed);
+    } catch (IOException | RuntimeException | Error observationFailure) {
+      failure = accumulate(failure, observationFailure);
+    }
+    closeFailure = failure;
+    rethrowCloseFailure();
+  }
+
+  private void rethrowCloseFailure() throws Exception {
+    if (closeFailure instanceof Exception exception) {
+      throw exception;
+    }
+    if (closeFailure instanceof Error error) {
+      throw error;
+    }
+  }
+
+  private <T> T mutateSync(Mutation mutation, SyncMutation<T> call) throws KvsClientException {
+    Ticket ticket = begin(mutation, CallKind.SYNC);
+    T actual;
+    try {
+      actual = call.invoke();
+    } catch (KvsClientException | RuntimeException | Error backendFailure) {
+      auditPreservingFailure(ticket, backendFailure);
+      throw backendFailure;
+    }
+    audit(ticket, outcome(mutation, actual));
+    return actual;
+  }
+
+  private <T> CompletableFuture<T> mutateAsync(Mutation mutation, Supplier<CompletableFuture<T>> call) {
+    Ticket ticket = begin(mutation, CallKind.ASYNC);
+    CompletableFuture<T> actual;
+    try {
+      actual = call.get();
+    } catch (RuntimeException | Error backendFailure) {
+      auditPreservingFailure(ticket, backendFailure);
+      throw backendFailure;
+    }
+    if (actual == null) {
+      recordUnknown(Reason.NULL_FUTURE);
+      throw new IllegalStateException(UNVERIFIED);
+    }
+    actual.whenComplete((value, backendFailure) -> {
+      try {
+        journal.complete(ticket, backendFailure == null ? outcome(mutation, value) : failureOutcome(backendFailure));
+      } catch (IOException | RuntimeException observationFailure) {
+        // The journal is already sticky UNKNOWN; the caller retains its actual backend future.
+        LOGGER.log(System.Logger.Level.WARNING, UNVERIFIED);
+      }
+    });
+    return actual;
+  }
+
+  private Ticket begin(Mutation mutation, CallKind callKind) {
+    try {
+      return journal.begin(mutation, callKind);
+    } catch (IOException observationFailure) {
+      // No backend method has been invoked when its BEGIN could not be durably observed.
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void audit(Ticket ticket, Outcome outcome) {
+    try {
+      journal.complete(ticket, outcome);
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void auditPreservingFailure(Ticket ticket, Throwable backendFailure) {
+    try {
+      journal.complete(ticket, failureOutcome(backendFailure));
+    } catch (IOException | RuntimeException observationFailure) {
+      backendFailure.addSuppressed(new IllegalStateException(UNVERIFIED));
+    }
+  }
+
+  private void recordUnknown(Reason reason) {
+    try {
+      journal.unknown(reason);
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private void checkOpen() {
+    try {
+      journal.requireOpen();
+    } catch (IOException observationFailure) {
+      throw new IllegalStateException(UNVERIFIED);
+    }
+  }
+
+  private static Outcome outcome(Mutation mutation, Object actual) {
+    if (mutation == Mutation.DELETE && !(actual instanceof Boolean)) {
+      return Outcome.REMOTE_OUTCOME_UNKNOWN;
+    }
+    if (mutation == Mutation.BULK_WRITE) {
+      if (!(actual instanceof BulkResult<?> bulk)) {
+        return Outcome.REMOTE_OUTCOME_UNKNOWN;
+      }
+      return bulk.hasError() ? Outcome.PARTIAL_ERROR : Outcome.SUCCESS;
+    }
+    return Outcome.SUCCESS;
+  }
+
+  private static Outcome failureOutcome(Throwable failure) {
+    Throwable cause = failure;
+    for (int depth = 0; depth < MAX_CAUSE_DEPTH
+        && (cause instanceof CompletionException || cause instanceof ExecutionException)
+        && cause.getCause() != null && cause.getCause() != cause; depth++) {
+      cause = cause.getCause();
+    }
+    if (cause instanceof java.util.concurrent.CancellationException) {
+      return Outcome.CANCELLED;
+    }
+    if (cause instanceof KvsClientException kvsFailure && ErrorCode.CONFLICT.getCode().equals(kvsFailure.getErrorCode())) {
+      return Outcome.BACKEND_REJECTED;
+    }
+    return Outcome.REMOTE_OUTCOME_UNKNOWN;
+  }
+
+  private static Throwable accumulate(Throwable previous, Throwable next) {
+    if (previous == null) {
+      return next;
+    }
+    previous.addSuppressed(next);
+    return previous;
+  }
+
+  @FunctionalInterface
+  private interface SyncMutation<T> {
+    T invoke() throws KvsClientException;
+  }
+}
diff --git a/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eOwnedProcessLeaseVerifier.java b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eOwnedProcessLeaseVerifier.java
new file mode 100644
index 000000000..15390fb18
--- /dev/null
+++ b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2eOwnedProcessLeaseVerifier.java
@@ -0,0 +1,199 @@
+package com.mercadolibre.rio.playmaker.localintegration;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.security.MessageDigest;
+import java.time.Instant;
+import java.util.HexFormat;
+import java.util.UUID;
+import java.util.concurrent.locks.LockSupport;
+import org.springframework.context.ApplicationContextInitializer;
+import org.springframework.context.ConfigurableApplicationContext;
+import org.springframework.core.env.Environment;
+import org.springframework.core.env.Profiles;
+
+/** Validates the own guardian lease before Spring creates web servers, clients or Kafka listeners. */
+public final class RealE2eOwnedProcessLeaseVerifier
+    implements ApplicationContextInitializer<ConfigurableApplicationContext> {
+
+  /** Registers an immutable witness only after an actual current-process and artifact check. */
+  @Override
+  public void initialize(ConfigurableApplicationContext context) {
+    Environment environment = context.getEnvironment();
+    if (!environment.acceptsProfiles(Profiles.of("real-e2e"))) {
+      return;
+    }
+    try {
+      if (!environment.getRequiredProperty("e2e.playmaker.lease.required", Boolean.class)) {
+        throw unavailable();
+      }
+      String run = environment.getRequiredProperty("e2e.playmaker.lease.run");
+      String generation = environment.getRequiredProperty("e2e.playmaker.lease.generation");
+      if (!run.matches("[a-z0-9][a-z0-9_-]{7,63}")) {
+        throw unavailable();
+      }
+      UUID.fromString(generation);
+      Path lease = Path.of(environment.getRequiredProperty("e2e.playmaker.lease.path"));
+      requirePrivateLease(lease);
+      Path jar = actualJar();
+      String digest = sha256(jar);
+      requireEqual(environment.getRequiredProperty("e2e.playmaker.lease.jar-sha256"), digest);
+      String source = environment.getRequiredProperty("e2e.playmaker.lease.source-commit");
+      String manifest = environment.getRequiredProperty("e2e.playmaker.lease.source-manifest-sha256");
+      if (!source.matches("[a-f0-9]{40}") || !manifest.matches("[a-f0-9]{64}")) {
+        throw unavailable();
+      }
+      ObjectMapper mapper = new ObjectMapper();
+      long deadline = System.nanoTime() + java.time.Duration.ofSeconds(30).toNanos();
+      JsonNode receipt;
+      do {
+        requirePrivateLease(lease);
+        // The private guardian directory and NOFOLLOW opening exclude an external lease target.
+        try (InputStream input = Files.newInputStream(lease, LinkOption.NOFOLLOW_LINKS)) {
+          receipt = mapper.readTree(input);
+        }
+        requireEqual(receipt, "kind", "PLAYMAKER_PROCESS_LEASE");
+        if (!receipt.path("schema_version").isIntegralNumber()
+            || receipt.path("schema_version").longValue() != 1) {
+          throw unavailable();
+        }
+        requireEqual(receipt, "run_id", run);
+        requireEqual(receipt, "generation", generation);
+        requireEqual(receipt, "jar_path", jar.toString());
+        requireEqual(receipt, "jar_sha256", digest);
+        requireEqual(receipt, "source_commit", source);
+        requireEqual(receipt, "source_manifest_sha256", manifest);
+        requireEqual(receipt, "consumer_group", "e2e_" + run + "_playmaker_results");
+        checkAlive(receipt, "parent");
+        checkAlive(receipt, "guardian");
+        String phase = receipt.path("phase").asText();
+        if ("REGISTERED".equals(phase) || "READY".equals(phase)) {
+          requireCurrent(receipt);
+          if (!receipt.path("port").isIntegralNumber()
+              || receipt.path("port").intValue() != environment.getRequiredProperty("server.port", Integer.class)) {
+            throw unavailable();
+          }
+          context.getBeanFactory().registerSingleton("realE2eOwnedProcessLeaseValidated",
+              new VerifiedLease(run, generation, lease, digest, source, manifest));
+          return;
+        }
+        if (!"STARTING".equals(phase) || System.nanoTime() >= deadline) {
+          throw unavailable();
+        }
+        if (Thread.currentThread().isInterrupted()) {
+          throw unavailable();
+        }
+        LockSupport.parkNanos(java.time.Duration.ofMillis(25).toNanos());
+      } while (true);
+    } catch (Exception exception) {
+      // Do not expose lease contents, paths, arguments or underlying SDK/file errors.
+      throw unavailable();
+    }
+  }
+
+  private static void requirePrivateLease(Path lease) throws Exception {
+    if (!lease.isAbsolute() || Files.isSymbolicLink(lease)
+        || !Files.isRegularFile(lease, LinkOption.NOFOLLOW_LINKS)
+        || Files.size(lease) > 65_536
+        || !Files.getPosixFilePermissions(lease, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rw-------"))) {
+      throw unavailable();
+    }
+    Path directory = lease.getParent();
+    if (directory == null || Files.isSymbolicLink(directory)
+        || !Files.isDirectory(directory, LinkOption.NOFOLLOW_LINKS)
+        || !Files.getPosixFilePermissions(directory, LinkOption.NOFOLLOW_LINKS)
+            .equals(PosixFilePermissions.fromString("rwx------"))
+        || !Files.getOwner(lease, LinkOption.NOFOLLOW_LINKS)
+            .equals(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS))) {
+      throw unavailable();
+    }
+    var owner = directory.getFileSystem().getUserPrincipalLookupService()
+        .lookupPrincipalByName(System.getProperty("user.name"));
+    if (!owner.equals(Files.getOwner(directory, LinkOption.NOFOLLOW_LINKS))) {
+      throw unavailable();
+    }
+    for (Path parent = directory; parent != null; parent = parent.getParent()) {
+      if (Files.isSymbolicLink(parent)) {
+        throw unavailable();
+      }
+    }
+  }
+
+  private static Path actualJar() {
+    String[] arguments = ProcessHandle.current().info().arguments().orElseThrow(
+        RealE2eOwnedProcessLeaseVerifier::unavailable);
+    for (int index = 0; index + 1 < arguments.length; index++) {
+      if ("-jar".equals(arguments[index])) {
+        Path jar = Path.of(arguments[index + 1]);
+        if (jar.isAbsolute() && Files.isRegularFile(jar, LinkOption.NOFOLLOW_LINKS)
+            && !Files.isSymbolicLink(jar)) {
+          return jar;
+        }
+      }
+    }
+    throw unavailable();
+  }
+
+  private static String sha256(Path path) throws Exception {
+    MessageDigest digest = MessageDigest.getInstance("SHA-256");
+    try (InputStream input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) {
+      byte[] bytes = new byte[65_536];
+      for (int count; (count = input.read(bytes)) >= 0;) {
+        digest.update(bytes, 0, count);
+      }
+    }
+    return HexFormat.of().formatHex(digest.digest());
+  }
+
+  private static void checkAlive(JsonNode receipt, String name) {
+    JsonNode pid = receipt.path(name + "_pid");
+    if (!pid.isIntegralNumber() || pid.longValue() <= 0) {
+      throw unavailable();
+    }
+    ProcessHandle process = ProcessHandle.of(pid.longValue()).orElseThrow(
+        RealE2eOwnedProcessLeaseVerifier::unavailable);
+    if (!process.isAlive()) {
+      throw unavailable();
+    }
+    requireEqual(receipt, name + "_start",
+        process.info().startInstant().orElseThrow(
+            RealE2eOwnedProcessLeaseVerifier::unavailable).toString());
+  }
+
+  private static void requireCurrent(JsonNode receipt) {
+    JsonNode pid = receipt.path("pm_pid");
+    if (!pid.isIntegralNumber() || pid.longValue() != ProcessHandle.current().pid()) {
+      throw unavailable();
+    }
+    Instant start = ProcessHandle.current().info().startInstant().orElseThrow(
+        RealE2eOwnedProcessLeaseVerifier::unavailable);
+    requireEqual(receipt, "pm_start", start.toString());
+  }
+
+  private static void requireEqual(JsonNode receipt, String key, String expected) {
+    if (!receipt.path(key).isTextual()) {
+      throw unavailable();
+    }
+    requireEqual(receipt.path(key).textValue(), expected);
+  }
+
+  private static void requireEqual(String actual, String expected) {
+    if (!expected.equals(actual)) {
+      throw unavailable();
+    }
+  }
+
+  private static IllegalStateException unavailable() {
+    return new IllegalStateException("REAL_E2E_PLAYMAKER_LEASE_UNVERIFIED");
+  }
+
+  /** Own current-process lease witness; a configuration flag alone cannot construct this proof. */
+  public record VerifiedLease(String runId, String generation, Path path, String jarSha256,
+                              String sourceCommit, String sourceManifestSha256) { }
+}
diff --git a/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2ePlaymakerConfiguration.java b/src/main/java/com/mercadolibre/rio/playmaker/localintegration/RealE2ePlaymakerConfiguration.java
new file mode 100644
